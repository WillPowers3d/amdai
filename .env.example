# Copy to .env locally. Never commit real IDs.
# Affiliate programs we use: Amazon Associates, Rakuten Advertising, B&H only.

# Amazon Associates store tag (?tag=). Optional — default in retailers.yaml is amdainet-20.
AMAZON_ASSOCIATE_TAG=

# Encrypted publisher token from the Rakuten Link Locator (`id=` on
# click.linksynergy.com/deeplink). Not the public Site ID (SID 4763021)
# stored as rakuten.sid in src/data/retailers.yaml. Leave unset until you have it.
RAKUTEN_PUBLISHER_ID=
# Newegg advertiser MID from the Rakuten dashboard once Newegg approves us.
# Do not guess. Unset = plain newegg.com links.
RAKUTEN_MID_NEWEGG=

# B&H — own program or a network. Prefer a template when you have a wrapper URL.
BHPHOTO_AFFILIATE_ID=
# Optional wrapper: https://example-network.example/c/{id}?u={url}
# Placeholders: {id} {url} {murl}
BHPHOTO_LINK_TEMPLATE=
# Used only when no template is set. Default is BI.
BHPHOTO_QUERY_PARAM=

# Optional privacy-friendly click ping (absolute URL). Unset = no tracking.
# /go/ links may carry ?src= (for example src=canrun-nextstep). The hop page
# includes that token in the beacon JSON when this URL is set.
AFFILIATE_CLICK_BEACON=

# Put Newegg first on Check-price buttons. Off until Rakuten Newegg deep links
# (RAKUTEN_PUBLISHER_ID + RAKUTEN_MID_NEWEGG) are live. Default is Amazon first.
# NEWEGG_FIRST=0

# Do not add MICROCENTER_AFFILIATE_ID or AMD_AFFILIATE_ID.

# Optional accounts (saved rigs + email alerts). Off = static SSG, no database.
ACCOUNTS_ENABLED=0
FORUM_ENABLED=0

# Required when ACCOUNTS_ENABLED=1. Never commit real values.
AUTH_SECRET=
# AUTH_URL=http://127.0.0.1:43147
# DATABASE_URL=file:./data/accounts.sqlite
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=0
# GITHUB_ID=
# GITHUB_SECRET=

# Public site URL for sitemap / canonicals. Default in astro.config.mjs is https://amdai.net
# SITE_URL=https://amdai.net

# Optional Stack Lab local web UI (http://127.0.0.1:<port> only). Unset = no localhost href.
# STACK_LAB_LOCAL_ORIGIN=

# Optional public contact inbox on /contact. Unset or invalid = no mailto, no invented address.
# Same value can live in src/data/contact.yaml (email: ""). The content QA gate warns when both are empty.
# CONTACT_EMAIL=
