# Copy to .env locally. Never commit real IDs.
# Affiliate programs we use: Amazon Associates, Rakuten Advertising, B&H only.

# Amazon Associates store tag (?tag=). Optional — default in retailers.yaml is amdainet-20.
AMAZON_ASSOCIATE_TAG=

# Rakuten Advertising — publisher / site id on click.linksynergy.com/deeplink
RAKUTEN_PUBLISHER_ID=
# Newegg merchant id from the Rakuten dashboard (do not guess)
RAKUTEN_MID_NEWEGG=

# B&H — own program or a network. Prefer a template when you have a wrapper URL.
BHPHOTO_AFFILIATE_ID=
# Optional wrapper: https://example-network.example/c/{id}?u={url}
# Placeholders: {id} {url} {murl}
BHPHOTO_LINK_TEMPLATE=
# Used only when no template is set. Default is BI.
BHPHOTO_QUERY_PARAM=

# Optional privacy-friendly click ping (absolute URL). Unset = no tracking.
AFFILIATE_CLICK_BEACON=

# Do not add MICROCENTER_AFFILIATE_ID or AMD_AFFILIATE_ID.
