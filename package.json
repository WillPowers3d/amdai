{
  "name": "r9700-lab-notes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Consumer AMD ROCm notes — local Qwen on Radeon, grounded in an R9700 test rig.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 43147",
    "build": "astro build && pagefind --site dist",
    "index": "pagefind --site dist --output-path public/pagefind",
    "preview": "astro preview --host 127.0.0.1 --port 43147",
    "astro": "astro",
    "check": "astro check",
    "test": "tsx --test src/lib/rig-match.test.ts",
    "notify": "tsx src/scripts/notify.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/node": "^11.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.44.5",
    "nodemailer": "^7.0.6",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.2",
    "pagefind": "^1.5.2",
    "tsx": "^4.20.6"
  }
}
