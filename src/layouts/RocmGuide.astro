---
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import RocmNav from '../components/rocm/RocmNav.astro';
import RocmRelated from '../components/rocm/RocmRelated.astro';
import { GUIDE_UPDATED, rocmPage, type RocmPageId } from '../lib/rocm-guide';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  page: RocmPageId;
  headings?: Heading[];
}

const { page: pageId, headings = [] } = Astro.props;
const page = rocmPage(pageId);
const updated = GUIDE_UPDATED;
---

<Base title={page.title} description={page.description}>
  <div class="rocm-guide mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[15rem_1fr] xl:grid-cols-[15rem_1fr_14rem]">
    <div class="rocm-guide-nav">
      <div class="sticky top-24">
        <RocmNav current={pageId} />
      </div>
    </div>
    <main id="main" class="min-w-0">
      <p class="kicker">What is ROCm</p>
      <h1 class="display mt-2 text-4xl tracking-tight text-balance sm:text-5xl">{page.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{page.description}</p>
      <p class="mt-3 text-sm text-faint">
        Updated {updated.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}.
        Independent notes — not AMD documentation.
      </p>
      <div class="mt-6 lg:hidden">
        <RocmNav current={pageId} variant="toc" />
      </div>
      {headings.length > 0 && (
        <div class="mt-6 xl:hidden">
          <Toc headings={headings} />
        </div>
      )}
      <article id="article" class="prose-lab prose mt-10 max-w-none">
        <slot />
      </article>
      <div class="mt-12">
        <RocmNav current={pageId} variant="pager" />
      </div>
      <RocmRelated />
    </main>
    {headings.length > 0 && (
      <div class="hidden xl:block">
        <div class="sticky top-24">
          <Toc headings={headings} />
        </div>
      </div>
    )}
  </div>
</Base>
