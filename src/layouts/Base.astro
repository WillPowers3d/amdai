---
import '../styles/global.css';
import '../lib/seo-pages';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Related from '../components/Related.astro';
import { jsonLdScript, pageJsonLd } from '../lib/jsonld';
import { relatedFor } from '../lib/related';
import {
  articleDates,
  breadcrumbsFor,
  canonicalUrl,
  documentTitle,
  pageDescription,
  shouldNoindex,
  urlPath,
} from '../lib/seo';
import { OG_HEIGHT, OG_WIDTH, ogImageAlt, ogSlug } from '../lib/og';
import { OG_SITE_NAME, site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const path = urlPath(Astro.url.pathname);
const title = documentTitle(path, Astro.props.title);
const description = pageDescription(path, Astro.props.description);
const canonical = canonicalUrl(path, Astro.site?.href.replace(/\/$/, '') || 'https://amdai.net');
const og = new URL(`/og/${ogSlug(path)}.png`, Astro.site);
const ogAlt = ogImageAlt(path);
const noindex = shouldNoindex(path);
const crumbs = path === '/' ? [] : breadcrumbsFor(path);
const related = relatedFor(path);
const dates = articleDates(path);
const jsonld = jsonLdScript(pageJsonLd({ pathname: path, title, description }));
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#08080b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {dates && <meta property="article:published_time" content={dates.published} />}
    {dates && <meta property="article:modified_time" content={dates.modified} />}
    {dates && <meta name="last-modified" content={dates.modified} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.wordmark} Lab Notes`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.wordmark} · ${site.name} updates`} href="/updates/rss.xml" />
    <link rel="alternate" type="application/json" title={`${site.wordmark} public API v1`} href="/api/v1/index.json" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      /* Main stays before chrome in source order. Reserve the header slot so a late
         parse of page-chrome does not shove page-main from y=0 to y=64. */
      .page-body { display: flex; flex-direction: column; }
      .page-body > .skip-link { order: 0; }
      .page-chrome,
      .page-chrome-reserve { order: 1; }
      .page-chrome-reserve { flex-shrink: 0; pointer-events: none; }
      .page-chrome { margin-top: -4rem; }
      .page-body:has(.page-chrome-reserve.has-crumbs) .page-chrome { margin-top: -8.25rem; }
      .crumb-bar { height: 4.25rem; }
      .page-main { order: 2; }
      .page-foot { order: 3; }
    </style>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:site_name" content={OG_SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <title>{title}</title>
    <Fragment set:html={`<script type="application/ld+json">${jsonld}</script>`} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="page-body min-h-screen antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <div
      class:list={['page-chrome-reserve', crumbs.length > 1 && 'has-crumbs']}
      style={crumbs.length > 1 ? 'height:8.25rem' : 'height:4rem'}
      aria-hidden="true"
    >
    </div>
    <div class="page-main" data-pagefind-body>
      <slot />
      {related.length > 0 && (
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <Related items={related} />
        </div>
      )}
    </div>
    <div
      class="page-chrome"
      data-pagefind-ignore
      style={crumbs.length > 1 ? 'margin-top:-8.25rem;min-height:8.25rem' : 'margin-top:-4rem;min-height:4rem'}
    >
      <ReadingProgress />
      <Header />
      {crumbs.length > 1 && (
        <div class="crumb-bar border-b border-line" style="height:4.25rem">
          <div class="mx-auto flex h-full max-w-6xl items-center justify-between gap-2 overflow-hidden px-4 sm:px-6">
            <Breadcrumbs items={crumbs} />
            {dates && (
              <p class="page-updated">
                Last updated <time datetime={dates.modified}>{dates.modified}</time>
              </p>
            )}
          </div>
        </div>
      )}
    </div>
    <div class="page-foot" data-pagefind-ignore>
      <Footer />
      <CommandPalette />
    </div>
    <script>
      document.querySelectorAll('pre').forEach((pre) => {
        if (!pre.hasAttribute('tabindex')) pre.setAttribute('tabindex', '0');
        if (pre.parentElement?.classList.contains('code-wrap')) return;
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          const text = pre.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copied';
          } catch {
            btn.textContent = 'Select';
          }
          window.setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1600);
        });
        wrap.appendChild(btn);
      });

      document.querySelectorAll('table').forEach((table) => {
        if (!table.querySelector(':scope > caption')) {
          const caption = document.createElement('caption');
          caption.className = 'sr-only';
          const heading = table.closest('section, article, figure')?.querySelector('h1, h2, h3, h4');
          caption.textContent = heading?.textContent?.trim() || 'Data table';
          table.prepend(caption);
        }
        table.querySelectorAll('thead th').forEach((th) => {
          if (!th.hasAttribute('scope')) {
            th.setAttribute('scope', th.colSpan > 1 ? 'colgroup' : 'col');
          }
        });
        table.querySelectorAll('tbody th').forEach((th) => {
          if (!th.hasAttribute('scope')) th.setAttribute('scope', 'row');
        });
        const parent = table.parentElement;
        if (parent && !parent.classList.contains('table-scroll') && !parent.classList.contains('overflow-x-auto') && !parent.classList.contains('qwen-table-wrap') && !parent.classList.contains('compare-table')) {
          parent.classList.add('table-scroll');
        }
      });
    </script>
  </body>
</html>
