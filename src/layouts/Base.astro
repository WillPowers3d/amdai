---
import '../styles/global.css';
import '../lib/seo-pages';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { jsonLdScript, pageJsonLd } from '../lib/jsonld';
import {
  breadcrumbsFor,
  canonicalUrl,
  documentTitle,
  isNestedPath,
  pageDescription,
  shouldNoindex,
  urlPath,
} from '../lib/seo';
import { OG_SITE_NAME, ogSlug, site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const path = urlPath(Astro.url.pathname);
const title = documentTitle(path, Astro.props.title);
const description = pageDescription(path, Astro.props.description);
const canonical = canonicalUrl(path, Astro.site?.href.replace(/\/$/, '') || 'https://amdai.net');
const og = new URL(`/og/${ogSlug(path)}.png`, Astro.site);
const noindex = shouldNoindex(path);
const crumbs = isNestedPath(path) ? breadcrumbsFor(path) : [];
const jsonld = jsonLdScript(pageJsonLd({ pathname: path, title, description }));
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#08080b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.wordmark} · ${site.name} updates`} href="/updates/rss.xml" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:site_name" content={OG_SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <title>{title}</title>
    <Fragment set:html={`<script type="application/ld+json">${jsonld}</script>`} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <ReadingProgress />
    <div data-pagefind-ignore>
      <Header />
      {crumbs.length > 1 && (
        <div class="border-b border-line">
          <div class="mx-auto max-w-6xl px-4 sm:px-6">
            <Breadcrumbs items={crumbs} />
          </div>
        </div>
      )}
    </div>
    <div data-pagefind-body>
      <slot />
    </div>
    <div data-pagefind-ignore>
      <Footer />
      <CommandPalette />
    </div>
    <script>
      document.querySelectorAll('pre').forEach((pre) => {
        if (!pre.hasAttribute('tabindex')) pre.setAttribute('tabindex', '0');
        if (pre.parentElement?.classList.contains('code-wrap')) return;
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          const text = pre.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copied';
          } catch {
            btn.textContent = 'Select';
          }
          window.setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1600);
        });
        wrap.appendChild(btn);
      });

      document.querySelectorAll('table').forEach((table) => {
        if (!table.querySelector(':scope > caption')) {
          const caption = document.createElement('caption');
          caption.className = 'sr-only';
          const heading = table.closest('section, article, figure')?.querySelector('h1, h2, h3, h4');
          caption.textContent = heading?.textContent?.trim() || 'Data table';
          table.prepend(caption);
        }
        table.querySelectorAll('thead th').forEach((th) => {
          if (!th.hasAttribute('scope')) {
            th.setAttribute('scope', th.colSpan > 1 ? 'colgroup' : 'col');
          }
        });
        table.querySelectorAll('tbody th').forEach((th) => {
          if (!th.hasAttribute('scope')) th.setAttribute('scope', 'row');
        });
        const parent = table.parentElement;
        if (parent && !parent.classList.contains('table-scroll') && !parent.classList.contains('overflow-x-auto') && !parent.classList.contains('qwen-table-wrap') && !parent.classList.contains('compare-table')) {
          parent.classList.add('table-scroll');
        }
      });
    </script>
  </body>
</html>
