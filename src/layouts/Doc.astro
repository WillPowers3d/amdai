---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  kicker?: string;
  updated?: Date;
  headings?: Heading[];
}

const { title, description, kicker, updated, headings = [] } = Astro.props;
---

<Base title={title} description={description}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1fr_16rem] xl:grid-cols-[15rem_1fr_15rem]">
    <Sidebar />
    <main id="main" class="min-w-0">
      <p class="kicker">{kicker ?? 'Guide'}</p>
      <h1 class="mt-2 font-serif text-4xl tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{description}</p>
      {updated && (
        <p class="mt-3 text-sm text-faint">
          Updated {updated.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
      )}
      <div class="mt-6 xl:hidden">
        <Toc headings={headings} />
      </div>
      <article id="article" class="prose-lab prose mt-10 max-w-none">
        <slot />
      </article>
    </main>
    <div class="hidden xl:block">
      <div class="sticky top-24">
        <Toc headings={headings} />
      </div>
    </div>
  </div>
</Base>
