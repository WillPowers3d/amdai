---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import NeweggReturnNote from './NeweggReturnNote.astro';
import {
  destinationUrl,
  goPath,
  nextStepRetailers,
  productById,
  productHasRetailer,
  retailerById,
  wrapRetailer,
} from '../lib/affiliates';
import { CAN_RUN_NEXT_STEP_ALT_SRC, CAN_RUN_NEXT_STEP_SRC, type UpgradePick } from '../lib/upgrade-pick';
import { buyButtonAriaLabel, buyButtonLabel, buyLinkRel } from '../lib/buy-label';

interface Props {
  picks: UpgradePick[];
  src?: string;
  altSrc?: string;
  lead?: string;
}

const {
  picks,
  src = CAN_RUN_NEXT_STEP_SRC,
  altSrc = CAN_RUN_NEXT_STEP_ALT_SRC,
  lead = 'Your next step for this model',
} = Astro.props;

const primary = picks.find((pick) => pick.kind === 'primary' && pick.productId);
const alt = picks.find((pick) => pick.kind === 'alt' && pick.productId);
const product = primary?.productId ? productById(primary.productId) : undefined;
const retailers = product
  ? nextStepRetailers().filter((retailer) => productHasRetailer(product, retailer.id))
  : [];
const altProduct = alt?.productId ? productById(alt.productId) : undefined;
const altNewegg = retailerById('newegg');
const altDest = altProduct && altNewegg ? destinationUrl(altProduct.id, altNewegg.id) : null;
const altWrapped = altDest && altNewegg ? wrapRetailer(altDest, altNewegg) : { href: '', affiliate: false };
const altHref = altProduct ? goPath('newegg', altProduct.id, altSrc) : '';
---

{primary && product && retailers.length > 0 && (
  <aside class="not-prose my-6 rounded-2xl border border-line bg-raised/50 p-5" data-pagefind-ignore data-next-step={primary.productId}>
    <p class="kicker">Next step</p>
    <p class="mt-2 font-serif text-2xl tracking-tight">
      {lead}: {primary.label}.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {retailers.map((retailer, index) => {
        const dest = destinationUrl(product.id, retailer.id);
        const wrapped = dest ? wrapRetailer(dest, retailer) : { href: '', affiliate: false };
        const href = goPath(retailer.id, product.id, src);
        const primaryBtn = index === 0;
        return (
          <li>
            <a
              class:list={[primaryBtn ? 'btn-primary' : 'btn-ghost']}
              href={href}
              rel={buyLinkRel(wrapped.affiliate)}
              target="_blank"
              aria-label={buyButtonAriaLabel(product.name, retailer.name)}
              data-retailer={retailer.id}
              data-product={product.id}
            >
              {buyButtonLabel(retailer.name)}
            </a>
          </li>
        );
      })}
    </ul>
    {alt && altProduct && altHref && (
      <p class="mt-3 text-sm text-muted">
        <a
          class="underline decoration-accent/40"
          href={altHref}
          rel={buyLinkRel(altWrapped.affiliate)}
          aria-label={buyButtonAriaLabel(altProduct.name, 'Newegg')}
          data-retailer="newegg"
          data-product={altProduct.id}
        >
          {alt.label}
        </a>
      </p>
    )}
    {retailers.some((retailer) => retailer.id === 'newegg') && <NeweggReturnNote productId={product.id} />}
    <p class="mt-3 text-sm text-muted">A commission does not change the fit verdict on this page. We do not print a price.</p>
    <div class="mt-3">
      <AffiliateDisclosure compact />
    </div>
  </aside>
)}
