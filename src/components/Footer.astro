---
import { AMAZON_ASSOCIATE_DISCLOSURE } from '../lib/affiliates';
import { CONSUMER_NAV_LINKS } from '../lib/consumer-gpu';
import { navGroups, primaryNav, site } from '../lib/site';
import { TRUST_FOOTER_LINKS } from '../lib/trust';
import Logo from './Logo.astro';
import NewsletterSignup from './NewsletterSignup.astro';
---

<footer class="mt-20 border-t border-line bg-raised/40">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-1">
      <Logo />
      <p class="mt-3 font-medium">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">
        Independent living notes for hobbyists. Not an AMD publication. Version pins are dated snapshots. Product names belong to their owners.
      </p>
      <div class="mt-6">
        <NewsletterSignup variant="compact" />
      </div>
    </div>
    {navGroups.map((group) => (
      <div>
        <p class="kicker">{group.label}</p>
        <ul class="mt-3 grid gap-1.5 text-sm">
          {primaryNav.filter((item) => item.group === group.id).map((item) => (
            <li><a class="inline-flex min-h-11 items-center text-muted hover:text-ink" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-line">
    <nav class="mx-auto max-w-7xl px-4 py-4 sm:px-6" aria-label="Trust and legal">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
        {TRUST_FOOTER_LINKS.map((link) => (
          <li>
            <a class="inline-flex min-h-11 items-center text-faint underline decoration-accent/40 underline-offset-2 hover:text-ink" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-xs leading-relaxed text-faint">
        Independent, not affiliated with AMD.
        Refresh <code class="font-mono">src/data/what-works.yaml</code> when the frontier moves.
        <a class="underline decoration-accent/40 underline-offset-2" href="/maintain">Weekday scrape</a>.
        <a class="underline decoration-accent/40 underline-offset-2" href="/newsletter">Digest</a>.
        <a class="underline decoration-accent/40 underline-offset-2" href="/faq">FAQ</a>.
        <a class="underline decoration-accent/40 underline-offset-2" href="/setup">Setup</a>.
        Consumer GPU sheets:
        {CONSUMER_NAV_LINKS.map((link, index) => (
          <>
            {index > 0 ? ' · ' : ' '}
            <a class="underline decoration-accent/40 underline-offset-2" href={link.href}>{link.label}</a>
          </>
        ))}
        .
        {AMAZON_ASSOCIATE_DISCLOSURE} Always confirm the live ROCm matrix.
      </p>
    </nav>
  </div>
</footer>
