---
import { navGroups, primaryNav, site } from '../lib/site';
---

<footer class="mt-16 border-t border-line bg-raised/40">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-1">
      <p class="font-serif text-xl">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">
        Independent living notes for hobbyists. Not an AMD publication. Version pins are dated snapshots. Product names belong to their owners.
      </p>
    </div>
    {navGroups.map((group) => (
      <div>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-faint">{group.label}</p>
        <ul class="mt-3 grid gap-1.5 text-sm">
          {primaryNav.filter((item) => item.group === group.id).map((item) => (
            <li><a class="text-muted hover:text-ink" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-7xl px-4 py-4 text-xs text-faint sm:px-6">
      Refresh <code class="font-mono">src/data/what-works.yaml</code> when the frontier moves. Always confirm the live ROCm matrix.
    </p>
  </div>
</footer>
