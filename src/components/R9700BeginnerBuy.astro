---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import NeweggReturnNote from './NeweggReturnNote.astro';
import { goPath } from '../lib/go-src';

interface Props {
  src?: string;
}

const { src = 'beginner-r9700' } = Astro.props;
const href = goPath('newegg', 'r9700', src);
---

<aside class="not-prose my-6 rounded-2xl border border-line bg-raised/50 p-5" data-buy="r9700">
  <p class="kicker">If your card is 16–24 GB</p>
  <p class="mt-2 font-serif text-2xl tracking-tight">
    One Radeon AI PRO R9700 (32 GB) holds Qwen3.6-35B at 256K on the GPU.
  </p>
  <p class="mt-2 text-sm text-muted">
    A 32 GB Radeon you already own does not need a second card for this model. A 24 GB card can stay at 32K, or try partial offload with 64 GB+ system RAM.
  </p>
  <p class="mt-4">
    <a
      class="inline-flex min-h-11 items-center rounded-full bg-[#c73b24] px-4 py-2 text-sm font-semibold text-[#fffaf3]"
      href={href}
      rel="sponsored nofollow noopener"
      target="_blank"
      aria-label="Check AMD Radeon AI PRO R9700 price at Newegg"
    >
      Newegg: check R9700 price
    </a>
  </p>
  <NeweggReturnNote productId="r9700" />
  <div class="mt-3">
    <AffiliateDisclosure compact />
  </div>
</aside>
