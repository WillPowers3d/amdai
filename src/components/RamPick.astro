---
import BuyButtons from './BuyButtons.astro';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import RamWorth from './RamWorth.astro';
import {
  DIMM_SPEED_NOTE,
  NAMED_RAM_KITS,
  RAM_96_FAST_DATED_PRICE,
  RAM_96_FAST_NOTE,
  RAM_96_FAST_PRODUCT,
  RAM_96_FAST_SRC,
  RAM_96_HEADLINE,
  RAM_ASK_COPY,
  REPLACE_KIT_NOTE,
  ramCapFlag,
  ramRecommendation,
} from '../lib/ram-kit';
import { goPath } from '../lib/go-src';
import type { Motherboard } from '../lib/motherboards';

interface Props {
  boards: Motherboard[];
  bigModels?: boolean;
  needsOffload?: boolean;
  gpuCount?: number;
  id?: string;
}

const { boards, bigModels = false, needsOffload = false, gpuCount = 1, id = 'ram-pick' } = Astro.props;
const initial = ramRecommendation({ bigModels, needsOffload, gpuCount });
const capped = boards.filter((board) => board.max_ram_gb < 256);
const visibleIds = new Set([initial.primary.id, ...initial.alternatives.map((row) => row.id)]);
---

<section id={id} class="space-y-4" data-ram-pick data-ram-offload={needsOffload ? '1' : '0'}>
  <div>
    <p class="kicker">System RAM</p>
    <h2 class="mt-2 text-2xl tracking-tight sm:text-3xl">Which DDR5 kit matches this build?</h2>
    <p class="mt-2 text-sm font-medium leading-relaxed" data-ram-headline>{RAM_96_HEADLINE}</p>
    <p class="mt-2 text-sm leading-relaxed text-muted">{RAM_ASK_COPY.expensive}</p>
    <p class="mt-2 text-sm leading-relaxed text-muted" data-ram-note>{initial.why}</p>
    <p class="mt-2 text-sm leading-relaxed text-muted">{DIMM_SPEED_NOTE}</p>
    <p class="mt-2 text-sm leading-relaxed text-muted">{REPLACE_KIT_NOTE}</p>
    <p class="mt-2 text-sm text-muted">Buttons say Check price. Any price shown carries the date we checked it — never a live or invented price.</p>
  </div>

  {NAMED_RAM_KITS.map((kit) => {
    const isPrimary = kit.id === initial.primary.id;
    return (
      <div class="card p-5 sm:p-6" data-ram-card={kit.id} hidden={!visibleIds.has(kit.id)}>
        <p class="kicker">{isPrimary ? 'Recommended · most builds' : kit.id === '32' ? '35B only · one card' : 'More RAM · larger, slower model'}</p>
        <h3 class="mt-1 text-2xl tracking-tight">{kit.name}</h3>
        <p class="mt-2 text-sm text-muted">{kit.kit_gb} GB · {kit.dimms} · {kit.part}</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">{kit.note}</p>
        {kit.dated_price && (
          <p class="mt-2 text-sm leading-relaxed" data-ram-dated-price>
            <strong class="font-medium text-ink">{kit.dated_price.label}</strong> on {kit.dated_price.as_of_label}
            — {kit.dated_price.source}. Prices change; check the current price before you buy.
          </p>
        )}
        {kit.id === '96' && (
          <p class="mt-2 text-sm leading-relaxed text-muted" data-ram-offload-note hidden={!initial.offload}>
            {RAM_ASK_COPY.offload}
          </p>
        )}
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Cite:
          <a class="underline decoration-accent/40 underline-offset-2" href={kit.citation.url} rel="noopener" target="_blank">
            {kit.citation.title}
          </a>
          — {kit.citation.section}. As of {kit.citation.as_of}.
        </p>
        <BuyButtons product={kit.product_id} src={kit.src} disclose={false} />
        {kit.id === '96' && (
          <div class="mt-4 space-y-3" data-ram-fastest>
            <p class="text-sm leading-relaxed text-muted">{RAM_96_FAST_NOTE}</p>
            <p class="text-sm leading-relaxed" data-ram-fastest-price>
              <strong class="font-medium text-ink">{RAM_96_FAST_DATED_PRICE.label}</strong> on {RAM_96_FAST_DATED_PRICE.as_of_label}
              — {RAM_96_FAST_DATED_PRICE.source}. Prices change; check the current price before you buy.
            </p>
            <p>
              <a
                class="inline-flex min-h-11 items-center rounded-full bg-[#c73b24] px-4 py-2 text-sm font-semibold text-[#fffaf3]"
                href={goPath('newegg', RAM_96_FAST_PRODUCT, RAM_96_FAST_SRC)}
                rel="sponsored nofollow noopener"
                target="_blank"
              >
                Fastest tested · Check price at Newegg
              </a>
            </p>
          </div>
        )}
      </div>
    );
  })}

  {capped.length > 0 && (
    <div data-ram-caps hidden={initial.only_35b_ok}>
      <p class="text-sm font-medium">Boards that cannot take 256 GB</p>
      <ul class="mt-2 space-y-2 text-sm leading-relaxed text-muted">
        {capped.map((board) => (
          <li>
            <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={`/motherboards#${board.id}`}>
              {board.name}
            </a>
            — {ramCapFlag(board.max_ram_gb)}
            Cite:
            <a class="underline decoration-accent/40 underline-offset-2" href={board.citation.url} rel="noopener" target="_blank">
              {board.citation.title}
            </a>
            — {board.citation.section}. As of {board.citation.as_of}.
          </li>
        ))}
      </ul>
    </div>
  )}

  <RamWorth id={`${id}-more-ram`} />

  <AffiliateDisclosure compact />
</section>

<script>
  function bigModels(): boolean {
    const checked = document.querySelector<HTMLInputElement>('input[name="bigmodels"]:checked');
    if (checked) return checked.value === '1' || checked.value === 'yes';
    return false;
  }

  function needsOffload(): boolean {
    const root = document.querySelector<HTMLElement>('[data-ram-pick]');
    return root?.getAttribute('data-ram-offload') === '1';
  }

  function gpuCount(): number {
    const field = document.querySelector<HTMLInputElement>('[name="gpuCount"]');
    if (field && field.value) {
      const n = Number(field.value);
      if (Number.isFinite(n) && n >= 1) return Math.min(4, Math.round(n));
    }
    const radio = document.querySelector<HTMLInputElement>('input[name="n"]:checked');
    if (radio) {
      const n = Number(radio.value);
      if (Number.isFinite(n) && n >= 1) return Math.min(4, Math.round(n));
    }
    const highlighted = document.querySelector<HTMLElement>('[data-tier].ring-accent, [data-tier].ring-2');
    if (highlighted?.getAttribute('data-tier') === 'pro') return 2;
    const q = new URLSearchParams(window.location.search);
    if (q.get('tier') === 'pro' || q.get('n') === '2') return 2;
    return 1;
  }

  const RAM_COPY = {
    no: 'We still recommend 96 GB (2x48 DDR5) for most builds, so Qwen 3.8 Flash stays an option. 32 GB (2x16) is enough only if you will run the 35B on one card and never want Flash.',
    yes: 'Recommend 96 GB (2x48 DDR5). With two R9700s it runs Qwen 3.8 Flash Q4 at full 256K context (estimate: about 67 GB needed). 128–256 GB loads larger, smarter models but answers a lot slower — usually not worth it.',
    offload: 'This model and setup already need RAM offload, so plan on 96 GB or more. 96 GB covers two-card Flash Q4 at 256K (estimate); check Minimum system RAM needed on the calculator for this exact pick.',
  };

  function syncRam() {
    const root = document.querySelector<HTMLElement>('[data-ram-pick]');
    if (!root) return;
    const n = gpuCount();
    const large = bigModels() || needsOffload() || n >= 2;
    const note = root.querySelector('[data-ram-note]');
    if (note) {
      note.textContent = needsOffload() && !bigModels() ? RAM_COPY.offload : large ? RAM_COPY.yes : RAM_COPY.no;
    }
    root.querySelectorAll<HTMLElement>('[data-ram-card]').forEach((card) => {
      const id = card.getAttribute('data-ram-card');
      if (id === '96') card.hidden = false;
      else if (id === '32') card.hidden = large;
      else card.hidden = !large;
    });
    const offloadNote = root.querySelector<HTMLElement>('[data-ram-offload-note]');
    if (offloadNote) offloadNote.hidden = !needsOffload();
    const caps = root.querySelector<HTMLElement>('[data-ram-caps]');
    if (caps) caps.hidden = !large;
    document.querySelectorAll<HTMLElement>('[data-ram-cap]').forEach((el) => {
      el.hidden = !large;
    });
  }

  document.addEventListener('change', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.matches('[name="bigmodels"], [name="n"], [name="gpuCount"]')) syncRam();
  });
  document.addEventListener('input', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.matches('[name="gpuCount"]')) syncRam();
  });
  window.addEventListener('amdai-ask-change', syncRam);
  window.addEventListener('amdai-ram-offload', ((event: CustomEvent<{ needed?: boolean }>) => {
    const root = document.querySelector<HTMLElement>('[data-ram-pick]');
    if (root) root.setAttribute('data-ram-offload', event.detail?.needed ? '1' : '0');
    syncRam();
  }) as EventListener);
  syncRam();
</script>
