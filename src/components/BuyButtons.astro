---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import { destinationUrl, goPath, productById, productHasRetailer, retailers, wrapRetailer } from '../lib/affiliates';

interface Props {
  product?: string;
  products?: string[];
  heading?: string;
  disclose?: boolean;
}

const { product: productId, products: productIds, heading, disclose = true } = Astro.props;
const ids = productIds ?? (productId ? [productId] : []);
const items = ids.map((id) => productById(id)).filter((item): item is NonNullable<typeof item> => Boolean(item));
---

{items.length > 0 && (
  <section class="not-prose my-6 space-y-5">
    {items.map((item) => {
      const links = retailers.filter((retailer) => productHasRetailer(item, retailer.id)).map((retailer) => {
        const dest = destinationUrl(item.id, retailer.id);
        const wrapped = dest ? wrapRetailer(dest, retailer) : { href: '', affiliate: false };
        return {
          retailer,
          href: goPath(retailer.id, item.id),
          affiliate: wrapped.affiliate,
        };
      });
      return (
        <div class="rounded-2xl border border-line bg-raised/50 p-4 sm:p-5" data-buy={item.id}>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">Check price · no live or stale prices</p>
          <h3 class="mt-1 font-serif text-2xl">{heading && items.length === 1 ? heading : item.name}</h3>
          {item.note && <p class="mt-1 text-sm text-muted">{item.note}</p>}
          <ul class="mt-4 flex flex-wrap gap-2">
            {links.map(({ retailer, href, affiliate }) => (
              <li>
                <a
                  class:list={[
                    'inline-flex min-h-11 items-center rounded-full px-4 py-2 text-sm',
                    affiliate ? 'bg-accent text-white' : 'border border-line bg-canvas text-ink',
                  ]}
                  href={href}
                  rel={affiliate ? 'sponsored nofollow noopener' : 'noopener'}
                  target="_blank"
                >
                  {affiliate ? `Check price at ${retailer.name}` : `Also at ${retailer.name}`}
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
    {disclose && (
      <div class="px-1">
        <AffiliateDisclosure compact />
      </div>
    )}
  </section>
)}
