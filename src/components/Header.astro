---
import { allNav, primaryNav, site } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  current?: string;
}

const { current = Astro.url.pathname } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(`${href}/`);
};
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="group flex min-w-0 items-center gap-2.5">
      <span class="mark" aria-hidden="true"></span>
      <span class="min-w-0">
        <span class="block font-serif text-lg leading-none tracking-tight">{site.name}</span>
        <span class="hidden text-[0.68rem] uppercase tracking-[0.16em] text-faint sm:block">Living ROCm notes</span>
      </span>
    </a>

    <div class="ml-auto flex items-center gap-2">
      <form class="hidden sm:block" action="/search" method="get" role="search">
        <label class="sr-only" for="header-search">Search</label>
        <input
          id="header-search"
          name="q"
          type="search"
          class="h-9 w-40 rounded-full border border-line bg-raised px-3 text-sm lg:w-52"
          placeholder="Search"
        />
      </form>
      <a class="inline-flex h-9 items-center rounded-full border border-line bg-raised px-3 text-sm sm:hidden" href="/search">Search</a>
      <a class="hidden rounded-full border border-line bg-raised px-3 py-1.5 text-sm sm:inline" href="/calculator">Calculator</a>
      <a class="hidden rounded-full bg-accent px-3 py-1.5 text-sm text-white sm:inline" href="/start">Start</a>
      <ThemeToggle />
      <button
        type="button"
        class="inline-flex h-9 items-center rounded-full border border-line bg-raised px-3 text-sm xl:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
      </button>
    </div>
  </div>

  <nav class="mx-auto hidden max-w-7xl flex-wrap gap-0.5 px-4 pb-2 sm:px-6 xl:flex" aria-label="Primary">
    {allNav.map((item) => (
      <a
        href={item.href}
        class:list={[
          'rounded-full px-2 py-1 text-[0.8rem] transition-colors',
          isActive(item.href) ? 'bg-accent-soft text-accent-ink' : 'text-muted hover:text-ink',
        ]}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <nav id="mobile-nav" class="hidden border-t border-line bg-canvas px-4 py-3 xl:hidden" aria-label="Mobile">
    <ul class="grid gap-1 sm:grid-cols-2">
      {primaryNav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block rounded-lg px-3 py-2',
              isActive(item.href) ? 'bg-accent-soft text-accent-ink' : 'text-ink',
            ]}
          >
            <span class="block font-medium">{item.label}</span>
            <span class="block text-sm text-muted">{item.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .mark {
    width: 1.05rem;
    height: 1.05rem;
    background: var(--accent);
    clip-path: polygon(18% 8%, 92% 8%, 82% 92%, 8% 92%);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, black);
  }
</style>
