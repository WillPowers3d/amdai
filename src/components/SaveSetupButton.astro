---
import { accountsEnabled } from '../lib/flags';

interface Props {
  from?: 'calculator' | 'budget';
}

const { from = 'calculator' } = Astro.props;
const href = accountsEnabled() ? `/account/save?from=${from}` : '/account';
---

<a class="save-setup rounded-full border border-line bg-raised px-4 py-2 text-sm" href={href} data-save-setup={from}>
  Save this setup
</a>
