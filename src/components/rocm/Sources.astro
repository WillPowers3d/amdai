---
import { citations, type CiteKey } from '../../lib/rocm-guide';

interface Props {
  used: readonly CiteKey[];
}

const { used } = Astro.props;
---

<section class="rocm-sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">Sources</h2>
  <p>
    Every version and support claim on this page points here. If a sentence has no mark, treat it as
    lab opinion or a TODO — not as AMD policy.
  </p>
  <ol>
    {used.map((id) => {
      const src = citations[id];
      return (
        <li id={`cite-${id}`}>
          <a href={src.href} rel="noreferrer">{src.title}</a>
          <span class="src-meta"> — {src.publisher}{src.note ? `. ${src.note}` : ''}</span>
        </li>
      );
    })}
  </ol>
</section>
