---
import { getCollection } from 'astro:content';
import { navGroups, primaryNav } from '../lib/site';

interface Props {
  current?: string;
}

const { current = Astro.url.pathname } = Astro.props;
const tutorials = (await getCollection('tutorials')).sort((a, b) => a.data.order - b.data.order);
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<aside class="hidden xl:block">
  <nav class="sticky top-28 space-y-7 text-sm" aria-label="Section map">
    {navGroups.map((group) => (
      <div>
        <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">{group.label}</p>
        <ul class="space-y-1">
          {primaryNav.filter((item) => item.group === group.id).map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-md px-2 py-1.5',
                  isActive(item.href) ? 'bg-accent-soft text-accent-ink' : 'text-muted hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div>
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">How-tos</p>
      <ul class="space-y-1">
        {tutorials.map((item) => {
          const href = `/tutorials/${item.id}`;
          return (
            <li>
              <a href={href} class:list={['block rounded-md px-2 py-1.5', current === href ? 'bg-accent-soft text-accent-ink' : 'text-muted hover:text-ink']}>
                {item.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
    <div>
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">ROCm notes</p>
      <ul class="space-y-1">
        {updates.map((item) => (
          <li>
            <a href="/rocm#version-notes" class="block rounded-md px-2 py-1.5 text-muted hover:text-ink">
              {item.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</aside>
