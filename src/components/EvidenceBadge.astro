---
import { TIER_LABEL, type EvidenceTier } from '../lib/recipes';

interface Props {
  tier: EvidenceTier;
  compact?: boolean;
}

const { tier, compact = false } = Astro.props;
const cls =
  tier === 'tested-our-rig'
    ? 'badge-tested'
    : tier === 'load-only'
      ? 'badge-warn'
      : tier === 'community'
        ? 'badge-ok'
        : 'badge';
---

<span class:list={[cls, compact && 'text-[0.7rem]']}>{TIER_LABEL[tier]}</span>
