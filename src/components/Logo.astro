---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['logo', compact && 'compact']}>
  <svg class="chip" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
    <rect x="7.2" y="7.2" width="17.6" height="17.6" rx="2.2" fill="var(--raised)" stroke="var(--accent)" stroke-width="1.5" />
    <rect x="10.4" y="4.2" width="2.1" height="2.6" rx="0.3" fill="var(--accent)" />
    <rect x="15" y="4.2" width="2.1" height="2.6" rx="0.3" fill="var(--faint)" />
    <rect x="19.6" y="4.2" width="2.1" height="2.6" rx="0.3" fill="var(--faint)" />
    <rect x="10.4" y="25.2" width="2.1" height="2.6" rx="0.3" fill="var(--faint)" />
    <rect x="15" y="25.2" width="2.1" height="2.6" rx="0.3" fill="var(--faint)" />
    <rect x="19.6" y="25.2" width="2.1" height="2.6" rx="0.3" fill="var(--accent)" />
    <rect x="4.2" y="10.4" width="2.6" height="2.1" rx="0.3" fill="var(--faint)" />
    <rect x="4.2" y="15" width="2.6" height="2.1" rx="0.3" fill="var(--faint)" />
    <rect x="4.2" y="19.6" width="2.6" height="2.1" rx="0.3" fill="var(--faint)" />
    <rect x="25.2" y="10.4" width="2.6" height="2.1" rx="0.3" fill="var(--faint)" />
    <rect x="25.2" y="15" width="2.6" height="2.1" rx="0.3" fill="var(--faint)" />
    <rect x="25.2" y="19.6" width="2.6" height="2.1" rx="0.3" fill="var(--faint)" />
  </svg>
  <span class="word">amd<span class="ai">ai</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }

  .chip {
    flex: none;
  }

  .word {
    font-size: 1.15rem;
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .ai {
    color: var(--accent);
  }

  .compact .word {
    font-size: 1.05rem;
  }
</style>
