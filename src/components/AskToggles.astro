---
import type { Priority } from '../lib/priority';
import type { Style, Usage } from '../lib/ask';
import { DEFAULT_PRIORITY } from '../lib/priority';
import { DEFAULT_BIG_MODELS, DEFAULT_COLD_LOAD, DEFAULT_CPU_WORK, DEFAULT_MIN_BUDGET, DEFAULT_STYLE, DEFAULT_USAGE, defaultExpandGpu } from '../lib/ask';
import { EXPAND_GPU_COPY, MIN_BUDGET_COPY } from '../lib/motherboards';
import { RAM_ASK_COPY } from '../lib/ram-kit';
import { CPU_WORK_COPY } from '../lib/cpu-pick';
import { STORAGE_ASK_COPY } from '../lib/storage-pick';

interface Props {
  defaultPriority?: Priority;
  defaultUsage?: Usage;
  defaultStyle?: Style;
  defaultMinBudget?: boolean;
  defaultExpandGpu?: boolean;
  defaultBigModels?: boolean;
  defaultCpuWork?: boolean;
  defaultColdLoad?: boolean;
}

const {
  defaultPriority = DEFAULT_PRIORITY,
  defaultUsage = DEFAULT_USAGE,
  defaultStyle = DEFAULT_STYLE,
  defaultMinBudget = DEFAULT_MIN_BUDGET,
  defaultExpandGpu: expandDefault = defaultExpandGpu(defaultMinBudget),
  defaultBigModels = DEFAULT_BIG_MODELS,
  defaultCpuWork = DEFAULT_CPU_WORK,
  defaultColdLoad = DEFAULT_COLD_LOAD,
} = Astro.props;
---

<section id="ask-first" class="space-y-6" data-ask-root>
  <div>
    <p class="kicker">Ask first</p>
    <h2 class="mt-2 text-2xl tracking-tight sm:text-3xl">What do you want first?</h2>
    <p class="mt-2 text-sm text-muted">
      Setup questions before the recommendation. They change the pick, not the VRAM math. Tokens per
      second are estimates unless a “Tested on our rig” number is showing. No cloud prices.
      Dual x8/x8 boards stay the default unless you explicitly pick Minimum budget.
    </p>
  </div>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
    <legend class="px-1 font-medium">Priority</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Priority">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="priority" value="size" checked={defaultPriority === 'size'} />
        <span class="block font-medium">Max model size</span>
        <span class="mt-1 block text-sm text-muted">More VRAM, more RAM, Q5/Q6 when they fit. Slower tokens.</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="priority" value="speed" checked={defaultPriority === 'speed'} />
        <span class="block font-medium">Speed</span>
        <span class="mt-1 block text-sm text-muted">One GPU, no offload, MoE, Q4_K_M to Q5.</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-priority-lede></p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
    <legend class="px-1 font-medium">Usage</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Usage">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="usage" value="local" checked={defaultUsage === 'local'} />
        <span class="block font-medium">Fully local</span>
        <span class="mt-1 block text-sm text-muted">Bigger VRAM/RAM and long context. The local model does everything.</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="usage" value="hybrid" checked={defaultUsage === 'hybrid'} />
        <span class="block font-medium">Hybrid (local plus a cloud model like Claude, Grok or ChatGPT for token-heavy work)</span>
        <span class="mt-1 block text-sm text-muted">Local keeps privacy-sensitive, repetitive, or always-on work. Cloud can take long jobs. No cloud prices on this page.</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-usage-lede></p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
    <legend class="px-1 font-medium">Model style</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Model style">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="style" value="standard" checked={defaultStyle === 'standard'} />
        <span class="block font-medium">Standard (original)</span>
        <span class="mt-1 block text-sm text-muted">Official instruct. The default.</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="style" value="abliterated" checked={defaultStyle === 'abliterated'} />
        <span class="block font-medium">Abliterated / uncensored</span>
        <span class="mt-1 block text-sm text-muted">Educational. Can hurt quality. You are responsible for use.</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-style-lede></p>
    <p class="mt-3 text-sm">
      <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href="/abliterated">Abliterated hub</a>
      — what it is, how to vet files, the catalog. Educational only. Tested pick: being reworked.
    </p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
    <legend class="px-1 font-medium">Board budget</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Board budget">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="minbudget" value="0" checked={!defaultMinBudget} />
        <span class="block font-medium">{MIN_BUDGET_COPY.recommended.label}</span>
        <span class="mt-1 block text-sm text-muted">{MIN_BUDGET_COPY.recommended.lede}</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="minbudget" value="1" checked={defaultMinBudget} />
        <span class="block font-medium">{MIN_BUDGET_COPY.minimum.label}</span>
        <span class="mt-1 block text-sm text-muted">{MIN_BUDGET_COPY.minimum.lede}</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-minbudget-lede></p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5" data-expand-gpu>
    <legend class="px-1 font-medium">{EXPAND_GPU_COPY.question}</legend>
    <p class="mt-2 text-sm leading-relaxed text-muted">{EXPAND_GPU_COPY.push}</p>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Second GPU later">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="expandgpu" value="1" checked={expandDefault} />
        <span class="block font-medium">{EXPAND_GPU_COPY.yes.label}</span>
        <span class="mt-1 block text-sm text-muted">{EXPAND_GPU_COPY.yes.lede}</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="expandgpu" value="0" checked={!expandDefault} />
        <span class="block font-medium">{EXPAND_GPU_COPY.no.label}</span>
        <span class="mt-1 block text-sm text-muted">{EXPAND_GPU_COPY.no.lede}</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-expandgpu-lede></p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5" data-big-models>
    <legend class="px-1 font-medium">{RAM_ASK_COPY.question}</legend>
    <p class="mt-2 text-sm leading-relaxed text-muted">{RAM_ASK_COPY.expensive}</p>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Larger models later">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="bigmodels" value="0" checked={!defaultBigModels} />
        <span class="block font-medium">{RAM_ASK_COPY.no.label}</span>
        <span class="mt-1 block text-sm text-muted">{RAM_ASK_COPY.no.lede}</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="bigmodels" value="1" checked={defaultBigModels} />
        <span class="block font-medium">{RAM_ASK_COPY.yes.label}</span>
        <span class="mt-1 block text-sm text-muted">{RAM_ASK_COPY.yes.lede}</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-bigmodels-lede></p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5" data-cpu-work hidden={!defaultBigModels}>
    <legend class="px-1 font-medium">{CPU_WORK_COPY.question}</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Other CPU jobs">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="cpuwork" value="0" checked={!defaultCpuWork} />
        <span class="block font-medium">{CPU_WORK_COPY.no.label}</span>
        <span class="mt-1 block text-sm text-muted">{CPU_WORK_COPY.no.lede}</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="cpuwork" value="1" checked={defaultCpuWork} />
        <span class="block font-medium">{CPU_WORK_COPY.yes.label}</span>
        <span class="mt-1 block text-sm text-muted">{CPU_WORK_COPY.yes.lede}</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-cpuwork-lede></p>
  </fieldset>

  <fieldset class="rounded-2xl border border-line bg-raised/40 p-5" data-cold-load>
    <legend class="px-1 font-medium">{STORAGE_ASK_COPY.question}</legend>
    <div class="mt-3 grid gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Fastest cold loads">
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="coldload" value="0" checked={!defaultColdLoad} />
        <span class="block font-medium">{STORAGE_ASK_COPY.no.label}</span>
        <span class="mt-1 block text-sm text-muted">{STORAGE_ASK_COPY.no.lede}</span>
      </label>
      <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
        <input class="sr-only" type="radio" name="coldload" value="1" checked={defaultColdLoad} />
        <span class="block font-medium">{STORAGE_ASK_COPY.yes.label}</span>
        <span class="mt-1 block text-sm text-muted">{STORAGE_ASK_COPY.yes.lede}</span>
      </label>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-muted" data-coldload-lede></p>
  </fieldset>
</section>
