---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import { destinationUrl, goPath, productById, retailerById, wrapRetailer } from '../lib/affiliates';
import { buyButtonAriaLabel, buyLinkRel } from '../lib/buy-label';
import { WHERE_TO_BUY_CHECKED_LABEL, WHERE_TO_BUY_NEWEGG_NOTE, WHERE_TO_BUY_PATH } from '../lib/where-to-buy-r9700';

const product = productById('r9700');
const newegg = retailerById('newegg');
const dest = destinationUrl('r9700', 'newegg');
const wrapped = dest && newegg ? wrapRetailer(dest, newegg) : { href: '', affiliate: false };
const href = goPath('newegg', 'r9700', 'home-start');
const name = product?.name ?? 'AMD Radeon AI PRO R9700';
---

<aside class="mt-8 max-w-xl rounded-2xl border border-line bg-raised/50 p-5" data-start-here>
  <p class="kicker">Start here</p>
  <p class="mt-3 leading-relaxed text-ink">
    One 32 GB Radeon AI PRO R9700 runs Qwen3.6-35B-A3B (UD-Q5_K_XL) at its full 256K context, entirely on
    the card, at about 100 tok/s on our rig (measured, llama.cpp Vulkan, short context). A second card does not
    make that model faster; it lets you run a second copy or a bigger, slower model with help from system RAM.
  </p>
  <p class="mt-3 text-sm leading-relaxed text-muted">
    Newegg listings checked {WHERE_TO_BUY_CHECKED_LABEL}. {WHERE_TO_BUY_NEWEGG_NOTE}
  </p>
  <p class="mt-4 flex flex-wrap gap-3">
    <a class="btn-primary" href={WHERE_TO_BUY_PATH}>Where to buy an R9700</a>
    <a
      class="btn-ghost"
      href={href}
      rel={buyLinkRel(wrapped.affiliate)}
      target="_blank"
      aria-label={buyButtonAriaLabel(name, 'Newegg')}
      data-retailer="newegg"
      data-product="r9700"
    >
      Check R9700 at Newegg
    </a>
    <a class="btn-ghost" href="/calculator">Already have a GPU? Check my rig</a>
  </p>
  <p class="mt-3 text-sm text-muted">
    You may need nothing, or only RAM.
    <a class="underline decoration-accent/40" href="/budget">Size the rest of the box</a>
    ·
    <a class="underline decoration-accent/40" href="/results">See the measured runs</a>
  </p>
  <div class="mt-4">
    <AffiliateDisclosure compact />
  </div>
</aside>
