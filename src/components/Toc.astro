---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 1 && (
  <nav class="rounded-xl border border-line bg-raised/70 p-4" aria-label="On this page">
    <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">On this page</p>
    <ol class="mt-3 space-y-1.5 text-sm">
      {items.map((heading) => (
        <li class:list={[heading.depth === 3 && 'pl-3']}>
          <a class="text-muted hover:text-ink" href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
