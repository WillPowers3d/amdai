---
import { allNav } from '../lib/site';

const items = allNav.map((item) => ({ href: item.href, label: item.label, description: item.description, group: item.group }));
---

<dialog id="cmdk" class="cmdk" aria-label="Search">
  <form method="dialog" class="cmdk-form" action="/search">
    <label class="sr-only" for="cmdk-input">Search the site</label>
    <div class="cmdk-bar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <input id="cmdk-input" name="q" type="search" placeholder="Search pages, stacks, errors…" autocomplete="off" />
      <kbd>esc</kbd>
    </div>
    <p class="cmdk-hint">Type to filter. Enter opens the first match. Full-text search lives on <a href="/search">/search</a>.</p>
    <ul id="cmdk-list" class="cmdk-list"></ul>
  </form>
</dialog>

<script define:vars={{ items }}>
  const dialog = document.getElementById('cmdk');
  const input = document.getElementById('cmdk-input');
  const list = document.getElementById('cmdk-list');
  if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !list) {
    /* no-op */
  } else {
    const rows = items;

    function render(q) {
      const needle = q.trim().toLowerCase();
      const hits = rows.filter((row) => {
        if (!needle) return true;
        return `${row.label} ${row.description} ${row.href}`.toLowerCase().includes(needle);
      }).slice(0, 10);
      list.innerHTML = hits
        .map(
          (row, i) =>
            `<li><a href="${row.href}" data-i="${i}"><span>${row.label}</span><span class="desc">${row.description}</span></a></li>`,
        )
        .join('');
      const first = list.querySelector('a');
      first?.setAttribute('aria-current', 'true');
    }

    function open() {
      render(input.value);
      dialog.showModal();
      input.focus();
      input.select();
    }

    function close() {
      dialog.close();
    }

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        dialog.open ? close() : open();
      }
    });

    document.querySelectorAll('[data-cmdk-open]').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      });
    });

    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        const first = list.querySelector('a');
        if (first && input.value.trim()) {
          event.preventDefault();
          window.location.href = first.getAttribute('href') || '/search';
        }
      }
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    render('');
  }
</script>

<style>
  .cmdk {
    width: min(40rem, calc(100vw - 1.5rem));
    margin: 12vh auto 0;
    border: 1px solid var(--line);
    background: var(--raised);
    color: var(--ink);
    border-radius: 1rem;
    box-shadow: var(--shadow);
    padding: 0;
  }

  .cmdk::backdrop {
    background: color-mix(in srgb, #000 55%, transparent);
  }

  .cmdk-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid var(--line);
    padding: 0.85rem 1rem;
    color: var(--muted);
  }

  .cmdk-bar input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--ink);
    font-size: 1rem;
    outline: none;
  }

  .cmdk-bar kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    padding: 0.1rem 0.35rem;
  }

  .cmdk-hint {
    padding: 0.55rem 1rem 0;
    font-size: 0.75rem;
    color: var(--faint);
  }

  .cmdk-list {
    max-height: 22rem;
    overflow: auto;
    padding: 0.5rem;
    margin: 0;
    list-style: none;
  }

  .cmdk-list a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-radius: 0.7rem;
    padding: 0.7rem 0.75rem;
  }

  .cmdk-list a:hover,
  .cmdk-list a[aria-current='true'] {
    background: var(--accent-soft);
  }

  .cmdk-list .desc {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
