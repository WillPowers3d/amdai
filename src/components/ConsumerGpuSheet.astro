---
import Callout from './Callout.astro';
import SystemRamNeed from './SystemRamNeed.astro';
import type { ConsumerRecipePage } from '../lib/consumer-gpu';

interface Props {
  sheet: ConsumerRecipePage;
}

const { sheet } = Astro.props;
---

<section id="identity" class="mt-10 scroll-mt-28" aria-labelledby="identity-heading">
  <h2 id="identity-heading" class="font-serif text-3xl tracking-tight">Official identity</h2>
  <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-2xl border border-line bg-raised/40 p-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-faint">Card</dt>
      <dd class="mt-2 font-serif text-2xl tracking-tight">{sheet.name}</dd>
    </div>
    <div class="rounded-2xl border border-line bg-raised/40 p-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-faint">gfx</dt>
      <dd class="mt-2 font-mono text-2xl text-accent-ink">{sheet.gfx}</dd>
    </div>
    <div class="rounded-2xl border border-line bg-raised/40 p-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-faint">Published VRAM</dt>
      <dd class="mt-2 font-serif text-2xl tracking-tight tabular-nums">{sheet.vramLabel}</dd>
      <dd class="mt-1 text-xs text-faint">Hardware label, not a bench</dd>
    </div>
    <div class="rounded-2xl border border-line bg-raised/40 p-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-faint">ROCm matrix</dt>
      <dd class="mt-2 text-lg font-medium">{sheet.support === 'official' ? 'Official' : 'Unofficial'}</dd>
      <dd class="mt-1 text-xs text-muted">{sheet.rocmNote}</dd>
    </div>
  </dl>
  <p class="mt-4 text-sm leading-relaxed text-muted">
    Cited support row:
    <a class="underline decoration-accent/40" href={sheet.matrixHref} rel="noopener">ROCm 10.1.0 compatibility matrix</a>
    and
    <a class="underline decoration-accent/40" href={sheet.linuxReqsHref} rel="noopener">Linux system requirements</a>.
    We do not invent a support claim past that listing.
    {sheet.productHref && (
      <>
        AMD product page:
        <a class="underline decoration-accent/40" href={sheet.productHref} rel="noopener">{sheet.shortName}</a>.
      </>
    )}
  </p>
  <p class="mt-2 text-sm text-muted">HSA_OVERRIDE: {sheet.hsaOverride}</p>
</section>

<Callout type="note" title="Not measured on local-desktop">
  <p>{sheet.notMeasured}</p>
</Callout>

<section id="fit" class="mt-12 scroll-mt-28" aria-labelledby="fit-heading">
  <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">What fits in VRAM</h2>
  <p class="mt-3 max-w-3xl leading-relaxed text-muted">
    {sheet.model} on {sheet.engine}, f16 KV, one GPU.
    Q6 / Q5 / Q4 rows are calculator estimates.
    <strong class="text-ink">{sheet.q3}</strong> is a labeled estimate ({sheet.q3Cite}) — not a local-desktop run.
    Speed stays not measured. Change quant or context in the
    <a class="underline decoration-accent/40" href={sheet.calculatorHref}>calculator</a>.
  </p>
  <div class="mt-6 overflow-x-auto">
    <table class="table-lab min-w-[52rem]">
      <caption>
        Estimated VRAM fit for {sheet.model} on {sheet.shortName} at {sheet.vramLabel}. Speed is not measured.
      </caption>
      <thead>
        <tr>
          <th scope="col">Quant</th>
          <th scope="col">Kind</th>
          <th scope="col">Weights</th>
          {sheet.fitRows[0]?.cells.map((cell) => (
            <th scope="col">{cell.contextLabel} total</th>
          ))}
          <th scope="col">Speed</th>
        </tr>
      </thead>
      <tbody>
        {sheet.fitRows.map((row) => (
          <tr>
            <th scope="row">{row.quant}</th>
            <td>{row.kindLabel}</td>
            <td class="tabular-nums">{row.weightsGb}</td>
            {row.cells.map((cell) => (
              <td>
                <span class="tabular-nums">{cell.totalGb}</span>
                <span class="mt-1 block text-xs text-muted">{cell.verdictLabel}</span>
              </td>
            ))}
            <td>{row.speed}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-faint">
    Weights notes: {sheet.fitRows.map((row) => `${row.quant} — ${row.weightsNote}`).join(' ')}
  </p>
</section>

<section id="ram" class="mt-12 scroll-mt-28" aria-labelledby="ram-heading">
  <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">System RAM</h2>
  <p class="mt-3 max-w-3xl leading-relaxed text-muted">{sheet.ramNote}</p>
  <div class="mt-6">
    <SystemRamNeed need={sheet.ramNeed} />
  </div>
</section>

<section id="stack" class="mt-12 scroll-mt-28" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="font-serif text-3xl tracking-tight">llama.cpp-first stack</h2>
  <ol class="mt-6 grid gap-4 md:grid-cols-2">
    {sheet.stack.map((tip, index) => (
      <li class="rounded-2xl border border-line bg-raised/50 p-5">
        <p class="kicker">Step {index + 1}</p>
        <h3 class="mt-2 font-serif text-2xl tracking-tight">{tip.title}</h3>
        <p class="mt-3 leading-relaxed text-muted">{tip.body}</p>
      </li>
    ))}
  </ol>
</section>

<nav class="mt-10" aria-label="Shopper tools">
  <ul class="flex flex-wrap gap-3">
    <li><a class="btn-primary" href={sheet.calculatorHref}>Open in calculator</a></li>
    <li><a class="btn-secondary" href={sheet.budget.href}>{sheet.budget.label}</a></li>
    <li><a class="btn-ghost" href="/benchmarks">Benchmarks</a></li>
    <li><a class="btn-ghost" href="/setup">First-run setup</a></li>
    <li><a class="btn-ghost" href="/stack-lab">Stack Lab</a></li>
    <li><a class="btn-ghost" href="/gpus/r9700">R9700 measured page</a></li>
    <li><a class="btn-ghost" href="/compare/radeon-vs-nvidia">Radeon vs NVIDIA</a></li>
    <li><a class="btn-ghost" href="/faq">FAQ</a></li>
    <li><a class="btn-ghost" href="/models">Models</a></li>
  </ul>
  <p class="mt-4 text-sm text-muted">
    Also:
    <a class="underline decoration-accent/40" href="/gpus">GPU directory</a>
    {' · '}
    <a class="underline decoration-accent/40" href="/start">Getting started</a>
    {' · '}
    <a class="underline decoration-accent/40" href="/backends/llamacpp">llama.cpp</a>
    {' · '}
    <a class="underline decoration-accent/40" href="/methodology">How we test</a>
    {' · '}
    <a class="underline decoration-accent/40" href="/contribute">Contribute a recipe</a>
    {sheet.siblings.map((link) => (
      <>
        {' · '}
        <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
      </>
    ))}
  </p>
</nav>
