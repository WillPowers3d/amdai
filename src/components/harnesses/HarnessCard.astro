---
import { CATEGORY_COPY, harnessPath, hybridLabel, surfaceLabel, type Harness } from '../../lib/harnesses';

interface Props {
  row: Harness;
}

const { row } = Astro.props;
const cat = CATEGORY_COPY[row.category];
---

<a class="card block p-5" href={harnessPath(row.id)}>
  <p class="flex flex-wrap gap-2 text-xs">
    <span class="badge">{cat.label}</span>
    {row.used_on_our_rig && <span class="badge-tested">Used on our rig</span>}
    <span class="badge">{hybridLabel(row)}</span>
    {row.surfaces.map((surface) => <span class="badge">{surfaceLabel(surface)}</span>)}
  </p>
  <h2 class="mt-3 text-xl tracking-tight">{row.title}</h2>
  <p class="mt-2 text-sm text-muted">{row.summary}</p>
  <p class="mt-3 text-xs text-faint">{row.vendor}</p>
</a>
