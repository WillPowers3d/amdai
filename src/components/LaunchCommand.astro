---
import { launchText, type Recipe } from '../lib/recipes';

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
const text = launchText(recipe);
const family = recipe.launch.family === 'llamacpp' ? 'llama.cpp' : 'Strata';
---

<div class="rounded-xl border border-line bg-canvas/50">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-3 py-2">
    <p class="text-sm">
      <span class="font-medium">{family}</span>
      {recipe.build === 'vulkan' ? ' · Vulkan' : ' · HIP'}
      {recipe.override ? ` · ${recipe.override}` : ''}
      {recipe.launch.todo_flags && <span class="ml-2 text-xs text-faint">flags not recorded</span>}
    </p>
    <button type="button" class="code-copy" data-launch-copy>Copy</button>
  </div>
  <pre class="overflow-x-auto p-3 text-xs leading-relaxed"><code data-launch-text>{text}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-launch-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.closest('div')?.parentElement?.querySelector('[data-launch-text]')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = 'Copy';
        }, 1200);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
  });
</script>
