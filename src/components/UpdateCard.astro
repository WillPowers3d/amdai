---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  note: CollectionEntry<'updates'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<article class="not-prose my-6 rounded-xl border border-line bg-raised/70 p-4">
  <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
    {note.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    {note.data.current ? ' · snapshot of that week' : ' · archive'}
  </p>
  <h3 class="mt-1 font-serif text-xl">{note.data.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{note.data.summary}</p>
  <div class="prose-lab prose mt-3 max-w-none text-sm">
    <Content />
  </div>
</article>
