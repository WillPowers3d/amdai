---
import { BUY_R9700_HREF, CODING_MODEL_PATH } from '../lib/buyer-pages';

interface Props {
  name?: string;
}

const { name = 'This harness' } = Astro.props;
---

<aside class="mt-6 rounded-2xl border border-line bg-raised/50 p-5" aria-label="Hardware for this harness">
  <h2 class="font-serif text-2xl tracking-tight">What runs this well at home</h2>
  <p class="mt-3 leading-relaxed text-muted">
    {name} needs a model with a long context window. Qwen recommends keeping Qwen3.6-35B-A3B at 128K or more.
    One 32 GB Radeon AI PRO R9700 holds it at the full 262K with nothing offloaded on the local desktop
    (about 100 tok/s on a short prompt, about 50 tok/s at 256K, llama.cpp Vulkan).
  </p>
  <ul class="mt-4 flex flex-wrap gap-2">
    <li>
      <a
        class="inline-flex min-h-9 items-center rounded-full border border-accent/40 bg-canvas px-3 text-sm text-ink hover:border-accent hover:text-accent-ink"
        href={BUY_R9700_HREF}
      >
        See R9700 listings
      </a>
    </li>
    <li>
      <a
        class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
        href="/calculator"
      >
        Already have a GPU? Check fit
      </a>
    </li>
    <li>
      <a
        class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
        href={CODING_MODEL_PATH}
      >
        Best local coding model for 32 GB
      </a>
    </li>
  </ul>
  <p class="mt-3 text-xs leading-relaxed text-faint">
    Some retailer links may earn a commission. No price is printed here so it cannot go stale.
    <a class="underline decoration-accent/40" href="/disclosure">Disclosure</a>.
  </p>
</aside>
