---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import { destinationUrl, retailerById, wrapRetailer } from '../lib/affiliates';
import { buyButtonAriaLabel, buyButtonLabel, buyLinkRel } from '../lib/buy-label';
import { buildList } from '../lib/build-list';

const two = buildList({ gpuCount: 2, minBudget: false, expandGpu: true, bigModels: true });
const rows = two.parts.filter((row) => row.role !== 'GPU');
const newegg = retailerById('newegg');
---

<section id="build-2" class="mt-12 scroll-mt-28" aria-labelledby="build-2-heading">
  <h2 id="build-2-heading" class="font-serif text-3xl tracking-tight">Two-card parts list</h2>
  <p class="mt-3 leading-relaxed text-muted">
    Building a two-card box? Board with x8/x8 slots, 1200 W PSU, 96 GB DDR5. Each row opens the Newegg search
    for that part. The GPU row goes to the R9700 buy notes — we do not print a GPU price here.
  </p>
  <div class="mt-6 overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <caption class="sr-only">Two-R9700 build parts with Newegg check-price links</caption>
      <thead>
        <tr class="border-b border-line text-faint">
          <th class="py-2 pr-3 font-normal" scope="col">Part</th>
          <th class="py-2 pr-3 font-normal" scope="col">Pick</th>
          <th class="py-2 font-normal" scope="col">Check</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-line/70 align-top">
          <th class="py-3 pr-3 font-medium text-ink" scope="row">GPU</th>
          <td class="py-3 pr-3 text-muted">Two AMD Radeon AI PRO R9700 (32 GB)</td>
          <td class="py-3">
            <a class="underline decoration-accent/40" href="/gpus/r9700/#buy">R9700 buy notes</a>
          </td>
        </tr>
        {rows.map((row) => {
          const dest = destinationUrl(row.product_id, 'newegg') ?? destinationUrl('r9700', 'newegg');
          const wrapped = dest && newegg ? wrapRetailer(dest, newegg) : { href: '', affiliate: false };
          return (
            <tr class="border-b border-line/70 align-top">
              <th class="py-3 pr-3 font-medium text-ink" scope="row">{row.role}</th>
              <td class="py-3 pr-3 text-muted">{row.part}</td>
              <td class="py-3">
                <a
                  class="underline decoration-accent/40"
                  href={row.go}
                  rel={buyLinkRel(wrapped.affiliate)}
                  target="_blank"
                  aria-label={buyButtonAriaLabel(`${row.part} (parts list)`, 'Newegg')}
                  data-retailer="newegg"
                  data-product={row.product_id}
                >
                  {buyButtonLabel('Newegg')}
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <div class="mt-4">
    <AffiliateDisclosure compact />
  </div>
</section>
