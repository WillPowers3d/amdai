---
import { PRIMARY_PATH } from '../lib/primary-path';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<nav class:list={['primary-path not-prose', !compact && 'border-b border-line']} aria-label="Primary path">
  <div class:list={[compact ? 'py-2' : 'mx-auto max-w-7xl px-4 py-10 sm:px-6']}>
    {!compact && (
      <>
        <p class="kicker">One path</p>
        <h2 class="display mt-2 text-3xl sm:text-4xl">Landing to a measured recipe</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Check the box, set up Ubuntu, load the daily-driver 35B on llama.cpp, then read the cards.
          Stack Lab is optional — packages are not published yet.
        </p>
      </>
    )}
    <ol class:list={[compact ? 'mt-4 grid gap-3' : 'mt-8 grid gap-3 md:grid-cols-5']}>
      {PRIMARY_PATH.map((step, index) => (
        <li class="rounded-2xl border border-line bg-raised/40 p-4">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">{index + 1}</p>
          <h3 class="mt-2 text-lg tracking-tight">
            <a class="hover:text-accent-ink" href={step.href}>{step.label}</a>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
          {step.also?.length ? (
            <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm">
              {step.also.map((link) => (
                <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
              ))}
            </p>
          ) : null}
        </li>
      ))}
    </ol>
  </div>
</nav>
