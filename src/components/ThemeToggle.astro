<button type="button" id="theme-toggle" class="theme-btn" aria-label="Switch to light theme">
  <span class="sr-only">Toggle theme</span>
  <svg class="icon dark-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M15.4 14.6A6.2 6.2 0 0 1 9.4 4.8 8 8 0 1 0 19.2 14.6a6.2 6.2 0 0 1-3.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
  <svg class="icon light-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6"/>
    <path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  const apply = (theme: string) => {
    root.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    if (button) {
      button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    }
  };

  button?.addEventListener('click', () => {
    apply(root.dataset.theme === 'dark' ? 'light' : 'dark');
  });
</script>

<style>
  .theme-btn {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--raised);
    color: var(--ink);
  }

  .theme-btn:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  :global([data-theme="dark"]) .light-icon,
  :global([data-theme="light"]) .dark-icon {
    display: none;
  }
</style>
