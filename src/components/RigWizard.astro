---
import { DEFAULT_PRIORITY } from '../lib/priority';
import { DEFAULT_BIG_MODELS, DEFAULT_COLD_LOAD, DEFAULT_CPU_WORK, DEFAULT_MIN_BUDGET, DEFAULT_STYLE, DEFAULT_USAGE, defaultExpandGpu } from '../lib/ask';
import { EXPAND_GPU_COPY, MIN_BUDGET_COPY } from '../lib/motherboards';
import { RAM_ASK_COPY } from '../lib/ram-kit';
import { CPU_WORK_COPY } from '../lib/cpu-pick';
import { STORAGE_ASK_COPY } from '../lib/storage-pick';
import { motherboards } from '../lib/motherboards-data';
import MotherboardPick from './MotherboardPick.astro';
import RamPick from './RamPick.astro';
import CpuPick from './CpuPick.astro';
import PsuPick from './PsuPick.astro';
import StoragePick from './StoragePick.astro';

interface Props {
  id?: string;
}

const { id = 'rig-wizard' } = Astro.props;
const expandDefault = defaultExpandGpu(DEFAULT_MIN_BUDGET);
---

<form id={id} class="wizard card p-5 sm:p-6" action="/calculator" method="get">
  <p class="kicker">Setup questions</p>
  <h2 class="mt-2 text-2xl tracking-tight">Size the box before you buy a card</h2>
  <p class="mt-2 text-sm text-muted">
    These change the recommendation, not the VRAM math. Tokens per second are estimates unless a “Tested on our rig” badge is showing.
  </p>

  <fieldset class="mt-5">
    <legend class="text-sm font-medium">Size or speed?</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="priority" value="size" checked={DEFAULT_PRIORITY === 'size'} />
        <span>
          <span class="block font-medium">Max model size</span>
          <span class="mt-0.5 block text-sm text-muted">More VRAM. Q5/Q6 when they fit.</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="priority" value="speed" checked={DEFAULT_PRIORITY === 'speed'} />
        <span>
          <span class="block font-medium">Speed</span>
          <span class="mt-0.5 block text-sm text-muted">One GPU, no offload, MoE.</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5">
    <legend class="text-sm font-medium">Where do the tokens run?</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="usage" value="local" checked={DEFAULT_USAGE === 'local'} />
        <span>
          <span class="block font-medium">Fully local</span>
          <span class="mt-0.5 block text-sm text-muted">The box does the whole job.</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="usage" value="hybrid" checked={DEFAULT_USAGE === 'hybrid'} />
        <span>
          <span class="block font-medium">Hybrid</span>
          <span class="mt-0.5 block text-sm text-muted">Local plus a cloud model for long jobs.</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5">
    <legend class="text-sm font-medium">Which weights?</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="style" value="standard" checked={DEFAULT_STYLE === 'standard'} />
        <span>
          <span class="block font-medium">Standard</span>
          <span class="mt-0.5 block text-sm text-muted">Official instruct. The default.</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="style" value="abliterated" checked={DEFAULT_STYLE === 'abliterated'} />
        <span>
          <span class="block font-medium">Abliterated</span>
          <span class="mt-0.5 block text-sm text-muted">Educational. Can hurt quality.</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5">
    <legend class="text-sm font-medium">How many GPUs now?</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="n" value="1" checked />
        <span>
          <span class="block font-medium">One GPU</span>
          <span class="mt-0.5 block text-sm text-muted">Still defaults to a dual x8/x8 board.</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="n" value="2" />
        <span>
          <span class="block font-medium">Two GPUs</span>
          <span class="mt-0.5 block text-sm text-muted">Only CPU-lane x8/x8 boards.</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5">
    <legend class="text-sm font-medium">Board budget</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="minbudget" value="0" checked={!DEFAULT_MIN_BUDGET} />
        <span>
          <span class="block font-medium">{MIN_BUDGET_COPY.recommended.label}</span>
          <span class="mt-0.5 block text-sm text-muted">Dual x8/x8 unless you pick Minimum budget.</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="minbudget" value="1" checked={DEFAULT_MIN_BUDGET} />
        <span>
          <span class="block font-medium">{MIN_BUDGET_COPY.minimum.label}</span>
          <span class="mt-0.5 block text-sm text-muted">May list a cheaper single-x16 board.</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5" data-expand-gpu>
    <legend class="text-sm font-medium">{EXPAND_GPU_COPY.question}</legend>
    <p class="mt-2 text-sm text-muted">{EXPAND_GPU_COPY.push}</p>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="expandgpu" value="1" checked={expandDefault} />
        <span>
          <span class="block font-medium">{EXPAND_GPU_COPY.yes.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{EXPAND_GPU_COPY.yes.lede}</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="expandgpu" value="0" checked={!expandDefault} />
        <span>
          <span class="block font-medium">{EXPAND_GPU_COPY.no.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{EXPAND_GPU_COPY.no.lede}</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5" data-big-models>
    <legend class="text-sm font-medium">{RAM_ASK_COPY.question}</legend>
    <p class="mt-2 text-sm text-muted">{RAM_ASK_COPY.expensive}</p>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="bigmodels" value="0" checked={!DEFAULT_BIG_MODELS} />
        <span>
          <span class="block font-medium">{RAM_ASK_COPY.no.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{RAM_ASK_COPY.no.lede}</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="bigmodels" value="1" checked={DEFAULT_BIG_MODELS} />
        <span>
          <span class="block font-medium">{RAM_ASK_COPY.yes.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{RAM_ASK_COPY.yes.lede}</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5" data-cpu-work hidden={!DEFAULT_BIG_MODELS}>
    <legend class="text-sm font-medium">{CPU_WORK_COPY.question}</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="cpuwork" value="0" checked={!DEFAULT_CPU_WORK} />
        <span>
          <span class="block font-medium">{CPU_WORK_COPY.no.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{CPU_WORK_COPY.no.lede}</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="cpuwork" value="1" checked={DEFAULT_CPU_WORK} />
        <span>
          <span class="block font-medium">{CPU_WORK_COPY.yes.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{CPU_WORK_COPY.yes.lede}</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="mt-5" data-cold-load>
    <legend class="text-sm font-medium">{STORAGE_ASK_COPY.question}</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label class="choice">
        <input type="radio" name="coldload" value="0" checked={!DEFAULT_COLD_LOAD} />
        <span>
          <span class="block font-medium">{STORAGE_ASK_COPY.no.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{STORAGE_ASK_COPY.no.lede}</span>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="coldload" value="1" checked={DEFAULT_COLD_LOAD} />
        <span>
          <span class="block font-medium">{STORAGE_ASK_COPY.yes.label}</span>
          <span class="mt-0.5 block text-sm text-muted">{STORAGE_ASK_COPY.yes.lede}</span>
        </span>
      </label>
    </div>
  </fieldset>

  <div class="mt-6">
    <MotherboardPick
      boards={motherboards}
      ask={{ gpuCount: 1, minBudget: DEFAULT_MIN_BUDGET, expandGpu: expandDefault }}
    />
  </div>
  <div class="mt-6">
    <RamPick boards={motherboards} bigModels={DEFAULT_BIG_MODELS} />
  </div>
  <div class="mt-6">
    <CpuPick ask={{ bigModels: DEFAULT_BIG_MODELS, needsOffload: false, cpuWork: DEFAULT_CPU_WORK }} />
  </div>
  <div class="mt-6">
    <PsuPick ask={{ gpuCount: 1, expandGpu: expandDefault }} />
  </div>
  <div class="mt-6">
    <StoragePick ask={{ bigModels: DEFAULT_BIG_MODELS, coldLoad: DEFAULT_COLD_LOAD }} />
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    <button class="btn-primary" type="submit">Open the calculator</button>
    <button class="btn-secondary" type="submit" formaction="/budget">Compare budget tiers</button>
  </div>
</form>

<style>
  .choice {
    display: flex;
    cursor: pointer;
    gap: 0.7rem;
    border: 1px solid var(--line);
    background: var(--canvas);
    border-radius: 0.9rem;
    padding: 0.85rem 0.95rem;
  }

  .choice:has(:checked) {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .choice input {
    margin-top: 0.2rem;
    accent-color: var(--accent);
  }
</style>
