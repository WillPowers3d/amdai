---
import { qwen36TableFromRuns } from '../lib/run-card';
import { runs } from '../lib/run-card-data';

const benches = qwen36TableFromRuns(runs);

type Props = {
  heading?: string;
};

const { heading = '35B decode, measured' } = Astro.props;
---

<section id="benchmarks" class="mt-10" aria-labelledby="benches-heading">
  <p class="kicker">{benches.label}</p>
  <h2 id="benches-heading" class="mt-2 font-serif text-3xl">{heading}</h2>
  <p class="mt-3 max-w-3xl text-muted">
    Qwen3.6-35B-A3B on {benches.gpu}, {benches.engine}, {benches.kv} KV.
    One R9700 versus a split across both cards, per context.
    Cells that we still do not have stay <strong class="text-ink">not measured</strong>.
    Units match the hardware labels (GB = Linux GiB).
    Full hub: <a class="underline decoration-accent/40" href="/benchmarks">benchmarks</a>.
    Filterable cards: <a class="underline decoration-accent/40" href="/results">comparable results</a>.
  </p>
  <div class="card mt-6 overflow-x-auto">
    <table class="table-lab min-w-[72rem]">
      <thead>
        <tr>
          <th rowspan="2">Quant</th>
          <th rowspan="2">Context</th>
          <th colspan="5">One R9700</th>
          <th colspan="5">Both R9700s (split)</th>
        </tr>
        <tr>
          <th>Prefill</th>
          <th>Decode</th>
          <th>VRAM / card</th>
          <th>VRAM total</th>
          <th>System RAM</th>
          <th>Prefill</th>
          <th>Decode</th>
          <th>VRAM / card</th>
          <th>VRAM total</th>
          <th>System RAM</th>
        </tr>
      </thead>
      <tbody>
        {benches.compare.map((row) => (
          <tr>
            <td class="font-medium">
              {row.quant}
              {row.flag ? <span class="block text-xs font-normal text-faint">{row.flag}</span> : null}
            </td>
            <td>{row.contextLabel}</td>
            <td class="tabular-nums">
              {row.one.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.one.href}>{row.one.prefill}</a>
              ) : (
                row.one.prefill
              )}
            </td>
            <td class="tabular-nums">
              {row.one.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.one.href}>{row.one.decode}</a>
              ) : (
                row.one.decode
              )}
            </td>
            <td class="tabular-nums">
              {row.one.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.one.href}>{row.one.vramPerGpu}</a>
              ) : (
                row.one.vramPerGpu
              )}
            </td>
            <td class="tabular-nums">
              {row.one.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.one.href}>{row.one.vramTotal}</a>
              ) : (
                row.one.vramTotal
              )}
            </td>
            <td class="tabular-nums">
              {row.one.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.one.href}>{row.one.systemRam}</a>
              ) : (
                row.one.systemRam
              )}
            </td>
            <td class="tabular-nums">
              {row.both.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.both.href}>{row.both.prefill}</a>
              ) : (
                row.both.prefill
              )}
            </td>
            <td class="tabular-nums">
              {row.both.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.both.href}>{row.both.decode}</a>
              ) : (
                row.both.decode
              )}
            </td>
            <td class="tabular-nums">
              {row.both.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.both.href}>{row.both.vramPerGpu}</a>
              ) : (
                row.both.vramPerGpu
              )}
            </td>
            <td class="tabular-nums">
              {row.both.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.both.href}>{row.both.vramTotal}</a>
              ) : (
                row.both.vramTotal
              )}
            </td>
            <td class="tabular-nums">
              {row.both.runIds.length ? (
                <a class="underline decoration-accent/40" href={row.both.href}>{row.both.systemRam}</a>
              ) : (
                row.both.systemRam
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="mt-4 space-y-1.5 text-sm text-muted">
    {benches.notes.map((note) => <li>{note}</li>)}
  </ul>
  <h3 class="mt-8 font-serif text-2xl">Q3 sizes on the same card (estimate / community)</h3>
  <p class="mt-2 max-w-2xl text-sm text-muted">
    Not measured on local-desktop. File sizes from
    <a class="underline decoration-accent/40" href="https://huggingface.co/unsloth/Qwen3.6-35B-A3B-GGUF/tree/main">unsloth/Qwen3.6-35B-A3B-GGUF</a>.
    Quality deltas are not first-party.
  </p>
  <div class="card mt-4 overflow-x-auto">
    <table class="table-lab min-w-[28rem]">
      <thead>
        <tr>
          <th>Quant</th>
          <th>Publisher listing</th>
          <th>Decode / VRAM</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="font-medium">UD-IQ3_S</td>
          <td>13.7 GB</td>
          <td>not measured · estimate / community</td>
        </tr>
        <tr>
          <td class="font-medium">UD-Q3_K_S</td>
          <td>15.4 GB</td>
          <td>not measured · estimate / community</td>
        </tr>
        <tr>
          <td class="font-medium">UD-Q3_K_M</td>
          <td>16.6 GB</td>
          <td>not measured · estimate / community</td>
        </tr>
        <tr>
          <td class="font-medium">UD-Q3_K_XL</td>
          <td>16.8 GB</td>
          <td>not measured · estimate / community</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
