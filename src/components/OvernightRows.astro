---
interface Props {
  rows: unknown[];
  note: string;
}

const { rows, note } = Astro.props;
---

<section id="overnight" class="mt-12 scroll-mt-28" aria-labelledby="overnight-heading">
  <h2 id="overnight-heading" class="font-serif text-3xl">Overnight results.json</h2>
  <p class="mt-3 max-w-2xl text-sm text-muted">{note}</p>
  {rows.length === 0 ? (
    <div class="card mt-6 border-dashed p-6 text-sm text-muted">
      <p class="kicker">Empty</p>
      <p class="mt-2">No overnight <code>results.json</code> rows yet. This slot stays reserved so a drop-in file can fill the table without a layout rewrite.</p>
    </div>
  ) : (
    <pre class="card mt-6 overflow-x-auto p-4 text-xs">{JSON.stringify(rows, null, 2)}</pre>
  )}
</section>
