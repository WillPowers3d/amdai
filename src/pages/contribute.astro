---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contribute a recipe"
  description="Submit a Radeon launch recipe as JSON. A moderator promotes it to community-verified. No invented numbers."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">Recipes</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Contribute a recipe</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      A recipe is one model on one card with ROCm fields and a sourced proof.
      Fill the form, download the JSON, and open a pull request or email it with a log or screenshot.
      A moderator promotes a clean run to <strong class="text-ink">Community-verified</strong>.
    </p>
    <p class="mt-3 text-sm text-muted">
      Q1 and Q2 stay off. Q3 is allowed only as estimate/community unless you measured it.
      llama.cpp first. No Qwen2.5 or Qwen3-8B. No invented tok/s.
      Bounty amounts are not listed — that needs amdai’s sign-off.
    </p>
    <p class="mt-4 flex flex-wrap gap-3 text-sm">
      <a class="btn-secondary" href="/wanted">Wanted board</a>
      <a class="btn-ghost" href="/credits">Credits</a>
      <a class="btn-ghost" href="/benchmarks/methodology">Gates</a>
    </p>

    <form id="recipe-form" class="mt-10 space-y-4">
      <fieldset class="rounded-2xl border border-line bg-raised/40 p-4 sm:p-5">
        <legend class="px-1 font-serif text-2xl">Launch</legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="block text-sm">Card id
            <input class="field mt-1" name="card" value="r9700" required />
          </label>
          <label class="block text-sm">Model
            <select class="field mt-1" name="model_id">
              <option value="qwen36">Qwen3.6-35B-A3B</option>
              <option value="flash">Qwen 3.8 Flash</option>
            </select>
          </label>
          <label class="block text-sm">Quant
            <input class="field mt-1" name="quant" value="UD-Q5_K_XL" required />
          </label>
          <label class="block text-sm">Backend
            <select class="field mt-1" name="backend">
              <option value="llamacpp">llama.cpp</option>
              <option value="strata">Strata</option>
            </select>
          </label>
          <label class="block text-sm">Build
            <select class="field mt-1" name="build">
              <option value="vulkan">Vulkan</option>
              <option value="hip">HIP</option>
            </select>
          </label>
          <label class="block text-sm">Context tokens
            <input class="field mt-1" name="ctx" type="number" value="4096" min="256" required />
          </label>
          <label class="block text-sm">Card count
            <input class="field mt-1" name="card_count" type="number" value="1" min="1" max="4" required />
          </label>
          <label class="block text-sm">gfx
            <input class="field mt-1" name="gfx" value="gfx1201" required />
          </label>
          <label class="block text-sm sm:col-span-2">GGUF filename
            <input class="field mt-1" name="filename" required />
          </label>
          <label class="block text-sm sm:col-span-2">HF repo
            <input class="field mt-1" name="repo" value="unsloth/Qwen3.6-35B-A3B-GGUF" required />
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl border border-line bg-raised/40 p-4 sm:p-5">
        <legend class="px-1 font-serif text-2xl">Proof</legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="block text-sm">Who
            <input class="field mt-1" name="who" required />
          </label>
          <label class="block text-sm">Date
            <input class="field mt-1" name="date" value="2026-10" required />
          </label>
          <label class="block text-sm">Decode tok/s (blank if not measured)
            <input class="field mt-1" name="decode" type="number" step="0.1" />
          </label>
          <label class="block text-sm">Prefill tok/s
            <input class="field mt-1" name="prefill" type="number" step="0.1" />
          </label>
          <label class="block text-sm sm:col-span-2">Source (required if you enter a number)
            <input class="field mt-1" name="source" required />
          </label>
          <label class="block text-sm sm:col-span-2">Log or screenshot note
            <textarea class="field mt-1 min-h-24" name="log" required placeholder="Paste a log excerpt or describe the screenshot you will attach."></textarea>
          </label>
        </div>
      </fieldset>

      <p class="text-sm text-muted">
        Forum “Submit a recipe” and account “Submit from saved rig” stay off on this static build.
        Saved-rig users can still export JSON here and attach it later.
      </p>
      <div class="flex flex-wrap gap-3">
        <button type="submit" class="btn-primary">Download recipe JSON</button>
        <button type="button" class="btn-ghost" data-preview>Preview</button>
      </div>
    </form>

    <pre id="recipe-preview" hidden class="mt-6 overflow-x-auto rounded-2xl border border-line bg-raised p-4 text-xs"></pre>
  </main>
</Base>

<script>
  const form = document.getElementById('recipe-form') as HTMLFormElement;
  const preview = document.getElementById('recipe-preview') as HTMLPreElement;

  function build() {
    const data = new FormData(form);
    const modelId = String(data.get('model_id'));
    const model = modelId === 'flash' ? 'Qwen 3.8 Flash' : 'Qwen3.6-35B-A3B';
    const official = modelId === 'flash' ? 'Qwen/Qwen3.8-Flash-Next' : 'Qwen/Qwen3.6-35B-A3B';
    const ctx = Number(data.get('ctx'));
    const decodeRaw = String(data.get('decode') ?? '').trim();
    const prefillRaw = String(data.get('prefill') ?? '').trim();
    const id = `${modelId}.${data.get('backend')}.${Math.round(ctx / 1000)}k`.replace(/[^a-z0-9.-]+/g, '-');
    return {
      id,
      card: String(data.get('card')),
      model_id: modelId,
      model,
      official,
      weights: {
        repo: String(data.get('repo')),
        commit: null,
        filename: String(data.get('filename')),
        quant: String(data.get('quant')),
      },
      backend: String(data.get('backend')),
      build: String(data.get('build')),
      rocm_version: null,
      gfx: String(data.get('gfx')),
      override: null,
      ctx,
      ctx_label: ctx >= 200000 ? '262K' : ctx >= 30000 ? '32K' : 'short',
      card_count: Number(data.get('card_count')),
      flags_todo: true,
      needs: { host_ram_gb: null, disk_gb: null },
      proof: [
        {
          date: String(data.get('date')),
          who: String(data.get('who')),
          tier: 'community',
          source: String(data.get('source')),
          gates: {
            load: 'pass',
            chat: 'pass',
            reasoning: 'not_measured',
            tools: 'not_measured',
            long_context: 'not_measured',
            speed: decodeRaw ? 'pass' : 'not_measured',
          },
          decode: decodeRaw ? Number(decodeRaw) : null,
          prefill: prefillRaw ? Number(prefillRaw) : null,
          log_hash: null,
        },
      ],
      withdrawn: null,
      launch: {
        family: String(data.get('backend')),
        todo_flags: true,
        env: [],
        lines: ['# Attach the command you actually ran.', '# Do not invent flags.'],
      },
      calculator: `/calculator?gpu=${data.get('card')}&n=${data.get('card_count')}&model=${modelId}&ctx=${ctx}`,
      notes: [String(data.get('log')), 'Community submission — not measured on local-desktop until a moderator says so.'],
    };
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const json = JSON.stringify(build(), null, 2);
    const blob = new Blob([json], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${build().id}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.querySelector('[data-preview]')?.addEventListener('click', () => {
    preview.hidden = false;
    preview.textContent = JSON.stringify(build(), null, 2);
  });
</script>
