---
import Base from '../layouts/Base.astro';
import NextSteps from '../components/NextSteps.astro';
import {
  SPONSOR_HEADING,
  SPONSOR_KICKER,
  SPONSOR_LABEL,
  SPONSOR_LEAD,
  SPONSOR_NAME,
  SPONSOR_PATH,
  SPONSOR_PAYMENT_URL_ENV,
  SPONSOR_RATES,
  SPONSOR_SLOTS,
  sponsorMailto,
  sponsorPaymentUrl,
} from '../lib/sponsor';

const payment = sponsorPaymentUrl();
const mailto = sponsorMailto();
---

<Base title={SPONSOR_NAME} description="">
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SPONSOR_KICKER}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{SPONSOR_HEADING}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{SPONSOR_LEAD}</p>
    <p class="mt-4 text-sm leading-relaxed text-muted">
      Every placement is labeled <strong class="font-medium text-ink">{SPONSOR_LABEL}</strong>.
      Rates are not listed yet — {SPONSOR_RATES}.
      Affiliate store buttons stay on the
      <a class="underline decoration-accent/40" href="/disclosure">affiliate disclosure</a>.
    </p>

    <section class="mt-10" aria-labelledby="slots-heading">
      <h2 id="slots-heading" class="font-serif text-3xl tracking-tight">Slots</h2>
      <ul class="mt-6 grid gap-4">
        {SPONSOR_SLOTS.map((slot) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{SPONSOR_LABEL}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{slot.name}</h3>
            <p class="mt-2 text-sm text-faint">
              Lives on
              <a class="underline decoration-accent/40" href={slot.placement}>{slot.placementLabel}</a>
              ({slot.placement}).
            </p>
            <p class="mt-3 leading-relaxed text-muted">{slot.summary}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{slot.audience}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="rates-heading">
      <h2 id="rates-heading" class="font-serif text-3xl tracking-tight">Rates</h2>
      <p class="mt-3 leading-relaxed text-muted">
        No dollar figures on this page. Ask with the routes below and we will {SPONSOR_RATES}.
        A payment button appears only when <code class="font-mono text-ink">{SPONSOR_PAYMENT_URL_ENV}</code>
        is set for this build.
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        {mailto && (
          <a class="btn-primary" href={mailto}>Email about a slot</a>
        )}
        {payment && (
          <a class="btn-secondary" href={payment} rel="noopener">Open payment page</a>
        )}
        {!mailto && !payment && (
          <a class="btn-primary" href="/contact">Contact</a>
        )}
      </p>
      {
        !mailto && (
          <p class="mt-4 text-sm text-faint">
            No contact email is configured on this build. Use
            <a class="underline decoration-accent/40" href="/contact">Contact</a>
            or Contribute.
          </p>
        )
      }
    </section>

    <p class="mt-10 text-sm text-muted">
      Editorial independence:
      <a class="underline decoration-accent/40" href="/about">About</a>
      ·
      <a class="underline decoration-accent/40" href="/methodology">How we test</a>
      ·
      <a class="underline decoration-accent/40" href="/disclosure">Disclosure</a>.
      Machine-readable site map:
      <a class="underline decoration-accent/40" href="/llms.txt">llms.txt</a>
      ·
      <a class="underline decoration-accent/40" href="/llms-full.txt">llms-full.txt</a>.
    </p>
    <NextSteps path={SPONSOR_PATH} />
  </main>
</Base>
