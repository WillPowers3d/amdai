---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That path is not on this site.">
  <main id="main" class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="kicker">404</p>
    <h1 class="display mt-3 text-4xl">No page at this address</h1>
    <p class="mt-4 text-muted">Try Getting started, or open Search (⌘K) for stacks, ROCm, the calculator, and the rest.</p>
    <a class="btn-primary mt-8" href="/">Back to the notebook</a>
  </main>
</Base>
