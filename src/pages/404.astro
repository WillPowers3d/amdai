---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That path is not on this site.">
  <main id="main" class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">404</p>
    <h1 class="mt-3 font-serif text-4xl">No page at this address</h1>
    <p class="mt-4 text-muted">The nav is short on purpose. Try Home, AMD GPUs, ROCm, Local AI, Tutorials, or Blog.</p>
    <a class="mt-8 inline-flex rounded-full bg-accent px-5 py-2.5 text-sm text-white" href="/">Back to the notebook</a>
  </main>
</Base>
