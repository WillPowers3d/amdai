---
import Base from '../layouts/Base.astro';
import NextSteps from '../components/NextSteps.astro';
import { CONTACT, contactEmail, contactRoutes } from '../lib/trust';

const email = contactEmail();
const routes = contactRoutes();
---

<Base
  title="Contact"
  description="Honest AMDai contact routes: contribute a sourced recipe, ROCm problems, and the forum when it is enabled. No invented inbox."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{CONTACT.kicker}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{CONTACT.name}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{CONTACT.lead}</p>

    {
      email ? (
        <p class="mt-6 rounded-2xl border border-line bg-raised/50 p-5 text-sm leading-relaxed">
          Contact email for this build:
          <a class="underline decoration-accent/40" href={`mailto:${email}`}>{email}</a>.
        </p>
      ) : (
        <p class="mt-6 text-sm text-faint">
          No contact email is configured on this build. Use the routes below.
        </p>
      )
    }

    <ul class="mt-10 grid gap-4">
      {routes.map((row) => (
        <li>
          <a class="card block p-5 hover:border-accent/40" href={row.href}>
            <p class="font-medium text-ink">{row.label}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{row.body}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm text-muted">
      Accessibility reports can also start on
      <a class="underline decoration-accent/40" href="/accessibility">Accessibility</a>.
      Legal:
      <a class="underline decoration-accent/40" href="/privacy">Privacy</a>
      ·
      <a class="underline decoration-accent/40" href="/terms">Terms</a>.
    </p>
    <NextSteps path="/contact" />
  </main>
</Base>
