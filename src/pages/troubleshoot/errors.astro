---
import Base from '../../layouts/Base.astro';
import { errorPatterns, errorsFile, forumAskPath, forumSearchPath } from '../../lib/errors';
import { forumEnabled } from '../../lib/flags';

const forumOn = forumEnabled();
const json = JSON.stringify(
  errorPatterns.map((row) => ({
    id: row.id,
    title: row.title,
    match: row.match,
    cause: row.cause,
    fix: row.fix,
    source: row.source,
    source_label: row.source_label,
    tags: row.tags,
    ask: forumAskPath(row),
  })),
);
---

<Base
  title="Error troubleshooter"
  description="Paste a ROCm, llama.cpp, or Ollama error. Matches ~16 cited patterns — hipErrorNoBinaryForGpu, MODE1 reset, gfx1201 Ollama issues, mixed apt repos."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Failures</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Paste your error</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Client-side matcher against {errorPatterns.length} patterns we have actually cited (as of {errorsFile.as_of}).
      No invented issue numbers. If nothing hits, that is a honest miss — file it upstream and tell us.
    </p>
    <p class="mt-3 text-sm text-faint">
      Symptom-first hub:
      <a class="underline decoration-accent/40 underline-offset-2" href="/troubleshoot">/troubleshoot</a>.
      Longer walkthrough:
      <a class="underline decoration-accent/40 underline-offset-2" href="/troubleshooting">Troubleshooting</a>.
    </p>

    <label class="mt-8 block font-medium" for="error-paste">Log or error string</label>
    <textarea
      id="error-paste"
      class="mt-2 min-h-40 w-full rounded-2xl border border-line bg-raised p-4 font-mono text-sm"
      placeholder="hipErrorNoBinaryForGpu, MODE1 reset, TensileLibrary_lazy_gfx1201…"
    ></textarea>
    <div class="mt-3 flex flex-wrap gap-2">
      <button type="button" id="error-run" class="btn-primary">Match</button>
      <button type="button" id="error-clear" class="rounded-full border border-line bg-canvas px-4 py-2 text-sm">Clear</button>
    </div>
    <p class="mt-3 text-sm text-faint" data-error-status>Nothing pasted yet. The list below is the full catalog.</p>
    <ol class="mt-4 space-y-2" data-error-hits></ol>

    <section class="mt-12">
      <h2 class="font-serif text-3xl">Catalog</h2>
      <ul class="mt-6 space-y-8">
        {errorPatterns.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/40 p-5" data-error-card={row.id}>
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">{row.tags.join(' · ')}</p>
            <h3 class="mt-1 font-serif text-2xl">{row.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted"><span class="font-medium text-ink">Cause. </span>{row.cause}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted"><span class="font-medium text-ink">Fix. </span>{row.fix}</p>
            <p class="mt-3 text-sm">
              {row.source.startsWith('http') ? (
                <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={row.source} rel="noopener">{row.source_label}</a>
              ) : (
                <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={row.source || '/calculator'}>{row.source_label}</a>
              )}
              {forumOn ? (
                <>
                  {' · '}
                  <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={forumSearchPath(row)}>Matching threads</a>
                  {' · '}
                  <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" data-forum-ask={row.id} href={forumAskPath(row)}>Ask the forum</a>
                </>
              ) : (
                <>
                  {' · '}
                  <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href="/rocm-problems/report">Write a report</a>
                  {' · '}
                  <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href="/forum">Forum (off on this build)</a>
                </>
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Symptom-first hub: <a class="underline decoration-accent/40 underline-offset-2" href="/troubleshoot">Troubleshoot</a>.
      Broader order-of-operations: <a class="underline decoration-accent/40 underline-offset-2" href="/troubleshooting">Troubleshooting</a>.
      Backend pick: <a class="underline decoration-accent/40 underline-offset-2" href="/backends">chooser</a>.
      {forumOn ? (
        <>Community: <a class="underline decoration-accent/40 underline-offset-2" href="/forum">forum</a>.</>
      ) : (
        <>Still stuck: <a class="underline decoration-accent/40 underline-offset-2" href="/rocm-problems/report">write a report</a>.</>
      )}
    </p>
  </main>
</Base>

<script define:vars={{ json, forumOn }}>
  const patterns = JSON.parse(json);
  const box = document.getElementById('error-paste');
  const status = document.querySelector('[data-error-status]');
  const hitsEl = document.querySelector('[data-error-hits]');
  const cards = [...document.querySelectorAll('[data-error-card]')];

  function normalize(text) {
    return String(text).toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function match(query) {
    const q = normalize(query);
    if (!q) return [];
    return patterns
      .map((pattern) => {
        const hits = pattern.match.filter((needle) => q.includes(normalize(needle)));
        const score = hits.reduce((sum, needle) => sum + needle.length, 0);
        return { pattern, score, hits };
      })
      .filter((row) => row.score > 0)
      .sort((a, b) => b.score - a.score);
  }

  function render() {
    const query = box?.value ?? '';
    const found = match(query);
    cards.forEach((card) => {
      const id = card.getAttribute('data-error-card');
      const on = found.length === 0 || found.some((row) => row.pattern.id === id);
      card.classList.toggle('opacity-40', found.length > 0 && !on);
    });
    if (!status || !hitsEl) return;
    hitsEl.innerHTML = '';
    if (!query.trim()) {
      status.textContent = 'Nothing pasted yet. The list below is the full catalog.';
      return;
    }
    if (found.length === 0) {
      status.textContent = 'No cited pattern matched. That is a miss, not a guess. Check dmesg, rocminfo, and the backend log.';
      return;
    }
    status.textContent = `${found.length} match${found.length === 1 ? '' : 'es'}.`;
    for (const row of found) {
      const li = document.createElement('li');
      const extra = forumOn
        ? (() => {
            const ask = new URL(row.pattern.ask, location.origin);
            if (query.trim()) ask.searchParams.set('body', query.trim().slice(0, 3500));
            return ` · <a class="text-sm underline" href="${ask.pathname + ask.search}">Ask the forum</a>`;
          })()
        : ' · <a class="text-sm underline" href="/rocm-problems/report">Write a report</a>';
      li.innerHTML = `<a class="text-sm text-accent-ink underline decoration-accent/40 underline-offset-2" href="#${row.pattern.id}">${row.pattern.title}</a> <span class="text-faint">· hit ${row.hits.slice(0, 2).join(', ')}</span>${extra}`;
      hitsEl.appendChild(li);
    }
    if (forumOn) {
      document.querySelectorAll('[data-forum-ask]').forEach((link) => {
        const id = link.getAttribute('data-forum-ask');
        const pattern = patterns.find((row) => row.id === id);
        if (!pattern) return;
        const ask = new URL(pattern.ask, location.origin);
        if (query.trim()) ask.searchParams.set('body', query.trim().slice(0, 3500));
        link.setAttribute('href', ask.pathname + ask.search);
      });
    }
  }

  document.getElementById('error-run')?.addEventListener('click', render);
  document.getElementById('error-clear')?.addEventListener('click', () => {
    if (box) box.value = '';
    render();
  });
  box?.addEventListener('input', () => {
    if ((box.value ?? '').length > 12) render();
  });
</script>
