---
import Base from '../layouts/Base.astro';
import BuyButtons from '../components/BuyButtons.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AskToggles from '../components/AskToggles.astro';
import AbliteratedPicks from '../components/AbliteratedPicks.astro';
import SaveSetupButton from '../components/SaveSetupButton.astro';
import { bandsReady, budgetFile, budgetTiers } from '../lib/budget';
import { DEFAULT_PRIORITY } from '../lib/priority';
import { DEFAULT_STYLE, DEFAULT_USAGE, suggestedBudgetTier } from '../lib/ask';

const hasBands = bandsReady();
const payload = JSON.stringify({
  asOf: budgetFile.as_of,
  hasBands,
  suggested: {
    'size-local': suggestedBudgetTier('size', 'local'),
    'speed-local': suggestedBudgetTier('speed', 'local'),
    'size-hybrid': suggestedBudgetTier('size', 'hybrid'),
    'speed-hybrid': suggestedBudgetTier('speed', 'hybrid'),
  },
  tiers: budgetTiers.map((tier) => ({
    id: tier.id,
    slider: tier.slider,
    usd_low: tier.usd_band.usd_low,
    usd_high: tier.usd_band.usd_high,
    status: tier.usd_band.status,
    size: tier.size,
    speed: tier.speed,
  })),
});
---

<Base
  title="Setup by budget"
  description="Starter through Pro local-AI Radeon builds. No invented prices. Calculator share links, llama.cpp first, Q4 and up only."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">Buy the box</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Setup by budget</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Four tiers from a 16 GB card to the two-R9700 test rig. Answer size vs speed first — that changes
      the pick. Models and quants are Q4 and up, estimated through the
      <a class="underline decoration-accent/40 underline-offset-2" href="/calculator">calculator</a>.
      Backend default is llama.cpp. Buttons say “Check price” — we do not show a live or stale price.
    </p>
    <p class="mt-3 text-sm text-faint">
      Price bands as of {budgetFile.as_of}: {budgetFile.price_label}.
      {hasBands ? 'Bands are filled from a cited source.' : 'Every USD band is still TODO — no cited street price, so the slider is by tier name, not dollars.'}
    </p>

    <div id="ask-row" class="mt-10 space-y-6">
      <AskToggles defaultPriority={DEFAULT_PRIORITY} defaultUsage={DEFAULT_USAGE} defaultStyle={DEFAULT_STYLE} />
    </div>

    <section class="mt-10 rounded-2xl border border-line bg-raised/40 p-5">
      <label class="font-medium" for="budget-slider">Which tier are you in?</label>
      <input
        id="budget-slider"
        type="range"
        min="1"
        max={budgetTiers.length}
        step="1"
        value="3"
        class="mt-4 w-full accent-[var(--accent)]"
      />
      <ol class="mt-2 grid grid-cols-4 gap-1 text-center font-mono text-[0.65rem] uppercase tracking-[0.08em] text-faint sm:text-[0.7rem]">
        {budgetTiers.map((tier) => (
          <li data-stop={tier.slider}>{tier.name}</li>
        ))}
      </ol>
      <div class="mt-4">
        <label class="block text-sm text-muted" for="budget-usd">Optional dollar input</label>
        <input
          id="budget-usd"
          type="number"
          min="0"
          step="50"
          inputmode="numeric"
          class="mt-1 min-h-11 w-full max-w-xs rounded-full border border-line bg-canvas px-4 text-sm"
          placeholder={hasBands ? 'USD' : 'Bands are TODO'}
          disabled={!hasBands}
        />
        <p class="mt-2 text-xs text-faint" data-budget-usd-status>
          {hasBands ? 'Highlights the tier whose cited band contains that number.' : 'No cited USD bands — pick a tier on the slider. Fill usd_low / usd_high in budget-tiers.yaml when you have a source.'}
        </p>
      </div>
    </section>

    <p class="mt-6">
      <SaveSetupButton from="budget" />
    </p>

    <AbliteratedPicks />

    <ol class="mt-12 grid gap-4 lg:grid-cols-2">
      {budgetTiers.map((tier) => (
        <li id={tier.id} class="card scroll-mt-28 p-5 sm:p-6" data-tier={tier.id} data-slider={tier.slider}>
          <p class="kicker">{tier.tagline}</p>
          <div class="mt-1 flex flex-wrap items-center gap-2">
            <h2 class="text-3xl tracking-tight">{tier.name}</h2>
            {tier.tested_rig && (
              <span class="rounded-full bg-ok/15 px-2.5 py-0.5 text-xs text-ok">Tested on our rig</span>
            )}
            <span class="hidden rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 text-xs text-accent-ink" data-suggested>
              Suggested for this priority
            </span>
          </div>
          <p class="mt-2 text-sm text-muted">{tier.vram_note}</p>
          <p class="mt-2 text-xs text-faint">
            {tier.usd_band.label}
            {tier.usd_band.usd_low != null && tier.usd_band.usd_high != null && (
              <span> · ${tier.usd_band.usd_low}–${tier.usd_band.usd_high} ({budgetFile.price_label})</span>
            )}
          </p>

          <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-medium text-ink">RAM</dt>
              <dd class="mt-1 text-muted">{tier.ram}</dd>
            </div>
            <div>
              <dt class="font-medium text-ink">NVMe</dt>
              <dd class="mt-1 text-muted">{tier.nvme}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="font-medium text-ink">PSU</dt>
              <dd class="mt-1 text-muted">{tier.psu}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="font-medium text-ink">Backend</dt>
              <dd class="mt-1 text-muted">{tier.backend} See the <a class="underline decoration-accent/40 underline-offset-2" href="/backends">chooser</a>.</dd>
            </div>
          </dl>

          <p class="mt-5 text-sm leading-relaxed text-muted" data-copy="verdict">{tier.speed.verdict}</p>

          <h3 class="mt-6 font-serif text-xl">What fits (Q4 and up)</h3>
          <ul class="mt-3 space-y-3">
            {tier.fits.map((row) => (
              <li
                class="rounded-xl border border-line bg-canvas/60 p-4"
                data-fit
                data-show={(row.show ?? ['size', 'speed']).join(',')}
              >
                <div class="flex flex-wrap items-center gap-2">
                  <p class="font-medium">{row.model} · {row.quant}</p>
                  {row.tested === 'daily' && (
                    <span class="rounded-full bg-ok/15 px-2 py-0.5 text-[0.7rem] text-ok">Tested on our rig — Qwen3.6-35B-A3B Q5</span>
                  )}
                  {row.tested === 'fast' && (
                    <span class="rounded-full bg-ok/15 px-2 py-0.5 text-[0.7rem] text-ok">Tested on our rig — Qwen 3.8 Flash Q6</span>
                  )}
                </div>
                <p class="mt-2 text-sm text-muted">{row.note}</p>
                <p class="mt-2 text-sm">
                  <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" data-calc-link href={row.calculator}>Open this setup in the calculator</a>
                </p>
              </li>
            ))}
          </ul>

          <p class="mt-5 text-sm leading-relaxed text-muted">
            <span class="font-medium text-ink">What you give up. </span><span data-copy="give_up">{tier.speed.give_up}</span>
          </p>

          <BuyButtons products={[...tier.gpus, ...tier.parts]} disclose={false} />
        </li>
      ))}
    </ol>
    <AffiliateDisclosure compact />

    <section id="upgrade" class="mt-16 rounded-2xl border border-line bg-raised/40 p-5 sm:p-6">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-accent">Already built</p>
      <h2 class="mt-2 font-serif text-3xl">{budgetFile.upgrade.title}</h2>
      <p class="mt-3 text-muted">{budgetFile.upgrade.lede}</p>
      <ol class="mt-5 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {budgetFile.upgrade.steps.map((step) => <li>{step}</li>)}
      </ol>
      <BuyButtons products={budgetFile.upgrade.products} />
    </section>
  </main>
</Base>

<script define:vars={{ payload }}>
  const data = JSON.parse(payload);
  const slider = document.getElementById('budget-slider');
  const usd = document.getElementById('budget-usd');
  const cards = [...document.querySelectorAll('[data-tier]')];
  const stops = [...document.querySelectorAll('[data-stop]')];
  const radios = [...document.querySelectorAll('input[name="priority"]')];
  const usageRadios = [...document.querySelectorAll('input[name="usage"]')];
  const styleRadios = [...document.querySelectorAll('input[name="style"]')];
  const COPY = {
    size: 'Favor more total VRAM — a larger card or a second GPU — and plenty of system RAM so a bigger file can overflow. Pick the largest house model and the highest quant that still makes sense (Q5 or Q6 when they fit, never below Q4). Tokens per second will be lower than an in-VRAM load. Speed numbers are estimates unless a “Tested on our rig” badge is showing.',
    speed: 'Favor the whole model in one GPU’s VRAM with no RAM offload. Prefer a MoE with few active parameters (Qwen3.6-35B-A3B style), Q4_K_M to Q5, a shorter context, and a single fast card. Offloading weights or KV into system RAM kills speed.',
    local: 'The local model does the whole job. That pushes toward more VRAM, more system RAM, and a long context so you are not shipping tokens off-box. No cloud pricing is involved.',
    hybrid: 'Local plus a cloud model (Claude, Grok, ChatGPT, or similar) for token-heavy work. The local box handles privacy-sensitive, repetitive, or always-on tasks. The cloud can take long reasoning jobs. This page does not quote cloud prices or claim a savings figure.',
    standard: 'Official instruct weights. This is the default and the reliability baseline. Prove Qwen3.6-35B-A3B before you swap.',
    abliterated: 'Abliteration edits refusals in the weights. It can hurt quality. Verify the uploader and the file. You are responsible for what you run. Floor is still Q4. There is no tested-on-our-rig abliterated pick — being reworked.',
  };

  function radioValue(list, fallback) {
    const checked = list.find((el) => el.checked);
    return checked ? checked.value : fallback;
  }

  function currentAsk() {
    return {
      priority: radioValue(radios, 'speed') === 'size' ? 'size' : 'speed',
      usage: radioValue(usageRadios, 'local') === 'hybrid' ? 'hybrid' : 'local',
      style: radioValue(styleRadios, 'standard') === 'abliterated' ? 'abliterated' : 'standard',
    };
  }

  function suggestedId(ask) {
    return data.suggested[ask.priority + '-' + ask.usage];
  }

  function writeUrl(tierId, ask) {
    const next = new URL(window.location.href);
    next.searchParams.set('tier', tierId);
    next.searchParams.set('priority', ask.priority);
    next.searchParams.set('usage', ask.usage);
    next.searchParams.set('style', ask.style);
    window.history.replaceState({}, '', next);
    document.querySelectorAll('[data-save-setup]').forEach((link) => {
      const base = link.getAttribute('href')?.split('?')[0] ?? '/account/save';
      if (base === '/account') return;
      link.setAttribute('href', `${base}?from=budget&${next.searchParams.toString()}`);
    });
  }

  function applyAsk(ask) {
    radios.forEach((el) => { el.checked = el.value === ask.priority; });
    usageRadios.forEach((el) => { el.checked = el.value === ask.usage; });
    styleRadios.forEach((el) => { el.checked = el.value === ask.style; });
    const pLede = document.querySelector('[data-priority-lede]');
    const uLede = document.querySelector('[data-usage-lede]');
    const sLede = document.querySelector('[data-style-lede]');
    if (pLede) pLede.textContent = COPY[ask.priority];
    if (uLede) uLede.textContent = COPY[ask.usage];
    if (sLede) sLede.textContent = COPY[ask.style];
    document.querySelectorAll('[data-abliterated-panel]').forEach((el) => {
      el.hidden = ask.style !== 'abliterated';
    });
    cards.forEach((card) => {
      const row = data.tiers.find((tier) => tier.id === card.getAttribute('data-tier'));
      const copy = row && row[ask.priority];
      card.querySelectorAll('[data-copy]').forEach((el) => {
        const key = el.getAttribute('data-copy');
        if (copy && key && copy[key]) el.textContent = copy[key];
      });
      const verdict = card.querySelector('[data-copy="verdict"]');
      if (verdict && copy) {
        const extra = ask.usage === 'hybrid'
          ? ' Hybrid: a cheaper local tier can be enough — keep private or always-on work on the card; send token-heavy reasoning to a cloud model you already use. No cloud pricing claims.'
          : ' Fully local: size the box so the local model can carry long context and the full file.';
        verdict.textContent = copy.verdict + extra;
      }
      const suggested = card.querySelector('[data-suggested]');
      if (suggested) suggested.classList.toggle('hidden', suggestedId(ask) !== row?.id);
      card.querySelectorAll('[data-fit]').forEach((fit) => {
        const show = (fit.getAttribute('data-show') || 'size,speed').split(',');
        fit.hidden = !show.includes(ask.priority);
      });
      card.querySelectorAll('[data-calc-link]').forEach((link) => {
        const href = link.getAttribute('href');
        if (!href) return;
        const url = new URL(href, window.location.origin);
        url.searchParams.set('priority', ask.priority);
        url.searchParams.set('usage', ask.usage);
        url.searchParams.set('style', ask.style);
        link.setAttribute('href', url.pathname + '?' + url.searchParams.toString());
      });
    });
  }

  function highlight(id) {
    cards.forEach((card) => {
      const on = card.getAttribute('data-tier') === id;
      card.classList.toggle('ring-2', on);
      card.classList.toggle('ring-accent', on);
      card.classList.toggle('opacity-55', !on);
    });
    stops.forEach((stop) => {
      const tier = data.tiers.find((row) => String(row.slider) === stop.getAttribute('data-stop'));
      stop.classList.toggle('text-ink', tier && tier.id === id);
    });
  }

  function selectSlider(value, lockTier = true) {
    const tier = data.tiers.find((row) => row.slider === Number(value)) || data.tiers[0];
    if (slider) slider.value = String(tier.slider);
    highlight(tier.id);
    if (lockTier) writeUrl(tier.id, currentAsk());
  }

  let userPickedTier = new URLSearchParams(window.location.search).has('tier');

  function fromQuery() {
    const q = new URLSearchParams(window.location.search);
    const ask = {
      priority: q.get('priority') === 'size' ? 'size' : 'speed',
      usage: q.get('usage') === 'hybrid' ? 'hybrid' : 'local',
      style: q.get('style') === 'abliterated' ? 'abliterated' : 'standard',
    };
    applyAsk(ask);
    const id = q.get('tier');
    const picked = data.tiers.find((row) => row.id === id);
    if (picked) selectSlider(picked.slider);
    else {
      const suggested = data.tiers.find((row) => row.id === suggestedId(ask));
      selectSlider(suggested ? suggested.slider : 3);
    }
  }

  function onAskChange() {
    const ask = currentAsk();
    applyAsk(ask);
    if (userPickedTier) {
      const q = new URLSearchParams(window.location.search);
      const locked = data.tiers.find((row) => row.id === q.get('tier'));
      writeUrl(locked ? locked.id : suggestedId(ask), ask);
    } else {
      const suggested = data.tiers.find((row) => row.id === suggestedId(ask));
      selectSlider(suggested ? suggested.slider : 3);
    }
  }

  [...radios, ...usageRadios, ...styleRadios].forEach((el) => {
    el.addEventListener('change', onAskChange);
  });

  slider?.addEventListener('input', () => {
    userPickedTier = true;
    selectSlider(slider.value);
  });
  usd?.addEventListener('input', () => {
    if (!data.hasBands) return;
    const n = Number(usd.value);
    const hit = data.tiers.find((row) => row.status === 'cited' && row.usd_low != null && row.usd_high != null && n >= row.usd_low && n <= row.usd_high);
    if (hit) selectSlider(hit.slider);
  });

  fromQuery();
</script>
