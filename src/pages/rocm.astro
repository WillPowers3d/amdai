---
import { getCollection, getEntry, render } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { mdxComponents } from '../lib/mdx';

const entry = await getEntry('guides', 'rocm');
if (!entry) throw new Error('Missing guides/rocm');
const { Content, headings } = await render(entry);
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Doc
  title={entry.data.title}
  description={entry.data.description}
  kicker={entry.data.kicker}
  updated={entry.data.updated}
  headings={[...headings, { depth: 2, slug: 'version-notes', text: 'Version notes' }]}
>
  <Content components={mdxComponents} />

  <h2 id="version-notes">Version notes</h2>
  <p>
    Historical snapshots — including ROCm 10.0 and vLLM 0.29 as <strong>examples of a week</strong>, not permanent law.
    The <a href="/">home status card</a> is the only “current recommendation.” If a note disagrees with the YAML, the YAML wins.
  </p>
  {updates.map((note) => <UpdateCard note={note} />)}
</Doc>
