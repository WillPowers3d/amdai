---
import Base from '../layouts/Base.astro';
import BuyButtons from '../components/BuyButtons.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AskToggles from '../components/AskToggles.astro';
import AbliteratedPicks from '../components/AbliteratedPicks.astro';
import SaveSetupButton from '../components/SaveSetupButton.astro';
import VramBar from '../components/VramBar.astro';
import HowWeTest from '../components/HowWeTest.astro';
import OlderModelsToggle from '../components/OlderModelsToggle.astro';
import {
  BACKENDS,
  CONTEXT_PRESETS,
  GPU_PRESETS,
  KV_TYPES,
  QUANTS,
  currentPickerPresets,
  olderModelsOpenFromSearch,
  olderPickerPresets,
  pickerPresetGroups,
} from '../lib/calculator';
import { measuredRamHits } from '../lib/measured-ram-data';
import { DEFAULT_PRIORITY } from '../lib/priority';
import { DEFAULT_STYLE, DEFAULT_USAGE } from '../lib/ask';
import { defaultExpandGpu } from '../lib/motherboards';
import { motherboards } from '../lib/motherboards-data';
import MotherboardPick from '../components/MotherboardPick.astro';
import RamPick from '../components/RamPick.astro';
import CpuPick from '../components/CpuPick.astro';
import PsuPick from '../components/PsuPick.astro';
import StoragePick from '../components/StoragePick.astro';
import BuildList from '../components/BuildList.astro';
import { gpuProducts } from '../lib/affiliates';
import { recipes } from '../lib/recipes-data';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../lib/ram-surfaces';

const fitGpus = gpuProducts();
const currentGroups = pickerPresetGroups(currentPickerPresets());
const olderPresets = olderPickerPresets();
const olderOpen = olderModelsOpenFromSearch(Astro.url.search);
---

<Base
  title="Quant + Hardware Calculator"
  description="Estimate GGUF weights, KV cache, and whether a stack fits a Radeon card — Q3 through BF16. Client-side, shareable URL. AMD/Radeon first."
>
  <main id="main" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <p class="kicker">Estimate · not a bench</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h1 class="display text-4xl sm:text-5xl">Quant + Hardware Calculator</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Three views, one engine: size a model, ask what a Radeon can hold, or read a decode-speed floor.
          Totals are <strong class="font-medium text-ink">estimates</strong> unless a tested badge shows a first-party R9700 number.
          Q3 is listed (estimate / community unless measured). Q1 / Q2 stay off. llama.cpp first. Those older 2.5-class and 8B names are not offered.
          Use with your AI assistant: <code class="font-mono text-sm">npx -y amdai-fit-mcp</code> is a stdio MCP server that lists Hugging Face GGUF files and estimates whether they fit a Radeon card. Docs ship with the npm package.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href="/compare">Compare 35B</a>
        <a class="btn-secondary" href="/compare/radeon-vs-nvidia">Radeon vs NVIDIA</a>
        <a class="btn-secondary" href="/benchmarks">Benchmarks</a>
        <a class="btn-secondary" href="/stacks">Recommended stacks</a>
        <a class="btn-secondary" href="/quants">Quant explainer</a>
        <a class="btn-secondary" href="/kv-cache">KV cache</a>
        <a class="btn-secondary" href="/out-of-vram">Out of VRAM</a>
        <a class="btn-secondary" href="/gpus/r9700">R9700 measured page</a>
        <a class="btn-secondary" href="/multi-gpu">Dual / multi-GPU</a>
        <a class="btn-secondary" href="/motherboards">Dual x8/x8 boards</a>
        <a class="btn-secondary" href="/gpus">GPU directory</a>
        <a class="btn-secondary" href="/models/qwen36">35B model page</a>
        <a class="btn-secondary" href="/models/flash">Flash model page</a>
        <a class="btn-secondary" href="/models/gpt-oss-20b">gpt-oss 20B</a>
        <a class="btn-secondary" href="/models/gemma3-27b">Gemma 3 27B</a>
        <a class="btn-secondary" href="/models/llama33-70b">Llama 3.3 70B</a>
        <a class="btn-secondary" href="/models/glm-53-flash">GLM 5.3 Flash</a>
        <a class="btn-secondary" href="/models/qwen36-27b">Qwen3.6 27B</a>
        <a class="btn-secondary" href="/models/qwen38-27b">Qwen3.8 27B</a>
      </div>
    </div>
    <div class="mt-4">
      <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
    </div>
    <p class="mt-4 max-w-2xl text-sm text-muted" data-assistant-note>
      Use with your AI assistant:
      <a class="underline decoration-accent/40" href="/api/">the public JSON API</a>
      and the <code class="text-ink">amdai-fit-mcp</code> server documented there.
    </p>

    <div id="ask-row" class="mt-8 space-y-6">
      <AskToggles defaultPriority={DEFAULT_PRIORITY} defaultUsage={DEFAULT_USAGE} defaultStyle={DEFAULT_STYLE} />
      <MotherboardPick
        boards={motherboards}
        ask={{ gpuCount: 1, minBudget: false, expandGpu: defaultExpandGpu(false) }}
      />
      <RamPick boards={motherboards} />
      <CpuPick />
      <PsuPick ask={{ gpuCount: 1, expandGpu: defaultExpandGpu(false) }} />
      <StoragePick />
      <BuildList />
    </div>

    <div id="tested-badge" hidden class="mt-6 inline-flex max-w-3xl items-start gap-2 rounded-2xl border border-ok/40 bg-ok/10 px-4 py-2 text-sm text-ok">
      <span aria-hidden="true">●</span>
      <span data-tested-label></span>
    </div>
    <p id="recipe-line" class="mt-3 max-w-3xl text-sm text-muted" data-recipe-line>Estimate only — no tested recipe for this card × model.</p>

    <details class="mt-4 max-w-3xl rounded-2xl border border-line bg-raised/40 p-4">
      <summary class="cursor-pointer font-medium">Detect GPU from rocminfo / rocm-smi</summary>
      <p class="mt-2 text-sm text-muted">Paste a marketing name or a gfx ID. gfx1201 is shared — the name wins when both appear.</p>
      <label class="mt-3 block text-sm" for="gpu-detect">
        <span class="text-faint">Paste rocminfo or rocm-smi output</span>
        <textarea id="gpu-detect" class="field mt-1 min-h-24" placeholder="Name: Radeon AI PRO R9700&#10;Marketing Name: Radeon AI PRO R9700&#10;Name: gfx1201"></textarea>
      </label>
      <p class="mt-2 text-sm text-faint" data-detect-status></p>
    </details>
    <script type="application/json" id="recipe-catalog" set:html={JSON.stringify(recipes)} />
    <script type="application/json" id="measured-ram" set:html={JSON.stringify(measuredRamHits)} />

    <div class="tabs mt-8" role="tablist" aria-label="Calculator view">
      <button type="button" class="tab is-on" role="tab" id="calc-tab-model" aria-controls="calc-panel-model" aria-selected="true" data-view="model">Size this model</button>
      <button type="button" class="tab" role="tab" id="calc-tab-gpu" aria-controls="calc-panel-gpu" aria-selected="false" data-view="gpu">What this GPU can run</button>
      <button type="button" class="tab" role="tab" id="calc-tab-speed" aria-controls="calc-panel-speed" aria-selected="false" data-view="speed">Speed floor</button>
    </div>
    <p id="calc-live" class="sr-only" aria-live="polite" aria-atomic="true"></p>

    <div class="tabs mt-4" role="group" aria-label="Stack presets">
      <button type="button" class="tab is-on" data-stack="daily">Daily driver</button>
      <button type="button" class="tab" data-stack="fast">Fast agent</button>
      <button type="button" class="tab" data-stack="custom">Custom</button>
    </div>

    <form id="calc-form" class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)]">
      <div class="space-y-6">
        <fieldset class="rounded-2xl border border-line bg-raised/40 p-4 sm:p-5">
          <legend class="px-1 font-serif text-2xl">Radeon</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="text-faint">Preset</span>
              <select name="gpuId" class="field mt-1">
                {GPU_PRESETS.map((gpu) => (
                  <option value={gpu.id}>
                    {gpu.name}{gpu.vramGb ? ` · ${gpu.vramGb} GB` : ''}{gpu.gfx ? ` · ${gpu.gfx}` : ''}
                  </option>
                ))}
              </select>
            </label>
            <label class="block text-sm">
              <span class="text-faint">VRAM per GPU (GB)</span>
              <input class="field mt-1" type="number" name="vramGb" min="1" max="512" step="1" inputmode="decimal" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">GPU count</span>
              <input class="field mt-1" type="number" name="gpuCount" min="1" max="4" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">System RAM (GB)</span>
              <input class="field mt-1" type="number" name="ramGb" min="0" max="1024" step="1" inputmode="decimal" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Published bandwidth (GB/s)</span>
              <input class="field mt-1" type="number" name="bandwidthGBs" min="0" max="10000" step="1" inputmode="decimal" />
              <span class="mt-1 block text-xs text-faint" data-bw-note></span>
            </label>
            <label class="block text-sm" data-unified-row hidden>
              <span class="text-faint">Usable share of unified memory (%)</span>
              <input class="field mt-1" type="number" name="usablePct" min="10" max="100" step="1" inputmode="decimal" />
              <span class="mt-1 block text-xs text-faint">Estimate. APUs and Apple Silicon lend the GPU a slice of one pool — paste a runtime figure if you have one.</span>
            </label>
          </div>
          <label class="mt-4 flex items-start gap-3 text-sm">
            <input class="mt-1 h-4 w-4 accent-[var(--accent)]" type="checkbox" name="split" />
            <span>
              Split the model across these cards
              <span class="mt-0.5 block text-faint">Off = one full copy must fit a single GPU (house rule: one LLM per GPU). On = weights + KV divided by GPU count, plus extra headroom for PCIe sync (estimate).</span>
            </span>
          </label>
          <label class="mt-3 flex items-start gap-3 text-sm">
            <input class="mt-1 h-4 w-4 accent-[var(--accent)]" type="checkbox" name="desktopSpare" />
            <span>
              Keep 5% desktop spare
              <span class="mt-0.5 block text-faint">A “fits” answer leaves room for a display. Tight means it only clears with no spare.</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="rounded-2xl border border-line bg-raised/40 p-4 sm:p-5" data-model-fields>
          <legend class="px-1 font-serif text-2xl">Model</legend>
          <div data-model-picker>
            <label class="mt-3 block text-sm">
              <span class="text-faint">Preset</span>
              <select name="modelId" class="field mt-1">
                {currentGroups.map((group) => (
                  <optgroup label={group.group}>
                    {group.models.map((model) => (
                      <option value={model.id}>{model.name}</option>
                    ))}
                  </optgroup>
                ))}
                <optgroup label="Older models" data-older-optgroup>
                  {olderPresets.map((model) => (
                    <option value={model.id} data-older-option>
                      {model.name}
                    </option>
                  ))}
                </optgroup>
              </select>
            </label>
            <OlderModelsToggle open={olderOpen} />
          </div>
          <p class="mt-2 text-xs leading-relaxed text-faint" data-arch-note></p>
          <label class="mt-4 block text-sm">
            <span class="text-faint">Or read a local GGUF header</span>
            <input class="field mt-1" type="file" name="gguf" accept=".gguf" />
            <span class="mt-1 block text-xs text-faint">Header only, in this browser. Nothing uploads. Weight size is the file on disk.</span>
            <span class="mt-1 block text-xs text-warn" data-gguf-status></span>
          </label>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="text-faint">Total params (billions)</span>
              <input class="field mt-1" type="number" name="totalParamsB" min="0" step="0.1" inputmode="decimal" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Active params (MoE, billions)</span>
              <input class="field mt-1" type="number" name="activeParamsB" min="0" step="0.1" inputmode="decimal" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Hidden layers</span>
              <input class="field mt-1" type="number" name="layers" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">KV-growing layers</span>
              <input class="field mt-1" type="number" name="kvLayers" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">KV heads</span>
              <input class="field mt-1" type="number" name="kvHeads" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Head dim</span>
              <input class="field mt-1" type="number" name="headDim" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">KV kind</span>
              <select name="kvKind" class="field mt-1">
                <option value="gqa">GQA / full + window</option>
                <option value="mla">MLA (compressed)</option>
              </select>
            </label>
            <label class="block text-sm">
              <span class="text-faint">MLA dim</span>
              <input class="field mt-1" type="number" name="mlaDim" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Sliding-window layers</span>
              <input class="field mt-1" type="number" name="windowLayers" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Window tokens</span>
              <input class="field mt-1" type="number" name="windowTokens" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Window KV heads</span>
              <input class="field mt-1" type="number" name="windowKvHeads" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Window head dim</span>
              <input class="field mt-1" type="number" name="windowHeadDim" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Indexer layers</span>
              <input class="field mt-1" type="number" name="indexerLayers" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Indexer dim</span>
              <input class="field mt-1" type="number" name="indexerDim" min="0" step="1" inputmode="numeric" />
            </label>
            <label class="block text-sm">
              <span class="text-faint">Fixed state (MiB)</span>
              <input class="field mt-1" type="number" name="fixedStateMiB" min="0" step="0.1" inputmode="decimal" />
            </label>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-line bg-raised/40 p-4 sm:p-5">
          <legend class="px-1 font-serif text-2xl">Quant, context, backend</legend>
          <p class="mt-2 text-xs text-faint">Q3_K_M, Q3_K_S, UD-Q3_K_XL, and IQ3 are listed. Those rows are estimates unless a tested badge applies. Q1 / Q2 stay off, including draft heads. Our local desktop measurements stay Q4 and above.</p>
          <label class="mt-3 block text-sm">
            <span class="text-faint">Quant</span>
            <select name="quantId" class="field mt-1">
              {QUANTS.map((quant) => <option value={quant.id}>{quant.label} · {quant.bpw} bpw</option>)}
            </select>
          </label>
          <label class="mt-3 block text-sm">
            <span class="text-faint">Context length</span>
            <input class="mt-2 w-full accent-[var(--accent)]" type="range" name="context" min="2048" max="524288" step="1024" />
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <input class="field w-32" type="number" name="contextNum" min="2048" max="1048576" step="1024" inputmode="numeric" />
              <span class="text-xs text-faint" data-ctx-label></span>
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {CONTEXT_PRESETS.map((ctx) => (
                <button type="button" class="rounded-full border border-line px-2.5 py-1 text-xs text-muted" data-ctx={ctx}>
                  {ctx >= 1024 ? `${ctx / 1024}K` : ctx}
                </button>
              ))}
            </div>
          </label>
          <label class="mt-3 block text-sm">
            <span class="text-faint">KV cache type</span>
            <select name="kvId" class="field mt-1">
              {KV_TYPES.map((kv) => <option value={kv.id}>{kv.label} · {kv.flag}</option>)}
            </select>
          </label>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="text-faint">Inference backend</span>
              <select name="backendId" class="field mt-1">
                {BACKENDS.map((be) => <option value={be.id}>{be.name}</option>)}
              </select>
            </label>
            <label class="block text-sm">
              <span class="text-faint">llama.cpp path</span>
              <select name="pathId" class="field mt-1">
                <option value="vulkan">Vulkan</option>
                <option value="hip">HIP / ROCm</option>
              </select>
            </label>
            <label class="block text-sm">
              <span class="text-faint">Concurrent sequences</span>
              <input class="field mt-1" type="number" name="batch" min="1" max="16" step="1" inputmode="numeric" />
              <span class="mt-1 block text-xs text-faint">Ollama multiplies KV per request. llama.cpp shares one pool.</span>
            </label>
            <label class="block text-sm">
              <span class="text-faint">Controller efficiency</span>
              <input class="field mt-1" type="number" name="efficiency" min="0.2" max="1" step="0.05" inputmode="decimal" />
              <span class="mt-1 block text-xs text-faint">Speed-floor only. Default 0.75 is an estimate, not measured.</span>
            </label>
          </div>
          <label class="mt-3 flex items-start gap-3 text-sm">
            <input class="mt-1 h-4 w-4 accent-[var(--accent)]" type="checkbox" name="separableEmbed" />
            <span>
              Host token embeddings / n-gram table in system RAM
              <span class="mt-0.5 block text-faint">llama.cpp can keep an untied embed table off the card. Subtracts a formula size — not a measured split.</span>
            </span>
          </label>
          <label class="mt-3 flex items-start gap-3 text-sm">
            <input class="mt-1 h-4 w-4 accent-[var(--accent)]" type="checkbox" name="overheadManual" />
            <span>Override overhead (GiB)</span>
          </label>
          <label class="mt-2 block text-sm">
            <span class="text-faint">Framework overhead (GiB)</span>
            <input class="field mt-1" type="number" name="overheadGiB" min="0" max="16" step="0.1" inputmode="decimal" />
            <span class="mt-1 block text-xs text-faint">Used only when override is on. Backend floors are estimates, not R9700 measurements.</span>
          </label>
        </fieldset>
      </div>

      <div class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <HowWeTest compact />
        <section class="rounded-2xl border border-line bg-raised p-5" id="calc-panel-model" role="tabpanel" aria-labelledby="calc-tab-model" data-panel="model">
          <p class="kicker">Required VRAM · estimate</p>
          <p class="mt-2 font-serif text-3xl" data-verdict-label>Fits in VRAM (estimate)</p>
          <p class="mt-1 text-sm text-faint">Per GPU vs the VRAM you entered. Totals in GiB (1024³). Desktop spare is extra.</p>
          <VramBar />
          <div class="mt-4 rounded-xl border border-line bg-canvas/60 p-3 text-sm leading-relaxed">
            <p class="font-medium" data-priority-headline></p>
            <p class="mt-2 text-muted" data-priority-body></p>
            <p class="mt-2 text-muted" data-usage-verdict></p>
            <button type="button" id="apply-priority" hidden class="btn-primary mt-3 px-3 py-1.5 text-xs"></button>
          </div>
          <AbliteratedPicks />
          <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-xl border border-line bg-canvas/50 p-3">
              <dt class="text-faint">Weights</dt>
              <dd class="mt-1 font-serif text-2xl tabular-nums" data-out="weights">—</dd>
            </div>
            <div class="rounded-xl border border-line bg-canvas/50 p-3">
              <dt class="text-faint">KV cache</dt>
              <dd class="mt-1 font-serif text-2xl tabular-nums" data-out="kv">—</dd>
            </div>
            <div class="rounded-xl border border-line bg-canvas/50 p-3">
              <dt class="text-faint">Overhead</dt>
              <dd class="mt-1 font-serif text-2xl tabular-nums" data-out="overhead">—</dd>
            </div>
            <div class="rounded-xl border border-line bg-canvas/50 p-3">
              <dt class="text-faint">Total</dt>
              <dd class="mt-1 font-serif text-2xl tabular-nums" data-out="total">—</dd>
            </div>
          </dl>
          <p class="mt-3 text-xs leading-relaxed text-faint" data-weights-note></p>
          <p class="mt-1 text-xs leading-relaxed text-faint" data-kv-note></p>
          <p class="mt-1 text-xs leading-relaxed text-faint" data-oh-note></p>
          <div class="mt-5 rounded-xl border border-line p-3 text-sm">
            <p><span class="text-faint">Per GPU · </span><span class="tabular-nums" data-out="perGpu">—</span> GiB vs <span class="tabular-nums" data-out="vram">—</span> GB</p>
            <p class="mt-1"><span class="text-faint">Usable pool · </span><span class="tabular-nums" data-out="available">—</span> GB</p>
            <p class="mt-1"><span class="text-faint">Overflow to system RAM · </span><span class="tabular-nums" data-out="overflow">—</span> GiB (<span class="tabular-nums" data-out="ramPct">—</span>% of RAM)</p>
            <p class="mt-2 hidden text-sm text-warn" data-offload-warn></p>
          </div>
          <div class="mt-5 rounded-xl border border-line p-3 text-sm" data-system-ram>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <p class="text-faint">{RAM_MIN_LABEL}</p>
                <p class="mt-1 font-serif text-2xl tabular-nums" data-out="ramMinKit">—</p>
                <p class="mt-1 text-xs text-faint" data-out="ramMinMeta"></p>
                <p class="mt-1 text-xs" data-out="ramMinLinks"></p>
              </div>
              <div>
                <p class="text-faint">{RAM_FULL_LABEL}</p>
                <p class="mt-1 font-serif text-2xl tabular-nums" data-out="ramFullKit">—</p>
                <p class="mt-1 text-xs text-faint" data-out="ramFullMeta"></p>
                <p class="mt-1 text-xs" data-out="ramFullLinks"></p>
              </div>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-faint" data-out="ramNote"></p>
            <details class="mt-3">
              <summary class="cursor-pointer text-xs font-medium">Breakdown</summary>
              <dl class="mt-2 grid gap-1 text-xs text-muted sm:grid-cols-2">
                <div><dt class="inline text-faint">Offloaded weights · </dt><dd class="inline tabular-nums" data-out="ramOffW">—</dd></div>
                <div><dt class="inline text-faint">Separable embed in RAM · </dt><dd class="inline tabular-nums" data-out="ramEmbed">—</dd></div>
                <div><dt class="inline text-faint">KV in RAM at selected · </dt><dd class="inline tabular-nums" data-out="ramKvSel">—</dd></div>
                <div><dt class="inline text-faint">KV in RAM at full context · </dt><dd class="inline tabular-nums" data-out="ramKvFull">—</dd></div>
                <div><dt class="inline text-faint">Runtime / backend · </dt><dd class="inline tabular-nums" data-out="ramRuntime">—</dd></div>
                <div><dt class="inline text-faint">OS / desktop baseline · </dt><dd class="inline tabular-nums" data-out="ramOs">—</dd></div>
                <div><dt class="inline text-faint">Headroom · </dt><dd class="inline tabular-nums" data-out="ramHead">—</dd></div>
              </dl>
            </details>
          </div>
          <div class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
            <div>
              <p class="text-faint" data-best-quant-label>Best quant that fits fully in VRAM</p>
              <p class="mt-1 font-medium" data-out="bestQuant">—</p>
            </div>
            <div>
              <p class="text-faint">Max context at that quant</p>
              <p class="mt-1 font-medium tabular-nums" data-out="maxBest">—</p>
            </div>
            <div class="sm:col-span-2">
              <p class="text-faint">Max context at the selected quant</p>
              <p class="mt-1 font-medium tabular-nums" data-out="maxSelected">—</p>
            </div>
          </div>
        </section>

        <section class="rounded-2xl border border-line bg-raised p-5" id="calc-panel-gpu" role="tabpanel" aria-labelledby="calc-tab-gpu" data-panel="gpu" hidden>
          <p class="kicker">What this GPU can run</p>
          <p class="mt-2 text-sm text-muted">Largest fits first. Highest listed quant that clears the pool with your context, KV, and backend. Out of reach is shown at the lightest listed quant (IQ3 / Q3) so you can see the miss.</p>
          <h3 class="mt-4 font-serif text-xl">Runs on this pool</h3>
          <ul class="mt-2 space-y-2 text-sm" data-gpu-fits></ul>
          <h3 class="mt-6 font-serif text-xl">Out of reach</h3>
          <ul class="mt-2 space-y-2 text-sm text-muted" data-gpu-misses></ul>
        </section>

        <section class="rounded-2xl border border-line bg-raised p-5" id="calc-panel-speed" role="tabpanel" aria-labelledby="calc-tab-speed" data-panel="speed" hidden>
          <p class="kicker">Decode speed floor</p>
          <p class="mt-2 font-serif text-3xl tabular-nums" data-speed-value>—</p>
          <p class="mt-2 text-sm text-muted" data-speed-note></p>
          <p class="mt-3 text-sm text-ok" data-speed-measured hidden></p>
        </section>

        <section class="rounded-2xl border border-line bg-raised/40 p-5">
          <h3 class="font-serif text-xl">VRAM vs context</h3>
          <p class="mt-1 text-xs text-faint">Same estimate at each preset window. Heights are relative to the largest total in the sweep.</p>
          <div class="mt-4 flex h-36 items-end gap-1" data-sweep-chart></div>
          <div class="mt-2 flex justify-between text-[0.65rem] text-faint" data-sweep-labels></div>
        </section>

        <section class="rounded-2xl border border-line bg-raised/40 p-5">
          <h3 class="font-serif text-xl">Matching Radeon options</h3>
          <p class="mt-1 text-xs text-faint">Smallest published VRAM first. Fit uses this model, quant, context, and backend — plus desktop spare.</p>
          <ol class="mt-3 space-y-1.5 text-sm" data-match-list></ol>
        </section>

        <div class="flex flex-wrap gap-2">
          <button type="button" id="share-btn" class="btn-primary">Copy share link</button>
          <button type="button" id="export-btn" class="btn-secondary">Download JSON</button>
          <SaveSetupButton from="calculator" />
          <span class="self-center text-sm text-ok" data-share-status hidden>Copied</span>
        </div>
        <p class="break-all font-mono text-[0.7rem] text-faint" data-share-url></p>

        <details class="rounded-2xl border border-line bg-raised/40 p-4 text-sm leading-relaxed">
          <summary class="cursor-pointer font-medium">How this result is calculated</summary>
          <div class="mt-3 space-y-3 text-muted">
            <p>
              <code class="text-ink">weights_GiB ≈ total_params × 10⁹ × bpw / 8 / 1024³</code>
              A Hugging Face listing or a local GGUF file size replaces the formula when present. Active experts do not shrink the file.
            </p>
            <p>
              <code class="text-ink">KV_GiB ≈ 2 × full_layers × heads × dim × context × bytes / 1024³</code>
              plus sliding-window layers at <code class="text-ink">min(context, window)</code>, or MLA as <code class="text-ink">layers × dim × tensors × context × bytes</code>.
              Hybrid Qwen cards only grow token-length KV on full-attention layers.
            </p>
            <p>
              Backend overhead is a labeled floor plus a percent of weights+KV. llama.cpp Vulkan is the default path; HIP adds a small estimate. These are not R9700 measurements.
              Ollama multiplies KV by concurrent sequences; the other backends share one pool.
            </p>
            <p>
              A card <strong class="text-ink">fits</strong> when the total plus 5% spare lands in the usable pool (more spare on a split).
              <strong class="text-ink">Tight</strong> clears the label but not the spare.
              <strong class="text-ink">No</strong> overflows — the extra is system RAM offload.
            </p>
            <p>
              Speed floor: published bandwidth × 75% controller / (active params × bpw / 8). Offered only when the file stays in VRAM. First-party tok/s appear only on the tested badge.
            </p>
          </div>
        </details>
      </div>
    </form>

    <section class="mt-12 border-t border-line pt-10">
      <p class="kicker">Check price · no live prices</p>
      <h2 class="mt-2 font-serif text-3xl">Cards in this VRAM neighborhood</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Estimate only. We show the selected card and any listed GPU whose published VRAM is at least the per-GPU total. Buttons open a search — never a stale price. As an Amazon Associate I earn from qualifying purchases.
      </p>
      <p class="mt-2 hidden text-sm text-warn" data-fit-none>
        No listed card holds this estimate in VRAM. Expect system RAM offload (slow), or pick a smaller listed quant (Q3 and up).
      </p>
      {fitGpus.map((item) => (
        <div data-fit-card data-fit-vram={item.vram_gb} data-fit-gpu={item.calculator_gpu ?? ''} hidden>
          <BuyButtons product={item.id} disclose={false} />
        </div>
      ))}
      <AffiliateDisclosure compact />
    </section>
  </main>
</Base>

<script>
  import {
    DEFAULT_INPUT,
    applyGpuPreset,
    applyModelPreset,
    applyMeasuredSystemRam,
    bindOlderModelPickers,
    compute,
    decimalGbToGiB,
    exportEstimate,
    formatCtx,
    formatGiB,
    formatTokS,
    gpuById,
    inputToQuery,
    modelById,
    queryToInput,
    type BackendId,
    type CalcInput,
    type CalcView,
    type GpuId,
    type KvId,
    type KvKind,
    type ModelId,
    type MeasuredRamHit,
    type PathId,
    type QuantId,
  } from '../lib/calculator';
  import { parseGgufHeader, ggufToBillions } from '../lib/gguf-header';
  import {
    PRIORITY_COPY,
    bestQuantForPriority,
    calculatorAdvice,
    type PriorityAdvice,
  } from '../lib/priority';
  import { USAGE_COPY, parseAsk, type AskState } from '../lib/ask';
  import { matchRecipe, recipeTestedLine, type Recipe } from '../lib/recipes';
  import { detectPrimary } from '../lib/gpu-detect';

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const shareBtn = document.getElementById('share-btn');
  const exportBtn = document.getElementById('export-btn');
  const applyBtn = document.getElementById('apply-priority') as HTMLButtonElement | null;
  let input: CalcInput = queryToInput(window.location.search);
  let ask: AskState = parseAsk(window.location.search);
  let pendingApply: CalcInput | null = null;

  const field = <T extends HTMLElement>(name: string) => form.querySelector(`[name="${name}"]`) as T;

  function writeForm() {
    field<HTMLSelectElement>('gpuId').value = input.gpuId;
    field<HTMLInputElement>('vramGb').value = String(input.vramGb);
    field<HTMLInputElement>('gpuCount').value = String(input.gpuCount);
    field<HTMLInputElement>('ramGb').value = String(input.ramGb);
    field<HTMLInputElement>('split').checked = input.split;
    field<HTMLInputElement>('desktopSpare').checked = input.desktopSpare;
    field<HTMLInputElement>('bandwidthGBs').value = String(input.bandwidthGBs);
    field<HTMLInputElement>('usablePct').value = String(input.usablePct);
    field<HTMLSelectElement>('modelId').value = input.modelId;
    field<HTMLInputElement>('totalParamsB').value = String(input.totalParamsB);
    field<HTMLInputElement>('activeParamsB').value = String(input.activeParamsB);
    field<HTMLInputElement>('layers').value = String(input.layers);
    field<HTMLInputElement>('kvLayers').value = String(input.kvLayers);
    field<HTMLInputElement>('kvHeads').value = String(input.kvHeads);
    field<HTMLInputElement>('headDim').value = String(input.headDim);
    field<HTMLSelectElement>('kvKind').value = input.kvKind;
    field<HTMLInputElement>('mlaDim').value = String(input.mlaDim);
    field<HTMLInputElement>('windowLayers').value = String(input.windowLayers);
    field<HTMLInputElement>('windowTokens').value = String(input.windowTokens);
    field<HTMLInputElement>('windowKvHeads').value = String(input.windowKvHeads);
    field<HTMLInputElement>('windowHeadDim').value = String(input.windowHeadDim);
    field<HTMLInputElement>('indexerLayers').value = String(input.indexerLayers);
    field<HTMLInputElement>('indexerDim').value = String(input.indexerDim);
    field<HTMLInputElement>('fixedStateMiB').value = String(input.fixedStateMiB);
    field<HTMLSelectElement>('quantId').value = input.quantId;
    field<HTMLInputElement>('context').value = String(Math.min(524288, input.context));
    field<HTMLInputElement>('contextNum').value = String(input.context);
    field<HTMLSelectElement>('kvId').value = input.kvId;
    field<HTMLSelectElement>('backendId').value = input.backendId;
    field<HTMLSelectElement>('pathId').value = input.pathId;
    field<HTMLInputElement>('batch').value = String(input.batch);
    field<HTMLInputElement>('efficiency').value = String(input.efficiency);
    field<HTMLInputElement>('separableEmbed').checked = input.separableEmbed;
    field<HTMLInputElement>('overheadManual').checked = input.overheadManual;
    field<HTMLInputElement>('overheadGiB').value = String(input.overheadGiB);
    const note = document.querySelector('[data-arch-note]');
    if (note) note.textContent = modelById(input.modelId).archNote;
    const bw = document.querySelector('[data-bw-note]');
    if (bw) bw.textContent = gpuById(input.gpuId).bandwidthNote;
    const unified = document.querySelector<HTMLElement>('[data-unified-row]');
    if (unified) unified.hidden = input.kind !== 'unified';
    document.querySelectorAll<HTMLInputElement>('input[name="priority"]').forEach((el) => {
      el.checked = el.value === ask.priority;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="usage"]').forEach((el) => {
      el.checked = el.value === ask.usage;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="style"]').forEach((el) => {
      el.checked = el.value === ask.style;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="minbudget"]').forEach((el) => {
      el.checked = (el.value === '1') === ask.minBudget;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="expandgpu"]').forEach((el) => {
      el.checked = (el.value === '1') === ask.expandGpu;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="bigmodels"]').forEach((el) => {
      el.checked = (el.value === '1') === ask.bigModels;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="cpuwork"]').forEach((el) => {
      el.checked = (el.value === '1') === ask.cpuWork;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="coldload"]').forEach((el) => {
      el.checked = (el.value === '1') === ask.coldLoad;
    });
  }

  function readForm(): CalcInput {
    const gpuId = field<HTMLSelectElement>('gpuId').value as GpuId;
    return {
      ...input,
      gpuId,
      vramGb: Number(field<HTMLInputElement>('vramGb').value),
      gpuCount: Number(field<HTMLInputElement>('gpuCount').value),
      split: field<HTMLInputElement>('split').checked,
      ramGb: Number(field<HTMLInputElement>('ramGb').value),
      desktopSpare: field<HTMLInputElement>('desktopSpare').checked,
      bandwidthGBs: Number(field<HTMLInputElement>('bandwidthGBs').value),
      usablePct: Number(field<HTMLInputElement>('usablePct').value),
      kind: gpuById(gpuId).kind,
      modelId: field<HTMLSelectElement>('modelId').value as ModelId,
      totalParamsB: Number(field<HTMLInputElement>('totalParamsB').value),
      activeParamsB: Number(field<HTMLInputElement>('activeParamsB').value),
      layers: Number(field<HTMLInputElement>('layers').value),
      kvLayers: Number(field<HTMLInputElement>('kvLayers').value),
      kvHeads: Number(field<HTMLInputElement>('kvHeads').value),
      headDim: Number(field<HTMLInputElement>('headDim').value),
      kvKind: field<HTMLSelectElement>('kvKind').value as KvKind,
      mlaDim: Number(field<HTMLInputElement>('mlaDim').value),
      windowLayers: Number(field<HTMLInputElement>('windowLayers').value),
      windowTokens: Number(field<HTMLInputElement>('windowTokens').value),
      windowKvHeads: Number(field<HTMLInputElement>('windowKvHeads').value),
      windowHeadDim: Number(field<HTMLInputElement>('windowHeadDim').value),
      indexerLayers: Number(field<HTMLInputElement>('indexerLayers').value),
      indexerDim: Number(field<HTMLInputElement>('indexerDim').value),
      fixedStateMiB: Number(field<HTMLInputElement>('fixedStateMiB').value),
      quantId: field<HTMLSelectElement>('quantId').value as QuantId,
      context: Number(field<HTMLInputElement>('contextNum').value || field<HTMLInputElement>('context').value),
      kvId: field<HTMLSelectElement>('kvId').value as KvId,
      backendId: field<HTMLSelectElement>('backendId').value as BackendId,
      pathId: field<HTMLSelectElement>('pathId').value as PathId,
      batch: Number(field<HTMLInputElement>('batch').value),
      efficiency: Number(field<HTMLInputElement>('efficiency').value),
      separableEmbed: field<HTMLInputElement>('separableEmbed').checked,
      overheadManual: field<HTMLInputElement>('overheadManual').checked,
      overheadGiB: Number(field<HTMLInputElement>('overheadGiB').value),
    };
  }

  function setText(selector: string, value: string) {
    document.querySelectorAll(selector).forEach((el) => {
      el.textContent = value;
    });
  }

  function shareQuery() {
    return inputToQuery(input, {
      priority: ask.priority,
      usage: ask.usage,
      style: ask.style,
      minbudget: ask.minBudget ? '1' : '0',
      expandgpu: ask.expandGpu ? '1' : '0',
      bigmodels: ask.bigModels ? '1' : '0',
      cpuwork: ask.cpuWork ? '1' : '0',
      coldload: ask.coldLoad ? '1' : '0',
    });
  }

  function renderAdvice(advice: PriorityAdvice) {
    setText('[data-priority-lede]', PRIORITY_COPY[ask.priority].lede);
    setText('[data-usage-lede]', USAGE_COPY[ask.usage].lede);
    setText('[data-style-lede]', ask.style === 'abliterated'
      ? 'Abliteration edits refusals in the weights. It can hurt quality. Verify the uploader and the file. You are responsible for what you run. Q1/Q2 stay off; Q3 is estimate/community unless measured. Tested pick: being reworked.'
      : 'Official instruct weights. This is the default and the reliability baseline. Prove Qwen3.6-35B-A3B before you swap.');
    setText('[data-minbudget-lede]', ask.minBudget
      ? 'Only this choice may drop the dual x8/x8 requirement. A cheaper single-x16 board limits a later second GPU.'
      : 'Default. Buy a board whose maker manual documents a CPU-lane x8/x8 split, even for one GPU.');
    setText('[data-expandgpu-lede]', ask.expandGpu
      ? 'A dual x8/x8 board now puts both cards on CPU lanes at the same width.'
      : 'One card will run on a single x16 slot. Combined with Minimum budget, a cheaper single-x16 board is listed.');
    setText('[data-bigmodels-lede]', ask.bigModels
      ? 'Recommend 192 GB or 256 GB now (G.SKILL Flare X5 4x48 DDR5-6000 CL28, or Trident Z5 Neo 4x64 DDR5-6000). That lets big MoE models keep experts in RAM.'
      : 'Recommend the G.SKILL Flare X5 2x16 DDR5-6000 CL30 (32 GB). The GPU does the work on the in-VRAM path, so save the money on system RAM.');
    setText('[data-cpuwork-lede]', ask.cpuWork
      ? 'Same PCIe story. For DDR5 offload the 9950X adds cores for side jobs; for in-VRAM the 9600X is still enough.'
      : 'The CPU mostly feeds the cards. Stay on the 9600X when the model fits in VRAM, or the 9900X when experts land in DDR5.');
    setText('[data-coldload-lede]', ask.coldLoad
      ? 'Samsung 9100 PRO. Helps most with direct I/O. Default mmap is usually CPU-bound. Cited third-party test: 13.8 s vs 15.2 s (about 9%).'
      : 'Default. Samsung 990 PRO or WD_BLACK SN850X. A published mmap test loaded a 40.5 GB file only about 9% faster on Gen5 (15.2 s vs 13.8 s).');
    setText('[data-priority-headline]', advice.headline);
    setText('[data-priority-body]', advice.body);
    setText('[data-usage-verdict]', USAGE_COPY[ask.usage].verdict);
    document.querySelectorAll<HTMLElement>('[data-abliterated-panel]').forEach((el) => {
      el.hidden = ask.style !== 'abliterated';
    });
    pendingApply = advice.apply ?? null;
    if (applyBtn) {
      if (advice.apply && advice.applyLabel) {
        applyBtn.hidden = false;
        applyBtn.textContent = advice.applyLabel;
      } else {
        applyBtn.hidden = true;
      }
    }
  }

  function renderLists(result: ReturnType<typeof compute>) {
    const fits = document.querySelector('[data-gpu-fits]');
    const misses = document.querySelector('[data-gpu-misses]');
    if (fits) {
      fits.innerHTML = result.gpuFits.length
        ? result.gpuFits
            .map(
              (row) =>
                `<li class="rounded-xl border border-line bg-canvas/50 px-3 py-2"><span class="font-medium text-ink">${row.name}</span> · ${row.quant.label} · ${formatGiB(row.totalGiB)} GiB · ${row.verdict}${row.tested ? ' · tested on our rig' : ' · estimate'}</li>`,
            )
            .join('')
        : '<li class="text-muted">Nothing in the catalog fits this pool at a listed quant.</li>';
    }
    if (misses) {
      misses.innerHTML = result.gpuMisses.length
        ? result.gpuMisses
            .map((row) => `<li>${row.name} needs about ${formatGiB(row.totalGiB)} GiB at ${row.quant.label} (estimate)</li>`)
            .join('')
        : '<li>Every catalog model has a listed-quant fit on this pool.</li>';
    }

    const match = document.querySelector('[data-match-list]');
    if (match) {
      match.innerHTML = result.matching
        .filter((g) => g.verdict !== 'no')
        .map(
          (g) =>
            `<li><span class="font-medium text-ink">${g.name}</span> · ${g.vramGb} GB · ${g.gfx} · ${g.verdict}</li>`,
        )
        .join('') || '<li class="text-muted">No listed Radeon clears this estimate. Offload or shorten context.</li>';
    }

    const chart = document.querySelector('[data-sweep-chart]');
    const labels = document.querySelector('[data-sweep-labels]');
    if (chart && labels) {
      const max = Math.max(...result.sweep.map((row) => row.totalGiB), 0.01);
      chart.innerHTML = result.sweep
        .map((row) => {
          const h = Math.max(8, (row.totalGiB / max) * 100);
          const tone = row.verdict === 'fits' ? 'bg-ok' : row.verdict === 'tight' ? 'bg-warn' : 'bg-accent';
          return `<div class="flex-1 rounded-t ${tone}/80" style="height:${h}%" title="${formatCtx(row.context)} · ${formatGiB(row.totalGiB)} GiB"></div>`;
        })
        .join('');
      labels.innerHTML = result.sweep.map((row) => `<span>${formatCtx(row.context)}</span>`).join('');
    }
  }

  const measuredRam = JSON.parse(document.getElementById('measured-ram')?.textContent || '[]') as MeasuredRamHit[];

  function ramHeadline(line: { label: string; kitGb: number; peakGbs?: number[] }): string {
    if (line.label === 'measured' && line.peakGbs?.length) {
      return `${[...new Set(line.peakGbs)].join(' / ')} GB`;
    }
    return `${line.kitGb} GB kit`;
  }

  function setRamLinks(selector: string, ids: string[] | undefined) {
    const el = document.querySelector(selector);
    if (!el) return;
    el.replaceChildren();
    for (const id of ids ?? []) {
      const link = document.createElement('a');
      link.href = `/results/${id}`;
      link.className = 'mr-2 underline decoration-accent/40';
      link.textContent = id;
      el.append(link);
    }
  }

  function render() {
    const result = applyMeasuredSystemRam(compute(input), measuredRam, input);
    const advice = calculatorAdvice(input, result, ask.priority);
    const pick = bestQuantForPriority(input, ask.priority);
    const verdictEl = document.querySelector('[data-verdict-label]');
    if (verdictEl) {
      verdictEl.textContent = `${result.verdictLabel} · ${result.tested ? 'tested on our rig' : 'estimate'}`;
      verdictEl.classList.toggle('text-ok', result.verdict === 'fits');
      verdictEl.classList.toggle('text-warn', result.verdict !== 'fits');
    }
    setText('[data-out="weights"]', `${formatGiB(result.weightsGiB)} GiB`);
    setText('[data-out="kv"]', result.kvReady ? `${formatGiB(result.kvGiB)} GiB` : '—');
    setText('[data-out="overhead"]', `${formatGiB(result.overheadGiB)} GiB`);
    setText('[data-out="total"]', `${formatGiB(result.totalGiB)} GiB`);
    setText('[data-out="perGpu"]', formatGiB(result.perGpuGiB));
    setText('[data-out="vram"]', String(input.vramGb));
    setText('[data-out="available"]', formatGiB(result.availableVramGb));
    setText('[data-out="overflow"]', formatGiB(result.overflowGiB));
    setText('[data-out="ramPct"]', result.overflowRamPct == null ? '—' : result.overflowRamPct.toFixed(1));
    const ram = result.systemRam;
    setText('[data-out="ramMinKit"]', ramHeadline(ram.atSelected));
    setText('[data-out="ramFullKit"]', ramHeadline(ram.atFullContext));
    setRamLinks('[data-out="ramMinLinks"]', ram.atSelected.runIds);
    setRamLinks('[data-out="ramFullLinks"]', ram.atFullContext.runIds);
    setText(
      '[data-out="ramMinMeta"]',
      `${ram.atSelected.label === 'measured' ? 'Measured' : 'Estimate'} · ${formatGiB(ram.atSelected.rawGiB)} GiB raw · ${formatCtx(ram.atSelected.context)} context`,
    );
    setText(
      '[data-out="ramFullMeta"]',
      `${ram.atFullContext.label === 'measured' ? 'Measured' : 'Estimate'} · ${formatGiB(ram.atFullContext.rawGiB)} GiB raw · ${formatCtx(ram.fullContext)} full context`,
    );
    setText('[data-out="ramNote"]', ram.atSelected.note);
    setText('[data-out="ramOffW"]', `${formatGiB(ram.atSelected.breakdown.offloadedWeightsGiB)} GiB`);
    setText('[data-out="ramEmbed"]', `${formatGiB(ram.atSelected.breakdown.separableEmbedGiB)} GiB`);
    setText('[data-out="ramKvSel"]', `${formatGiB(ram.atSelected.breakdown.kvInRamGiB)} GiB`);
    setText('[data-out="ramKvFull"]', `${formatGiB(ram.atFullContext.breakdown.kvInRamGiB)} GiB`);
    setText('[data-out="ramRuntime"]', `${formatGiB(ram.atSelected.breakdown.runtimeOverheadGiB)} GiB`);
    setText('[data-out="ramOs"]', `${formatGiB(ram.atSelected.breakdown.osDesktopGiB)} GiB`);
    setText('[data-out="ramHead"]', `${formatGiB(ram.atSelected.breakdown.headroomGiB)} GiB`);
    setText('[data-weights-note]', result.weightsNote);
    setText('[data-kv-note]', result.kvNote);
    setText('[data-oh-note]', result.overheadNote);
    setText('[data-best-quant-label]', PRIORITY_COPY[ask.priority].bestQuantLabel);
    setText('[data-out="bestQuant"]', pick ? `${pick.label} (estimate)` : 'No listed quant fits fully in VRAM');
    setText('[data-out="maxBest"]', result.maxContextAtBest != null ? `${formatCtx(result.maxContextAtBest)} (estimate)` : '—');
    setText('[data-out="maxSelected"]', result.maxContextAtSelected != null ? `${formatCtx(result.maxContextAtSelected)} (estimate)` : '—');
    setText('[data-ctx-label]', `${formatCtx(input.context)} tokens`);
    setText('[data-speed-value]', result.speed.offered ? `${formatTokS(result.speed.tokS)} tok/s · estimate` : 'Not offered');
    setText('[data-speed-note]', result.speed.note);
    const measured = document.querySelector<HTMLElement>('[data-speed-measured]');
    if (measured) {
      measured.hidden = !result.speed.measured;
      measured.textContent = result.speed.measured?.label ?? '';
    }
    renderAdvice(advice);
    renderLists(result);

    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => {
      el.hidden = el.dataset.panel !== input.view && el.dataset.panel !== undefined && !['model', 'gpu', 'speed'].includes(el.dataset.panel ?? '');
    });
    document.querySelectorAll<HTMLElement>('[data-panel="model"]')[0] && ((document.querySelector<HTMLElement>('[data-panel="model"]') as HTMLElement).hidden = false);
    const gpuPanel = document.querySelector<HTMLElement>('[data-panel="gpu"]');
    const speedPanel = document.querySelector<HTMLElement>('[data-panel="speed"]');
    if (gpuPanel) gpuPanel.hidden = input.view !== 'gpu';
    if (speedPanel) speedPanel.hidden = input.view !== 'speed';

    const warn = document.querySelector('[data-offload-warn]');
    if (warn) {
      warn.textContent = PRIORITY_COPY[ask.priority].offload;
      warn.classList.toggle('hidden', result.overflowGiB <= 0.05);
    }

    const badge = document.getElementById('tested-badge');
    const badgeLabel = document.querySelector('[data-tested-label]');
    if (badge && badgeLabel) {
      if (result.tested) {
        badge.hidden = false;
        badgeLabel.textContent = result.tested.label;
      } else {
        badge.hidden = true;
      }
    }

    const catalog = JSON.parse(document.getElementById('recipe-catalog')?.textContent || '[]') as Recipe[];
    const matched = matchRecipe(catalog, input);
    const line = recipeTestedLine(matched);
    const recipeLine = document.querySelector<HTMLParagraphElement>('[data-recipe-line]');
    if (recipeLine) {
      recipeLine.classList.toggle('text-ok', line.tested);
      recipeLine.replaceChildren();
      if (line.href) {
        const link = document.createElement('a');
        link.href = line.href;
        link.className = 'underline decoration-accent/40';
        link.textContent = line.text;
        recipeLine.append(link);
      } else {
        recipeLine.textContent = line.text;
      }
    }

    const offloadNeeded = result.overflowGiB > 1 || result.systemRam.atSelected.breakdown.offloadedWeightsGiB > 1;
    window.dispatchEvent(new CustomEvent('amdai-ram-offload', { detail: { needed: offloadNeeded } }));

    const qs = shareQuery();
    const url = `${window.location.pathname}?${qs}`;
    setText('[data-share-url]', url);
    history.replaceState(null, '', url);
    document.querySelectorAll<HTMLAnchorElement>('[data-save-setup]').forEach((link) => {
      const base = link.getAttribute('href')?.split('?')[0] ?? '/account/save';
      if (base === '/account') return;
      link.href = `${base}?from=calculator&${qs}`;
    });

    const bar = document.querySelector<HTMLElement>('[data-vram-bar]');
    if (bar) {
      bar.hidden = false;
      const cap = Math.max(input.kind === 'unified' ? result.usableVramGb : input.vramGb, 0.01);
      const used = result.perGpuGiB;
      const total = Math.max(result.totalGiB, 0.01);
      bar.style.setProperty('--used', `${Math.min(100, (used / cap) * 100)}%`);
      bar.style.setProperty('--w-weights', `${(result.weightsGiB / total) * 100}%`);
      bar.style.setProperty('--w-kv', `${(result.kvGiB / total) * 100}%`);
      bar.style.setProperty('--w-oh', `${(result.overheadGiB / total) * 100}%`);
      bar.dataset.overflow = result.overflowGiB > 0.05 ? '1' : '0';
      const usedLabel = bar.querySelector('[data-vram-used]');
      if (usedLabel) usedLabel.textContent = `${formatGiB(used)} GiB / ${formatGiB(cap)} GB`;
    }

    const needed = result.perGpuGiB;
    let anyFit = false;
    document.querySelectorAll<HTMLElement>('[data-fit-card]').forEach((el) => {
      const vram = Number(el.dataset.fitVram);
      const selected = Boolean(el.dataset.fitGpu) && el.dataset.fitGpu === input.gpuId;
      const fits = Number.isFinite(vram) && vram + 0.05 >= needed;
      if (fits) anyFit = true;
      el.hidden = !(selected || fits);
    });
    document.querySelector('[data-fit-none]')?.classList.toggle('hidden', anyFit);

    document.querySelectorAll<HTMLButtonElement>('[data-stack]').forEach((btn) => {
      const on =
        (btn.dataset.stack === 'daily' && input.modelId === 'qwen36' && input.quantId === 'q5_k_m' && input.gpuId === 'r9700') ||
        (btn.dataset.stack === 'fast' && input.modelId === 'flash' && input.quantId === 'q6_k') ||
        (btn.dataset.stack === 'custom' && input.modelId === 'custom');
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-pressed', String(on));
    });
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
      const on = btn.dataset.view === input.view;
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-selected', String(on));
    });

    const live = document.getElementById('calc-live');
    if (live) {
      if (input.view === 'speed') {
        live.textContent = result.speed.offered
          ? `Decode speed floor ${formatTokS(result.speed.tokS)} tokens per second, estimate.`
          : 'Decode speed floor not offered for this setup.';
      } else if (input.view === 'gpu') {
        live.textContent = `GPU view updated for ${input.vramGb} GB VRAM.`;
      } else {
        live.textContent = `${result.verdictLabel}. Total ${formatGiB(result.totalGiB)} GiB, ${result.tested ? 'tested on our rig' : 'estimate'}.`;
      }
    }
  }

  function sync(next: CalcInput) {
    input = next;
    writeForm();
    render();
  }

  form.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.name === 'gguf') return;
    if (target.name === 'gpuId') {
      sync(applyGpuPreset(target.value as GpuId, readForm()));
      return;
    }
    if (target.name === 'modelId') {
      sync(applyModelPreset(target.value as ModelId, { ...readForm(), fileWeightGiB: null }));
      return;
    }
    if (target.name === 'context') {
      field<HTMLInputElement>('contextNum').value = target.value;
    }
    if (target.name === 'contextNum') {
      field<HTMLInputElement>('context').value = String(Math.min(524288, Number(target.value)));
    }
    input = readForm();
    writeForm();
    render();
  });

  form.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.name === 'gguf') return;
    input = readForm();
    render();
  });

  document.getElementById('gpu-detect')?.addEventListener('input', (event) => {
    const text = (event.target as HTMLTextAreaElement).value;
    const hit = detectPrimary(text);
    const status = document.querySelector('[data-detect-status]');
    if (!hit) {
      if (status) status.textContent = text.trim() ? 'No marketing name or gfx ID matched.' : '';
      return;
    }
    if (status) status.textContent = `${hit.reason} → ${hit.name}`;
    if (hit.confidence === 'name') {
      sync(applyGpuPreset(hit.id as GpuId, readForm()));
    }
  });

  field<HTMLInputElement>('gguf').addEventListener('change', async () => {
    const file = field<HTMLInputElement>('gguf').files?.[0];
    const status = document.querySelector('[data-gguf-status]');
    if (!file) return;
    const slice = await file.slice(0, 2_000_000).arrayBuffer();
    const parsed = parseGgufHeader(slice, file.size);
    if (!parsed.ok) {
      if (status) status.textContent = parsed.error;
      return;
    }
    if (status) status.textContent = `Read ${parsed.meta.name} (${parsed.meta.architecture || 'unknown arch'}). File stays local.`;
    const billions = ggufToBillions(parsed.meta.parameterCount);
    sync({
      ...applyModelPreset('custom', readForm()),
      fileWeightGiB: decimalGbToGiB(file.size / 1e9),
      totalParamsB: billions ?? input.totalParamsB,
      layers: parsed.meta.layers ?? input.layers,
      kvLayers: parsed.meta.layers ?? input.kvLayers,
      kvHeads: parsed.meta.kvHeads ?? input.kvHeads,
      headDim: parsed.meta.headDim ?? input.headDim,
      embedHidden: parsed.meta.embedHidden ?? input.embedHidden,
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-ctx]').forEach((btn) => {
    btn.addEventListener('click', () => {
      input = { ...readForm(), context: Number(btn.dataset.ctx) };
      writeForm();
      render();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-stack]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const stack = btn.dataset.stack;
      if (stack === 'daily') {
        sync(applyModelPreset('qwen36', applyGpuPreset('r9700', { ...DEFAULT_INPUT, gpuCount: 1, split: false, ramGb: 256 })));
      } else if (stack === 'fast') {
        sync(applyModelPreset('flash', applyGpuPreset('r9700', { ...DEFAULT_INPUT, gpuCount: 1, split: false, ramGb: 256 })));
      } else {
        sync(applyModelPreset('custom', { ...DEFAULT_INPUT, modelId: 'custom' }));
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
    btn.addEventListener('click', () => {
      input = { ...readForm(), view: (btn.dataset.view || 'model') as CalcView };
      writeForm();
      render();
    });
  });

  shareBtn?.addEventListener('click', async () => {
    const url = `${window.location.origin}${window.location.pathname}?${shareQuery()}`;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      window.prompt('Copy this share link', url);
    }
    const status = document.querySelector('[data-share-status]');
    if (status) {
      status.removeAttribute('hidden');
      window.setTimeout(() => status.setAttribute('hidden', ''), 2000);
    }
  });

  exportBtn?.addEventListener('click', () => {
    const blob = new Blob([exportEstimate(input, applyMeasuredSystemRam(compute(input), measuredRam, input))], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'amdai-calculator-estimate.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  function readAsk(): AskState {
    const p = document.querySelector<HTMLInputElement>('input[name="priority"]:checked')?.value;
    const u = document.querySelector<HTMLInputElement>('input[name="usage"]:checked')?.value;
    const s = document.querySelector<HTMLInputElement>('input[name="style"]:checked')?.value;
    const min = document.querySelector<HTMLInputElement>('input[name="minbudget"]:checked')?.value === '1';
    const expandRaw = document.querySelector<HTMLInputElement>('input[name="expandgpu"]:checked')?.value;
    return {
      priority: p === 'size' ? 'size' : 'speed',
      usage: u === 'hybrid' ? 'hybrid' : 'local',
      style: s === 'abliterated' ? 'abliterated' : 'standard',
      minBudget: min,
      expandGpu: expandRaw == null ? !min : expandRaw === '1',
      bigModels: document.querySelector<HTMLInputElement>('input[name="bigmodels"]:checked')?.value === '1',
      cpuWork: document.querySelector<HTMLInputElement>('input[name="cpuwork"]:checked')?.value === '1',
      coldLoad: document.querySelector<HTMLInputElement>('input[name="coldload"]:checked')?.value === '1',
    };
  }

  document.querySelectorAll<HTMLInputElement>('input[name="priority"], input[name="usage"], input[name="style"], input[name="minbudget"], input[name="expandgpu"], input[name="bigmodels"], input[name="cpuwork"], input[name="coldload"]').forEach((el) => {
    el.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'minbudget') {
        const want = target.value === '1' ? '0' : '1';
        document.querySelectorAll<HTMLInputElement>('input[name="expandgpu"]').forEach((radio) => {
          radio.checked = radio.value === want;
        });
      }
      ask = readAsk();
      writeForm();
      render();
      window.dispatchEvent(new Event('amdai-ask-change'));
    });
  });

  applyBtn?.addEventListener('click', () => {
    if (!pendingApply) return;
    sync(pendingApply);
  });

  if (!window.location.search) {
    input = { ...DEFAULT_INPUT };
    ask = { priority: 'speed', usage: 'local', style: 'standard', minBudget: false, expandGpu: true, bigModels: false, cpuWork: false, coldLoad: false };
  }
  writeForm();
  bindOlderModelPickers();
  render();
  window.dispatchEvent(new Event('amdai-ask-change'));
</script>

<style>
  .field {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
    background: var(--canvas);
    color: var(--ink);
    padding: 0.65rem 0.8rem;
    min-height: 2.75rem;
  }
</style>
