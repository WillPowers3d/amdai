---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HouseRam from '../components/HouseRam.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import { COMPARE_Q3 } from '../lib/local-desktop-compare';
import {
  FA_AB,
  FA_BACKENDS,
  FA_BENCH,
  FA_CITED_LABEL,
  FA_DESCRIPTION,
  FA_HUB_LINKS,
  FA_KV,
  FA_LEAD,
  FA_PREFILL_AB,
  FA_QUANTS,
  FA_RAM,
  FA_SERVER,
  FA_SOURCES,
  FA_STEPS,
  FA_TITLE,
  FA_TRADEOFF,
  FA_WHAT,
} from '../lib/flash-attention';
---

<Base title={FA_TITLE} description={FA_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{FA_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
      Flash Attention (-fa) on a Radeon GPU with llama.cpp
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{FA_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {FA_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="linux" title="Overnight -fa 1 is llama-bench">
      <p>
        House 35B Vulkan cards recorded <code>-fa 1</code> on llama-bench, not
        llama-server. Server FA on versus off stays {FA_AB} — open the planner.
        The {FA_PREFILL_AB} includes FA among the prefill knobs.
      </p>
    </Callout>

    <section id="what" class="mt-12 scroll-mt-28" aria-labelledby="what-heading">
      <h2 id="what-heading" class="font-serif text-3xl tracking-tight">What -fa does</h2>
      <p class="mt-3 leading-relaxed text-muted">{FA_WHAT}</p>
    </section>

    <section id="kv" class="mt-12 scroll-mt-28" aria-labelledby="kv-heading">
      <h2 id="kv-heading" class="font-serif text-3xl tracking-tight">KV type and quantized V</h2>
      <p class="mt-3 leading-relaxed text-muted">{FA_KV}</p>
    </section>

    <section id="backends" class="mt-12 scroll-mt-28" aria-labelledby="backends-heading">
      <h2 id="backends-heading" class="font-serif text-3xl tracking-tight">Vulkan first, HIP second</h2>
      <p class="mt-3 leading-relaxed text-muted">{FA_BACKENDS}</p>
    </section>

    <section id="tradeoff" class="mt-12 scroll-mt-28" aria-labelledby="tradeoff-heading">
      <h2 id="tradeoff-heading" class="font-serif text-3xl tracking-tight">What we have measured</h2>
      <p class="mt-3 leading-relaxed text-muted">{FA_TRADEOFF}</p>
    </section>

    <section id="flags" class="mt-12 scroll-mt-28" aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-serif text-3xl tracking-tight">Cited flags</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Vulkan house path. The bench line is recorded. The server block is a
        copy-paste that matches the house recipe — not a measured FA on/off
        card. Replace the binary and GGUF paths.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{FA_BENCH.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{FA_SERVER.trim()}</code></pre>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">Q6 / Q5 / Q4 plus a labeled Q3</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Flash attention is a kernel, not a smaller GGUF. House recipes stay Q4
        and up. {COMPARE_Q3} is a labeled estimate — do not download it to run.
      </p>
      <ul class="mt-4 space-y-3">
        {FA_QUANTS.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">
              {row.quant}
              {row.estimate ? ' · labeled estimate' : ''}
            </p>
            <p class="mt-1 text-sm text-muted">{row.file}. {row.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to a measured FA pin</h2>
      <ol class="mt-8 space-y-6">
        {FA_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {FA_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (Ubuntu-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">{FA_RAM}</p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        {FA_AB} and {FA_PREFILL_AB} are the A/Bs. They are not allowlisted deep
        links on this site. Use the planner. Packages are not published yet
        and there is no public download.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {FA_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
            {source.official ? '' : ' — unofficial for llama.cpp'}
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/flash-attention" />
  </main>
</Base>
