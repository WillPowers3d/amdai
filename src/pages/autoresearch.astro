---
import Base from '../layouts/Base.astro';
import HowWeTest from '../components/HowWeTest.astro';
import { SHANNON_CITED_LABEL, loadShannonLab, shannonIdea } from '../lib/shannon-lab';

const file = loadShannonLab();
const loop = shannonIdea('autoresearch');
const thermite = shannonIdea('thermite');
const vii = shannonIdea('radeon-vii');
---

<Base
  title="Autoresearch idea"
  description="Cited idea for amdai-bench — container per GPU, automatic experiments, Prometheus/Grafana, bot steering. Thermite is not a public repo here. Not measured by AMDai."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SHANNON_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Autoresearch idea</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      {loop?.body}
    </p>
    <p class="mt-3 text-sm text-faint">
      Cited from
      <a class="underline decoration-accent/40" href={file.article.href} rel="noopener">{file.article.title}</a>.
      House schema stays
      <a class="underline decoration-accent/40" href="/amdai-bench">amdai-bench/run@1</a>.
      llama.cpp first. Q3 is a labeled estimate unless a card is measured. Nothing below Q3.
    </p>

    <section class="mt-10" aria-labelledby="shape-heading">
      <h2 id="shape-heading" class="font-serif text-3xl tracking-tight">Cited shape</h2>
      <ol class="mt-6 space-y-4">
        <li class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">One container per GPU</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Isolate the experiment so two cards do not share a process unless the run is a split on purpose.
            House multi-GPU notes stay on
            <a class="underline decoration-accent/40" href="/multi-gpu">/multi-gpu</a>.
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Automatic experiment</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Sweep engine or runtime knobs, then write an
            <code class="font-mono text-ink">amdai-bench/run@1</code> line with the exact launch command.
            Do not invent tok/s.
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Prometheus / Grafana results</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Shannon’s write-up names Prometheus and Grafana for the result stream. We have not
            shipped those dashboards on AMDai. Empty cells stay empty.
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Bot steering</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            A bot picks the next experiment. That is his layout. A house overnight loop, when we
            have one, still has to pass the same
            <a class="underline decoration-accent/40" href="/methodology">how we test</a> rules.
          </p>
        </li>
      </ol>
    </section>

    <section id="thermite" class="mt-12 scroll-mt-28" aria-labelledby="thermite-heading">
      <h2 id="thermite-heading" class="font-serif text-3xl tracking-tight">Thermite</h2>
      <p class="mt-4 leading-relaxed text-muted">{thermite?.body}</p>
    </section>

    <section id="radeon-vii" class="mt-12 scroll-mt-28" aria-labelledby="vii-heading">
      <h2 id="vii-heading" class="font-serif text-3xl tracking-tight">Radeon VII note</h2>
      <p class="mt-4 leading-relaxed text-muted">{vii?.body}</p>
      <p class="mt-3 text-sm text-muted">
        Cheap-card context:
        <a class="underline decoration-accent/40" href="/hardware#old-cheap-amd">/hardware</a>.
        NVIDIA P100 cite stays on
        <a class="underline decoration-accent/40" href="/labs/shannon#p100-context">Shannon’s lab</a>
        — not a Radeon table.
      </p>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
  </main>
</Base>
