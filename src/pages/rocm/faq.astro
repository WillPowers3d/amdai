---
import RocmGuide from '../../layouts/RocmGuide.astro';
import Callout from '../../components/Callout.astro';
import Sources from '../../components/rocm/Sources.astro';
import type { CiteKey } from '../../lib/rocm-guide';
import { ROCM_FAQ, ROCM_MISCONCEPTIONS } from '../../lib/rocm-faq';

const used = [
  'rocmHome',
  'hipWhat',
  'rocm101Notes',
  'rocm10Notes',
  'rocm101Blog',
  'rocmCli',
  'hsaOverride2353',
  'productR9700',
  'llamaCpp',
] as const satisfies readonly CiteKey[];

const headings = [
  { depth: 2, slug: 'misconceptions', text: 'Common misconceptions' },
  { depth: 2, slug: 'faq', text: 'FAQ' },
];
---

<RocmGuide page="faq" headings={headings}>
  <p>
    Site-wide newcomer FAQ: <a href="/faq">/faq</a>. This page is ROCm-specific — what people
    get wrong, then short answers with cites.
  </p>

  <h2 id="misconceptions">Common misconceptions</h2>
  {ROCM_MISCONCEPTIONS.map((item) => (
    <section aria-labelledby={item.id}>
      <h3 id={item.id}>{item.question}</h3>
      <p>{item.answer}</p>
    </section>
  ))}

  <h2 id="faq">FAQ</h2>
  {ROCM_FAQ.map((item) => (
    <section aria-labelledby={item.id}>
      <h3 id={item.id}>{item.question}</h3>
      <p>{item.answer}</p>
    </section>
  ))}

  <Callout type="check">
    Unsure whether a claim is official? Check the
    <a href="https://rocm.docs.amd.com/en/docs-10.1.0/about/release-notes.html">10.1.0 notes</a>
    and the <a href="/gpus">GPU directory</a>. If we do not have a source, we write not recorded — we do
    not invent a version.
  </Callout>

  <Sources used={used} />
</RocmGuide>
