const headings = [
  { depth: 2, slug: 'picture', text: 'The picture' },
  { depth: 2, slug: 'kernel', text: 'Kernel driver: amdgpu and KFD' },
  { depth: 2, slug: 'rocr', text: 'ROCr runtime' },
  { depth: 2, slug: 'hip', text: 'HIP' },
