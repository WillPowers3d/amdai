---
import RocmGuide from '../../layouts/RocmGuide.astro';
import Sources from '../../components/rocm/Sources.astro';
import type { CiteKey } from '../../lib/rocm-guide';
import { ROCM_GLOSSARY, ROCM_GLOSSARY_GROUPS } from '../../lib/rocm-glossary';

const used = [
  'rocmHome',
  'hipWhat',
  'rocr',
  'amdgpuKernel',
  'hipRtc',
  'rocblas',
  'hipblaslt',
  'miopen',
  'rccl',
  'rocwmma',
  'ck',
  'rocm101Notes',
  'rocm101Blog',
  'theRock',
  'rocmCli',
  'hsaOverride2353',
  'llamaCpp',
] as const satisfies readonly CiteKey[];

const headings = ROCM_GLOSSARY_GROUPS.map((group) => ({
  depth: 2,
  slug: group.id,
  text: group.heading,
}));
---

<RocmGuide page="glossary" headings={headings}>
  <p>
    Short definitions. If a word has an official AMD sentence, that is cited. Site jargon is
    labeled as ours. Consumer jargon for the rest of the site lives in the
    <a href="/glossary">AMDai glossary</a>.
  </p>

  {ROCM_GLOSSARY_GROUPS.map((group) => (
    <section aria-labelledby={group.id}>
      <h2 id={group.id}>{group.heading}</h2>
      <dl>
        {ROCM_GLOSSARY.filter((term) => term.group === group.id).map((term) => (
          <>
            <dt id={term.id}>{term.term}</dt>
            <dd>{term.definition}</dd>
          </>
        ))}
      </dl>
    </section>
  ))}

  <Sources used={used} />
</RocmGuide>
