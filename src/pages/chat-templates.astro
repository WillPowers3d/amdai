---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HouseRam from '../components/HouseRam.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import { COMPARE_Q3 } from '../lib/local-desktop-compare';
import {
  CT_APPLY,
  CT_CITED_LABEL,
  CT_DESCRIPTION,
  CT_FLAGS,
  CT_H1,
  CT_HARNESS,
  CT_HOUSE,
  CT_HUB_LINKS,
  CT_KWARGS,
  CT_LEAD,
  CT_MODELS,
  CT_PICK,
  CT_PROPS,
  CT_QUANTS,
  CT_RAM,
  CT_SOURCES,
  CT_STEPS,
  CT_SYMPTOMS,
  CT_TITLE,
  CT_UNMEASURED,
  CT_WHAT,
} from '../lib/chat-templates';
---

<Base title={CT_TITLE} description={CT_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{CT_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
      {CT_H1}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{CT_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {CT_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="linux" title="House recipes pass --jinja">
      <p>
        Official llama-server default is enabled. The house pin still passes
        <code>--jinja</code> and does not record <code>--chat-template</code>
        or <code>--chat-template-file</code>. Template quality stays {CT_UNMEASURED}.
        Inspect <code>GET /props</code> before you override.
      </p>
    </Callout>

    <section id="what" class="mt-12 scroll-mt-28" aria-labelledby="what-heading">
      <h2 id="what-heading" class="font-serif text-3xl tracking-tight">What a chat template is</h2>
      <p class="mt-3 leading-relaxed text-muted">{CT_WHAT}</p>
    </section>

    <section id="flags" class="mt-12 scroll-mt-28" aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-serif text-3xl tracking-tight">How llama-server picks it</h2>
      <p class="mt-3 leading-relaxed text-muted">{CT_PICK}</p>
      <ul class="mt-4 space-y-3">
        {CT_FLAGS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">{row.flag}</p>
            <p class="mt-2 text-sm text-ink">{row.meaning}</p>
            <p class="mt-2 text-sm text-muted">{row.cite}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="symptoms" class="mt-12 scroll-mt-28" aria-labelledby="symptoms-heading">
      <h2 id="symptoms-heading" class="font-serif text-3xl tracking-tight">Symptom to fix</h2>
      <ul class="mt-4 space-y-3">
        {CT_SYMPTOMS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-serif text-xl tracking-tight">{row.symptom}</p>
            <p class="mt-2 text-sm text-ink">{row.fix}</p>
            <p class="mt-2 text-sm text-muted">{row.cite}</p>
            <p class="mt-3">
              <a class="underline decoration-accent/40" href={row.href}>{row.label}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="harnesses" class="mt-12 scroll-mt-28" aria-labelledby="harnesses-heading">
      <h2 id="harnesses-heading" class="font-serif text-3xl tracking-tight">How harnesses hit it</h2>
      <p class="mt-3 leading-relaxed text-muted">{CT_HARNESS}</p>
    </section>

    <section id="models" class="mt-12 scroll-mt-28" aria-labelledby="models-heading">
      <h2 id="models-heading" class="font-serif text-3xl tracking-tight">House models — card notes only</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Only official cards already on /models. If a card is not quoted for a
        Jinja string, this page says so.
      </p>
      <ul class="mt-4 space-y-3">
        {CT_MODELS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">
              {row.model}
              {row.card ? ' · cited card' : ''}
            </p>
            <p class="mt-2 text-sm text-muted">{row.note}</p>
            <p class="mt-3">
              <a class="underline decoration-accent/40" href={row.href}>{row.model}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="commands" class="mt-12 scroll-mt-28" aria-labelledby="commands-heading">
      <h2 id="commands-heading" class="font-serif text-3xl tracking-tight">Cited house pin and inspect commands</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Vulkan house path. The first block is the recorded llama-server line
        with <code>--jinja</code>. The rest are official inspect shapes, not
        local desktop pins. Replace the binary and GGUF paths.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CT_HOUSE.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CT_PROPS.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CT_APPLY.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CT_KWARGS.trim()}</code></pre>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">Q6 / Q5 / Q4 plus a labeled Q3</h2>
      <p class="mt-3 leading-relaxed text-muted">
        A template is not a smaller GGUF. House recipes stay Q4 and up.
        {COMPARE_Q3} is a labeled estimate — do not download it to run. Both
        RAM lines appear.
      </p>
      <ul class="mt-4 space-y-3">
        {CT_QUANTS.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">
              {row.quant}
              {row.estimate ? ' · labeled estimate' : ''}
            </p>
            <p class="mt-1 text-sm text-muted">{row.file}</p>
            <p class="mt-2 text-sm text-ink">Template quality: {row.template}</p>
            <p class="mt-1 text-sm text-muted">{row.ramMin}</p>
            <p class="mt-1 text-sm text-muted">{row.ramFull}</p>
            <p class="mt-2 text-sm text-muted">{row.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to a cited template pin</h2>
      <ol class="mt-8 space-y-6">
        {CT_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {CT_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (Ubuntu-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">{CT_RAM}</p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        There is no Stack Lab chat-template pack id on this site. Use the
        planner. Packages are not published yet and there is no public download.
        Anything unmeasured stays {CT_UNMEASURED}.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {CT_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
            {source.official ? '' : ' — unofficial for llama.cpp'}
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/chat-templates" />
  </main>
</Base>
