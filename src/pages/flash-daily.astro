---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import OvernightRows from '../components/OvernightRows.astro';
import SystemRamNeed from '../components/SystemRamNeed.astro';
import { officialLinks } from '../lib/site';
import { formatLinuxGb, flashRamTable, NOT_MEASURED_ON_local-desktop } from '../lib/flash-daily';
import { flashDaily as file } from '../lib/flash-daily-data';
import { FLASH_RERUN_NOTE, flashQ3FromRuns, formatTokCell } from '../lib/run-card';
import { runs } from '../lib/run-card-data';

const q6 = file.measured_q6_two_cards;
const ramRows = flashRamTable(file);
const twoCard = ramRows.filter((row) => row.cards === 2);
const oneCard = ramRows.filter((row) => row.cards === 1);
const flashQ3 = flashQ3FromRuns(runs);
const flashQ3Cell = flashQ3
  ? `${formatTokCell(flashQ3.results.decode_tps)} · measured`
  : null;
---

<Base
  title="Qwen 3.8 Flash as a daily driver"
  description="VRAM plus DDR5 offload for Flash Q3–Q6 at full 262K on one or two R9700s. Measured Q6 speeds; Q3/Q5 RAM is file size plus KV math."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">{file.host} · {file.as_of}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Flash as a daily driver</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      {file.model} ({file.official}) from {file.gguf}.
      Full context {file.full_context.toLocaleString()} tokens.
      RAM is Linux GiB labeled GB, against a {file.kit.dimm_gb} GB kit (about {file.kit.usable_gb} usable).
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href="/flash-ram-offload">Flash RAM offload</a>
      <a class="btn-secondary" href="/backends/strata">Strata deep dive</a>
      <a class="btn-ghost" href="/calculator?model=flash&quant=q6_k&ctx=262144&n=2&split=1">Open in calculator</a>
      <a class="btn-ghost" href="/models/flash">Flash model page</a>
      <a class="btn-ghost" href="/qwen">Qwen compare</a>
      <a class="btn-ghost" href="/qwen36-dual">35B on two cards</a>
      <a class="btn-ghost" href="/multi-gpu">Dual / multi-GPU</a>
      <a class="btn-ghost" href={officialLinks.qwenFlashGguf}>Unsloth GGUF</a>
    </div>

    <Callout type="warn" title="Flash / Strata / Q3 pending">
      <p>{FLASH_RERUN_NOTE} Figures on this page are the earlier first-party Flash Q6 set, not the 2026-10-13 35B drop.</p>
    </Callout>

    <Callout type="check" title="Measured Q6 on two cards">
      <p>
        UD-Q6_K_XL, two R9700s, 262K. Strata <strong class="text-ink">{q6.strata_8k_tok_s} tok/s</strong> at 8K and 32K,
        <strong class="text-ink">{q6.strata_100k_tok_s} tok/s</strong> at 100K.
        llama.cpp at DDR5-5200 is <strong class="text-ink">{q6.llamacpp_ddr5_5200.join(' / ')}</strong> tok/s
        at those three contexts; at DDR5-3600 it is <strong class="text-ink">{q6.llamacpp_ddr5_3600.join(' / ')}</strong>.
        {file.label}.
      </p>
    </Callout>

    <section id="ddr5" class="mt-12 scroll-mt-28" aria-labelledby="ddr5-heading">
      <p class="kicker">Visible factor</p>
      <h2 id="ddr5-heading" class="mt-2 font-serif text-3xl">DDR5 speed moves Flash</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Same two-card Q6, same 262K. Only the DIMM clock changes for the llama.cpp pair.
        Strata prefill at 5200 is the unexplained regression.
      </p>
      <div class="card mt-6 overflow-x-auto">
        <table class="table-lab min-w-[40rem]">
          <thead>
            <tr>
              <th>Engine</th>
              <th>DDR5</th>
              <th>8K</th>
              <th>32K</th>
              <th>100K</th>
              <th>Trust</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-medium">Strata v0.1.42</td>
              <td>5200</td>
              <td class="tabular-nums">{q6.strata_8k_tok_s} tok/s</td>
              <td class="tabular-nums">{q6.strata_32k_tok_s} tok/s</td>
              <td class="tabular-nums">{q6.strata_100k_tok_s} tok/s</td>
              <td><span class="badge-tested">{file.label}</span></td>
            </tr>
            <tr>
              <td class="font-medium">llama.cpp</td>
              <td>5200</td>
              <td class="tabular-nums">{q6.llamacpp_ddr5_5200[0]} tok/s</td>
              <td class="tabular-nums">{q6.llamacpp_ddr5_5200[1]} tok/s</td>
              <td class="tabular-nums">{q6.llamacpp_ddr5_5200[2]} tok/s</td>
              <td><span class="badge-tested">{file.label}</span></td>
            </tr>
            <tr>
              <td class="font-medium">llama.cpp</td>
              <td>3600</td>
              <td class="tabular-nums">{q6.llamacpp_ddr5_3600[0]} tok/s</td>
              <td class="tabular-nums">{q6.llamacpp_ddr5_3600[1]} tok/s</td>
              <td class="tabular-nums">{q6.llamacpp_ddr5_3600[2]} tok/s</td>
              <td><span class="badge-tested">{file.label}</span></td>
            </tr>
            <tr>
              <td class="font-medium">Strata prefill</td>
              <td>5200 vs 3600</td>
              <td colspan="3">{q6.strata_prefill_note}</td>
              <td><span class="badge-tested">{file.label}</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-muted">{q6.prior_first_party}</p>
    </section>

    <section id="ram" class="mt-12 scroll-mt-28" aria-labelledby="ram-heading">
      <p class="kicker">Estimate · file size + KV</p>
      <h2 id="ram-heading" class="mt-2 font-serif text-3xl">VRAM plus DDR5 offload at 262K</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Q3 and Q5 RAM is publisher file size plus KV math — labeled estimate.
        Q4 uses the ~111 GB UD-Q4_K_XL listing. Q6 uses the ~169 GB folder.
        Minimum system RAM and RAM-at-full-context come from the same calculator as
        <a class="underline decoration-accent/40" href="/calculator">/calculator</a>.
        Kit: {file.kit.dimm_gb} GB · about {file.kit.usable_gb} GB usable.
      </p>

      <h3 class="mt-8 font-serif text-2xl">Two R9700s · 64 GB VRAM</h3>
      <p class="mt-2 text-sm text-muted">{file.gpus_two}. Split pool. Every GiB column is an estimate.</p>
      <div class="card mt-4 overflow-x-auto">
        <table class="table-lab min-w-[52rem]">
          <thead>
            <tr>
              <th>Quant</th>
              <th>File</th>
              <th>Weights</th>
              <th>KV · 262K</th>
              <th>Offload</th>
              <th>Min RAM kit</th>
              <th>RAM at 262K</th>
              <th>Decode</th>
            </tr>
          </thead>
          <tbody>
            {twoCard.map((row) => (
              <tr>
                <td class="font-medium">{row.label}</td>
                <td class="tabular-nums">{row.fileGb} GB</td>
                <td class="tabular-nums">{formatLinuxGb(row.weightsGiB)} <span class="text-faint">est.</span></td>
                <td class="tabular-nums">{formatLinuxGb(row.kvGiB)} <span class="text-faint">est.</span></td>
                <td class="tabular-nums">{formatLinuxGb(row.offloadedWeightsGiB)} <span class="text-faint">est.</span></td>
                <td class="tabular-nums">{row.ram.atSelected.kitGb} GB</td>
                <td class="tabular-nums">{row.ram.atFullContext.kitGb} GB</td>
                <td>
                  {row.short === 'Q6' ? (
                    <span>{q6.strata_8k_tok_s} / {q6.strata_100k_tok_s} tok/s · measured</span>
                  ) : row.short === 'Q3' && flashQ3 && flashQ3.hardware.gpu_count_used === 2 && flashQ3Cell ? (
                    <span>{flashQ3Cell}</span>
                  ) : (
                    <span class="text-faint">{NOT_MEASURED_ON_local-desktop}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="mt-10 font-serif text-2xl">One R9700 · 32 GB VRAM</h3>
      <p class="mt-2 text-sm text-muted">{file.gpus_one}. More of the file lands on DDR5. Every GiB column is an estimate.</p>
      <div class="card mt-4 overflow-x-auto">
        <table class="table-lab min-w-[52rem]">
          <thead>
            <tr>
              <th>Quant</th>
              <th>File</th>
              <th>Weights</th>
              <th>KV · 262K</th>
              <th>Offload</th>
              <th>Min RAM kit</th>
              <th>RAM at 262K</th>
              <th>Decode</th>
            </tr>
          </thead>
          <tbody>
            {oneCard.map((row) => (
              <tr>
                <td class="font-medium">{row.label}</td>
                <td class="tabular-nums">{row.fileGb} GB</td>
                <td class="tabular-nums">{formatLinuxGb(row.weightsGiB)} <span class="text-faint">est.</span></td>
                <td class="tabular-nums">{formatLinuxGb(row.kvGiB)} <span class="text-faint">est.</span></td>
                <td class="tabular-nums">{formatLinuxGb(row.offloadedWeightsGiB)} <span class="text-faint">est.</span></td>
                <td class="tabular-nums">{row.ram.atSelected.kitGb} GB</td>
                <td class="tabular-nums">{row.ram.atFullContext.kitGb} GB</td>
                <td>
                  {row.short === 'Q3' && flashQ3 && flashQ3.hardware.gpu_count_used === 1 ? (
                    <span>{flashQ3Cell}</span>
                  ) : (
                    <span class="text-faint">{NOT_MEASURED_ON_local-desktop} at this card count</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-faint">
        Linux GiB labeled GB. Raw host-RAM estimate includes offloaded weights, KV that missed VRAM,
        runtime overhead, 8 GB OS/desktop, and 16 GB headroom, then rounds up to a DIMM kit.
      </p>

      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {twoCard.map((row) => (
          <div class="card p-4">
            <p class="kicker">{row.label} · two cards · estimate</p>
            <SystemRamNeed need={row.ram} />
          </div>
        ))}
      </div>
    </section>

    <section id="community" class="mt-12 scroll-mt-28" aria-labelledby="community-heading">
      <p class="kicker">Community · {NOT_MEASURED_ON_local-desktop}</p>
      <h2 id="community-heading" class="mt-2 font-serif text-3xl">Q3 and Q5 speeds we did not run</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Q3 and Q5 decode on this page is only what other people posted.
        IQ3_S is not UD-Q3_K_XL. We do not invent a Q5 tok/s.
      </p>
      <ul class="mt-6 space-y-4">
        {file.community_speeds.map((row) => (
          <li class="card p-5">
            <p class="kicker">{row.quant} · {row.label} · {row.date}</p>
            <p class="mt-2 text-sm text-muted">{row.note}</p>
            {row.figures ? <p class="mt-2 text-ink">{row.figures}</p> : <p class="mt-2 text-faint">No cited tok/s.</p>}
            <p class="mt-3 text-sm">
              <a class="underline decoration-accent/40" href={row.href}>Source</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <OvernightRows rows={file.overnight_results_json_rows} note={file.overnight_note} />

    <section class="mt-12" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl">Sources</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {file.sources.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href}>{source.title}</a>
            <span class="text-faint"> · {source.date}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
