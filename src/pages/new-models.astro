---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import NextSteps from '../components/NextSteps.astro';
import {
  FIT_VRAM,
  NEW_MODELS_DESCRIPTION,
  NEW_MODELS_FEED,
  NEW_MODELS_H1,
  NEW_MODELS_JSON,
  NEW_MODELS_KICKER,
  NEW_MODELS_PATH,
  NEW_MODELS_TITLE,
  loadNewModelsFile,
  makersOf,
  rowAnchor,
} from '../lib/new-models';

const file = loadNewModelsFile();
const makers = makersOf(file);
const fallback = JSON.stringify(file).replaceAll('<', '\\u003c');
const count = file.days.reduce((n, day) => n + day.models.length, 0);
const asOf = file.as_of ? file.as_of.slice(0, 10) : '';

function paramsLabel(row: (typeof file.days)[number]['models'][number]): string {
  if (row.params_b == null) return 'not listed';
  const active =
    row.active_params_b != null && row.active_params_b !== row.params_b
      ? ` / ${row.active_params_b}B active`
      : '';
  return `${row.params_b}B${active}`;
}
---

<Base title={NEW_MODELS_TITLE} description={NEW_MODELS_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-[96rem] px-4 py-10 sm:px-6">
    <p class="kicker">{NEW_MODELS_KICKER}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{NEW_MODELS_H1}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
      Recently created text-generation and image-text-to-text releases from the public
      Hugging Face Hub API. Known labs plus trending rows. Finetune spam with low
      downloads stays off. GGUF packs are searched on unsloth, bartowski,
      lmstudio-community, and ggml-org. Q3–Q8 only — Q1/Q2 stay off.
      Fit is a labeled Q4_K_M estimate, not a measured card.
    </p>
    <p class="mt-3 text-sm text-muted">
      <span id="nm-asof">{count} models · as of {asOf || 'this build'}.</span>
      The table reads
      <a class="underline decoration-accent/40" href={NEW_MODELS_JSON}>{NEW_MODELS_JSON}</a>
      in the browser so a server cron can refresh it without a rebuild.
      This page ships a static fallback from the last sync.
      Feed:
      <a class="underline decoration-accent/40" href={NEW_MODELS_FEED}>{NEW_MODELS_FEED}</a>.
    </p>
    <p class="mt-4 flex flex-wrap gap-3">
      <a class="btn-secondary" href="/models">House models</a>
      <a class="btn-secondary" href="/calculator">Calculator</a>
      <a class="btn-ghost" href="/quants">Quants</a>
      <a class="btn-ghost" href="/can-run">Can my Radeon run it?</a>
      <a class="btn-ghost" href="/methodology">How we test</a>
    </p>

    <Callout type="note" title="Estimates stay labeled">
      Param counts come from Hub safetensors metadata or config. Q4_K_M GiB is a Hub file
      size when a pack lists one, otherwise params × 4.85 bits. Fit adds 1.5 GiB overhead
      against 16 / 24 / 32 / 2×32 GB. Empty cells stay not listed — we do not invent a model.
    </Callout>

    <section id="table" class="mt-12 scroll-mt-28" aria-labelledby="table-heading">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="kicker">Releases</p>
          <h2 id="table-heading" class="mt-2 font-serif text-3xl">Filter the days</h2>
          <p class="mt-2 max-w-2xl text-sm text-muted">
            Maker, size band, GGUF, and a Radeon VRAM class. Click a column to sort inside
            each day. Without JavaScript the full fallback table stays visible.
          </p>
        </div>
        <p id="nm-count" class="text-sm text-muted" aria-live="polite">{count} rows</p>
      </div>

      <form id="nm-filters" class="mt-6 space-y-4" aria-controls="nm-table">
        <div>
          <label class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint" for="nm-maker">Maker</label>
          <select id="nm-maker" class="field mt-2 max-w-sm" name="maker">
            <option value="">Any maker</option>
            {makers.map((maker) => <option value={maker}>{maker}</option>)}
          </select>
        </div>
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Size band</p>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Size band">
            <button type="button" class="chip is-on" data-filter="band" data-value="" aria-pressed="true">Any</button>
            <button type="button" class="chip" data-filter="band" data-value="<8B" aria-pressed="false">&lt;8B</button>
            <button type="button" class="chip" data-filter="band" data-value="8-20B" aria-pressed="false">8–20B</button>
            <button type="button" class="chip" data-filter="band" data-value="20-40B" aria-pressed="false">20–40B</button>
            <button type="button" class="chip" data-filter="band" data-value="40-80B" aria-pressed="false">40–80B</button>
            <button type="button" class="chip" data-filter="band" data-value="80B+" aria-pressed="false">80B+</button>
          </div>
        </div>
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">GGUF</p>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Has GGUF">
            <button type="button" class="chip is-on" data-filter="gguf" data-value="" aria-pressed="true">Any</button>
            <button type="button" class="chip" data-filter="gguf" data-value="yes" aria-pressed="false">Has GGUF</button>
            <button type="button" class="chip" data-filter="gguf" data-value="no" aria-pressed="false">No GGUF yet</button>
          </div>
        </div>
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Fits my GPU</p>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Fits my GPU">
            <button type="button" class="chip is-on" data-filter="gpu" data-value="" aria-pressed="true">Any</button>
            {Object.keys(FIT_VRAM).map((key) => (
              <button type="button" class="chip" data-filter="gpu" data-value={key} aria-pressed="false">
                {key === '2x32' ? '2×32 GB' : `${key} GB`}
              </button>
            ))}
          </div>
        </div>
        <button type="reset" class="btn-ghost">Clear</button>
      </form>

      <div id="nm-table" class="mt-8 space-y-10">
        {file.days.length === 0 ? (
          <p class="text-sm text-muted">
            No Hub rows in the last 90 days on this build. Run
            <code class="font-mono">node scripts/new-models-sync.mjs</code>
            to seed <code class="font-mono">public/data/new-models.json</code>.
          </p>
        ) : (
          file.days.map((day) => (
            <section data-day={day.date} aria-labelledby={`day-${day.date}`}>
              <h3 id={`day-${day.date}`} class="font-serif text-2xl tracking-tight">{day.date}</h3>
              <div class="mt-3 overflow-x-auto rounded-2xl border border-line">
                <table class="table-lab min-w-[72rem]">
                  <caption class="sr-only">Open-weight releases on {day.date}</caption>
                  <thead>
                    <tr>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="name">Model</button></th>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="maker">Maker</button></th>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="params">Params</button></th>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="arch">Arch</button></th>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="ctx">Ctx</button></th>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="license">License</button></th>
                      <th scope="col">GGUF</th>
                      <th scope="col"><button type="button" class="nm-sort" data-sort="q4">Q4_K_M</button></th>
                      <th scope="col">16</th>
                      <th scope="col">24</th>
                      <th scope="col">32</th>
                      <th scope="col">2×32</th>
                    </tr>
                  </thead>
                  <tbody>
                    {day.models.map((row) => (
                      <tr
                        id={rowAnchor(row.id)}
                        data-id={row.id}
                        data-maker={row.maker}
                        data-band={row.size_band}
                        data-gguf={row.gguf.length ? 'yes' : 'no'}
                        data-fit-16={row.fit['16']}
                        data-fit-24={row.fit['24']}
                        data-fit-32={row.fit['32']}
                        data-fit-2x32={row.fit['2x32']}
                        data-name={row.name}
                        data-params={row.params_b ?? ''}
                        data-arch={row.architecture ?? ''}
                        data-ctx={row.context ?? ''}
                        data-license={row.license ?? ''}
                        data-q4={row.q4_k_m_gib ?? ''}
                      >
                        <th scope="row">
                          <a class="underline decoration-accent/40" href={row.href} rel="noopener">{row.name}</a>
                          <p class="mt-1 text-xs text-faint">{row.modalities.join(' · ')}</p>
                        </th>
                        <td>{row.maker}</td>
                        <td>{paramsLabel(row)}</td>
                        <td class="text-sm">{row.architecture ?? 'not listed'}</td>
                        <td>{row.context != null ? row.context.toLocaleString('en-US') : 'not listed'}</td>
                        <td class="text-sm">{row.license ?? 'not listed'}</td>
                        <td class="text-sm">
                          {row.gguf.length === 0 ? (
                            'none listed'
                          ) : (
                            <ul class="space-y-1">
                              {row.gguf.map((pack) => (
                                <li>
                                  <a class="underline decoration-accent/40" href={pack.href} rel="noopener">{pack.org}</a>
                                  {' · '}
                                  {pack.quants.join(', ')}
                                </li>
                              ))}
                            </ul>
                          )}
                        </td>
                        <td>
                          {row.q4_k_m_gib != null ? `${row.q4_k_m_gib} GiB` : 'unknown'}
                          <span class="block text-xs text-faint">{row.q4_k_m_kind}</span>
                        </td>
                        <td>{row.fit['16']}</td>
                        <td>{row.fit['24']}</td>
                        <td>{row.fit['32']}</td>
                        <td>{row.fit['2x32']}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        )}
      </div>
    </section>
    <NextSteps path={NEW_MODELS_PATH} />
  </main>
  <script type="application/json" id="nm-fallback" set:html={fallback}></script>
</Base>

<script>
  type Fit = 'fits' | 'tight' | 'no' | 'unknown';
  type Row = {
    id: string;
    name: string;
    href: string;
    maker: string;
    released: string;
    params_b: number | null;
    active_params_b: number | null;
    architecture: string | null;
    context: number | null;
    license: string | null;
    modalities: string[];
    gguf: Array<{ org: string; href: string; quants: string[] }>;
    q4_k_m_gib: number | null;
    q4_k_m_kind: string;
    fit: Record<string, Fit>;
    size_band: string;
  };
  type FileShape = { schema?: string; as_of?: string; days: Array<{ date: string; models: Row[] }> };

  const filters = { maker: '', band: '', gguf: '', gpu: '' };
  let sortKey = 'name';
  let sortDir = 1;
  let file: FileShape = { days: [] };

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function rowAnchor(id: string): string {
    return id.replaceAll('/', '--');
  }

  function parseFallback(): FileShape {
    const node = document.getElementById('nm-fallback');
    if (!node?.textContent) return { days: [] };
    try {
      const parsed = JSON.parse(node.textContent) as FileShape;
      return parsed?.days ? parsed : { days: [] };
    } catch {
      return { days: [] };
    }
  }

  function paramsLabel(row: Row): string {
    if (row.params_b == null) return 'not listed';
    const active =
      row.active_params_b != null && row.active_params_b !== row.params_b
        ? ` / ${row.active_params_b}B active`
        : '';
    return `${row.params_b}B${active}`;
  }

  function ggufHtml(row: Row): string {
    if (!row.gguf.length) return 'none listed';
    const items = row.gguf
      .map(
        (pack) =>
          `<li><a class="underline decoration-accent/40" href="${escapeHtml(pack.href)}" rel="noopener">${escapeHtml(pack.org)}</a> · ${escapeHtml(pack.quants.join(', '))}</li>`,
      )
      .join('');
    return `<ul class="space-y-1">${items}</ul>`;
  }

  function sortRows(rows: Row[]): Row[] {
    const key = sortKey;
    const dir = sortDir;
    return rows.slice().sort((a, b) => {
      const av =
        key === 'params' ? a.params_b ?? -1
        : key === 'ctx' ? a.context ?? -1
        : key === 'q4' ? a.q4_k_m_gib ?? -1
        : key === 'maker' ? a.maker
        : key === 'arch' ? a.architecture ?? ''
        : key === 'license' ? a.license ?? ''
        : a.name;
      const bv =
        key === 'params' ? b.params_b ?? -1
        : key === 'ctx' ? b.context ?? -1
        : key === 'q4' ? b.q4_k_m_gib ?? -1
        : key === 'maker' ? b.maker
        : key === 'arch' ? b.architecture ?? ''
        : key === 'license' ? b.license ?? ''
        : b.name;
      if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
      return String(av).localeCompare(String(bv)) * dir || a.id.localeCompare(b.id);
    });
  }

  function rowVisible(row: Row): boolean {
    const gguf = row.gguf.length ? 'yes' : 'no';
    const fit = filters.gpu ? row.fit[filters.gpu] : '';
    return (
      (!filters.maker || row.maker === filters.maker) &&
      (!filters.band || row.size_band === filters.band) &&
      (!filters.gguf || gguf === filters.gguf) &&
      (!filters.gpu || fit === 'fits' || fit === 'tight')
    );
  }

  function render(next: FileShape) {
    file = next;
    const root = document.getElementById('nm-table');
    if (!root) return;
    const maker = document.getElementById('nm-maker') as HTMLSelectElement | null;
    if (maker) {
      const current = maker.value;
      const names = [...new Set(next.days.flatMap((day) => day.models.map((row) => row.maker)))].sort((a, b) =>
        a.localeCompare(b),
      );
      maker.innerHTML = `<option value="">Any maker</option>${names.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join('')}`;
      if (names.includes(current)) maker.value = current;
      else filters.maker = '';
    }
    if (!next.days.length) {
      root.innerHTML =
        '<p class="text-sm text-muted">No Hub rows in the last 90 days on this build. Run <code class="font-mono">node scripts/new-models-sync.mjs</code> to seed <code class="font-mono">public/data/new-models.json</code>.</p>';
      const count = document.getElementById('nm-count');
      if (count) count.textContent = '0 rows';
      return;
    }
    root.innerHTML = next.days
      .map((day) => {
        const rows = sortRows(day.models.filter(rowVisible));
        const body = rows
          .map((row) => {
            const gguf = row.gguf.length ? 'yes' : 'no';
            return `<tr id="${escapeHtml(rowAnchor(row.id))}" data-id="${escapeHtml(row.id)}" data-maker="${escapeHtml(row.maker)}" data-band="${escapeHtml(row.size_band)}" data-gguf="${gguf}" data-fit-16="${row.fit['16']}" data-fit-24="${row.fit['24']}" data-fit-32="${row.fit['32']}" data-fit-2x32="${row.fit['2x32']}">
              <th scope="row"><a class="underline decoration-accent/40" href="${escapeHtml(row.href)}" rel="noopener">${escapeHtml(row.name)}</a><p class="mt-1 text-xs text-faint">${escapeHtml((row.modalities || []).join(' · '))}</p></th>
              <td>${escapeHtml(row.maker)}</td>
              <td>${escapeHtml(paramsLabel(row))}</td>
              <td class="text-sm">${escapeHtml(row.architecture ?? 'not listed')}</td>
              <td>${row.context != null ? escapeHtml(row.context.toLocaleString('en-US')) : 'not listed'}</td>
              <td class="text-sm">${escapeHtml(row.license ?? 'not listed')}</td>
              <td class="text-sm">${ggufHtml(row)}</td>
              <td>${row.q4_k_m_gib != null ? `${row.q4_k_m_gib} GiB` : 'unknown'}<span class="block text-xs text-faint">${escapeHtml(row.q4_k_m_kind)}</span></td>
              <td>${row.fit['16']}</td>
              <td>${row.fit['24']}</td>
              <td>${row.fit['32']}</td>
              <td>${row.fit['2x32']}</td>
            </tr>`;
          })
          .join('');
        return `<section data-day="${escapeHtml(day.date)}" ${rows.length ? '' : 'hidden'} aria-labelledby="day-${escapeHtml(day.date)}">
          <h3 id="day-${escapeHtml(day.date)}" class="font-serif text-2xl tracking-tight">${escapeHtml(day.date)}</h3>
          <div class="mt-3 overflow-x-auto rounded-2xl border border-line">
            <table class="table-lab min-w-[72rem]">
              <caption class="sr-only">Open-weight releases on ${escapeHtml(day.date)}</caption>
              <thead><tr>
                <th scope="col"><button type="button" class="nm-sort" data-sort="name">Model</button></th>
                <th scope="col"><button type="button" class="nm-sort" data-sort="maker">Maker</button></th>
                <th scope="col"><button type="button" class="nm-sort" data-sort="params">Params</button></th>
                <th scope="col"><button type="button" class="nm-sort" data-sort="arch">Arch</button></th>
                <th scope="col"><button type="button" class="nm-sort" data-sort="ctx">Ctx</button></th>
                <th scope="col"><button type="button" class="nm-sort" data-sort="license">License</button></th>
                <th scope="col">GGUF</th>
                <th scope="col"><button type="button" class="nm-sort" data-sort="q4">Q4_K_M</button></th>
                <th scope="col">16</th>
                <th scope="col">24</th>
                <th scope="col">32</th>
                <th scope="col">2×32</th>
              </tr></thead>
              <tbody>${body}</tbody>
            </table>
          </div>
        </section>`;
      })
      .join('');
    bindSort();
    const visible = next.days.reduce((n, day) => n + day.models.filter(rowVisible).length, 0);
    const count = document.getElementById('nm-count');
    if (count) count.textContent = `${visible} rows`;
    const asof = document.getElementById('nm-asof');
    if (asof && next.as_of) {
      const total = next.days.reduce((n, day) => n + day.models.length, 0);
      asof.textContent = `${total} models · as of ${next.as_of.slice(0, 10)}.`;
    }
  }

  function apply() {
    if (file.days.length) render(file);
  }

  function bindChips() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter as keyof typeof filters;
        const value = btn.dataset.value ?? '';
        filters[key] = value;
        document.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]`).forEach((other) => {
          const on = other === btn;
          other.classList.toggle('is-on', on);
          other.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        apply();
      });
    });
    const maker = document.getElementById('nm-maker') as HTMLSelectElement | null;
    maker?.addEventListener('change', () => {
      filters.maker = maker.value;
      apply();
    });
    document.getElementById('nm-filters')?.addEventListener('reset', () => {
      filters.maker = '';
      filters.band = '';
      filters.gguf = '';
      filters.gpu = '';
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
        const on = (btn.dataset.value ?? '') === '';
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      queueMicrotask(apply);
    });
  }

  function bindSort() {
    document.querySelectorAll<HTMLButtonElement>('.nm-sort').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort || 'name';
        if (sortKey === key) sortDir *= -1;
        else {
          sortKey = key;
          sortDir = 1;
        }
        apply();
      });
    });
  }

  async function hydrate() {
    file = parseFallback();
    bindChips();
    bindSort();
    try {
      const res = await fetch('/data/new-models.json', { cache: 'no-store' });
      if (!res.ok) return;
      const live = (await res.json()) as FileShape;
      if (!live?.days) return;
      if (live.as_of && live.as_of === file.as_of) return;
      render(live);
    } catch {
      /* keep static fallback */
    }
  }

  hydrate();
</script>

<style>
  .nm-sort {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-align: left;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0.2rem 0.15rem;
    cursor: pointer;
  }
  .nm-sort:hover,
  .nm-sort:focus-visible {
    color: var(--ink);
  }
</style>
