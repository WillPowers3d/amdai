---
import Base from '../layouts/Base.astro';
import NextSteps from '../components/NextSteps.astro';
import {
  FIT_VRAM,
  NEW_MODELS_DESCRIPTION,
  NEW_MODELS_FEED,
  NEW_MODELS_H1,
  NEW_MODELS_JSON,
  NEW_MODELS_KICKER,
  NEW_MODELS_PATH,
  NEW_MODELS_TITLE,
  loadNewModelsFile,
  makersOf,
  rowAnchor,
} from '../lib/new-models';
import { RUN_ENGINES, engineLabel, engineNote, yesEngineIds } from '../lib/new-model-engines';

const file = loadNewModelsFile();
const makers = makersOf(file);
const fallback = JSON.stringify(file).replaceAll('<', '\\u003c');
const count = file.days.reduce((n, day) => n + day.models.length, 0);
const asOf = file.as_of ? file.as_of.slice(0, 10) : '';
const selected = file.days[0]?.models[0] ?? null;

function paramsLabel(row: (typeof file.days)[number]['models'][number]): string {
  if (row.params_b == null) return 'not listed';
  const active =
    row.active_params_b != null && row.active_params_b !== row.params_b
      ? ` / ${row.active_params_b}B active`
      : '';
  return `${row.params_b}B${active}`;
}

function enginesShort(row: (typeof file.days)[number]['models'][number]): string {
  const ids = yesEngineIds(row.runs_on);
  return ids.length ? ids.map((id) => engineLabel(id)).join(' · ') : 'unknown';
}

function fitClass(verdict: string): string {
  if (verdict === 'fits') return 'is-ok';
  if (verdict === 'tight') return 'is-warn';
  return '';
}
---

<Base title={NEW_MODELS_TITLE} description={NEW_MODELS_DESCRIPTION}>
  <main id="main" class="nm-page mx-auto max-w-[64rem] px-4 py-10 sm:px-6">
    <p class="kicker">{NEW_MODELS_KICKER}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{NEW_MODELS_H1}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
      Recently created text-generation and image-text-to-text releases from the public
      Hugging Face Hub API. Known labs plus trending rows. Finetune spam with low
      downloads stays off. GGUF packs are searched on unsloth, bartowski,
      lmstudio-community, and ggml-org. Q3–Q8 only — Q1/Q2 stay off.
      Fit is a labeled Q4_K_M estimate, not a measured card.
      Runs on is evidence-only: llama.cpp convert arch or a listed GGUF pack,
      vLLM’s supported-architectures list, Ollama library slugs, Strata’s
      Qwen 3.8 Flash notes on /backends, and SGLang architecture names when
      listed. LM Studio and Lemonade follow GGUF as llama.cpp wrappers.
      Empty stays unknown. MLX is off — not a Radeon path.
    </p>
    <p class="mt-3 text-sm text-muted">
      <span id="nm-asof">{count} models · as of {asOf || 'this build'}.</span>
      The table reads
      <a class="underline decoration-accent/40" href={NEW_MODELS_JSON}>{NEW_MODELS_JSON}</a>
      in the browser so a server cron can refresh it without a rebuild.
      This page ships a static fallback from the last sync.
      Feed:
      <a class="underline decoration-accent/40" href={NEW_MODELS_FEED}>{NEW_MODELS_FEED}</a>.
    </p>
    <p class="mt-5 flex flex-wrap gap-3">
      <a class="btn-primary" href="/calculator">Open calculator</a>
      <a class="btn-secondary" href="/models">House models</a>
      <a class="btn-ghost" href="/quants">Quants</a>
      <a class="btn-ghost" href="/can-run">Can my Radeon run it?</a>
      <a class="btn-ghost" href="/methodology">How we test</a>
    </p>

    <div class="nm-stack mt-10" id="table">
      <section class="nm-card" aria-labelledby="table-heading">
        <div class="nm-card-head">
          <div>
            <p class="kicker">Filter</p>
            <h2 id="table-heading" class="nm-card-title">The last 90 days</h2>
          </div>
          <p id="nm-count" class="text-sm text-muted" aria-live="polite">{count} rows</p>
        </div>
        <p class="mt-2 text-sm text-muted">
          Newest release first, grouped by day. Click a column to sort inside each day.
          Select a row for the detail card. Without JavaScript the fallback table stays visible.
        </p>

        <form id="nm-filters" class="nm-filters" aria-controls="nm-table">
          <div class="nm-field">
            <label class="nm-label" for="nm-maker">Maker</label>
            <select id="nm-maker" class="field" name="maker">
              <option value="">Any maker</option>
              {makers.map((maker) => <option value={maker}>{maker}</option>)}
            </select>
          </div>

          <div class="nm-field">
            <p class="nm-label" id="nm-band-label">Size band</p>
            <div class="nm-tabs" role="group" aria-labelledby="nm-band-label">
              <button type="button" class="nm-tab is-on" data-filter="band" data-value="" aria-pressed="true">Any</button>
              <button type="button" class="nm-tab" data-filter="band" data-value="<8B" aria-pressed="false">&lt;8B</button>
              <button type="button" class="nm-tab" data-filter="band" data-value="8-20B" aria-pressed="false">8–20B</button>
              <button type="button" class="nm-tab" data-filter="band" data-value="20-40B" aria-pressed="false">20–40B</button>
              <button type="button" class="nm-tab" data-filter="band" data-value="40-80B" aria-pressed="false">40–80B</button>
              <button type="button" class="nm-tab" data-filter="band" data-value="80B+" aria-pressed="false">80B+</button>
            </div>
          </div>

          <div class="nm-pair">
            <div class="nm-field">
              <p class="nm-label" id="nm-gguf-label">GGUF</p>
              <div class="nm-tabs" role="group" aria-labelledby="nm-gguf-label">
                <button type="button" class="nm-tab is-on" data-filter="gguf" data-value="" aria-pressed="true">Any</button>
                <button type="button" class="nm-tab" data-filter="gguf" data-value="yes" aria-pressed="false">Has GGUF</button>
                <button type="button" class="nm-tab" data-filter="gguf" data-value="no" aria-pressed="false">No GGUF yet</button>
              </div>
            </div>
            <div class="nm-field">
              <p class="nm-label" id="nm-gpu-label">Fits my GPU</p>
              <div class="nm-tabs" role="group" aria-labelledby="nm-gpu-label">
                <button type="button" class="nm-tab is-on" data-filter="gpu" data-value="" aria-pressed="true">Any</button>
                {Object.keys(FIT_VRAM).map((key) => (
                  <button type="button" class="nm-tab" data-filter="gpu" data-value={key} aria-pressed="false">
                    {key === '2x32' ? '2×32 GB' : `${key} GB`}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="nm-field">
            <p class="nm-label" id="nm-engine-label">Runs on</p>
            <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="nm-engine-label">
              <button type="button" class="chip is-on" data-filter="engine" data-value="" aria-pressed="true">Any</button>
              {RUN_ENGINES.map((engine) => (
                <button type="button" class="chip" data-filter="engine" data-value={engine.id} aria-pressed="false">
                  {engine.label}
                </button>
              ))}
            </div>
          </div>

          <p class="nm-actions"><button type="reset" class="btn-ghost">Clear</button></p>
          <p class="nm-estimate">
            Estimate — not a measured card. Param counts come from Hub safetensors or config.
            Q4_K_M GiB is a Hub file size when a pack lists one, otherwise params × 4.85 bits.
            Fit adds 1.5 GiB overhead against 16 / 24 / 32 / 2×32 GB. Empty cells stay not listed.
          </p>
        </form>
      </section>

      <section class="nm-card nm-table-card" aria-labelledby="nm-results-heading">
        <div class="nm-card-head">
          <div>
            <p class="kicker">Releases</p>
            <h2 id="nm-results-heading" class="nm-card-title">Newest first</h2>
          </div>
        </div>
        <div id="nm-table" class="nm-table-wrap">
          {file.days.length === 0 ? (
            <p class="text-sm text-muted">
              No Hub rows in the last 90 days on this build. Run
              <code class="font-mono">node scripts/new-models-sync.mjs</code>
              to seed <code class="font-mono">public/data/new-models.json</code>.
            </p>
          ) : (
            <table class="table-lab nm-table">
              <caption class="sr-only">Open-weight releases, newest day first</caption>
              <thead>
                <tr>
                  <th scope="col" aria-sort="descending">
                    <button type="button" class="nm-sort is-on" data-sort="released">Released</button>
                  </th>
                  <th scope="col"><button type="button" class="nm-sort" data-sort="name">Model</button></th>
                  <th scope="col"><button type="button" class="nm-sort" data-sort="maker">Maker</button></th>
                  <th scope="col"><button type="button" class="nm-sort" data-sort="params">Params</button></th>
                  <th scope="col"><button type="button" class="nm-sort" data-sort="runs">Runs on</button></th>
                  <th scope="col">GGUF</th>
                  <th scope="col"><button type="button" class="nm-sort" data-sort="q4">Q4_K_M</button></th>
                  <th scope="col">16</th>
                  <th scope="col">24</th>
                  <th scope="col">32</th>
                  <th scope="col">2×32</th>
                </tr>
              </thead>
              <tbody>
                {file.days.map((day) => (
                  <>
                    <tr class="nm-day" data-day={day.date}>
                      <th scope="rowgroup" colspan="11">{day.date}</th>
                    </tr>
                    {day.models.map((row) => (
                      <tr
                        id={rowAnchor(row.id)}
                        class:list={['nm-row', selected?.id === row.id && 'is-on']}
                        data-id={row.id}
                        data-maker={row.maker}
                        data-band={row.size_band}
                        data-gguf={row.gguf.length ? 'yes' : 'no'}
                        data-engines={yesEngineIds(row.runs_on).join(' ')}
                        data-fit-16={row.fit['16']}
                        data-fit-24={row.fit['24']}
                        data-fit-32={row.fit['32']}
                        data-fit-2x32={row.fit['2x32']}
                        data-name={row.name}
                        data-params={row.params_b ?? ''}
                        data-released={row.released}
                        data-updated={row.updated}
                      >
                        <td class="nm-num">{row.released.slice(5)}</td>
                        <th scope="row">
                          <button type="button" class="nm-pick" data-pick={row.id} aria-pressed={selected?.id === row.id ? 'true' : 'false'}>
                            {row.name}
                          </button>
                        </th>
                        <td>{row.maker}</td>
                        <td class="nm-num">{paramsLabel(row)}</td>
                        <td class="nm-runs">{enginesShort(row)}</td>
                        <td>{row.gguf.length ? 'yes' : 'none'}</td>
                        <td class="nm-num">
                          {row.q4_k_m_gib != null ? `${row.q4_k_m_gib}` : '—'}
                        </td>
                        <td class:list={['nm-num', 'nm-fit', fitClass(row.fit['16'])]}>{row.fit['16']}</td>
                        <td class:list={['nm-num', 'nm-fit', fitClass(row.fit['24'])]}>{row.fit['24']}</td>
                        <td class:list={['nm-num', 'nm-fit', fitClass(row.fit['32'])]}>{row.fit['32']}</td>
                        <td class:list={['nm-num', 'nm-fit', fitClass(row.fit['2x32'])]}>{row.fit['2x32']}</td>
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </section>

      <section class="nm-card" id="nm-detail" aria-labelledby="nm-detail-heading" aria-live="polite">
        <p class="kicker">This model</p>
        {selected ? (
          <>
            <h2 id="nm-detail-heading" class="nm-card-title">{selected.name}</h2>
            <p class="mt-1 text-sm text-muted">{selected.maker} · {selected.released}</p>
            <dl class="nm-kv">
              <div><dt>Maker</dt><dd>{selected.maker}</dd></div>
              <div><dt>Released</dt><dd>{selected.released}</dd></div>
              <div><dt>Params</dt><dd>{paramsLabel(selected)}</dd></div>
              <div><dt>Architecture</dt><dd>{selected.architecture ?? 'not listed'}</dd></div>
              <div><dt>Context</dt><dd>{selected.context != null ? selected.context.toLocaleString('en-US') : 'not listed'}</dd></div>
              <div><dt>License</dt><dd>{selected.license ?? 'not listed'}</dd></div>
              <div>
                <dt>GGUF</dt>
                <dd>
                  {selected.gguf.length === 0 ? (
                    'none listed'
                  ) : (
                    <ul>
                      {selected.gguf.map((pack) => (
                        <li>
                          <a class="underline decoration-accent/40" href={pack.href} rel="noopener">{pack.org}</a>
                          {' · '}
                          {pack.quants.join(', ')}
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </div>
              <div>
                <dt>Q4_K_M</dt>
                <dd>
                  {selected.q4_k_m_gib != null ? `${selected.q4_k_m_gib} GiB` : 'unknown'}
                  {' '}
                  <span class="text-faint">{selected.q4_k_m_kind}</span>
                </dd>
              </div>
              <div>
                <dt>16 / 24 / 32 / 2×32</dt>
                <dd>
                  {selected.fit['16']} · {selected.fit['24']} · {selected.fit['32']} · {selected.fit['2x32']}
                </dd>
              </div>
            </dl>
            <p class="nm-label mt-5">Runs on</p>
            {yesEngineIds(selected.runs_on).length === 0 ? (
              <p class="mt-2 text-sm text-muted">unknown</p>
            ) : (
              <ul class="nm-engine-list">
                {selected.runs_on
                  .filter((hit) => hit.status === 'yes')
                  .map((hit) => (
                    <li>
                      <a class="nm-engine underline decoration-accent/40" href={RUN_ENGINES.find((e) => e.id === hit.id)?.href ?? '/backends'}>
                        <span>{engineLabel(hit.id)}</span>
                        <span class="text-xs text-faint">{engineNote(hit.id)}</span>
                      </a>
                    </li>
                  ))}
              </ul>
            )}
            <p class="mt-5">
              <a class="btn-primary" href={selected.href} rel="noopener">Open on Hub</a>
            </p>
          </>
        ) : (
          <h2 id="nm-detail-heading" class="nm-card-title">No row selected</h2>
        )}
        <details class="nm-sources">
          <summary>Sources</summary>
          <p>
            Hugging Face Hub public API. GGUF filenames from unsloth, bartowski, lmstudio-community,
            and ggml-org. Runs-on from llama.cpp convert architecture names or a listed GGUF pack,
            the vLLM supported-architectures registry, Ollama library slugs, Strata Qwen 3.8 Flash
            notes on /backends, and SGLang architecture names when listed. LM Studio and Lemonade
            follow GGUF. MLX is excluded. Not llama-bench.
          </p>
        </details>
      </section>
    </div>

    <NextSteps path={NEW_MODELS_PATH} />
  </main>
  <script type="application/json" id="nm-fallback" set:html={fallback}></script>
</Base>

<script>
  type Fit = 'fits' | 'tight' | 'no' | 'unknown';
  type Row = {
    id: string;
    name: string;
    href: string;
    maker: string;
    released: string;
    updated: string;
    params_b: number | null;
    active_params_b: number | null;
    architecture: string | null;
    context: number | null;
    license: string | null;
    modalities: string[];
    gguf: Array<{ org: string; href: string; quants: string[] }>;
    q4_k_m_gib: number | null;
    q4_k_m_kind: string;
    fit: Record<string, Fit>;
    size_band: string;
    runs_on?: Array<{ id: string; status: string; evidence?: string }>;
  };
  type FileShape = { schema?: string; as_of?: string; days: Array<{ date: string; models: Row[] }> };

  const engineMeta: Record<string, { label: string; note: string; href: string }> = {
    llamacpp: { label: 'llama.cpp', note: 'Vulkan / ROCm', href: '/backends/llamacpp' },
    strata: { label: 'Strata', note: 'ROCm (HIP)', href: '/backends/strata' },
    vllm: { label: 'vLLM', note: 'ROCm', href: '/backends/vllm' },
    ollama: { label: 'Ollama', note: 'ROCm', href: '/backends/ollama' },
    lmstudio: { label: 'LM Studio', note: 'Vulkan / ROCm', href: '/backends/lmstudio' },
    lemonade: { label: 'Lemonade', note: 'Vulkan / ROCm', href: '/backends/lemonade' },
    sglang: { label: 'SGLang', note: 'ROCm', href: '/backends/sglang' },
  };

  const filters = { maker: '', band: '', gguf: '', gpu: '', engine: '' };
  let sortKey = 'released';
  let sortDir = -1;
  let selectedId = '';
  let file: FileShape = { days: [] };

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function rowAnchor(id: string): string {
    return id.replaceAll('/', '--');
  }

  function parseFallback(): FileShape {
    const node = document.getElementById('nm-fallback');
    if (!node?.textContent) return { days: [] };
    try {
      const parsed = JSON.parse(node.textContent) as FileShape;
      return parsed?.days ? parsed : { days: [] };
    } catch {
      return { days: [] };
    }
  }

  function paramsLabel(row: Row): string {
    if (row.params_b == null) return 'not listed';
    const active =
      row.active_params_b != null && row.active_params_b !== row.params_b
        ? ` / ${row.active_params_b}B active`
        : '';
    return `${row.params_b}B${active}`;
  }

  function yesEngines(row: Row): string[] {
    return (row.runs_on || []).filter((hit) => hit.status === 'yes' && hit.id !== 'mlx').map((hit) => hit.id);
  }

  function enginesShort(row: Row): string {
    const yes = yesEngines(row);
    if (!yes.length) return 'unknown';
    return yes.map((id) => engineMeta[id]?.label || id).join(' · ');
  }

  function fitClass(verdict: string): string {
    if (verdict === 'fits') return 'is-ok';
    if (verdict === 'tight') return 'is-warn';
    return '';
  }

  function sortRows(rows: Row[]): Row[] {
    const key = sortKey;
    const dir = sortDir;
    return rows.slice().sort((a, b) => {
      if (key === 'released') {
        const byDay = b.released.localeCompare(a.released) || (b.updated || '').localeCompare(a.updated || '');
        return (dir < 0 ? byDay : -byDay) || a.name.localeCompare(b.name) || a.id.localeCompare(b.id);
      }
      const av =
        key === 'params' ? a.params_b ?? -1
        : key === 'q4' ? a.q4_k_m_gib ?? -1
        : key === 'maker' ? a.maker
        : key === 'runs' ? yesEngines(a).join(' ')
        : a.name;
      const bv =
        key === 'params' ? b.params_b ?? -1
        : key === 'q4' ? b.q4_k_m_gib ?? -1
        : key === 'maker' ? b.maker
        : key === 'runs' ? yesEngines(b).join(' ')
        : b.name;
      if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
      return String(av).localeCompare(String(bv)) * dir || a.id.localeCompare(b.id);
    });
  }

  function rowVisible(row: Row): boolean {
    const gguf = row.gguf.length ? 'yes' : 'no';
    const fit = filters.gpu ? row.fit[filters.gpu] : '';
    const engines = yesEngines(row);
    return (
      (!filters.maker || row.maker === filters.maker) &&
      (!filters.band || row.size_band === filters.band) &&
      (!filters.gguf || gguf === filters.gguf) &&
      (!filters.engine || engines.includes(filters.engine)) &&
      (!filters.gpu || fit === 'fits' || fit === 'tight')
    );
  }

  function visibleRows(next: FileShape): Row[] {
    return next.days.flatMap((day) => sortRows(day.models.filter(rowVisible)));
  }

  function findRow(id: string): Row | undefined {
    for (const day of file.days) {
      const hit = day.models.find((row) => row.id === id);
      if (hit) return hit;
    }
    return undefined;
  }

  function renderDetail(row: Row | undefined) {
    const root = document.getElementById('nm-detail');
    if (!root) return;
    if (!row) {
      root.innerHTML = '<p class="kicker">This model</p><h2 id="nm-detail-heading" class="nm-card-title">No row selected</h2>';
      return;
    }
    const yes = yesEngines(row);
    const engines = yes.length
      ? `<ul class="nm-engine-list">${yes
          .map((id) => {
            const meta = engineMeta[id] || { label: id, note: '', href: '/backends' };
            const note = meta.note ? `<span class="text-xs text-faint">${escapeHtml(meta.note)}</span>` : '';
            return `<li><a class="nm-engine underline decoration-accent/40" href="${escapeHtml(meta.href)}"><span>${escapeHtml(meta.label)}</span>${note}</a></li>`;
          })
          .join('')}</ul>`
      : '<p class="mt-2 text-sm text-muted">unknown</p>';
    const gguf = row.gguf.length
      ? `<ul>${row.gguf
          .map(
            (pack) =>
              `<li><a class="underline decoration-accent/40" href="${escapeHtml(pack.href)}" rel="noopener">${escapeHtml(pack.org)}</a> · ${escapeHtml(pack.quants.join(', '))}</li>`,
          )
          .join('')}</ul>`
      : 'none listed';
    root.innerHTML = `
      <p class="kicker">This model</p>
      <h2 id="nm-detail-heading" class="nm-card-title">${escapeHtml(row.name)}</h2>
      <p class="mt-1 text-sm text-muted">${escapeHtml(row.maker)} · ${escapeHtml(row.released)}</p>
      <dl class="nm-kv">
        <div><dt>Maker</dt><dd>${escapeHtml(row.maker)}</dd></div>
        <div><dt>Released</dt><dd>${escapeHtml(row.released)}</dd></div>
        <div><dt>Params</dt><dd>${escapeHtml(paramsLabel(row))}</dd></div>
        <div><dt>Architecture</dt><dd>${escapeHtml(row.architecture ?? 'not listed')}</dd></div>
        <div><dt>Context</dt><dd>${row.context != null ? escapeHtml(row.context.toLocaleString('en-US')) : 'not listed'}</dd></div>
        <div><dt>License</dt><dd>${escapeHtml(row.license ?? 'not listed')}</dd></div>
        <div><dt>GGUF</dt><dd>${gguf}</dd></div>
        <div><dt>Q4_K_M</dt><dd>${row.q4_k_m_gib != null ? `${row.q4_k_m_gib} GiB` : 'unknown'} <span class="text-faint">${escapeHtml(row.q4_k_m_kind)}</span></dd></div>
        <div><dt>16 / 24 / 32 / 2×32</dt><dd>${escapeHtml(row.fit['16'])} · ${escapeHtml(row.fit['24'])} · ${escapeHtml(row.fit['32'])} · ${escapeHtml(row.fit['2x32'])}</dd></div>
      </dl>
      <p class="nm-label mt-5">Runs on</p>
      ${engines}
      <p class="mt-5"><a class="btn-primary" href="${escapeHtml(row.href)}" rel="noopener">Open on Hub</a></p>
      <details class="nm-sources">
        <summary>Sources</summary>
        <p>
          Hugging Face Hub public API. GGUF filenames from unsloth, bartowski, lmstudio-community,
          and ggml-org. Runs-on from llama.cpp convert architecture names or a listed GGUF pack,
          the vLLM supported-architectures registry, Ollama library slugs, Strata Qwen 3.8 Flash
          notes on /backends, and SGLang architecture names when listed. LM Studio and Lemonade
          follow GGUF. MLX is excluded. Not llama-bench.
        </p>
      </details>`;
  }

  function selectRow(id: string, scroll = false) {
    selectedId = id;
    document.querySelectorAll<HTMLTableRowElement>('.nm-row').forEach((tr) => {
      const on = tr.dataset.id === id;
      tr.classList.toggle('is-on', on);
    });
    document.querySelectorAll<HTMLButtonElement>('.nm-pick').forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.pick === id ? 'true' : 'false');
    });
    renderDetail(findRow(id));
    if (scroll && id) {
      const node = document.getElementById(rowAnchor(id));
      node?.scrollIntoView({ block: 'nearest' });
    }
    if (id) {
      const next = `#${rowAnchor(id)}`;
      if (location.hash !== next) history.replaceState(null, '', next);
    }
  }

  function render(next: FileShape) {
    file = next;
    const root = document.getElementById('nm-table');
    if (!root) return;
    const maker = document.getElementById('nm-maker') as HTMLSelectElement | null;
    if (maker) {
      const current = maker.value;
      const names = [...new Set(next.days.flatMap((day) => day.models.map((row) => row.maker)))].sort((a, b) =>
        a.localeCompare(b),
      );
      maker.innerHTML = `<option value="">Any maker</option>${names.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join('')}`;
      if (names.includes(current)) maker.value = current;
      else filters.maker = '';
    }
    if (!next.days.length) {
      root.innerHTML =
        '<p class="text-sm text-muted">No Hub rows in the last 90 days on this build. Run <code class="font-mono">node scripts/new-models-sync.mjs</code> to seed <code class="font-mono">public/data/new-models.json</code>.</p>';
      const count = document.getElementById('nm-count');
      if (count) count.textContent = '0 rows';
      renderDetail(undefined);
      return;
    }
    const days = next.days.slice().sort((a, b) => b.date.localeCompare(a.date));
    const headSort = (key: string, label: string) => {
      const on = sortKey === key;
      const aria = on ? (sortDir < 0 ? 'descending' : 'ascending') : undefined;
      const ariaAttr = aria ? ` aria-sort="${aria}"` : '';
      return `<th scope="col"${ariaAttr}><button type="button" class="nm-sort${on ? ' is-on' : ''}" data-sort="${key}">${label}</button></th>`;
    };
    const body = days
      .map((day) => {
        const rows = sortRows(day.models.filter(rowVisible));
        if (!rows.length) return '';
        const trs = rows
          .map((row) => {
            const gguf = row.gguf.length ? 'yes' : 'no';
            const engines = yesEngines(row).join(' ');
            const on = row.id === selectedId ? ' is-on' : '';
            const pressed = row.id === selectedId ? 'true' : 'false';
            return `<tr id="${escapeHtml(rowAnchor(row.id))}" class="nm-row${on}" data-id="${escapeHtml(row.id)}" data-maker="${escapeHtml(row.maker)}" data-band="${escapeHtml(row.size_band)}" data-gguf="${gguf}" data-engines="${escapeHtml(engines)}" data-fit-16="${row.fit['16']}" data-fit-24="${row.fit['24']}" data-fit-32="${row.fit['32']}" data-fit-2x32="${row.fit['2x32']}" data-released="${escapeHtml(row.released)}" data-updated="${escapeHtml(row.updated || '')}">
              <td class="nm-num">${escapeHtml(row.released.slice(5))}</td>
              <th scope="row"><button type="button" class="nm-pick" data-pick="${escapeHtml(row.id)}" aria-pressed="${pressed}">${escapeHtml(row.name)}</button></th>
              <td>${escapeHtml(row.maker)}</td>
              <td class="nm-num">${escapeHtml(paramsLabel(row))}</td>
              <td class="nm-runs">${escapeHtml(enginesShort(row))}</td>
              <td>${row.gguf.length ? 'yes' : 'none'}</td>
              <td class="nm-num">${row.q4_k_m_gib != null ? row.q4_k_m_gib : '—'}</td>
              <td class="nm-num nm-fit ${fitClass(row.fit['16'])}">${row.fit['16']}</td>
              <td class="nm-num nm-fit ${fitClass(row.fit['24'])}">${row.fit['24']}</td>
              <td class="nm-num nm-fit ${fitClass(row.fit['32'])}">${row.fit['32']}</td>
              <td class="nm-num nm-fit ${fitClass(row.fit['2x32'])}">${row.fit['2x32']}</td>
            </tr>`;
          })
          .join('');
        return `<tr class="nm-day" data-day="${escapeHtml(day.date)}"><th scope="rowgroup" colspan="11">${escapeHtml(day.date)}</th></tr>${trs}`;
      })
      .join('');
    root.innerHTML = `<table class="table-lab nm-table">
      <caption class="sr-only">Open-weight releases, newest day first</caption>
      <thead><tr>
        ${headSort('released', 'Released')}
        ${headSort('name', 'Model')}
        ${headSort('maker', 'Maker')}
        ${headSort('params', 'Params')}
        ${headSort('runs', 'Runs on')}
        <th scope="col">GGUF</th>
        ${headSort('q4', 'Q4_K_M')}
        <th scope="col">16</th>
        <th scope="col">24</th>
        <th scope="col">32</th>
        <th scope="col">2×32</th>
      </tr></thead>
      <tbody>${body}</tbody>
    </table>`;
    bindSort();
    bindPicks();
    const visible = visibleRows(next);
    if (!visible.some((row) => row.id === selectedId)) {
      selectedId = visible[0]?.id ?? '';
    }
    selectRow(selectedId);
    const count = document.getElementById('nm-count');
    if (count) count.textContent = `${visible.length} rows`;
    const asof = document.getElementById('nm-asof');
    if (asof && next.as_of) {
      const total = next.days.reduce((n, day) => n + day.models.length, 0);
      asof.textContent = `${total} models · as of ${next.as_of.slice(0, 10)}.`;
    }
  }

  function apply() {
    if (file.days.length) render(file);
  }

  function bindChips() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter as keyof typeof filters;
        const value = btn.dataset.value ?? '';
        filters[key] = value;
        const group = btn.classList.contains('nm-tab') ? '.nm-tab' : '.chip';
        btn
          .closest('[role="group"]')
          ?.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]${group === '.nm-tab' ? '.nm-tab' : ''}`)
          .forEach((other) => {
            const on = other === btn;
            other.classList.toggle('is-on', on);
            other.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        apply();
      });
    });
    const maker = document.getElementById('nm-maker') as HTMLSelectElement | null;
    maker?.addEventListener('change', () => {
      filters.maker = maker.value;
      apply();
    });
    document.getElementById('nm-filters')?.addEventListener('reset', () => {
      filters.maker = '';
      filters.band = '';
      filters.gguf = '';
      filters.gpu = '';
      filters.engine = '';
      sortKey = 'released';
      sortDir = -1;
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
        const on = (btn.dataset.value ?? '') === '';
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      queueMicrotask(apply);
    });
  }

  function bindSort() {
    document.querySelectorAll<HTMLButtonElement>('.nm-sort').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort || 'released';
        if (sortKey === key) sortDir *= -1;
        else {
          sortKey = key;
          sortDir = key === 'released' ? -1 : 1;
        }
        apply();
      });
    });
  }

  function bindPicks() {
    document.querySelectorAll<HTMLButtonElement>('.nm-pick').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.pick || '';
        if (id) selectRow(id);
      });
    });
  }

  async function hydrate() {
    file = parseFallback();
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    const fromHash = file.days.flatMap((day) => day.models).find((row) => rowAnchor(row.id) === hash);
    selectedId = fromHash?.id || file.days[0]?.models[0]?.id || '';
    bindChips();
    bindSort();
    bindPicks();
    if (selectedId) selectRow(selectedId);
    try {
      const res = await fetch('/data/new-models.json', { cache: 'no-store' });
      if (!res.ok) return;
      const live = (await res.json()) as FileShape;
      if (!live?.days) return;
      if (live.as_of && live.as_of === file.as_of && selectedId) return;
      render(live);
    } catch {
      /* keep static fallback */
    }
  }

  hydrate();
</script>

