---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import Mermaid from '../../components/rocm/Mermaid.astro';
import BackendsNav from '../../components/backends/BackendsNav.astro';
import {
  BACKEND_FLOWCHART,
  COMPARE_COLUMNS,
  backendPath,
  usedOnOurRig,
  verdictLabel,
} from '../../lib/backends';
import { backends, backendsFile } from '../../lib/backends-data';
import Qwen36Benches from '../../components/Qwen36Benches.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';

const list = backends();
const onRig = usedOnOurRig(list);
const tone: Record<string, string> = {
  default: 'bg-ok/15 text-ok',
  ok: 'bg-accent-soft text-accent-ink',
  try: 'bg-accent-soft text-accent-ink',
  advanced: 'bg-warn/15 text-warn',
  caution: 'bg-warn/15 text-warn',
};
---

<Base
  title="Inference engines compared"
  description="llama.cpp first. Vulkan daily driver on one R9700. Strata for Flash. vLLM, Ollama, LM Studio, SGLang, ExLlama, MLC, KTransformers, and raw PyTorch — cited, no invented benches."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <BackendsNav current="overview" />
    <h1 class="display mt-6 text-4xl sm:text-5xl">Inference engines compared</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      The model files are not the runtime. On a Radeon you pick an
      <strong class="text-ink">engine</strong> that speaks Vulkan or HIP, then optionally a
      <a class="underline decoration-accent/40" href="/harnesses">harness</a> that POSTs to
      <code>/v1</code>. Consumer default is <strong class="text-ink">llama.cpp</strong>.
      As of {backendsFile.as_of}.
    </p>

    <ul class="mt-6 space-y-1.5 text-sm text-muted">
      {backendsFile.notes.map((note) => <li>{note}</li>)}
    </ul>

    <p class="mt-6 flex flex-wrap gap-3 text-sm">
      <a class="btn-primary" href="/backends/llamacpp">llama.cpp deep dive</a>
      <a class="btn-secondary" href="/backends/strata">Strata deep dive</a>
      <a class="btn-ghost" href="/flash-daily">Flash daily driver</a>
      <a class="btn-ghost" href="/qwen36-dual">35B on two cards</a>
      <a class="btn-ghost" href="/multi-gpu">Dual / multi-GPU</a>
      <a class="btn-secondary" href="/benchmarks">Benchmarks</a>
      <a class="btn-secondary" href="/calculator">Calculator</a>
      <a class="btn-ghost" href="/stack-lab">Stack Lab</a>
      <a class="btn-ghost" href="/rocm">What is ROCm</a>
      <a class="btn-ghost" href="/troubleshoot/errors">Paste a log</a>
    </p>
    <div class="mt-4">
      <OpenInStackLab {...HOUSE_STACK_LAB.llama} compact />
    </div>

    {onRig.length > 0 && (
      <section class="card mt-10 p-5" aria-labelledby="rig-heading">
        <p class="kicker">local-desktop</p>
        <h2 id="rig-heading" class="mt-1 text-xl tracking-tight">Used on our rig</h2>
        <ul class="mt-4 space-y-3">
          {onRig.map((row) => (
            <li>
              <a class="font-medium underline decoration-accent/40" href={backendPath(row.id)}>{row.name}</a>
              <span class="ml-2 badge-tested">Used on our rig</span>
              <p class="mt-1 text-sm text-muted">{row.short}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12" aria-labelledby="flow-heading">
      <h2 id="flow-heading" class="text-2xl tracking-tight">Which one should I use?</h2>
      <p class="mt-2 text-sm text-muted">
        The diagram needs JavaScript. The list under it is the same advice and reads without it.
      </p>
      <Mermaid title="Default is llama.cpp">
        {BACKEND_FLOWCHART}
      </Mermaid>
      <ol class="mt-6 space-y-2 rounded-2xl border border-line bg-raised/40 p-5 text-sm leading-relaxed">
        {backendsFile.flowchart_fallback.map((line, i) => (
          <li><strong class="text-ink">{i + 1}.</strong> {line}</li>
        ))}
      </ol>
    </section>

    <Callout type="linux">
      Compile <a href="/backends/llamacpp">llama.cpp</a> yourself on AMD. Do not let a desktop
      harness download a CUDA runtime “for convenience.” Confirm
      <a href="/tutorials/verify-rocm">rocminfo</a> shows <code>gfx1201</code>, then
      <code>curl</code> <code>/v1</code> before you attach <a href="/harnesses">Hermes</a>.
    </Callout>

    <Qwen36Benches heading="35B on llama.cpp, measured" />

    <section class="mt-12" id="compare" aria-labelledby="table-heading">
      <h2 id="table-heading" class="text-2xl tracking-tight">Comparison</h2>
      <p class="mt-2 text-sm text-muted">
        Cells are paraphrases of cited docs plus this site’s house rules. “Not documented”
        and not recorded stay labeled. First-party speed is the 35B llama.cpp set
        (Measured on our rig, 2026-10) plus the Flash Q6 pair.
      </p>
      <div class="card mt-6 overflow-x-auto">
        <table class="table-lab min-w-[80rem]">
          <caption>Inference backends compared. Cells are paraphrases of cited docs plus house rules. First-party speed is the 35B llama.cpp set plus the Flash Q6 pair.</caption>
          <thead>
            <tr>
              <th scope="col">Engine</th>
              {COMPARE_COLUMNS.map((col) => <th scope="col">{col.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {list.map((row) => (
              <tr>
                <td>
                  <a class="font-medium hover:text-accent-ink" href={backendPath(row.id)}>{row.name}</a>
                  <p class="mt-1">
                    <span class:list={['badge', tone[row.verdict]]}>{verdictLabel[row.verdict]}</span>
                    {row.used_on_our_rig && <span class="badge-tested ml-1">On our rig</span>}
                  </p>
                </td>
                {COMPARE_COLUMNS.map((col) => (
                  <td class="max-w-xs text-sm text-muted">{row[col.key]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="cards-heading">
      <h2 id="cards-heading" class="text-2xl tracking-tight">Deep dives</h2>
      <ul class="mt-5 grid gap-3">
        {list.map((row) => (
          <li>
            <a class="card block p-5" href={backendPath(row.id)}>
              <p class="flex flex-wrap gap-2 text-xs">
                <span class:list={['badge', tone[row.verdict]]}>{verdictLabel[row.verdict]}</span>
                {row.used_on_our_rig && <span class="badge-tested">Used on our rig</span>}
              </p>
              <h3 class="mt-3 text-xl tracking-tight">{row.name}</h3>
              <p class="mt-2 text-sm text-muted">{row.short}</p>
              <p class="mt-2 text-xs text-faint">{row.version}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Fit a quant: <a class="underline decoration-accent/40" href="/quants">quants</a>
      and the <a class="underline decoration-accent/40" href="/calculator">calculator</a>.
      Vulkan vs HIP: <a class="underline decoration-accent/40" href="/rocm/vulkan-hip">ROCm guide</a>.
      Errors: <a class="underline decoration-accent/40" href="/troubleshoot/errors">paste a log</a>.
      Plug a client in: <a class="underline decoration-accent/40" href="/harnesses">harnesses</a>.
    </p>
  </main>
</Base>
