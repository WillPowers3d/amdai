---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import BackendsNav from '../../components/backends/BackendsNav.astro';
import StrataDeepDive from '../../components/backends/StrataDeepDive.astro';
import { backendPath, verdictLabel } from '../../lib/backends';
import { backend, backends } from '../../lib/backends-data';
import HouseRam from '../../components/HouseRam.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';

export function getStaticPaths() {
  return backends().map((row) => ({ params: { slug: row.id } }));
}

const row = backend(Astro.params.slug ?? '');
if (!row) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const tone: Record<string, string> = {
  default: 'bg-ok/15 text-ok',
  ok: 'bg-accent-soft text-accent-ink',
  try: 'bg-accent-soft text-accent-ink',
  advanced: 'bg-warn/15 text-warn',
  caution: 'bg-warn/15 text-warn',
};

const neighbors = backends();
const index = neighbors.findIndex((item) => item.id === row.id);
const prev = index > 0 ? neighbors[index - 1] : null;
const next = index >= 0 && index < neighbors.length - 1 ? neighbors[index + 1] : null;
---

<Base title={row.name} description={row.short}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <BackendsNav current={row.id} />
    <p class="mt-6 text-sm text-faint">
      <a href="/backends">Engines</a>
      {' / '}
      {row.id}
    </p>
    <p class="mt-4 flex flex-wrap gap-2 text-xs">
      <span class:list={['badge', tone[row.verdict]]}>{verdictLabel[row.verdict]}</span>
      {row.used_on_our_rig && <span class="badge-tested">Used on our rig</span>}
    </p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">{row.name}</h1>
    <p class="mt-3 text-sm text-faint">{row.version}</p>
    <p class="mt-4 text-lg leading-relaxed text-muted">{row.short}</p>
    {row.id === 'llamacpp' && (
      <div class="mt-4 space-y-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.daily} compact />
        <HouseRam which="daily" compact />
      </div>
    )}
    {row.id === 'strata' && (
      <div class="mt-4 space-y-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.flash} compact />
        <HouseRam which="flash" compact />
      </div>
    )}

    {row.used_on_our_rig && row.id === 'llamacpp' && (
      <Callout type="check" title="Used on our rig">
        Daily driver: Qwen3.6-35B-A3B Unsloth UD-Q5_K_XL on <strong>one</strong> R9700 via
        llama.cpp <strong>Vulkan</strong>, 262144 context, f16 KV, 0% RAM offload.
        <strong>Measured on our rig, 2026-10</strong> — UD-Q5_K_XL decode <strong>102.39 tok/s</strong>
        at short context, <strong>90.52</strong> at 32K, <strong>66.43</strong> at 128K,
        <strong>44.4</strong> at 256K (25.97 GB VRAM at 4K); Q5_K_M
        <strong>109.73 tok/s</strong> (24.68 GB VRAM); Q4_K_M <strong>117.69 tok/s</strong> decode,
        <strong>1902.1 tok/s</strong> prefill at 32K. Official llama-bench cards:
        <a href="/results">/results</a>. Table: <a href="/benchmarks">benchmarks</a>.
      </Callout>
    )}
    {row.used_on_our_rig && row.id === 'strata' && (
      <Callout type="check" title="Used on our rig">
        Fast agent: Qwen 3.8 Flash Unsloth UD-Q6_K_XL on Strata <strong>v0.1.42</strong> at
        262K. First-party on this rig: about <strong>32.6 tok/s</strong> versus llama.cpp
        about <strong>16 tok/s</strong> on that Flash Q6. Exact flags / VRAM+RAM stay not recorded.
        RAM-offload page: <a href="/flash-ram-offload">/flash-ram-offload</a>.
      </Callout>
    )}
    {!row.used_on_our_rig && (
      <Callout type="warn">
        Not measured on our test rig. Commands below are from cited docs, not a first-party
        recipe. If a GPU meter does not move, come back to
        <a href="/backends/llamacpp">llama.cpp</a>.
      </Callout>
    )}

    <article class="prose-lab prose mt-10 max-w-none">
      <h2 id="what">What it is</h2>
      <p>{row.what}</p>
      <h2 id="architecture">Architecture in plain English</h2>
      <p>{row.architecture}</p>
      <h2 id="well">What it does well</h2>
      <p>{row.well}</p>
      <h2 id="badly">What it does badly</h2>
      <p>{row.badly}</p>
      <h2 id="rocm">ROCm / Radeon</h2>
      <p>{row.rocm_level}</p>
      <p><strong>Vulkan.</strong> {row.vulkan}</p>
      <h2 id="quants">Supported quants</h2>
      <p>{row.quants}</p>
      <p>
        Q3 is listed as estimate/community unless measured; Q1/Q2 stay off. Prefer Q5. See <a href="/quants">quants</a> and the
        <a href="/calculator">calculator</a>.
      </p>
      <h2 id="install">Install on an R9700</h2>
      <pre><code>{row.install}</code></pre>
      <h2 id="run">Run</h2>
      <pre><code>{row.run}</code></pre>
      <h2 id="tuning">Tuning flags</h2>
      <p>{row.tuning}</p>
      <h2 id="when">When to choose it</h2>
      <p>{row.choose}</p>
      <p>{row.when}</p>
    </article>

    {row.id === 'strata' && <StrataDeepDive />}

    <article class="prose-lab prose mt-10 max-w-none">
      <h2 id="links">Official links</h2>
      <ul>
        <li><a href={row.homepage}>Home</a></li>
        <li><a href={row.docs}>Docs used for this row</a></li>
        {row.repo && <li><a href={row.repo}>Repository</a></li>}
      </ul>
      <h2 id="sources">Sources</h2>
      <ul>
        {row.sources.map((source) => (
          <li><a href={source.href}>{source.title}</a></li>
        ))}
      </ul>
    </article>

    <p class="mt-10 text-sm text-muted">
      Next:
      <a class="underline decoration-accent/40" href="/harnesses">harnesses</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/calculator">calculator</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/compare/vulkan-vs-rocm">Vulkan vs ROCm</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/rocm">ROCm</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/troubleshoot/errors">troubleshooter</a>
    </p>
    <nav class="mt-6 flex flex-wrap justify-between gap-3 text-sm" aria-label="Engine pager">
      {prev ? (
        <a class="underline decoration-accent/40" href={backendPath(prev.id)}>← {prev.name}</a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="underline decoration-accent/40" href={backendPath(next.id)}>{next.name} →</a>
      ) : (
        <span />
      )}
    </nav>
  </main>
</Base>
