---
import Base from '../layouts/Base.astro';
import { backends, backendsFile, verdictLabel } from '../lib/backends';

const tone: Record<string, string> = {
  default: 'bg-ok/15 text-ok',
  ok: 'bg-accent-soft text-accent-ink',
  try: 'bg-accent-soft text-accent-ink',
  advanced: 'bg-warn/15 text-warn',
  caution: 'bg-warn/15 text-warn',
};
---

<Base
  title="Backend chooser"
  description="llama.cpp first. Vulkan or HIP for a home Radeon. Strata is the measured fast-agent try. vLLM is advanced. Ollama gfx1201 is rocky."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Inference</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Which backend?</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Consumer default is <strong class="text-ink">llama.cpp</strong>. Daily driver on our test rig is
      Vulkan; HIP is the sibling build. vLLM is a serve try, not the house path. Ollama’s gfx1201
      ROCm story is still cited pain. As of {backendsFile.as_of}.
    </p>

    <ol class="mt-8 space-y-3 rounded-2xl border border-line bg-raised/40 p-5 text-sm leading-relaxed">
      <li><strong class="text-ink">1.</strong> Need tokens on one card tonight → llama.cpp (Vulkan if HIP CMake sulks).</li>
      <li><strong class="text-ink">2.</strong> Daily driver already works and you want the Flash agent → Strata v0.1.42.</li>
      <li><strong class="text-ink">3.</strong> Several clients / batching → vLLM, advanced, pin a ROCm image. Not default PyPI.</li>
      <li><strong class="text-ink">4.</strong> Ollama or LM Studio → only if a GPU meter moves. Else back to step 1.</li>
    </ol>

    <div class="mt-10 overflow-x-auto">
      <table class="min-w-[40rem] w-full text-left text-sm">
        <thead>
          <tr class="border-b border-line text-faint">
            <th class="py-2 pr-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]">Engine</th>
            <th class="py-2 pr-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]">Verdict</th>
            <th class="py-2 font-mono text-[0.68rem] uppercase tracking-[0.12em]">Pick when</th>
          </tr>
        </thead>
        <tbody>
          {backends.map((row) => (
            <tr class="border-b border-line/70">
              <td class="py-3 pr-3 font-medium"><a class="hover:text-accent-ink" href={`#${row.id}`}>{row.name}</a></td>
              <td class="py-3 pr-3"><span class:list={['rounded-full px-2 py-0.5 text-xs', tone[row.verdict]]}>{verdictLabel[row.verdict]}</span></td>
              <td class="py-3 text-muted">{row.when}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <ul class="mt-12 space-y-8">
      {backends.map((row) => (
        <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/40 p-5">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">{row.short}</p>
          <h2 class="mt-1 font-serif text-3xl">{row.name}</h2>
          <p class="mt-3 text-sm text-muted"><span class="font-medium text-ink">Speaks. </span>{row.backends}</p>
          <p class="mt-2 text-sm text-muted"><span class="font-medium text-ink">Best at. </span>{row.best_for}</p>
          <p class="mt-2 text-sm text-muted"><span class="font-medium text-ink">Pain. </span>{row.worst_for}</p>
          <p class="mt-2 text-sm text-muted"><span class="font-medium text-ink">ROCm / Radeon. </span>{row.rocm}</p>
          <p class="mt-2 text-sm text-muted"><span class="font-medium text-ink">Caveats. </span>{row.caveats}</p>
          <p class="mt-4 text-sm">
            <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={row.href}>Open the walkthrough</a>
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-sm text-muted">
      Fit a quant: <a class="underline decoration-accent/40 underline-offset-2" href="/quants">quant explainer</a>
      and the <a class="underline decoration-accent/40 underline-offset-2" href="/calculator">calculator</a>.
      Errors: <a class="underline decoration-accent/40 underline-offset-2" href="/troubleshoot/errors">paste a log</a>.
    </p>
  </main>
</Base>
