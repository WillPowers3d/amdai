---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HouseRam from '../../components/HouseRam.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../../lib/ram-surfaces';
import {
  SETUP_MULTI_GPU_CITED_LABEL,
  SETUP_MULTI_GPU_HUB_LINKS,
  SETUP_MULTI_GPU_HIP_A,
  SETUP_MULTI_GPU_HIP_B,
  SETUP_MULTI_GPU_LIST,
  SETUP_MULTI_GPU_ONE_4K,
  SETUP_MULTI_GPU_OVERNIGHT,
  SETUP_MULTI_GPU_PIN_A,
  SETUP_MULTI_GPU_PIN_B,
  SETUP_MULTI_GPU_QUANTS,
  SETUP_MULTI_GPU_SOURCES,
  SETUP_MULTI_GPU_SPLIT,
  SETUP_MULTI_GPU_SPLIT_4K,
  SETUP_MULTI_GPU_STEPS,
  SETUP_MULTI_GPU_SYSTEMD_COMBO_A,
  SETUP_MULTI_GPU_SYSTEMD_COMBO_B,
  SETUP_MULTI_GPU_SYSTEMD_SPLIT,
  SETUP_MULTI_GPU_TRACKS,
  SETUP_MULTI_GPU_TROUBLE,
  SETUP_MULTI_GPU_TS_EXAMPLE,
} from '../../lib/setup-multi-gpu';
---

<Base
  title="Run llama.cpp across two (or more) Radeon GPUs"
  description="Cited llama.cpp multi-GPU on Radeon: Vulkan and HIP device pins, --split-mode layer, --tensor-split, two-server combo. 35B split measured on local-desktop. No invented tok/s."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SETUP_MULTI_GPU_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
      Run llama.cpp across two (or more) Radeon GPUs
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Hands-on llama.cpp on two consumer Radeon cards. The why lives on
      <a class="underline decoration-accent/40" href="/multi-gpu">/multi-gpu</a>
      and the measured 35B table on
      <a class="underline decoration-accent/40" href="/compare/one-vs-two-gpu">/compare/one-vs-two-gpu</a>.
      Ubuntu 24.04+ first —
      <a class="underline decoration-accent/40" href="/setup">/setup</a>.
      Flags come from the llama.cpp multi-GPU docs and AMD mGPU / isolation
      pages. We do not invent a flag, a tok/s, or a price.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {SETUP_MULTI_GPU_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="warn" title="A split is not 2× chat">
      <p>
        Official 35B UD-Q5_K_XL at 4K: one R9700 decodes
        <strong class="text-ink">{SETUP_MULTI_GPU_ONE_4K} tok/s</strong>;
        the layer split is
        <strong class="text-ink">{SETUP_MULTI_GPU_SPLIT_4K} tok/s</strong>.
        Split a file that does not fit. Two models side by side are two
        servers, not tensor parallel.
      </p>
    </Callout>

    <section id="tracks" class="mt-12 scroll-mt-28" aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="font-serif text-3xl tracking-tight">Two patterns</h2>
      <div class="mt-6 grid gap-4">
        {SETUP_MULTI_GPU_TRACKS.map((track) => (
          <article id={track.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{track.recommend ? 'Try this when the file does not fit' : 'Two models, or two copies'}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{track.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{track.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to both cards</h2>
      <ol class="mt-8 space-y-6">
        {SETUP_MULTI_GPU_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {SETUP_MULTI_GPU_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="commands" class="mt-12 scroll-mt-28" aria-labelledby="commands-heading">
      <h2 id="commands-heading" class="font-serif text-3xl tracking-tight">Cited commands</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Official list, then a layer split or two pinned servers. Overnight
        35B cards recorded
        <code>{SETUP_MULTI_GPU_OVERNIGHT}</code>
        on llama-bench. Paths are placeholders. Dual-card systemd units
        below are examples, not measured local-desktop services. The one-GPU
        always-on unit lives on
        <a class="underline decoration-accent/40" href="/setup/server">/setup/server</a>.
      </p>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_LIST}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_SPLIT}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_TS_EXAMPLE}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_PIN_A}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_PIN_B}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_HIP_A}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_HIP_B}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_SYSTEMD_SPLIT}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_SYSTEMD_COMBO_A}</code></pre>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_MULTI_GPU_SYSTEMD_COMBO_B}</code></pre>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">35B quants on two cards</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Q6 / Q5 / Q4 from the overnight 35B table. Q3 stays a labeled
        estimate. Nothing below Q3. Flash fit — the file that actually
        needs two 32 GB cards — stays on
        <a class="underline decoration-accent/40" href="/flash-daily">/flash-daily</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[32rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            35B GGUF quants for llama.cpp on one or two Radeon GPUs. Flash stays on /flash-daily.
          </caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-2 pr-3 font-medium">Quant</th>
              <th scope="col" class="py-2 pr-3 font-medium">Role</th>
              <th scope="col" class="py-2 font-medium">Note</th>
            </tr>
          </thead>
          <tbody>
            {SETUP_MULTI_GPU_QUANTS.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th scope="row" class="py-3 pr-3 font-mono text-ink">
                  {row.quant}
                  {row.estimate ? (
                    <span class="mt-1 block font-sans text-xs font-normal text-faint">Estimate</span>
                  ) : null}
                </th>
                <td class="py-3 pr-3 text-muted">{row.role}</td>
                <td class="py-3 text-ink">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines</h2>
      <p class="mt-3 leading-relaxed text-muted">
        <strong class="text-ink">{RAM_MIN_LABEL}</strong>
        is the load at the context you picked.
        <strong class="text-ink">{RAM_FULL_LABEL}</strong>
        is the 262144 line. House 35B peaks below are Ubuntu llama.cpp on
        one R9700. Flash two-card offload is an estimate unless a card is
        measured.
      </p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="trouble" class="mt-12 scroll-mt-28" aria-labelledby="trouble-heading">
      <h2 id="trouble-heading" class="font-serif text-3xl tracking-tight">Troubleshooting</h2>
      <Callout type="warn" title="Paste the log first">
        <p>
          Do not duplicate the matcher. Open
          <a class="underline decoration-accent/40" href="/troubleshoot/errors">/troubleshoot/errors</a>
          and paste the line. Rows we see on two cards:
        </p>
      </Callout>
      <ul class="mt-4 space-y-3">
        {SETUP_MULTI_GPU_TROUBLE.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-xl tracking-tight">{row.title}</h3>
            <p class="mt-2 leading-relaxed text-ink">{row.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Stack Lab remains Ubuntu llama.cpp-first. There is no public
        combo or dual-GPU package and no public download. Doctor still
        checks the box you already have. New speeds belong on
        <a class="underline decoration-accent/40" href="/amdai-bench">amdai-bench</a>.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {SETUP_MULTI_GPU_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/setup/multi-gpu" />
  </main>
</Base>
