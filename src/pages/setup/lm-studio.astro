---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HouseRam from '../../components/HouseRam.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import {
  SETUP_LM_STUDIO_CITED_LABEL,
  SETUP_LM_STUDIO_HOUSE_FILE,
  SETUP_LM_STUDIO_HUB_LINKS,
  SETUP_LM_STUDIO_LOAD,
  SETUP_LM_STUDIO_QUANTS,
  SETUP_LM_STUDIO_SERVER,
  SETUP_LM_STUDIO_SOURCES,
  SETUP_LM_STUDIO_STEPS,
  SETUP_LM_STUDIO_TRACKS,
} from '../../lib/setup-lm-studio';
---

<Base
  title="Run LM Studio on a Radeon GPU"
  description="Cited LM Studio Vulkan or ROCm llama.cpp runtime on Radeon. Local OpenAI /v1 on :1234. Not measured on the local desktop."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SETUP_LM_STUDIO_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Run LM Studio on a Radeon GPU</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      LM Studio is a desktop llama.cpp wrapper with a local OpenAI-compatible
      server. Ubuntu 24.04+ on bare-metal llama.cpp is still the measured AMDai
      path —
      <a class="underline decoration-accent/40" href="/setup">/setup</a>,
      <a class="underline decoration-accent/40" href="/gpus/r9700">/gpus/r9700</a>,
      <a class="underline decoration-accent/40" href="/benchmarks">/benchmarks</a>.
      This page is the first-app path: Windows installer or Linux AppImage,
      Vulkan runtime first, house
      <code>{SETUP_LM_STUDIO_HOUSE_FILE}</code>
      at 262K. Everything here is
      <strong class="text-ink">{SETUP_LM_STUDIO_CITED_LABEL}</strong>.
      We do not invent LM Studio versions, tok/s, or a bundled-ROCm GPU list.
      llama.cpp first.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {SETUP_LM_STUDIO_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="warn" title="Measured on llama.cpp, not inside LM Studio">
      <p>
        Official 35B decode numbers on AMDai are Ubuntu llama-bench cards
        (102.39 tok/s at 4K on one R9700, UD-Q5). LM Studio can still get a first
        token. It cannot claim those tok/s. We do not invent an LM Studio speed
        or a delta versus llama.cpp.
      </p>
    </Callout>

    <section id="tracks" class="mt-12 scroll-mt-28" aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="font-serif text-3xl tracking-tight">Vulkan vs ROCm runtime</h2>
      <p class="mt-3 leading-relaxed text-muted">
        AMD’s playbook names both runtimes. Official LM Studio docs do not
        publish a per-SKU Radeon table. RDNA 2, RDNA 3, RDNA 4, and the R9700
        follow this site’s Vulkan-first rule until the picker lists this gfx for
        ROCm.
      </p>
      <div class="mt-6 grid gap-4">
        {SETUP_LM_STUDIO_TRACKS.map((track) => (
          <article id={track.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{track.recommend ? 'Try this' : 'Do not start here'}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{track.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{track.body}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{track.gpus}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to first token</h2>
      <ol class="mt-8 space-y-6">
        {SETUP_LM_STUDIO_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {SETUP_LM_STUDIO_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">Quant picker</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Q6, Q5, and Q4 first. Q3 is a cited option labeled estimate. Speeds below
        are
        <strong class="text-ink">measured on llama.cpp directly, not inside LM Studio</strong>.
        Q1/Q2 stay off.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            35B GGUF quants for LM Studio on Radeon, with llama.cpp measurements labeled as not from LM Studio
          </caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-2 pr-3 font-medium">Quant</th>
              <th scope="col" class="py-2 pr-3 font-medium">Role</th>
              <th scope="col" class="py-2 pr-3 font-medium">llama.cpp on the local desktop (not LM Studio)</th>
              <th scope="col" class="py-2 font-medium">Fit note</th>
            </tr>
          </thead>
          <tbody>
            {SETUP_LM_STUDIO_QUANTS.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th scope="row" class="py-3 pr-3 font-mono text-ink">
                  {row.quant}
                  {row.estimate ? (
                    <span class="mt-1 block font-sans text-xs font-normal text-faint">Estimate</span>
                  ) : null}
                </th>
                <td class="py-3 pr-3 text-muted">{row.role}</td>
                <td class="py-3 pr-3 text-ink">{row.llamaCpp}</td>
                <td class="py-3 text-muted">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="cli" class="mt-12 scroll-mt-28" aria-labelledby="cli-heading">
      <h2 id="cli-heading" class="font-serif text-3xl tracking-tight">Cited CLI shape</h2>
      <p class="mt-3 leading-relaxed text-muted">
        After the first launch, <code>lms ls</code> prints the model key.
        Offload and context flags are from the official <code>lms load</code>
        page. Confirm the server with a loopback curl. Not measured on the local desktop.
      </p>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{`# Cited shape — not measured on the local desktop.
# Replace <model_key> with the id from lms ls.
${SETUP_LM_STUDIO_LOAD}
curl -s ${SETUP_LM_STUDIO_SERVER.replace(/\/v1$/, '')}/v1/models`}</code></pre>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (llama.cpp-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Use the calculator before you download a second quant. The two labels stay
        <strong class="text-ink">Minimum system RAM needed</strong>
        and
        <strong class="text-ink">RAM needed at full context</strong>.
        The house 35B peaks below are Ubuntu llama.cpp, not LM Studio.
      </p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Stack Lab remains Ubuntu llama.cpp-first. The button is the allowlisted
        scheme. There is no LM Studio package and no public download.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {SETUP_LM_STUDIO_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/setup/lm-studio" />
  </main>
</Base>
