---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HouseRam from '../../components/HouseRam.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import {
  SETUP_CODING_CITED_LABEL,
  SETUP_CODING_CLIENTS,
  SETUP_CODING_HOUSE_FILE,
  SETUP_CODING_HUB_LINKS,
  SETUP_CODING_QUANTS,
  SETUP_CODING_SERVER,
  SETUP_CODING_SERVER_CMD,
  SETUP_CODING_SOURCES,
  SETUP_CODING_STEPS,
  SETUP_CODING_TIERS,
  SETUP_CODING_TRACKS,
} from '../../lib/setup-coding-assistant';
---

<Base
  title="Run a local coding assistant on a Radeon GPU"
  description="Cited Aider, Cline, and Continue on llama-server /v1. Vulkan first. Measured 35B llama.cpp speeds, not harness tok/s."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SETUP_CODING_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Run a local coding assistant on a Radeon GPU</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Start
      <a class="underline decoration-accent/40" href="/backends/llamacpp">llama.cpp</a>
      llama-server with an OpenAI-compatible
      <code>/v1</code>, then point Aider, Cline, or Continue at
      <code>{SETUP_CODING_SERVER}</code>.
      Ubuntu 24.04+ Vulkan is the measured path —
      <a class="underline decoration-accent/40" href="/setup">/setup</a>,
      <a class="underline decoration-accent/40" href="/gpus/r9700">/gpus/r9700</a>.
      House file
      <code>{SETUP_CODING_HOUSE_FILE}</code>.
      LM Studio’s :1234 server is secondary —
      <a class="underline decoration-accent/40" href="/setup/lm-studio">/setup/lm-studio</a>.
      We do not invent harness tok/s or prices.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {SETUP_CODING_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="warn" title="Measured on llama.cpp, not inside Aider">
      <p>
        Official 35B decode numbers are Ubuntu llama-bench cards (102.39 tok/s at
        4K on one R9700, UD-Q5). Aider, Cline, and Continue can call that
        <code>/v1</code>. They cannot claim those tok/s.
      </p>
    </Callout>

    <section id="tracks" class="mt-12 scroll-mt-28" aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="font-serif text-3xl tracking-tight">llama.cpp first</h2>
      <div class="mt-6 grid gap-4">
        {SETUP_CODING_TRACKS.map((track) => (
          <article id={track.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{track.recommend ? 'Try this' : 'Do not start here'}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{track.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{track.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to first edit</h2>
      <ol class="mt-8 space-y-6">
        {SETUP_CODING_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {SETUP_CODING_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="server-cmd" class="mt-12 scroll-mt-28" aria-labelledby="server-cmd-heading">
      <h2 id="server-cmd-heading" class="font-serif text-3xl tracking-tight">Cited llama-server line</h2>
      <p class="mt-3 leading-relaxed text-muted">
        House daily-driver flags. Vulkan binary. Loopback
        <code>/v1</code>. Measured on local-desktop as llama.cpp, not as a harness.
      </p>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_CODING_SERVER_CMD}</code></pre>
    </section>

    <section id="clients" class="mt-12 scroll-mt-28" aria-labelledby="clients-heading">
      <h2 id="clients-heading" class="font-serif text-3xl tracking-tight">Copy-paste clients</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Each block is cited from that tool’s OpenAI-compatible docs. Replace
        <code>qwen</code> with the id from <code>GET /v1/models</code>.
      </p>
      {SETUP_CODING_CLIENTS.map((client) => (
        <article id={client.id} class="mt-6 scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">{client.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{client.note}</p>
          <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-canvas p-4 text-sm leading-relaxed text-ink"><code>{client.body.trim()}</code></pre>
          <p class="mt-3 text-sm">
            <a class="underline decoration-accent/40" href={client.docs} rel="noopener">Official {client.title} docs</a>
            {client.filename ? ` · ${client.filename}` : ''}
          </p>
        </article>
      ))}
    </section>

    <section id="tiers" class="mt-12 scroll-mt-28" aria-labelledby="tiers-heading">
      <h2 id="tiers-heading" class="font-serif text-3xl tracking-tight">Models by VRAM</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Only files already on
        <a class="underline decoration-accent/40" href="/models">/models</a>.
        Q6 / Q5 / Q4 plus a cited Q3 estimate. Nothing below Q3.
      </p>
      <div class="mt-6 grid gap-4">
        {SETUP_CODING_TIERS.map((tier) => (
          <article id={tier.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{tier.vram}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{tier.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{tier.body}</p>
            <p class="mt-3">
              <a class="underline decoration-accent/40" href={tier.href}>{tier.href}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">35B quant picker</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Speeds are
        <strong class="text-ink">measured on llama.cpp directly, not inside Aider, Cline, or Continue</strong>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[32rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            35B GGUF quants for a local coding assistant, with llama.cpp measurements labeled as not from Aider
          </caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-2 pr-3 font-medium">Quant</th>
              <th scope="col" class="py-2 pr-3 font-medium">Role</th>
              <th scope="col" class="py-2 font-medium">llama.cpp on local-desktop (not the harness)</th>
            </tr>
          </thead>
          <tbody>
            {SETUP_CODING_QUANTS.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th scope="row" class="py-3 pr-3 font-mono text-ink">
                  {row.quant}
                  {row.estimate ? (
                    <span class="mt-1 block font-sans text-xs font-normal text-faint">Estimate</span>
                  ) : null}
                </th>
                <td class="py-3 pr-3 text-muted">{row.role}</td>
                <td class="py-3 text-ink">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (llama.cpp-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Wherever a file spills off the GPU, the two labels stay
        <strong class="text-ink">Minimum system RAM needed</strong>
        and
        <strong class="text-ink">RAM needed at full context</strong>.
        House 35B peaks below are Ubuntu llama.cpp, not Aider.
      </p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Stack Lab remains Ubuntu llama.cpp-first. There is no Aider package and no
        public download.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {SETUP_CODING_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/setup/coding-assistant" />
  </main>
</Base>
