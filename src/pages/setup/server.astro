---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HouseRam from '../../components/HouseRam.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import {
  SETUP_SERVER_CITED_LABEL,
  SETUP_SERVER_DESCRIPTION,
  SETUP_SERVER_ENABLE,
  SETUP_SERVER_HUB_LINKS,
  SETUP_SERVER_LAN,
  SETUP_SERVER_LEAD,
  SETUP_SERVER_LOGS,
  SETUP_SERVER_RESTART,
  SETUP_SERVER_SOURCES,
  SETUP_SERVER_STEPS,
  SETUP_SERVER_TITLE,
  SETUP_SERVER_TUNNEL,
  SETUP_SERVER_UFW,
  SETUP_SERVER_UNIT,
} from '../../lib/setup-server';
---

<Base title={SETUP_SERVER_TITLE} description={SETUP_SERVER_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SETUP_SERVER_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
      Run llama.cpp as an always-on local AI server on Linux
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{SETUP_SERVER_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {SETUP_SERVER_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="linux" title="Loopback first">
      <p>
        llama-server’s documented <code>--host</code> default is <code>127.0.0.1</code>.
        Dual-card systemd examples stay on
        <a class="underline decoration-accent/40" href="/setup/multi-gpu">/setup/multi-gpu</a>.
        This unit is an example, not a measured local-desktop service.
      </p>
    </Callout>

    <section id="unit" class="mt-12 scroll-mt-28" aria-labelledby="unit-heading">
      <h2 id="unit-heading" class="font-serif text-3xl tracking-tight">House unit</h2>
      <p class="mt-3 leading-relaxed text-muted">
        One GPU, Vulkan <code>llama-server</code>, house 35B. Replace the binary, GGUF, and
        <code>User=</code> login. systemd.service documents <code>Type</code>,
        <code>ExecStart</code>, <code>Restart</code>, and <code>User</code>.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_UNIT.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_ENABLE.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_LOGS.trim()}</code></pre>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to always-on</h2>
      <ol class="mt-8 space-y-6">
        {SETUP_SERVER_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {SETUP_SERVER_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="lan" class="mt-12 scroll-mt-28" aria-labelledby="lan-heading">
      <h2 id="lan-heading" class="font-serif text-3xl tracking-tight">LAN, ufw, and SSH</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Opt-in only. <code>--api-key</code> is from the llama-server README. ufw and
        <code>ssh -L</code> are unofficial for llama.cpp.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_LAN.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_UFW.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_TUNNEL.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_SERVER_RESTART.trim()}</code></pre>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (Ubuntu-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">
        <strong class="text-ink">Minimum system RAM needed</strong>
        and
        <strong class="text-ink">RAM needed at full context</strong>
        for the house 35B. Those peaks are llama-bench on local-desktop, not this unit.
      </p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Stack Lab remains Ubuntu-first. Packages are not published yet and there is no
        public download.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {SETUP_SERVER_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
            {source.official ? '' : ' — unofficial for llama.cpp'}
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/setup/server" />
  </main>
</Base>
