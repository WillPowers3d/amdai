---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HouseRam from '../../components/HouseRam.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import {
  SETUP_DOCKER_CITED_LABEL,
  SETUP_DOCKER_COMPOSE,
  SETUP_DOCKER_COMPOSE_DUAL,
  SETUP_DOCKER_HUB_LINKS,
  SETUP_DOCKER_SOURCES,
  SETUP_DOCKER_STEPS,
  SETUP_DOCKER_TRACKS,
} from '../../lib/setup-docker';
---

<Base
  title="Run llama.cpp on Radeon in Docker or Podman"
  description="Cited official llama.cpp Vulkan and ROCm images on Radeon. Localhost /v1. Not measured on local-desktop."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SETUP_DOCKER_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Run llama.cpp on Radeon in Docker or Podman</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Ubuntu 24.04+ on bare metal is still the measured AMDai path —
      <a class="underline decoration-accent/40" href="/setup">/setup</a>,
      <a class="underline decoration-accent/40" href="/gpus/r9700">/gpus/r9700</a>,
      <a class="underline decoration-accent/40" href="/benchmarks">/benchmarks</a>.
      This page is the isolated first-run: official ggml-org llama.cpp images, host
      device nodes, localhost <code>/v1</code>. Everything here is
      <strong class="text-ink">{SETUP_DOCKER_CITED_LABEL}</strong>.
      We do not invent image tags, tok/s, prices, or a container speed delta.
      llama.cpp first.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {SETUP_DOCKER_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="warn" title="Not measured on local-desktop">
      <p>
        Official 35B decode numbers on AMDai are Ubuntu llama-bench cards. A Docker or
        Podman box can still get a first token. It cannot claim those tok/s, and we do
        not cite a container overhead number.
      </p>
    </Callout>

    <section id="tracks" class="mt-12 scroll-mt-28" aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="font-serif text-3xl tracking-tight">Two tracks</h2>
      <div class="mt-6 grid gap-4">
        {SETUP_DOCKER_TRACKS.map((track) => (
          <article id={track.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{track.recommend ? 'Try this' : 'Do not start here'}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{track.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{track.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to first token</h2>
      <ol class="mt-8 space-y-6">
        {SETUP_DOCKER_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {SETUP_DOCKER_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="compose" class="mt-12 scroll-mt-28" aria-labelledby="compose-heading">
      <h2 id="compose-heading" class="font-serif text-3xl tracking-tight">Compose examples</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Cited shape only. Replace the NVMe host path. HIP adds
        <code>/dev/kfd</code> and optional <code>seccomp=unconfined</code> from AMD’s
        ROCm 10.1 container page. Not measured on local-desktop.
      </p>
      <h3 class="mt-6 font-serif text-2xl tracking-tight">One card, Vulkan</h3>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_DOCKER_COMPOSE.trim()}</code></pre>
      <h3 class="mt-6 font-serif text-2xl tracking-tight">Two copies</h3>
      <pre class="mt-3 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{SETUP_DOCKER_COMPOSE_DUAL.trim()}</code></pre>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (Ubuntu-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Use the calculator before you download a second quant. The two labels stay
        <strong class="text-ink">Minimum system RAM needed</strong>
        and
        <strong class="text-ink">RAM needed at full context</strong>.
        The house 35B peaks below are Ubuntu, not Docker or Podman.
      </p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Stack Lab remains Ubuntu-first. The button is the allowlisted scheme. There is no
        container package and no public download.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {SETUP_DOCKER_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/setup/docker" />
  </main>
</Base>
