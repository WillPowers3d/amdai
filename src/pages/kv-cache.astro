---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HowWeTest from '../components/HowWeTest.astro';
import HouseRam from '../components/HouseRam.astro';
import NextSteps from '../components/NextSteps.astro';
import SystemRamNeed from '../components/SystemRamNeed.astro';
import {
  COMPARE_ENGINE,
  COMPARE_MODEL,
  COMPARE_Q3,
  SWEEP_REVERIFY,
} from '../lib/local-desktop-compare';
import {
  KV_CACHE_DESCRIPTION,
  KV_CACHE_EMPTY,
  KV_CACHE_FAQ,
  KV_CACHE_FLAGS,
  KV_CACHE_HUB,
  KV_CACHE_LEAD,
  KV_CACHE_QUALITY,
  KV_CACHE_RAM,
  KV_CACHE_SECTIONS,
  KV_CACHE_SOURCES,
  KV_CACHE_STACK_LAB,
  KV_CACHE_TITLE,
  KV_CACHE_WHAT,
  KV_CACHE_WHY_F16,
  kvContextRows,
  kvFitRows,
  kvHouseRamNeed,
} from '../lib/kv-cache';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../lib/ram-surfaces';

const contexts = kvContextRows();
const fit = kvFitRows();
const ramNeed = kvHouseRamNeed();
---

<Base title={KV_CACHE_TITLE} description={KV_CACHE_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">
      {COMPARE_MODEL} · {COMPARE_ENGINE} · f16 vs q8_0 vs q4_0
    </p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{KV_CACHE_TITLE}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{KV_CACHE_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {KV_CACHE_HUB.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-4">
      <HouseRam which="daily" compact />
    </div>

    <Callout type="warn" title="Overnight sweep, 2026-10-12">
      <p>{SWEEP_REVERIFY}</p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="KV cache sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {KV_CACHE_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="what-it-is" class="mt-10 scroll-mt-36" aria-labelledby="what-it-is-heading">
      <h2 id="what-it-is-heading" class="font-serif text-3xl tracking-tight">What the KV cache is</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{KV_CACHE_WHAT}</p>
      <p class="mt-4">
        <a class="btn-secondary" href="/glossary#kv-cache">Glossary · KV cache</a>
        <a class="btn-ghost ml-3" href="/calculator">Open calculator</a>
      </p>
    </section>

    <section id="flags" class="mt-12 scroll-mt-36" aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-serif text-3xl tracking-tight">llama.cpp flags</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{KV_CACHE_FLAGS}</p>
      <p class="mt-4">
        <a class="btn-secondary" href="/tuning">Speed up llama.cpp</a>
        <a class="btn-ghost ml-3" href="/backends/llamacpp">llama.cpp</a>
      </p>
    </section>

    <section id="why-f16" class="mt-12 scroll-mt-36" aria-labelledby="why-f16-heading">
      <h2 id="why-f16-heading" class="font-serif text-3xl tracking-tight">Why the house box stays f16</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{KV_CACHE_WHY_F16}</p>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{KV_CACHE_QUALITY}</p>
      <p class="mt-4">
        <a class="btn-secondary" href="/gpus/r9700">R9700 measured page</a>
        <a class="btn-ghost ml-3" href="/long-context">Long context</a>
      </p>
    </section>

    <section id="per-context" class="mt-12 scroll-mt-36" aria-labelledby="per-context-heading">
      <h2 id="per-context-heading" class="font-serif text-3xl tracking-tight">Per-context VRAM on one R9700</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        House file is {COMPARE_MODEL} UD-Q5_K_XL on {COMPARE_ENGINE} Vulkan, one R9700.
        Peak VRAM is measured only for f16 KV. The three KV-only columns are calculator
        estimates from the official card (10 full-attention layers × 2 heads × 256 dim).
        q8_0 and q4_0 totals stay <strong class="text-ink">{KV_CACHE_EMPTY}</strong>.
        The house window is 262144 tokens (printed 256K on the overnight cards).
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-[48rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            Measured f16 peak VRAM and estimated KV-only GiB at 4K, 32K, 128K, and 256K for the house 35B on one R9700.
          </caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Context</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">
                Peak VRAM · f16
                <span class="block text-[0.65rem] font-normal text-faint">measured</span>
              </th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">
                KV only · f16
                <span class="block text-[0.65rem] font-normal text-faint">estimate</span>
              </th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">
                KV only · q8_0
                <span class="block text-[0.65rem] font-normal text-faint">estimate</span>
              </th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">
                KV only · q4_0
                <span class="block text-[0.65rem] font-normal text-faint">estimate</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {contexts.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-3 pr-4 font-medium text-ink">{row.label}</th>
                <td class="py-3 pr-4 tabular-nums text-muted">{row.measuredF16Vram}</td>
                <td class="py-3 pr-4 tabular-nums text-muted">{row.kvF16}</td>
                <td class="py-3 pr-4 tabular-nums text-muted">{row.kvQ8}</td>
                <td class="py-3 pr-4 tabular-nums text-muted">{row.kvQ4}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4">
        <a class="btn-secondary" href="/results">Run cards</a>
        <a class="btn-ghost ml-3" href="/calculator">Size a window</a>
      </p>
    </section>

    <section id="fit" class="mt-12 scroll-mt-36" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">Fit by card at 262144, f16 KV</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Q6 / Q5 / Q4 from the calculator unless a cell says measured. {COMPARE_Q3} is a
        labeled estimate — no Q3 download or run on the local desktop. When a file does not sit in
        VRAM, shopper RAM lines stay <strong class="text-ink">{RAM_MIN_LABEL}</strong> and
        <strong class="text-ink">{RAM_FULL_LABEL}</strong>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-[64rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            House 35B Q6 Q5 Q4 plus labeled Q3 estimate at 262144 f16 KV on 12 16 20 24 32 GB Radeon cards and dual R9700.
          </caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Card</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Q6</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Q5</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Q4</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Q3 (estimate)</th>
            </tr>
          </thead>
          <tbody>
            {fit.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-3 pr-4 font-medium text-ink">
                  <a class="underline decoration-accent/40" href={row.href}>{row.card}</a>
                  <span class="block text-[0.65rem] font-normal text-faint">{row.vram}</span>
                </th>
                <td class="py-3 pr-4 text-muted">{row.q6.text}</td>
                <td class="py-3 pr-4 text-muted">{row.q5.text}</td>
                <td class="py-3 pr-4 text-muted">{row.q4.text}</td>
                <td class="py-3 pr-4 text-muted">{row.q3.text}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="ram" class="mt-12 scroll-mt-36" aria-labelledby="ram-heading">
      <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">Both RAM lines</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{KV_CACHE_RAM}</p>
      <div class="mt-4 max-w-3xl">
        <SystemRamNeed need={ramNeed} />
      </div>
    </section>

    <section id="stack-lab" class="mt-12 scroll-mt-36" aria-labelledby="stack-lab-heading">
      <h2 id="stack-lab-heading" class="font-serif text-3xl tracking-tight">Stack Lab</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{KV_CACHE_STACK_LAB}</p>
      <p class="mt-4">
        <a class="btn-secondary" href="/stack-lab">Stack Lab planner</a>
        <a class="btn-ghost ml-3" href="/amdai-bench">amdai-bench</a>
      </p>
    </section>

    <section id="faq" class="mt-12 scroll-mt-36" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <ul class="mt-6 grid gap-4">
        {KV_CACHE_FAQ.map((item) => (
          <li id={item.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{item.question}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
            {item.links?.length ? (
              <ul class="mt-4 flex flex-wrap gap-2">
                {item.links.map((link) => (
                  <li>
                    <a
                      class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-36" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
        {KV_CACHE_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href}>{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <NextSteps path="/kv-cache" />
  </main>
</Base>
