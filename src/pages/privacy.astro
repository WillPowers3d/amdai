---
import Base from '../layouts/Base.astro';
import { accountsEnabled } from '../lib/flags';
---

<Base
  title="Privacy"
  description="What R9700 Lab Notes collects when optional accounts are on — email, saved rigs, and nothing else we do not need."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Legal</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Privacy</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      This site is independent documentation. We are not affiliated with AMD. Content pages are static
      and do not need an account. Accounts are optional and currently
      <strong class="text-ink">{accountsEnabled() ? 'on for this build' : 'off on the public static build'}</strong>.
    </p>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">What we collect</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
        <li>Email address (magic link) or the verified GitHub email, if you sign in.</li>
        <li>Saved rigs you choose to store: GPU, VRAM, RAM, OS, backend, models/quants (Q4+), context, and the three preference toggles.</li>
        <li>Notification preference (instant / weekly / forum replies) and an unsubscribe token.</li>
        <li>If the forum is on: thread and reply text you post, optional attached-rig snapshots, votes, and reports.</li>
        <li>Session cookie and a CSRF cookie. No advertising IDs. No live prices.</li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">What we do not collect</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
        <li>Passwords — magic link or GitHub only.</li>
        <li>Payment data, cloud API keys, or model weights.</li>
        <li>Analytics beacons beyond an optional affiliate click ping if you set one locally.</li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">Your controls</h2>
      <p class="mt-3 leading-relaxed text-muted">
        On <a class="underline decoration-accent/40 underline-offset-2" href="/account">/account</a> you can edit or
        delete rigs and export them as JSON. Email alerts are opt-in. Every alert includes an unsubscribe link.
        POSTs to account and forum endpoints check CSRF and are rate-limited. Forum reply mail is opt-in.
      </p>
    </section>
  </main>
</Base>
