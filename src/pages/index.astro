---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { officialLinks, plannedSections, primaryNav, site } from '../lib/site';

const tutorials = (await getCollection('tutorials'))
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  <main id="main">
    <section class="border-b border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:py-20">
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Home-lab notes · Linux first</p>
          <h1 class="mt-4 max-w-xl font-serif text-4xl leading-[1.05] tracking-tight text-balance sm:text-6xl">
            A workstation GPU for local AI — explained like a lab notebook.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
            People search for an “AMD R9700 Pro.” AMD’s official name is the
            <strong class="font-medium text-ink">{site.officialGpu}</strong>:
            an RDNA 4 Radeon AI PRO card with 32&nbsp;GB of GDDR6, listed on the current ROCm matrix as
            <code class="rounded bg-accent-soft px-1.5 py-0.5 font-mono text-[0.95em] text-accent-ink">gfx1201</code>.
            This site is for putting one in a tower at home and actually running models.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white" href="/tutorials/install-rocm">Install ROCm</a>
            <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/gpus">Read the GPU guide</a>
          </div>
        </div>
        <aside class="self-start rounded-2xl border border-line bg-raised p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">What this site covers</p>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed">
            {primaryNav.slice(1).map((item) => (
              <li class="border-b border-line/80 pb-3 last:border-0 last:pb-0">
                <a class="font-medium text-ink hover:text-accent-ink" href={item.href}>{item.label}</a>
                <p class="text-muted">{item.description}</p>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-3">
        <article class="rounded-2xl border border-line bg-raised/60 p-6">
          <h2 class="font-serif text-2xl">Why this card at home</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Consumer Radeon cards are cheaper and often enough for smaller models. The R9700 exists because 32&nbsp;GB of VRAM changes which checkpoints you can keep entirely on the GPU — especially if you want longer context or less aggressive quantization. AMD publishes it as a desktop workstation card, not an Instinct accelerator.
          </p>
        </article>
        <article class="rounded-2xl border border-line bg-raised/60 p-6">
          <h2 class="font-serif text-2xl">Linux is the realistic path</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            ROCm is a first-class Linux stack. Windows can run some inference through Vulkan or a limited PyTorch-on-ROCm slice, but a home lab that wants HIP, <code class="font-mono text-accent-ink">rocm-smi</code>, and the usual server tools should plan on Ubuntu or another listed distro.
          </p>
        </article>
        <article class="rounded-2xl border border-line bg-raised/60 p-6">
          <h2 class="font-serif text-2xl">No invented numbers</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Official product-page specs are labeled. We do not publish homemade tokens-per-second charts. If a step depends on AMD’s current support matrix, the page says so and links the source.
          </p>
        </article>
      </div>
    </section>

    <section class="border-y border-line bg-raised/30">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">Start here</p>
            <h2 class="mt-2 font-serif text-3xl sm:text-4xl">Featured tutorials</h2>
          </div>
          <a class="hidden text-sm text-muted hover:text-ink sm:inline" href="/tutorials">All tutorials →</a>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {tutorials.map((item) => (
            <a class="group rounded-2xl border border-line bg-canvas p-5 transition-colors hover:border-accent/50" href={`/tutorials/${item.id}`}>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
                {item.data.difficulty} · {item.data.minutes} min
              </p>
              <h3 class="mt-2 font-serif text-2xl group-hover:text-accent-ink">{item.data.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">From the notebook</p>
        <h2 class="mt-2 font-serif text-3xl">Latest posts</h2>
        <ul class="mt-6 divide-y divide-line">
          {posts.map((post) => (
            <li class="py-4 first:pt-0">
              <a class="font-medium hover:text-accent-ink" href={`/blog/${post.id}`}>{post.data.title}</a>
              <p class="mt-1 text-sm text-muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
        <a class="mt-4 inline-block text-sm text-muted hover:text-ink" href="/blog">Blog index →</a>
      </div>
      <div class="rounded-2xl border border-line p-6">
        <h2 class="font-serif text-2xl">Official starting points</h2>
        <p class="mt-2 text-sm text-muted">These change. Prefer the live AMD pages over anything cached in a blog post — including this one.</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={officialLinks.product}>AMD Radeon AI PRO R9700 product page</a></li>
          <li><a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={officialLinks.compatibility}>ROCm Linux system requirements / GPU matrix</a></li>
          <li><a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={officialLinks.rocmInstall}>ROCm quick-start install</a></li>
          <li><a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href={officialLinks.pytorch}>Install PyTorch for ROCm</a></li>
        </ul>
        <div class="mt-8 border-t border-line pt-6" id="planned-home">
          <h3 class="font-serif text-xl">Room to grow</h3>
          <p class="mt-2 text-sm text-muted">
            The nav is built so FAQ, a hardware guide, and troubleshooting can land later without dummy pages today. Those three are listed as planned in the footer.
          </p>
          <ul class="mt-3 text-sm text-faint">
            {plannedSections.map((item) => <li>— {item.label}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>
</Base>
