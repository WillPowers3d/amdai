---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusPanel from '../components/StatusPanel.astro';
import HouseRules from '../components/HouseRules.astro';
import { officialLinks, primaryNav, site } from '../lib/site';

const tutorials = (await getCollection('tutorials')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Base>
  <main id="main">
    <section class="border-b border-line">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:py-16">
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Consumer AMD ROCm · living notes</p>
          <h1 class="mt-4 max-w-xl font-serif text-4xl leading-[1.05] tracking-tight text-balance sm:text-6xl">
            Local Qwen on Radeon. Built from a real R9700 test rig.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
            ROCm is AMD’s open compute stack — the Linux software that lets a Radeon run local models instead of sitting there as a display card.
            This site is for people at home, not a cluster: which GGUF, which engine, and whether it fits your VRAM.
          </p>
          <p class="mt-4 max-w-xl text-muted">
            Our test rig is two <strong class="font-medium text-ink">{site.officialGpu}</strong> cards
            (<code class="rounded bg-accent-soft px-1.5 py-0.5 font-mono text-[0.95em] text-accent-ink">gfx1201</code>, 32&nbsp;GB each) and 256&nbsp;GB DDR5.
            The daily driver uses <strong class="font-medium text-ink">one</strong> card.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white" href="/stacks">Recommended stacks</a>
            <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/calculator">Quant + Hardware Calculator</a>
            <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/start">Getting started</a>
            <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/backends">Backend chooser</a>
          </div>
        </div>
        <StatusPanel />
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">Pick your path</p>
      <h2 class="mt-2 font-serif text-3xl">Linux, Windows, or Docker</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-3">
        {[
          {
            n: '01',
            href: '/tutorials/run-local-llm',
            t: 'Linux + llama.cpp',
            d: 'The consumer default. Vulkan (or HIP gfx1201) on Ubuntu, Qwen3.6-35B-A3B UD-Q5_K_XL on one 32 GB card, 262K context.',
          },
          {
            n: '02',
            href: '/faq',
            t: 'Windows',
            d: 'Honest path is Vulkan llama.cpp. Full ROCm userspace is a Linux product. Do not expect rocm-smi culture on Windows.',
          },
          {
            n: '03',
            href: '/tutorials/serve-qwen',
            t: 'Docker / vLLM try',
            d: 'When several clients need a real /v1. Community ROCm vLLM 0.31 is a try; llama.cpp stays the daily driver.',
          },
        ].map((step) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] text-faint">{step.n}</p>
            <a class="mt-1 block font-serif text-2xl hover:text-accent-ink" href={step.href}>{step.t}</a>
            <p class="mt-2 text-sm text-muted">{step.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-y border-line bg-raised/30">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <HouseRules />
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <a class="block rounded-2xl border border-line bg-canvas p-6 hover:border-accent/50" href="/stacks">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-accent">From the rig</p>
            <h2 class="mt-2 font-serif text-3xl">Two stacks we actually run</h2>
            <p class="mt-3 text-muted">Daily driver: Qwen3.6-35B-A3B Q5 on llama.cpp Vulkan, one R9700, 262K, no RAM offload. Fast agent: Qwen 3.8 Flash Q6 on Strata.</p>
          </a>
          <a class="block rounded-2xl border border-line bg-canvas p-6 hover:border-accent/50" href="/calculator">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-accent">Fit check</p>
            <h2 class="mt-2 font-serif text-3xl">Quant + Hardware Calculator</h2>
            <p class="mt-3 text-muted">Presets for those two stacks, plus your own card, quant (Q4+ only), context, and KV type. Shareable URL. Estimates, not benches.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-line">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">Map</p>
        <h2 class="mt-2 font-serif text-3xl">Everything in the nav</h2>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {primaryNav.map((item) => (
            <li>
              <a class="block rounded-xl border border-line bg-canvas p-4 hover:border-accent/50" href={item.href}>
                <span class="font-medium">{item.label}</span>
                <span class="mt-1 block text-sm text-muted">{item.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">Tutorials</p>
        <h2 class="mt-2 font-serif text-3xl">Do the work</h2>
        <ul class="mt-5 divide-y divide-line">
          {tutorials.map((item) => (
            <li class="py-3">
              <a class="font-medium hover:text-accent-ink" href={`/tutorials/${item.id}`}>{item.data.title}</a>
              <p class="text-sm text-muted">{item.data.description}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">Dated notes</p>
        <h2 class="mt-2 font-serif text-3xl">ROCm / vLLM snapshots</h2>
        <ul class="mt-5 divide-y divide-line">
          {updates.map((item) => (
            <li class="py-3">
              <p class="font-mono text-[0.68rem] text-faint">{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
              <a class="font-medium hover:text-accent-ink" href="/updates">{item.data.title}</a>
              <p class="text-sm text-muted">{item.data.summary}</p>
            </li>
          ))}
        </ul>
        <ul class="mt-6 space-y-2 text-sm">
          {posts.map((post) => (
            <li><a class="text-muted hover:text-ink" href={`/blog/${post.id}`}>{post.data.title}</a></li>
          ))}
        </ul>
        <p class="mt-4 text-sm">
          <a class="text-muted hover:text-ink" href={officialLinks.compatibility}>AMD GPU matrix ↗</a>
        </p>
      </div>
    </section>
  </main>
</Base>
