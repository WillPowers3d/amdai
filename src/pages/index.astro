---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusPanel from '../components/StatusPanel.astro';
import HouseRules from '../components/HouseRules.astro';
import SiliconGrid from '../components/SiliconGrid.astro';
import RigWizard from '../components/RigWizard.astro';
import { HERO_HEADLINE, officialLinks, site } from '../lib/site';

const tutorials = (await getCollection('tutorials')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Base>
  <main id="main">
    <section class="relative overflow-hidden border-b border-line">
      <SiliconGrid />
      <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
        <div>
          <p class="kicker">Consumer Radeon · living notes</p>
          <h1 class="display mt-5 max-w-xl text-4xl sm:text-6xl lg:text-[4.4rem]">
            {HERO_HEADLINE}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
            AMDai is the independent notebook for home-lab AI on Radeon. Which GGUF, which engine, whether it fits your VRAM — grounded in a two-card test rig, written for people who buy one GPU.
          </p>
          <p class="mt-4 max-w-xl text-muted">
            Our test rig is two <strong class="font-medium text-ink">{site.officialGpu}</strong> cards
            (<code class="rounded bg-accent-soft px-1.5 py-0.5 font-mono text-[0.95em] text-accent-ink">gfx1201</code>, 32&nbsp;GB each) and 256&nbsp;GB DDR5.
            The daily driver uses <strong class="font-medium text-ink">one</strong> card.
          </p>
        </div>
        <RigWizard />
      </div>
    </section>

    <section class="border-b border-line">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <StatusPanel />
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <p class="kicker">Radeon → model → agent</p>
      <h2 class="display mt-2 text-3xl sm:text-4xl">Your card, a tested model, then the harness</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Pick a Radeon with a recipe, run the house Qwen on llama.cpp (or Strata for Flash), then point Hermes, Aider, Cline, or OpenCode at <code>:8080</code> / <code>:8083</code>.
        Compatibility means a recipe passed our gates — not a spreadsheet.
      </p>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        <li class="card p-5">
          <p class="kicker">1 · Radeon</p>
          <h3 class="mt-2 text-xl tracking-tight">Start from the card you own</h3>
          <p class="mt-2 text-sm text-muted">R9700 has tested recipes. Other directory cards stay listed as gaps.</p>
          <p class="mt-4"><a class="underline decoration-accent/40" href="/gpus/r9700">R9700 recipes</a> · <a class="underline decoration-accent/40" href="/gpus">Directory</a></p>
        </li>
        <li class="card p-5">
          <p class="kicker">2 · Tested model</p>
          <h3 class="mt-2 text-xl tracking-tight">Daily 35B or Flash</h3>
          <p class="mt-2 text-sm text-muted">Qwen3.6-35B-A3B on llama.cpp Vulkan. Flash on Strata when you want the faster agent.</p>
          <p class="mt-4"><a class="underline decoration-accent/40" href="/models/qwen36">35B</a> · <a class="underline decoration-accent/40" href="/models/flash">Flash</a> · <a class="underline decoration-accent/40" href="/qwen">All Qwen</a></p>
        </li>
        <li class="card p-5">
          <p class="kicker">3 · Agent</p>
          <h3 class="mt-2 text-xl tracking-tight">Hermes, Aider, Cline, OpenCode</h3>
          <p class="mt-2 text-sm text-muted">Same OpenAI-shaped /v1. Copy the snippet generated from the recipe’s port and model name.</p>
          <p class="mt-4"><a class="underline decoration-accent/40" href="/harnesses/connect">Connect a harness</a></p>
        </li>
      </ol>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <p class="kicker">From the rig</p>
      <h2 class="display mt-2 text-3xl sm:text-4xl">Tested stacks, measured where we have numbers</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        <a class="card p-6" href="/stacks">
          <p class="kicker">Daily driver</p>
          <h3 class="mt-2 text-2xl tracking-tight">Qwen3.6-35B-A3B · UD-Q5_K_XL</h3>
          <p class="mt-3 text-muted">llama.cpp Vulkan on one R9700. 262K context, f16 KV, 0% RAM offload. <strong class="text-ink">102.39 tok/s</strong> short context, 90.52 at 32K, 66.43 at 128K, 44.4 at 256K — Measured on our rig, 2026-10.</p>
          <p class="mt-4 flex flex-wrap gap-2">
            <span class="badge-tested">Measured on our rig, 2026-10</span>
            <span class="badge">102.39 / 90.52 / 44.4 tok/s</span>
          </p>
        </a>
        <a class="card p-6" href="/flash-daily">
          <p class="kicker">Fast agent</p>
          <h3 class="mt-2 text-2xl tracking-tight">Qwen 3.8 Flash · UD-Q6_K_XL</h3>
          <p class="mt-3 text-muted">Two-card Q6 at 262K: Strata <strong class="text-ink">32.8 tok/s</strong> at 8K/32K, 31.8 at 100K. Prior first-party ~32.6 vs llama.cpp ~16. DDR5 speed is a visible factor.</p>
          <p class="mt-4 flex flex-wrap gap-2">
            <span class="badge-tested">Measured on our rig, 2026-10</span>
            <span class="badge">32.8 / 31.8 tok/s</span>
          </p>
        </a>
        <a class="card p-6" href="/qwen36-dual">
          <p class="kicker">Two cards</p>
          <h3 class="mt-2 text-2xl tracking-tight">35B · two copies beat a split</h3>
          <p class="mt-3 text-muted">UD-Q5_K_XL on llama.cpp Vulkan, DDR5-5200. Two single-card copies: about 100 tok/s per request, 172 total at 2 concurrent. A split server tops out at 79.</p>
          <p class="mt-4 flex flex-wrap gap-2">
            <span class="badge-tested">Measured on our rig, 2026-10</span>
            <span class="badge">0 errors in 423</span>
          </p>
        </a>
        <a class="card p-6" href="/benchmarks">
          <p class="kicker">First-party</p>
          <h3 class="mt-2 text-2xl tracking-tight">Benchmarks</h3>
          <p class="mt-3 text-muted">Overnight 35B llama.cpp matrix from official run cards — UD-Q5 / Q5 / Q4 / Q6 at 4K–256K, one GPU and split. Flash Strata vs llama.cpp stays its own cited block. Empty cells stay not measured.</p>
          <p class="mt-4 flex flex-wrap gap-2">
            <span class="badge-tested">Measured on our rig, 2026-10</span>
            <span class="badge">No leaderboard spam</span>
          </p>
        </a>
      </div>
    </section>

    <section class="border-y border-line bg-raised/30">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
        <p class="kicker">The rest of the lab</p>
        <h2 class="display mt-2 text-3xl sm:text-4xl">Directory, troubleshooter, forum, ROCm</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <a class="card p-6" href="/gpus">
            <p class="kicker">Hardware</p>
            <h3 class="mt-2 text-2xl tracking-tight">GPU directory</h3>
            <p class="mt-3 text-sm text-muted">Radeon cards, gfx IDs, VRAM, official ROCm rows. No invented support claims.</p>
          </a>
          <a class="card p-6" href="/bios">
            <p class="kicker">Firmware</p>
            <h3 class="mt-2 text-2xl tracking-tight">BIOS for local AI</h3>
            <p class="mt-3 text-sm text-muted">Above 4G, ReBAR/SAM, CSM off, x8/x8 vs x16/x4, EXPO/XMP, IOMMU. Cited chipsets; board table empty until submissions.</p>
          </a>
          <a class="card p-6" href="/results">
            <p class="kicker">Comparable</p>
            <h3 class="mt-2 text-2xl tracking-tight">Official run cards</h3>
            <p class="mt-3 text-sm text-muted">amdai-bench/run@1 cards credited to amdai on local-desktop. Exact launch command. No invented tok/s.</p>
          </a>
          <a class="card p-6" href="/troubleshoot/errors">
            <p class="kicker">When it breaks</p>
            <h3 class="mt-2 text-2xl tracking-tight">Troubleshooter</h3>
            <p class="mt-3 text-sm text-muted">Paste a log. Cited patterns for ROCm, Ollama, HIP, and reset hangs.</p>
          </a>
          <a class="card p-6" href="/forum">
            <p class="kicker">Community</p>
            <h3 class="mt-2 text-2xl tracking-tight">Forum</h3>
            <p class="mt-3 text-sm text-muted">Categories, rig badges, and solved marks. Off on this static build until FORUM_ENABLED.</p>
          </a>
          <a class="card p-6" href="/rocm">
            <p class="kicker">The stack</p>
            <h3 class="mt-2 text-2xl tracking-tight">What is ROCm</h3>
            <p class="mt-3 text-sm text-muted">Plain-English deep dive: the stack, gfx IDs, Vulkan vs HIP, versions, history, glossary, FAQ.</p>
          </a>
          <a class="card p-6" href="/faq">
            <p class="kicker">First questions</p>
            <h3 class="mt-2 text-2xl tracking-tight">FAQ</h3>
            <p class="mt-3 text-sm text-muted">Which GPU, Ubuntu vs Windows, 35B vs Flash, how to read the measured matrix, and when Q3 is only an estimate.</p>
          </a>
          <a class="card p-6" href="/setup">
            <p class="kicker">First token</p>
            <h3 class="mt-2 text-2xl tracking-tight">First-run setup</h3>
            <p class="mt-3 text-sm text-muted">Ubuntu 24.04+ to a measured recipe, plus an honest Windows path. llama.cpp first. No invented tok/s.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <HouseRules />
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <a class="card p-6" href="/budget">
          <p class="kicker">Spend</p>
          <h3 class="mt-2 text-2xl tracking-tight">Setup by budget</h3>
          <p class="mt-3 text-muted">Starter 16 GB through the two-R9700 Pro rig. No invented prices.</p>
        </a>
        <a class="card p-6" href="/calculator">
          <p class="kicker">Fit check</p>
          <h3 class="mt-2 text-2xl tracking-tight">Quant calculator</h3>
          <p class="mt-3 text-muted">Weights, KV, and overhead stacked against card capacity. Shareable URL.</p>
        </a>
        <a class="card p-6" href="/abliterated">
          <p class="kicker">Educational</p>
          <h3 class="mt-2 text-2xl tracking-tight">Abliterated hub</h3>
          <p class="mt-3 text-muted">Never the default. Test official instruct first. Tested pick: being reworked.</p>
        </a>
      </div>
    </section>

    <section class="border-t border-line">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2">
        <div>
          <p class="kicker">Tutorials</p>
          <h2 class="display mt-2 text-3xl">Do the work</h2>
          <ul class="mt-5 divide-y divide-line">
            {tutorials.map((item) => (
              <li class="py-3">
                <a class="font-medium hover:text-accent-ink" href={`/tutorials/${item.id}`}>{item.data.title}</a>
                <p class="text-sm text-muted">{item.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="kicker">Dated notes</p>
          <h2 class="display mt-2 text-3xl">ROCm / vLLM snapshots</h2>
          <ul class="mt-5 divide-y divide-line">
            {updates.map((item) => (
              <li class="py-3">
                <p class="font-mono text-[0.68rem] text-faint">{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
                <a class="font-medium hover:text-accent-ink" href="/updates">{item.data.title}</a>
                <p class="text-sm text-muted">{item.data.summary}</p>
              </li>
            ))}
          </ul>
          <ul class="mt-6 space-y-2 text-sm">
            {posts.map((post) => (
              <li><a class="text-muted hover:text-ink" href={`/blog/${post.id}`}>{post.data.title}</a></li>
            ))}
          </ul>
          <p class="mt-4 text-sm">
            <a class="text-muted hover:text-ink" href={officialLinks.compatibility}>AMD GPU matrix ↗</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</Base>
