---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import RunCard from '../components/RunCard.astro';
import { FLASH_RERUN_NOTE, RUN_SCHEMA, SWEEP_REVERIFY, officialAmdaiRuns, uniqueRunFilters } from '../lib/run-card';
import { runs } from '../lib/run-card-data';
import { AMDAI_BENCH_SCHEMA, AMDAI_BENCH_VERSION } from '../lib/results';
import HowWeTest from '../components/HowWeTest.astro';

const cards = runs;
const options = uniqueRunFilters(cards);
const officialCount = officialAmdaiRuns(cards).length;
const submittedCount = cards.filter((card) => !card.submitted_by.verified).length;
---

<Base
  title="Official test-run cards"
  description="amdai-bench/run@1 cards from overnight local desktop tests — credited to the submitter, with the exact launch command. Verified AMDai rows feed the model, GPU, and 35B tables."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">{RUN_SCHEMA}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Official test-run cards</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      Every overnight local desktop drop lands here as one card, credited to AMDai.
      The house verified rows show the badge. A measured Qwen 3.8 Flash Q3 run is an approved
      one-time exception — when that jsonl line arrives, it will show as measured.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href="#cards">Run cards</a>
      <a class="btn-secondary" href="/compare">Compare 35B</a>
      <a class="btn-secondary" href="/amdai-bench/runs.json">Download run JSON</a>
      <a class="btn-ghost" href="/amdai-bench/run@1.schema.json">JSON Schema</a>
      <a class="btn-ghost" href="/amdai-bench.v1.json">Derived v{AMDAI_BENCH_VERSION} catalog</a>
    </div>
    <div class="mt-4">
      <HowWeTest />
    </div>

    <Callout type="warn" title="Flash / Strata / Q3 pending">
      <p>{FLASH_RERUN_NOTE} This drop is 35B llama.cpp only. No Flash rows were added.</p>
    </Callout>

    <Callout type="warn" title="Overnight sweep, 2026-10-12">
      <p>
        {SWEEP_REVERIFY}
        Q6_K single-GPU 4K table cell is 103.23 tok/s (23:55). The earlier 82.62 card stays here and is not averaged.
      </p>
    </Callout>

    <Callout type="check" title="Verified vs submitted">
      Green <strong class="text-ink">Verified</strong> cards were measured on the local desktop and credited to AMDai.
      This snapshot has {officialCount} official AMDai cards.
      <strong class="text-ink">Submitted</strong> is the badge for a community jsonl line that matches
      <code>{RUN_SCHEMA}</code> and has not been rerun here. There are {submittedCount} submitted cards.
      Unverified rows do not fill the model, GPU, or 35B tables.
    </Callout>

    <section class="mt-10" aria-labelledby="schema-heading">
      <h2 id="schema-heading" class="font-serif text-3xl">amdai-bench/run@1</h2>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        Published schema in <code>docs/amdai-bench-run.schema.json</code>.
        Stack Lab’s amdai-bench emitter writes this object (one jsonl line).
        The older <code>{AMDAI_BENCH_SCHEMA}</code> v{AMDAI_BENCH_VERSION} file is derived from
        verified 35B single-card llama.cpp rows only — it never invents Flash scores.
      </p>
    </section>

    <section id="cards" class="mt-12 scroll-mt-28" aria-labelledby="cards-heading">
      <h2 id="cards-heading" class="font-serif text-3xl">Filter the cards</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Filters run in the browser. Without JavaScript the full set stays visible.
        Each card links to its own page with the exact launch command.
      </p>

      <form id="results-filters" class="card mt-6 grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-3" aria-controls="results-list">
        <label class="block text-sm">
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Model</span>
          <select name="model" class="field mt-1">
            <option value="">All models</option>
            {options.model.map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Backend</span>
          <select name="backend" class="field mt-1">
            <option value="">All backends</option>
            {options.backend.map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Quant</span>
          <select name="quant" class="field mt-1">
            <option value="">All quants</option>
            {options.quant.map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Context</span>
          <select name="context" class="field mt-1">
            <option value="">All contexts</option>
            {options.context.map((value) => (
              <option value={String(value)}>{value.toLocaleString()} tokens</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">GPUs used</span>
          <select name="gpus" class="field mt-1">
            <option value="">Any count</option>
            {options.gpus.map((value) => (
              <option value={String(value)}>{value}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Trust</span>
          <select name="trust" class="field mt-1">
            <option value="">Verified + submitted</option>
            <option value="verified">Verified only</option>
            <option value="submitted">Submitted only</option>
          </select>
        </label>
        <div class="flex flex-wrap items-end gap-3 sm:col-span-2 lg:col-span-3">
          <button type="reset" class="btn-ghost">Clear filters</button>
          <p id="results-count" class="text-sm text-muted">{cards.length} cards</p>
        </div>
      </form>

      <div id="results-list" class="mt-8 grid gap-6">
        {cards.map((card) => (
          <RunCard card={card} heading="h3" />
        ))}
      </div>
      <div id="results-empty" class="card mt-6 hidden p-6" role="status">
        <p class="kicker">Empty</p>
        <h3 class="mt-2 text-xl tracking-tight">No cards match these filters</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Overnight drops go in <code>data/runs/*.jsonl</code>. We will not invent a row to fill a filter.
        </p>
      </div>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById('results-filters');
  const list = document.getElementById('results-list');
  const empty = document.getElementById('results-empty');
  const count = document.getElementById('results-count');
  if (form instanceof HTMLFormElement && list && empty && count) {
    const cards = [...list.querySelectorAll('article')];
    const apply = () => {
      const data = new FormData(form);
      const model = String(data.get('model') ?? '');
      const backend = String(data.get('backend') ?? '');
      const quant = String(data.get('quant') ?? '');
      const context = String(data.get('context') ?? '');
      const gpus = String(data.get('gpus') ?? '');
      const trust = String(data.get('trust') ?? '');
      let visible = 0;
      for (const card of cards) {
        const show =
          (!model || card.dataset.model === model) &&
          (!backend || card.dataset.backend === backend) &&
          (!quant || card.dataset.quant === quant) &&
          (!context || card.dataset.context === context) &&
          (!gpus || card.dataset.gpus === gpus) &&
          (!trust || card.dataset.verified === trust);
        card.hidden = !show;
        if (show) visible += 1;
      }
      empty.classList.toggle('hidden', visible > 0);
      count.textContent = visible === 1 ? '1 card' : `${visible} cards`;
    };
    form.addEventListener('change', apply);
    form.addEventListener('reset', () => {
      queueMicrotask(apply);
    });
  }
</script>
