---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import OvernightRows from '../components/OvernightRows.astro';
import { FLASH_RERUN_NOTE, SWEEP_REVERIFY, contextLabel, matchRuns, runPath, verifiedMeasured } from '../lib/run-card';
import { runs } from '../lib/run-card-data';
import { MEASURED_ON_OUR_RIG } from '../lib/local-desktop-dual';
import { local-desktopDual as file } from '../lib/local-desktop-dual-data';

const splitOfficial = [4096, 32768, 131072, 262144].map((ctx) => {
  const card = matchRuns(verifiedMeasured(runs), {
    model: 'qwen36',
    quant: 'UD-Q5_K_XL',
    backend: 'llama.cpp',
    context: ctx,
    layout: 'split',
    gpus: 2,
  })[0];
  return {
    ctx,
    label: contextLabel(ctx),
    decode: card?.results.decode_tps ?? null,
    prefill: card?.results.prefill_tps ?? null,
    vramPerGpu: card?.results.peak_vram_gb_per_gpu ?? [],
    vram: card?.results.peak_vram_gb_total ?? null,
    ram: card?.results.peak_system_ram_gb ?? null,
    href: card ? runPath(card.run_id) : '/results',
    runId: card?.run_id ?? null,
  };
});

const copies = file.copies;
const split = file.split;
---

<Base
  title="Qwen 3.6 35B on two R9700s"
  description="UD-Q5_K_XL on local-desktop: one split server versus two single-card copies behind a least-connections balancer. Measured on our rig, 2026-10."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">{file.host} · {file.as_of}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Two R9700s, one 35B</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      {file.quant} on {file.engine}, {file.ddr5}. {file.gpus}.
      Every tok/s, VRAM, and soak figure below is first-party unless a citation says otherwise.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href="/stacks">Daily-driver stack</a>
      <a class="btn-secondary" href="/flash-daily">Flash daily driver</a>
      <a class="btn-ghost" href="/compare/one-vs-two-gpu">One vs split</a>
      <a class="btn-ghost" href="/benchmarks">Benchmarks</a>
      <a class="btn-ghost" href="/backends/llamacpp">llama.cpp</a>
    </div>

    <Callout type="warn" title="Flash / Strata / Q3 pending">
      <p>{FLASH_RERUN_NOTE} This page is 35B llama.cpp only.</p>
    </Callout>

    <Callout type="warn" title="Overnight sweep, 2026-10-12">
      <p>{SWEEP_REVERIFY}</p>
    </Callout>

    <Callout type="check" title="Recommendation">
      <p>
        <strong class="text-ink">{file.recommendation}</strong>
        Official split llama-bench is <strong class="text-ink">{split.max_total_tok_s} tok/s</strong> at 4K
        and <strong class="text-ink">{split.single_request_tok_s} tok/s</strong> at 256K.
        Two copies still hold about <strong class="text-ink">{copies.per_request_tok_s} tok/s</strong> per request.
      </p>
    </Callout>

    <p class="mt-6 text-sm text-muted">
      RAM is Linux GiB labeled GB. The kit is {file.kit.dimm_gb} GB
      (about {file.kit.usable_gb} usable). {file.kit.usable_note}
    </p>

    <section class="mt-12" aria-labelledby="copies-heading">
      <p class="kicker">{MEASURED_ON_OUR_RIG}</p>
      <h2 id="copies-heading" class="mt-2 font-serif text-3xl">{copies.title}</h2>
      <p class="mt-3 max-w-2xl text-muted">{copies.note}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card p-5">
          <p class="text-faint">Per request</p>
          <p class="mt-1 font-serif text-3xl tabular-nums">{copies.per_request_tok_s} tok/s</p>
          <p class="mt-1 text-xs text-faint">About 100 tok/s · one copy per card</p>
        </div>
        <div class="card p-5">
          <p class="text-faint">Total · 2 concurrent</p>
          <p class="mt-1 font-serif text-3xl tabular-nums">{copies.total_at_2_tok_s} tok/s</p>
        </div>
        <div class="card p-5">
          <p class="text-faint">Total · 4–8 concurrent</p>
          <p class="mt-1 font-serif text-3xl tabular-nums">~{copies.total_at_4_to_8_tok_s} tok/s</p>
        </div>
        <div class="card p-5">
          <p class="text-faint">Soak</p>
          <p class="mt-1 font-serif text-3xl tabular-nums">{copies.soak_errors} errors</p>
          <p class="mt-1 text-xs text-faint">
            {copies.soak_requests} requests · {copies.soak_minutes} minutes
          </p>
        </div>
      </div>
      <dl class="card mt-6 grid gap-4 p-5 sm:grid-cols-3">
        <div>
          <dt class="text-faint">Peak VRAM</dt>
          <dd class="mt-1 text-ink">{copies.peak_vram_gb[0]} / {copies.peak_vram_gb[1]} GB</dd>
          <dd class="text-xs text-faint">Linux GiB labeled GB · card A / card B</dd>
        </div>
        <div>
          <dt class="text-faint">DDR5</dt>
          <dd class="mt-1 text-ink">about {copies.ddr5_gb} GB</dd>
          <dd class="text-xs text-faint">Against the {file.kit.dimm_gb} GB kit · {file.kit.usable_gb} usable</dd>
        </div>
        <div>
          <dt class="text-faint">Balancer</dt>
          <dd class="mt-1 text-ink">Least connections</dd>
          <dd class="text-xs text-faint">One llama-server per card</dd>
        </div>
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="split-heading">
      <p class="kicker">{MEASURED_ON_OUR_RIG}</p>
      <h2 id="split-heading" class="mt-2 font-serif text-3xl">{split.title}</h2>
      <p class="mt-3 max-w-2xl text-muted">{split.note}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="card p-5">
          <p class="text-faint">Single request · 256K</p>
          <p class="mt-1 font-serif text-3xl tabular-nums">{split.single_request_tok_s} tok/s</p>
        </div>
        <div class="card p-5">
          <p class="text-faint">4K decode · split</p>
          <p class="mt-1 font-serif text-3xl tabular-nums">{split.max_total_tok_s} tok/s</p>
        </div>
      </div>
      <div class="card mt-6 overflow-x-auto">
        <table class="table-lab min-w-[36rem]">
          <caption>35B on two R9700s — measured decode, prefill, VRAM, and system RAM from local-desktop.</caption>
          <thead>
            <tr>
              <th scope="col">Context</th>
              <th scope="col">Decode</th>
              <th scope="col">Prefill</th>
              <th scope="col">VRAM / card</th>
              <th scope="col">VRAM total</th>
              <th scope="col">System RAM</th>
              <th scope="col">Card</th>
            </tr>
          </thead>
          <tbody>
            {splitOfficial.map((row) => (
              <tr>
                <td class="font-medium">{row.label}</td>
                <td class="tabular-nums">{row.decode != null ? `${row.decode} tok/s` : 'not measured'}</td>
                <td class="tabular-nums">{row.prefill != null ? `${row.prefill} tok/s` : 'not measured'}</td>
                <td class="tabular-nums">{row.vramPerGpu.length ? `${row.vramPerGpu.join(' / ')} GB` : 'not measured'}</td>
                <td class="tabular-nums">{row.vram != null ? `${row.vram} GB` : 'not measured'}</td>
                <td class="tabular-nums">{row.ram != null ? `${row.ram} GB` : 'not measured'}</td>
                <td>
                  {row.runId ? (
                    <a class="underline decoration-accent/40" href={row.href}>{row.runId}</a>
                  ) : (
                    'not measured'
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted">
        Official llama-bench split (c060ca974 Vulkan, UD-Q5_K_XL, two R9700s).
        A split 35B is slower than one card and much slower than two copies.
        House rule still stands: one LLM per GPU unless you deliberately combine.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="single-heading">
      <p class="kicker">Reference · one card</p>
      <h2 id="single-heading" class="mt-2 font-serif text-3xl">Single-card 35B</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Same rig, one R9700, llama.cpp Vulkan, f16 KV.
        {MEASURED_ON_OUR_RIG}.
      </p>
      <div class="card mt-6 overflow-x-auto">
        <table class="table-lab min-w-[36rem]">
          <caption>Single-card 35B decode on one R9700. Measured on our rig.</caption>
          <thead>
            <tr>
              <th scope="col">Quant</th>
              <th scope="col">Context</th>
              <th scope="col">Decode</th>
              <th scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {file.single_card.map((row) => (
              <tr>
                <td class="font-medium">{row.quant}</td>
                <td>{row.context}</td>
                <td class="tabular-nums">{row.tok_s} tok/s</td>
                <td class="text-muted">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="vllm-heading">
      <p class="kicker">Community image · first-party band</p>
      <h2 id="vllm-heading" class="mt-2 font-serif text-3xl">vLLM on gfx1201</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Image <code>{file.vllm.image}</code>, {file.vllm.quant}, {file.vllm.cards} card.
        About <strong class="text-ink">{file.vllm.tok_s_low}–{file.vllm.tok_s_high} tok/s</strong> on one card.
        {file.vllm.vs_llamacpp}
        vLLM stays unused on the engine catalog — this is a cited try, not the daily driver.
      </p>
      <Callout type="note" title="Community table, not the house band">
        <p>{file.vllm.community_table_note}</p>
      </Callout>
    </section>

    <OvernightRows rows={file.overnight_results_json_rows} note={file.overnight_note} />

    <section class="mt-12" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl">Sources</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {file.sources.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href}>{source.title}</a>
            <span class="text-faint"> · {source.date}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
