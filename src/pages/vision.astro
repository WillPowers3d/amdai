---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import {
  VISION_CITED_LABEL,
  VISION_DESCRIPTION,
  VISION_FAQ,
  VISION_FIT_ROWS,
  VISION_HUB_LINKS,
  VISION_LEAD,
  VISION_SECTIONS,
  VISION_SOURCES,
  VISION_SPEED_LABEL,
  VISION_STEPS,
  VISION_TITLE,
  VISION_WHAT,
} from '../lib/vision';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../lib/ram-surfaces';
---

<Base title={VISION_TITLE} description={VISION_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">{VISION_CITED_LABEL}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{VISION_TITLE}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{VISION_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {VISION_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>

    <Callout type="note" title="llama.cpp mmproj first, not image gen">
      <p>
        Local vision on AMDai is image in, text out: a text GGUF plus a matching
        mmproj, served by <code class="font-mono text-ink">llama-mtmd-cli</code> or
        <code class="font-mono text-ink">llama-server --mmproj</code>.
        That is not ComfyUI. Speeds are
        <strong class="text-ink">{VISION_SPEED_LABEL}</strong> — the gap is on
        <a class="underline decoration-accent/40" href="/wanted">/wanted</a>
        as a first-party <code class="font-mono text-ink">amdai-bench/run@1</code> card.
        Q3 stays a labeled estimate. The house 35B daily driver is text-only.
      </p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="Vision sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {VISION_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="what-it-is" class="mt-10 scroll-mt-36" aria-labelledby="what-it-is-heading">
      <h2 id="what-it-is-heading" class="font-serif text-3xl tracking-tight">What local vision is</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{VISION_WHAT}</p>
      <Callout type="note" title="Go deeper">
        <p>
          Pairing is architecture-specific. Shopper RAM lines stay
          <strong class="text-ink">{RAM_MIN_LABEL}</strong> and
          <strong class="text-ink">{RAM_FULL_LABEL}</strong>
          because the projector can stay on GPU or move off with
          <code class="font-mono text-ink">--no-mmproj-offload</code>.
          Image generation is a different job at
          <a class="underline decoration-accent/40" href="/image-gen">/image-gen</a>.
        </p>
      </Callout>
    </section>

    <section id="linux" class="mt-12 scroll-mt-36" aria-labelledby="linux-heading">
      <h2 id="linux-heading" class="font-serif text-3xl tracking-tight">Linux path — two files, then a picture</h2>
      <ol class="mt-6 grid gap-4">
        {VISION_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Step {index + 1}</p>
            <h3 class="mt-1 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="fit" class="mt-12 scroll-mt-36" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">GPU-class fit</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Every row is a labeled estimate. Confirm both GGUFs. Speed stays {VISION_SPEED_LABEL}.
        Q3 is a labeled estimate.
      </p>
      <ul class="mt-6 grid gap-4">
        {VISION_FIT_ROWS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.vramClass}</h3>
            <p class="mt-3 leading-relaxed text-muted">{row.fit}</p>
            <p class="mt-2 text-sm text-faint">Speed · {row.speed}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {row.cards.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq" class="mt-12 scroll-mt-36" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <ul class="mt-6 grid gap-4">
        {VISION_FAQ.map((item) => (
          <li id={item.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{item.question}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {item.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-36" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
        {VISION_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href}>{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <NextSteps path="/vision" />
  </main>
</Base>
