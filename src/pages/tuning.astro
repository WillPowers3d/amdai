---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import SystemRamNeed from '../components/SystemRamNeed.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import { runPath } from '../lib/run-card';
import { runs } from '../lib/run-card-data';
import {
  COMPARE_MODEL,
  COMPARE_Q3,
  RAM_FULL_LABEL,
  RAM_MIN_LABEL,
  TUNING_CITED_LABEL,
  TUNING_DESCRIPTION,
  TUNING_FAQ,
  TUNING_HOUSE_LAUNCH,
  TUNING_HUB_LINKS,
  TUNING_KNOBS,
  TUNING_LEAD,
  TUNING_RAM_NOTE,
  TUNING_SECTIONS,
  TUNING_SOURCES,
  TUNING_TITLE,
  TUNING_UNMEASURED,
  tuningMeasuredRows,
  tuningOffloadRamNeed,
} from '../lib/tuning';

const measured = tuningMeasuredRows(runs);
const ramNeed = tuningOffloadRamNeed();
---

<Base title={TUNING_TITLE} description={TUNING_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">{TUNING_CITED_LABEL}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{TUNING_TITLE}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{TUNING_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {TUNING_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-4 grid gap-3">
      <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
    </div>

    <Callout type="note" title="Measure one knob at a time">
      <p>
        Official decode cells are the local desktop {COMPARE_MODEL} llama.cpp Vulkan sweep.
        Everything else stays <strong class="text-ink">{TUNING_UNMEASURED}</strong>.
        Stack Lab planner plus an <a class="underline decoration-accent/40" href="/amdai-bench">amdai-bench</a> card
        is how you A/B this on your box. Q3 is a labeled estimate. Draft models stay Q4 and up.
      </p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="Tuning sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {TUNING_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="measured" class="mt-12 scroll-mt-28" aria-labelledby="measured-heading">
      <h2 id="measured-heading" class="font-serif text-3xl tracking-tight">Measured 35B on one R9700</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Official llama.cpp Vulkan cells from existing run cards. Empty stays {TUNING_UNMEASURED}.
        {COMPARE_Q3} is a labeled estimate. Full matrix:
        <a class="underline decoration-accent/40" href="/benchmarks">/benchmarks</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">{COMPARE_MODEL} decode on one R9700</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Kind</th>
              <th class="py-2 pr-3 font-normal" scope="col">4K decode</th>
              <th class="py-2 pr-3 font-normal" scope="col">32K decode</th>
              <th class="py-2 font-normal" scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {measured.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">{row.quant}</th>
                <td class="py-3 pr-3 text-muted">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Measured'}</td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && row.decode4k !== TUNING_UNMEASURED ? (
                    <span class="text-accent-ink">{row.decode4k}</span>
                  ) : (
                    <span class="text-faint">{row.decode4k}</span>
                  )}
                </td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && row.decode32k !== TUNING_UNMEASURED ? (
                    <span class="text-accent-ink">{row.decode32k}</span>
                  ) : (
                    <span class="text-faint">{row.decode32k}</span>
                  )}
                </td>
                <td class="py-3 text-xs text-faint">
                  {row.note}
                  {row.runIds.length > 0 && (
                    <p class="mt-1">
                      {row.runIds.map((id) => (
                        <a class="mr-2 underline decoration-accent/40" href={runPath(id)}>{id}</a>
                      ))}
                    </p>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="house" class="mt-12 scroll-mt-28" aria-labelledby="house-heading">
      <h2 id="house-heading" class="font-serif text-3xl tracking-tight">House launch</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Start here, then change one flag. Exact recipe:
        <a class="underline decoration-accent/40" href="/recipes/qwen36-35b.llamacpp-vulkan.262k">qwen36-35b.llamacpp-vulkan.262k</a>.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{TUNING_HOUSE_LAUNCH}</pre>
    </section>

    {TUNING_KNOBS.map((knob) => (
      <section id={knob.id} class="mt-12 scroll-mt-28" aria-labelledby={`${knob.id}-heading`}>
        <h2 id={`${knob.id}-heading`} class="font-serif text-3xl tracking-tight">{knob.title}</h2>
        <p class="mt-2 font-mono text-sm text-accent-ink">{knob.flag}</p>
        <dl class="mt-5 grid gap-4 text-sm">
          <div>
            <dt class="text-faint">What it does</dt>
            <dd class="mt-1 leading-relaxed text-muted">{knob.what}</dd>
          </div>
          <div>
            <dt class="text-faint">When it helps</dt>
            <dd class="mt-1 leading-relaxed text-muted">{knob.when}</dd>
          </div>
          <div>
            <dt class="text-faint">Tradeoff</dt>
            <dd class="mt-1 leading-relaxed text-muted">{knob.tradeoff}</dd>
          </div>
        </dl>
        <pre class="mt-5 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{knob.example}</pre>
        <p class="mt-2 text-xs text-faint">{knob.exampleNote}</p>
        <p class="mt-3 text-sm text-muted">{knob.stackLab}</p>
        <p class="mt-3 text-sm">
          {knob.links.map((link, index) => (
            <>
              {index > 0 ? ' · ' : ''}
              <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      </section>
    ))}

    <section id="ram" class="mt-12 scroll-mt-28" aria-labelledby="ram-heading">
      <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">System RAM</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TUNING_RAM_NOTE}</p>
      <p class="mt-3 text-sm text-muted">
        Shopper lines stay <strong class="text-ink">{RAM_MIN_LABEL}</strong> and
        <strong class="text-ink">{RAM_FULL_LABEL}</strong>.
      </p>
      <div class="mt-6">
        <SystemRamNeed need={ramNeed} />
      </div>
    </section>

    <section id="faq" class="mt-12 scroll-mt-28" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <dl class="mt-6 grid gap-6">
        {TUNING_FAQ.map((item) => (
          <div>
            <dt class="font-serif text-2xl tracking-tight">{item.question}</dt>
            <dd class="mt-2 leading-relaxed text-muted">{item.answer}</dd>
            <dd class="mt-2 text-sm">
              {item.links.map((link, index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {TUNING_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel={source.href.startsWith('http') ? 'noopener' : undefined}>
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40" href="/guides/quantize-gguf">Make GGUF quants</a>
      ·
      <a class="underline decoration-accent/40" href="/fine-tuning">Fine-tuning</a>
      ·
      <a class="underline decoration-accent/40" href="/setup">Setup</a>
      ·
      <a class="underline decoration-accent/40" href="/faq">FAQ</a>
    </p>
    <NextSteps path="/tuning" />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
