---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import HouseRam from '../../components/HouseRam.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import SystemRamNeed from '../../components/SystemRamNeed.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import { runPath } from '../../lib/run-card';
import { runs } from '../../lib/run-card-data';
import {
  COMPARE_MODEL,
  COMPARE_Q3,
  LLAMA_FN,
  LLAMA_GRAMMARS,
  LLAMA_SERVER,
  RAM_FULL_LABEL,
  RAM_MIN_LABEL,
  TC_CITED_LABEL,
  TC_CURL_SCHEMA,
  TC_CURL_TOOLS,
  TC_DESCRIPTION,
  TC_FAQ,
  TC_FLAGS,
  TC_HEADING,
  TC_HOUSE,
  TC_HOUSE_TEMPLATE,
  TC_HUB_LINKS,
  TC_JINJA,
  TC_LAUNCH,
  TC_LEAD,
  TC_NAME,
  TC_PACK,
  TC_PATH,
  TC_RAM_NOTE,
  TC_SECTIONS,
  TC_SOURCES,
  TC_STACK_LAB,
  TC_STRATA,
  TC_STRUCTURED,
  TC_TROUBLE,
  TC_UNMEASURED,
  TC_WHAT,
  tcDailyRamNeed,
  tcFitNote,
  tcFitRows,
  tcMeasuredRows,
  tcOffloadRamNeed,
  tcQ3RamNeed,
} from '../../lib/tool-calling';

const measured = tcMeasuredRows(runs);
const fit32k = tcFitRows(32768);
const fit262k = tcFitRows(262144);
const dailyRam = tcDailyRamNeed();
const offloadRam = tcOffloadRamNeed();
const q3Ram = tcQ3RamNeed();
---

<Base title={TC_NAME} description={TC_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">{TC_CITED_LABEL}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{TC_HEADING}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{TC_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {TC_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>
    {dailyRam && (
      <div class="mt-6">
        <HouseRam which="daily" compact />
      </div>
    )}
    <div class="mt-4 grid gap-3">
      <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
    </div>

    <Callout type="warn" title="Tool-call success is not measured here">
      <p>
        {TC_UNMEASURED}. Baseline 35B decode is the official local desktop llama.cpp Vulkan
        sweep with no tools array. {TC_STACK_LAB} {COMPARE_Q3} is a labeled estimate.
      </p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="Tool calling sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {TC_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="what" class="mt-12 scroll-mt-28" aria-labelledby="what-heading">
      <h2 id="what-heading" class="font-serif text-3xl tracking-tight">What a tool call is</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_WHAT}</p>
      <p class="mt-3 text-sm text-muted">
        Official path:
        <a class="underline decoration-accent/40" href={LLAMA_FN} rel="noopener">llama.cpp function-calling.md</a>
        ·
        <a class="underline decoration-accent/40" href="/setup/coding-assistant">coding assistant</a>
        ·
        <a class="underline decoration-accent/40" href="/harnesses">harnesses</a>.
      </p>
    </section>

    <section id="jinja" class="mt-12 scroll-mt-28" aria-labelledby="jinja-heading">
      <h2 id="jinja-heading" class="font-serif text-3xl tracking-tight">--jinja and templates</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_JINJA}</p>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_HOUSE_TEMPLATE}</p>
      <ul class="mt-6 grid gap-4">
        {TC_FLAGS.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-mono text-sm text-accent-ink">{row.flag}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{row.meaning}</p>
            <p class="mt-2 text-xs text-faint">{row.cite}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="structured" class="mt-12 scroll-mt-28" aria-labelledby="structured-heading">
      <h2 id="structured-heading" class="font-serif text-3xl tracking-tight">Structured JSON</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_STRUCTURED}</p>
      <p class="mt-3 text-sm text-muted">
        Official:
        <a class="underline decoration-accent/40" href={LLAMA_SERVER} rel="noopener">server README</a>
        ·
        <a class="underline decoration-accent/40" href={LLAMA_GRAMMARS} rel="noopener">grammars/README.md</a>
        ·
        <a class="underline decoration-accent/40" href="/glossary#gbnf">GBNF</a>
        ·
        <a class="underline decoration-accent/40" href="/glossary#json-schema">JSON schema</a>.
        Measure pack {TC_PACK} on
        <a class="underline decoration-accent/40" href="/stack-lab">Stack Lab</a>
        — do not invent an overhead tok/s.
      </p>
    </section>

    <section id="house" class="mt-12 scroll-mt-28" aria-labelledby="house-heading">
      <h2 id="house-heading" class="font-serif text-3xl tracking-tight">House launch</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_HOUSE}</p>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_STRATA}</p>
      <p class="mt-3 text-sm text-muted">
        Daily-driver recipe:
        <a class="underline decoration-accent/40" href="/recipes/qwen36-35b.llamacpp-vulkan.262k">qwen36-35b.llamacpp-vulkan.262k</a>
        · Coding clients:
        <a class="underline decoration-accent/40" href="/setup/coding-assistant">/setup/coding-assistant</a>
        · Hermes:
        <a class="underline decoration-accent/40" href="/harnesses/hermes">/harnesses/hermes</a>
        · Strata (not verified for tools):
        <a class="underline decoration-accent/40" href="/backends/strata">/backends/strata</a>.
      </p>
      <pre class="mt-6 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{TC_LAUNCH}</pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{TC_CURL_TOOLS}</pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{TC_CURL_SCHEMA}</pre>
      <p class="mt-3 text-sm text-faint">
        Shape only. Official tools payload from
        <a class="underline decoration-accent/40" href={LLAMA_FN} rel="noopener">function-calling.md</a>,
        pointed at house <code class="text-ink">qwen</code> on
        <code class="text-ink">127.0.0.1:8080</code>. Not a measured success rate.
      </p>
    </section>

    <section id="trouble" class="mt-12 scroll-mt-28" aria-labelledby="trouble-heading">
      <h2 id="trouble-heading" class="font-serif text-3xl tracking-tight">Troubleshooting</h2>
      <ul class="mt-6 grid gap-4">
        {TC_TROUBLE.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{row.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="measured" class="mt-12 scroll-mt-28" aria-labelledby="measured-heading">
      <h2 id="measured-heading" class="font-serif text-3xl tracking-tight">Measured 35B — no tools</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Official {COMPARE_MODEL} llama.cpp Vulkan cells from existing run cards.
        These launches have no tools array. Tool-call and grammar cells stay unmeasured.
        {COMPARE_Q3} is a labeled estimate. Full matrix:
        <a class="underline decoration-accent/40" href="/benchmarks">/benchmarks</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">{COMPARE_MODEL} decode on one R9700 without tools</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Kind</th>
              <th class="py-2 pr-3 font-normal" scope="col">4K decode</th>
              <th class="py-2 pr-3 font-normal" scope="col">32K decode</th>
              <th class="py-2 font-normal" scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {measured.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">{row.quant}</th>
                <td class="py-3 pr-3 text-muted">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Measured'}</td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && /tok\/s/.test(row.decode4k) ? (
                    <span class="text-accent-ink">{row.decode4k}</span>
                  ) : (
                    <span class="text-faint">{row.decode4k}</span>
                  )}
                </td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && /tok\/s/.test(row.decode32k) ? (
                    <span class="text-accent-ink">{row.decode32k}</span>
                  ) : (
                    <span class="text-faint">{row.decode32k}</span>
                  )}
                </td>
                <td class="py-3 text-xs text-faint">
                  {row.note}
                  {row.runIds.length > 0 && (
                    <p class="mt-1">
                      {row.runIds.map((id) => (
                        <a class="mr-2 underline decoration-accent/40" href={runPath(id)}>{id}</a>
                      ))}
                    </p>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fit" class="mt-12 scroll-mt-28" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">VRAM fit</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{tcFitNote()}</p>

      <h3 class="mt-8 font-serif text-2xl tracking-tight">One R9700 · 32K</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Calculator leftover VRAM after house 35B at 32K on one R9700</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Weights</th>
              <th class="py-2 pr-3 font-normal" scope="col">Total</th>
              <th class="py-2 pr-3 font-normal" scope="col">Usable</th>
              <th class="py-2 font-normal" scope="col">Leftover</th>
            </tr>
          </thead>
          <tbody>
            {fit32k.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">
                  {row.quant}
                  <span class="mt-1 block text-xs text-faint">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Estimate'}</span>
                </th>
                <td class="py-3 pr-3 tabular-nums">{row.weightsGb}</td>
                <td class="py-3 pr-3 tabular-nums">{row.totalGb}</td>
                <td class="py-3 pr-3 tabular-nums">{row.usableGb}</td>
                <td class="py-3 text-xs text-muted">{row.leftover}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="mt-8 font-serif text-2xl tracking-tight">One R9700 · 262K</h3>
      <p class="mt-2 text-sm text-muted">
        KV grows. Tool schemas sit in that window. Size <code class="text-ink">-c</code> on
        <a class="underline decoration-accent/40" href="/long-context">/long-context</a>.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Calculator leftover VRAM after house 35B at 262K on one R9700</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Total</th>
              <th class="py-2 font-normal" scope="col">Leftover</th>
            </tr>
          </thead>
          <tbody>
            {fit262k.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">{row.quant}</th>
                <td class="py-3 pr-3 tabular-nums">{row.totalGb} of {row.usableGb}</td>
                <td class="py-3 text-xs text-muted">{row.leftover}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <aside class="mt-10 rounded-2xl border border-line bg-raised/40 p-5" aria-labelledby="q3-heading">
      <p class="kicker">Q3 estimate</p>
      <h2 id="q3-heading" class="mt-2 font-serif text-2xl tracking-tight">{COMPARE_Q3}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Q6 / Q5 / Q4 above include this labeled estimate. It is not a house pick and
        not a tool-call card. House files stay Q6 / Q5 / Q4.
      </p>
      <div class="mt-4">
        <SystemRamNeed need={q3Ram} compact />
      </div>
    </aside>

    <section id="ram" class="mt-12 scroll-mt-28" aria-labelledby="ram-heading">
      <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">System RAM</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{TC_RAM_NOTE}</p>
      {dailyRam && (
        <div class="mt-6">
          <h3 class="font-serif text-2xl tracking-tight">House 35B · in-VRAM on one R9700</h3>
          <div class="mt-4">
            <HouseRam which="daily" compact />
          </div>
        </div>
      )}
      <div class="mt-8">
        <h3 class="font-serif text-2xl tracking-tight">Offload example · 16 GB + 35B Q4</h3>
        <p class="mt-2 text-sm text-muted">
          {RAM_MIN_LABEL} and {RAM_FULL_LABEL}. Estimate. A tools payload does not add GGUF weight.
        </p>
        <div class="mt-4">
          <SystemRamNeed need={offloadRam} compact />
        </div>
      </div>
    </section>

    <section id="faq" class="mt-12 scroll-mt-28" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <ul class="mt-6 grid gap-4">
        {TC_FAQ.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.question}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{row.answer}</p>
            <p class="mt-3 text-sm">
              {row.links.map((link, index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {TC_SOURCES.map((source) => (
          <li>
            <a
              class="underline decoration-accent/40"
              href={source.href}
              rel={source.href.startsWith('http') ? 'noopener' : undefined}
            >
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40" href="/setup/coding-assistant">Coding assistant</a>
      ·
      <a class="underline decoration-accent/40" href="/harnesses">Harnesses</a>
      ·
      <a class="underline decoration-accent/40" href="/speculative-decoding">Speculative decoding</a>
      ·
      <a class="underline decoration-accent/40" href="/glossary">Glossary</a>
      ·
      <a class="underline decoration-accent/40" href="/faq">FAQ</a>.
    </p>
    <NextSteps path={TC_PATH} />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
