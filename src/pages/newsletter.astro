---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { NEWSLETTER_CADENCE, NEWSLETTER_NAME, NEWSLETTER_TOPICS } from '../lib/newsletter';
import { newsletterEnabled } from '../lib/flags';
---

<Base
  title="Lab Notes digest"
  description="Email-only AMDai Lab Notes digest: new run cards, guides, ROCm problems, and Stack Lab. Double opt-in, one-click unsubscribe, no account."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">Follow the lab</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{NEWSLETTER_NAME}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Follow new measured run cards, guides, ROCm problem updates, and Stack Lab notes
      without making an account. {NEWSLETTER_CADENCE}
    </p>
    <p class="mt-3 text-sm text-muted">
      We store email, confirm state, topic choices, and timestamps.
      Confirm with the link in mail. Unsubscribe is one click and does not need a login.
      No tracking pixel. On
      <a class="underline decoration-accent/40" href="/account">/account</a>
      you can manage the same topics if you already signed in.
    </p>
    {
      !newsletterEnabled() && (
        <p class="mt-4 text-sm text-faint">
          This static preview shows the form. The hosted mailer accepts signups when
          <code>NEWSLETTER_ENABLED=1</code> or accounts are on. Sending a digest still
          needs <code>NEWSLETTER_SEND=1</code> and an explicit <code>--send</code>.
        </p>
      )
    }

    <div class="card mt-8 p-6">
      <NewsletterSignup variant="page" />
    </div>

    <section class="mt-12" aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="font-serif text-3xl">What you can pick</h2>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
        {NEWSLETTER_TOPICS.map((topic) => (
          <li>
            <a class="font-medium text-ink underline decoration-accent/40" href={topic.href}>{topic.label}</a>
            — {topic.description}
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Privacy:
      <a class="underline decoration-accent/40" href="/privacy">what we store</a>
      ·
      <a class="underline decoration-accent/40" href="/unsubscribe">unsubscribe</a>
    </p>
  </main>
</Base>
