---
import Base from '../layouts/Base.astro';
import { wantedFile } from '../lib/wanted-data';
---

<Base
  title="Wanted recipes"
  description="Radeon card × model gaps we want a sourced recipe for. No bounty amounts until amdai signs them off."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">Gaps · {wantedFile.as_of}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Wanted recipes</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{wantedFile.rule}</p>
    <p class="mt-3 text-sm text-muted">
      Most-requested Radeon gaps from the house stacks. A wanted row is not a claim that the combo fits.
      <a class="underline decoration-accent/40" href="/contribute">Submit a recipe</a>.
    </p>
    <ol class="mt-10 grid gap-4">
      {wantedFile.items.map((item) => (
        <li class="card p-5">
          <p class="kicker">{item.card_name}</p>
          <h2 class="mt-1 text-2xl tracking-tight">{item.model}</h2>
          <p class="mt-3 text-sm text-muted">{item.why}</p>
          <p class="mt-2 text-sm">{item.request}</p>
          <p class="mt-4 text-sm">
            <a class="underline decoration-accent/40" href={`/gpus/${item.card}`}>GPU page</a>
            {' · '}
            <a class="underline decoration-accent/40" href="/contribute">Contribute</a>
          </p>
        </li>
      ))}
    </ol>
  </main>
</Base>
