---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HouseRam from '../components/HouseRam.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import { COMPARE_Q3 } from '../lib/local-desktop-compare';
import {
  CX_ARMS,
  CX_CITED_LABEL,
  CX_DESCRIPTION,
  CX_H1,
  CX_HOUSE,
  CX_HUB_LINKS,
  CX_LADDER,
  CX_LEAD,
  CX_LEAN,
  CX_PACK,
  CX_QUANTS,
  CX_RAM,
  CX_RUN_IT,
  CX_SOURCES,
  CX_STEPS,
  CX_TITLE,
  CX_UNMEASURED,
  CX_WHAT,
} from '../lib/context-ceiling';
---

<Base title={CX_TITLE} description={CX_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{CX_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
      {CX_H1}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{CX_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {CX_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="linux" title="ctx-ceiling/1 is not yet ingested">
      <p>
        House overnight 35B cards recorded llama-bench windows, not a Stack Lab
        <code>{CX_PACK}</code> climb. The finder winner, first fail reason, and
        per-step VRAM stay {CX_UNMEASURED} — open the
        <a class="underline decoration-accent/40" href="/stack-lab">planner</a>.
        Pack {CX_PACK} is the A/B.
      </p>
    </Callout>

    <section id="what" class="mt-12 scroll-mt-28" aria-labelledby="what-heading">
      <h2 id="what-heading" class="font-serif text-3xl tracking-tight">Native max vs the real ceiling</h2>
      <p class="mt-3 leading-relaxed text-muted">{CX_WHAT}</p>
    </section>

    <section id="ladder" class="mt-12 scroll-mt-28" aria-labelledby="ladder-heading">
      <h2 id="ladder-heading" class="font-serif text-3xl tracking-tight">Lean ladder, one GPU, all GPUs</h2>
      <p class="mt-3 leading-relaxed text-muted">{CX_LADDER}</p>
      <ul class="mt-4 space-y-3">
        {CX_ARMS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">{row.shopper}</p>
            <p class="mt-1 text-sm text-muted">{row.what}</p>
            <p class="mt-2 text-sm text-ink">Winner: {row.winner}</p>
            <p class="mt-1 text-sm text-muted">{row.ram}</p>
            <p class="mt-2 text-sm text-muted">{row.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="flags" class="mt-12 scroll-mt-28" aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-serif text-3xl tracking-tight">Cited house pin and lean load</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Vulkan house path. The first block is the recorded llama-server line at
        native 262144 — not a <code>{CX_PACK}</code> winner. The second is a
        lean 4K shape for the kit line. Replace the binary and GGUF paths.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CX_HOUSE.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CX_LEAN.trim()}</code></pre>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">Q6 / Q5 / Q4 plus a labeled Q3</h2>
      <p class="mt-3 leading-relaxed text-muted">
        A smaller GGUF can raise the window that fits, but house recipes stay Q4
        and up. {COMPARE_Q3} is a labeled estimate — do not download it to run.
        Both RAM lines appear. Every <code>{CX_PACK}</code> winner stays {CX_UNMEASURED}.
      </p>
      <ul class="mt-4 space-y-3">
        {CX_QUANTS.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">
              {row.quant}
              {row.estimate ? ' · labeled estimate' : ''}
            </p>
            <p class="mt-1 text-sm text-muted">{row.file}</p>
            <p class="mt-2 text-sm text-ink">Ceiling: {row.ceiling}</p>
            <p class="mt-1 text-sm text-muted">{row.ramMin}</p>
            <p class="mt-1 text-sm text-muted">{row.ramFull}</p>
            <p class="mt-2 text-sm text-muted">{row.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="run-it" class="mt-12 scroll-mt-28" aria-labelledby="run-it-heading">
      <h2 id="run-it-heading" class="font-serif text-3xl tracking-tight">Run it yourself</h2>
      <Callout type="linux" title="Run it yourself">
        <p>
          Stack Lab {CX_PACK} is the lean-ladder climb on one GPU and on all GPUs.
          Export a <code>lab-notes-report/1</code> pack, then ingest into Lab Notes.
          Each row must be a validating <code>amdai-bench/run@1</code> card. Do not
          hand-type tok/s. The pack is not an allowlisted Open-in-Stack-Lab deep
          link — open the planner.
        </p>
      </Callout>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{CX_RUN_IT.trim()}</code></pre>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to a measured ceiling</h2>
      <ol class="mt-8 space-y-6">
        {CX_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {CX_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (Ubuntu-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">{CX_RAM}</p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        {CX_PACK} is the context-ceiling finder. It is not an allowlisted deep
        link on this site. Use the planner. Packages are not published yet and
        there is no public download. Anything unmeasured stays {CX_UNMEASURED}.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {CX_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
            {source.official ? '' : ' — unofficial for llama.cpp'}
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/context-ceiling" />
  </main>
</Base>
