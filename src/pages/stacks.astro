---
import Base from '../layouts/Base.astro';
import HouseRules from '../components/HouseRules.astro';
import BuyButtons from '../components/BuyButtons.astro';
import Qwen36Benches from '../components/Qwen36Benches.astro';
import SystemRamNeed from '../components/SystemRamNeed.astro';
import { stacksGuide } from '../lib/status';
import { systemRamNeedFromQuery } from '../lib/calculator';
---

<Base
  title="Recommended stacks"
  description="Daily driver and fast-agent Qwen stacks from our R9700 test rig — llama.cpp first, Strata when you need speed."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">From the test rig · snapshot {stacksGuide.as_of}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Recommended stacks</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      {stacksGuide.test_rig.label}: {stacksGuide.test_rig.gpus}, {stacksGuide.test_rig.ram}.
      {stacksGuide.test_rig.note}
      Command lines and UD-Q5_K_XL VRAM stay marked TODO.       Decode tok/s for the 35B is filled — see
      <a class="underline decoration-accent/40" href="/benchmarks">benchmarks</a>.
      We do not invent flags.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href="/calculator">Quant + Hardware Calculator</a>
      <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/backends">Inference engines</a>
      <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/gpus">GPU directory</a>
      <a class="rounded-full border border-line bg-raised px-5 py-2.5 text-sm" href="/start">Getting started</a>
    </div>

    <HouseRules />

    <Qwen36Benches />

    <ol class="mt-4 grid gap-5">
      {stacksGuide.stacks.map((stack) => (
        <li id={stack.id} class="card scroll-mt-28 p-5 sm:p-6">
          <p class="kicker">{stack.kicker}</p>
          <div class="mt-1 flex flex-wrap items-end justify-between gap-3">
            <h2 class="font-serif text-3xl">{stack.title}</h2>
            <a class="rounded-full border border-line px-3 py-1.5 text-sm" href={stack.calculator}>Open in calculator</a>
          </div>
          <p class="mt-3 max-w-3xl text-muted">{stack.why}</p>
          <dl class="mt-5 grid gap-3 sm:grid-cols-2">
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Model</dt>
              <dd class="mt-1">{stack.model}</dd>
              <dd class="text-sm text-muted">{stack.official}</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Weights</dt>
              <dd class="mt-1">{stack.gguf}</dd>
              <dd class="text-sm text-muted">{stack.quant}</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Engine</dt>
              <dd class="mt-1">{stack.engine}</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">GPUs</dt>
              <dd class="mt-1">{stack.gpus}</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Context / KV</dt>
              <dd class="mt-1">{stack.context} · {stack.kv}</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">RAM offload</dt>
              <dd class="mt-1">{stack.offload}</dd>
            </div>
          </dl>
          {stack.calculator.includes('?') && (
            <div class="mt-4">
              <SystemRamNeed need={systemRamNeedFromQuery(stack.calculator)} />
            </div>
          )}
          <div class="mt-5 rounded-xl border border-dashed border-line bg-canvas/40 p-4">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">What we know / still TODO</p>
            <ul class="mt-2 space-y-1.5 text-sm text-muted">
              {stack.measured.map((line) => <li>{line}</li>)}
            </ul>
          </div>
          {stack.id === 'daily-driver' && (
            <p class="mt-5 text-sm text-muted">
              Plug a harness into llama-server on <code>127.0.0.1:8080/v1</code> after
              <code>curl</code> works.
              <a class="ml-1 underline decoration-accent/40" href="/harnesses/hermes">Hermes Agent</a>
              is used on our rig.
              <a class="underline decoration-accent/40" href="/harnesses/connect#llama">Connect snippets</a>
              · <a class="underline decoration-accent/40" href="/harnesses">All harnesses</a>.
            </p>
          )}
          {stack.id === 'fast-agent' && (
            <p class="mt-5 text-sm text-muted">
              Plug a harness into Strata on <code>127.0.0.1:8083/v1</code>.
              amdai’s daily agent is
              <a class="underline decoration-accent/40" href="/harnesses/hermes">Hermes</a>,
              pointed at this port and at llama-server.
              <a class="underline decoration-accent/40" href="/harnesses/connect#strata">Connect snippets</a>
              · <a class="underline decoration-accent/40" href="/harnesses">All harnesses</a>.
            </p>
          )}
        </li>
      ))}
    </ol>

    <section class="mt-12">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-accent">Hardware for these stacks</p>
      <h2 class="mt-2 font-serif text-3xl">Check price for the R9700 box</h2>
      <p class="mt-3 max-w-2xl text-muted">No live prices. As an Amazon Associate I earn from qualifying purchases.</p>
      <BuyButtons products={['r9700', 'ddr5-kit', 'nvme', 'psu-1000w']} />
    </section>
  </main>
</Base>
