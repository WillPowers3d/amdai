---
import Base from '../../layouts/Base.astro';
import ProblemsNav from '../../components/problems/ProblemsNav.astro';
import { accountsEnabled, forumEnabled } from '../../lib/flags';
import {
  filterProblems,
  problemMatchesRig,
  problemPath,
  statusLabel,
  uniqueFilterValues,
  type ProblemFilters,
} from '../../lib/rocm-problems';
import { rocmProblems, rocmProblemsFile } from '../../lib/rocm-problems-data';
import type { SavedRigMatch } from '../../lib/rig-match';

export const prerender = !accountsEnabled();

const all = rocmProblems();
const q = Astro.url.searchParams;
const filters: ProblemFilters = {
  gpu: q.get('gpu') || undefined,
  os: q.get('os') || undefined,
  status: q.get('status') || undefined,
};
const mine = q.get('mine') === '1';
const options = uniqueFilterValues(all);
let rows = filterProblems(all, filters);

type RigHit = { name: string; ids: string[] };
let rigHits: RigHit[] = [];
let signedIn = false;

if (accountsEnabled()) {
  const { getSessionUser } = await import('../../server/session');
  const { listRigs, toMatch } = await import('../../server/rigs');
  const session = await getSessionUser(Astro.cookies);
  signedIn = Boolean(session);
  if (session) {
    const rigs = await listRigs(session.id);
    rigHits = rigs.map((rig) => {
      const match: SavedRigMatch = toMatch(rig);
      return {
        name: rig.name,
        ids: rows.filter((problem) => problemMatchesRig(problem, match).matched).map((p) => p.id),
      };
    });
    if (mine) {
      const mineIds = new Set(rigHits.flatMap((hit) => hit.ids));
      rows = rows.filter((problem) => mineIds.has(problem.id));
    }
  }
}

const affecting = new Set(rigHits.flatMap((hit) => hit.ids));
---

<Base
  title="ROCm's open problems"
  description="Cited consumer ROCm problems — Ollama gfx1201, MODE1 resets, HSA_OVERRIDE, WSL limits — and how you can help."
>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <ProblemsNav current="tracker" />
    <h1 class="display mt-6 text-4xl sm:text-5xl">ROCm’s open problems &amp; how you can help</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      A living tracker of <strong class="text-ink">cited</strong> consumer gaps. We do not invent issue
      numbers. Unverified rows stay labeled not recorded. As of {rocmProblemsFile.as_of}.
    </p>
    <p class="mt-4 flex flex-wrap gap-3 text-sm">
      <a class="btn-secondary" href="/rocm-problems/help">How you can help</a>
      <a class="btn-ghost" href="/rocm-problems/report">Write a good report</a>
      <a class="btn-ghost" href="/forum">Forum</a>
      <a class="btn-ghost" href="/rocm">What is ROCm</a>
    </p>

    {signedIn && rigHits.length > 0 && (
      <section class="card mt-8 p-5" aria-labelledby="affects-heading">
        <h2 id="affects-heading" class="text-xl tracking-tight">Affects your rig</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          {rigHits.map((hit) => (
            <li>
              <strong class="text-ink">{hit.name}</strong>
              {hit.ids.length === 0 ? (
                <span> — no tracker rows match the GPU / gfx / OS / backend you saved.</span>
              ) : (
                <span>
                  {' — '}
                  {hit.ids.map((id, i) => (
                    <>
                      {i > 0 && ', '}
                      <a class="underline decoration-accent/40" href={problemPath(id)}>{id}</a>
                    </>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
    {accountsEnabled() && !signedIn && (
      <p class="mt-6 text-sm text-muted">
        <a class="underline decoration-accent/40" href="/login?next=/rocm-problems">Sign in</a> with a
        saved rig to see which rows match. Matching also runs in tests without a login.
      </p>
    )}

    <form class="mt-10 flex flex-wrap items-end gap-3" method="get" action="/rocm-problems">
      <label class="text-sm">
        <span class="text-faint">GPU / gfx</span>
        <select class="field mt-1 min-h-0 py-2" name="gpu">
          <option value="">Any</option>
          {options.gpus.map((gpu) => (
            <option value={gpu} selected={filters.gpu === gpu}>{gpu}</option>
          ))}
        </select>
      </label>
      <label class="text-sm">
        <span class="text-faint">OS</span>
        <select class="field mt-1 min-h-0 py-2" name="os">
          <option value="">Any</option>
          {options.oses.map((os) => (
            <option value={os} selected={filters.os === os}>{os}</option>
          ))}
        </select>
      </label>
      <label class="text-sm">
        <span class="text-faint">Status</span>
        <select class="field mt-1 min-h-0 py-2" name="status">
          <option value="">Any</option>
          <option value="open" selected={filters.status === 'open'}>Open</option>
          <option value="workaround" selected={filters.status === 'workaround'}>Workaround</option>
          <option value="fixed" selected={filters.status === 'fixed'}>Fixed</option>
        </select>
      </label>
      {signedIn && (
        <label class="flex items-center gap-2 text-sm text-muted">
          <input type="checkbox" name="mine" value="1" checked={mine} />
          Only my rig
        </label>
      )}
      <button class="btn-secondary" type="submit">Filter</button>
      {(filters.gpu || filters.os || filters.status || mine) && (
        <a class="btn-ghost" href="/rocm-problems">Clear</a>
      )}
    </form>

    {rows.length === 0 ? (
      <p class="mt-10 text-muted">
        No rows match those filters.
        {forumEnabled() ? (
          <> <a class="underline decoration-accent/40" href="/forum/new?category=install-drivers">Ask the forum</a>.</>
        ) : (
          <> Check the <a class="underline decoration-accent/40" href="/forum/rules">rules</a> and come back when the forum is on.</>
        )}
      </p>
    ) : (
      <ul class="mt-10 space-y-3">
        {rows.map((problem) => (
          <li>
            <a class="card block p-5" href={problemPath(problem.id)}>
              <p class="flex flex-wrap gap-2 text-xs">
                <span class={problem.status === 'open' ? 'badge-warn' : 'badge'}>
                  {statusLabel(problem.status, problem.fixed_in)}
                </span>
                {problem.todo && <span class="badge">not recorded</span>}
                {affecting.has(problem.id) && <span class="badge-tested">Affects your rig</span>}
                {problem.affected_gfx.map((gfx) => <span class="badge">{gfx}</span>)}
                {problem.affected_os.map((os) => <span class="badge">{os}</span>)}
              </p>
              <h2 class="mt-3 text-xl tracking-tight">{problem.title}</h2>
              <p class="mt-2 text-sm text-muted">{problem.summary}</p>
              <p class="mt-3 text-xs text-faint">Checked {problem.last_checked}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
