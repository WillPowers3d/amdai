---
import Base from '../../layouts/Base.astro';
import ProblemsNav from '../../components/problems/ProblemsNav.astro';
import { accountsEnabled, forumEnabled } from '../../lib/flags';
import {
  forumDiscussPath,
  forumProblemSearchPath,
  problemMatchesRig,
  statusLabel,
} from '../../lib/rocm-problems';
import { rocmProblem, rocmProblems } from '../../lib/rocm-problems-data';
import { threadPath } from '../../lib/forum-categories';

export const prerender = !accountsEnabled();

export function getStaticPaths() {
  return rocmProblems().map((problem) => ({ params: { slug: problem.id } }));
}

const problem = rocmProblem(Astro.params.slug ?? '');
if (!problem) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

type ThreadHit = { slug: string; title: string; solved: number };
let threads: ThreadHit[] = [];
let rigNames: string[] = [];

if (forumEnabled()) {
  const { getSessionUser } = await import('../../server/session');
  const { asActor, listThreads } = await import('../../server/forum');
  const session = await getSessionUser(Astro.cookies);
  threads = listThreads({
    errorPatternId: problem.id,
    actor: session ? asActor(session) : null,
    limit: 8,
  }).map((row) => ({ slug: row.slug, title: row.title, solved: row.solved }));
}

if (accountsEnabled()) {
  const { getSessionUser } = await import('../../server/session');
  const { listRigs, toMatch } = await import('../../server/rigs');
  const session = await getSessionUser(Astro.cookies);
  if (session) {
    const rigs = await listRigs(session.id);
    rigNames = rigs
      .filter((rig) => problemMatchesRig(problem, toMatch(rig)).matched)
      .map((rig) => rig.name);
  }
}
---

<Base title={problem.title} description={problem.summary}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <ProblemsNav current="tracker" />
    <p class="mt-6 text-sm text-faint">
      <a href="/rocm-problems">Tracker</a>
      {' / '}
      {problem.id}
    </p>
    <p class="mt-4 flex flex-wrap gap-2 text-xs">
      <span class={problem.status === 'open' ? 'badge-warn' : 'badge'}>
        {statusLabel(problem.status, problem.fixed_in)}
      </span>
      {problem.todo && <span class="badge">TODO — unverified KI</span>}
      {problem.affected_gfx.map((gfx) => <span class="badge">{gfx}</span>)}
      {problem.affected_gpus.map((gpu) => <span class="badge">{gpu}</span>)}
      {problem.affected_os.map((os) => <span class="badge">{os}</span>)}
      {problem.affected_backends.map((backend) => <span class="badge">{backend}</span>)}
    </p>
    <h1 class="display mt-4 text-4xl sm:text-5xl">{problem.title}</h1>
    {rigNames.length > 0 && (
      <p class="mt-4 text-sm">
        <span class="badge-tested">Affects your rig</span>
        <span class="ml-2 text-muted">{rigNames.join(', ')}</span>
      </p>
    )}
    <p class="mt-3 text-sm text-faint">Last checked {problem.last_checked}. Independent notes — not AMD documentation.</p>

    <article class="prose-lab prose mt-10 max-w-none">
      <h2 id="summary">In plain English</h2>
      <p>{problem.summary}</p>
      <h2 id="impact">Impact on consumers</h2>
      <p>{problem.impact}</p>
      <h2 id="workaround">Workaround</h2>
      <p>{problem.workaround}</p>
      <h2 id="upstream">Upstream</h2>
      <ul>
        {problem.upstream.map((link) => (
          <li>
            <a href={link.href}>{link.title}</a>
            {link.repo ? <span> ({link.repo})</span> : null}
          </li>
        ))}
      </ul>
    </article>

    <section class="card mt-10 p-5" aria-labelledby="discuss-heading">
      <h2 id="discuss-heading" class="text-xl tracking-tight">Discuss in forum</h2>
      <p class="mt-2 text-sm text-muted">
        Prefer an existing thread over a duplicate. Attach a saved rig. Reading needs no JavaScript.
      </p>
      {threads.length > 0 ? (
        <ul class="mt-4 space-y-2">
          {threads.map((row) => (
            <li>
              <a class="underline decoration-accent/40" href={threadPath(row.slug)}>{row.title}</a>
              {row.solved ? <span class="badge-tested ml-2">Solved</span> : null}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-muted">No forum thread is tagged with this tracker id yet.</p>
      )}
      <p class="mt-5 flex flex-wrap gap-3 text-sm">
        <a class="btn-primary" href={forumDiscussPath(problem)}>
          {threads.length ? 'Start another thread' : 'Ask the forum'}
        </a>
        <a class="btn-ghost" href={forumProblemSearchPath(problem)}>Search the forum</a>
        <a class="btn-ghost" href={`/rocm-problems/works?problem=${problem.id}`}>Works on my rig</a>
      </p>
    </section>
  </main>
</Base>
