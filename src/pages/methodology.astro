---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import NextSteps from '../components/NextSteps.astro';
import { FLASH_RERUN_NOTE, SWEEP_REVERIFY } from '../lib/run-card';
import { COMPARE_Q3, METHODOLOGY } from '../lib/trust';
---

<Base
  title="How we test"
  description="How AMDai produces measured tok/s (amdai-bench/run@1), how estimates are labeled including Q3, and how citations and corrections work."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{METHODOLOGY.kicker}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{METHODOLOGY.name}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{METHODOLOGY.lead}</p>
    <p class="mt-4 flex flex-wrap gap-3 text-sm">
      <a class="btn-primary" href="/benchmarks">Benchmarks</a>
      <a class="btn-secondary" href="/results">Run cards</a>
      <a class="btn-ghost" href="/amdai-bench">amdai-bench</a>
      <a class="btn-ghost" href="/contribute">Contribute</a>
      <a class="btn-ghost" href="/benchmarks/methodology">Recipe gates</a>
    </p>

    <Callout type="warn" title="Overnight sweep, 2026-10-12">
      <p>{SWEEP_REVERIFY}</p>
    </Callout>
    <Callout type="warn" title="Flash / Strata / Q3 pending">
      <p>{FLASH_RERUN_NOTE} {COMPARE_Q3} stays a labeled estimate until a card says measured.</p>
    </Callout>

    <section class="mt-10" aria-labelledby="cards-heading">
      <h2 id="cards-heading" class="font-serif text-3xl tracking-tight">{METHODOLOGY.cards.title}</h2>
      <p class="mt-3 leading-relaxed text-muted">{METHODOLOGY.cards.body}</p>
    </section>

    <section class="mt-10" aria-labelledby="estimates-heading">
      <h2 id="estimates-heading" class="font-serif text-3xl tracking-tight">{METHODOLOGY.estimates.title}</h2>
      <p class="mt-3 leading-relaxed text-muted">{METHODOLOGY.estimates.body}</p>
      <p class="mt-3 text-sm text-muted">
        Calculator lines
        <strong class="text-ink">Minimum system RAM needed</strong>
        and
        <strong class="text-ink">RAM needed at full context</strong>
        use a measured peak when a card recorded one; otherwise a labeled kit estimate.
        Open the
        <a class="underline decoration-accent/40" href="/calculator">calculator</a>.
      </p>
    </section>

    <section class="mt-10" aria-labelledby="citations-heading">
      <h2 id="citations-heading" class="font-serif text-3xl tracking-tight">{METHODOLOGY.citations.title}</h2>
      <p class="mt-3 leading-relaxed text-muted">{METHODOLOGY.citations.body}</p>
    </section>

    <section class="mt-10" aria-labelledby="corrections-heading">
      <h2 id="corrections-heading" class="font-serif text-3xl tracking-tight">{METHODOLOGY.corrections.title}</h2>
      <p class="mt-3 leading-relaxed text-muted">{METHODOLOGY.corrections.body}</p>
      <p class="mt-3 text-sm text-muted">
        <a class="underline decoration-accent/40" href="/contribute">Contribute a recipe</a>
        ·
        <a class="underline decoration-accent/40" href="/contact">Contact</a>.
      </p>
    </section>
    <NextSteps path="/methodology" />
  </main>
</Base>
