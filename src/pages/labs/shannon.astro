---
import Base from '../../layouts/Base.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import {
  SHANNON_CITED_LABEL,
  SHANNON_HUB_LINKS,
  loadShannonLab,
  shannonIdeas,
} from '../../lib/shannon-lab';

const file = loadShannonLab();
const groups = [
  { id: 'harnesses', label: 'Harnesses next to amdai’s Hermes' },
  { id: 'cheap-amd', label: 'Old / cheap AMD cards' },
  { id: 'secure', label: 'Secure home lab' },
  { id: 'autoresearch', label: 'Autoresearch idea' },
];
---

<Base
  title="Shannon’s lab"
  description="Cited write-up from Shannon (@iamMrDuncan), How I run my Lab, Oct 12 2026. Not measured by AMDai. No invented numbers."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{SHANNON_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{file.author} — {file.article.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Sourced from @{file.handle}’s X Article on {file.article.date}.
      Everything on this page is <strong class="text-ink">{SHANNON_CITED_LABEL}</strong>.
      We do not invent tok/s or prices. llama.cpp first. Q3 stays a labeled estimate.
      Nothing below Q3.
    </p>
    <p class="mt-3 text-sm text-faint">
      Primary source:
      <a class="underline decoration-accent/40" href="https://x.com/iamMrDuncan/status/2109744566001938923" rel="noopener">{file.article.title}</a>.
      House cards:
      <a class="underline decoration-accent/40" href="/results">/results</a>.
      Attribution:
      <a class="underline decoration-accent/40" href="/credits">/credits</a>.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {SHANNON_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    {groups.map((group) => (
      <section id={group.id} class="mt-12 scroll-mt-28" aria-labelledby={`${group.id}-heading`}>
        <h2 id={`${group.id}-heading`} class="font-serif text-3xl tracking-tight">{group.label}</h2>
        <div class="mt-6 space-y-6">
          {shannonIdeas(group.id).map((idea) => (
            <article id={idea.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">{SHANNON_CITED_LABEL}</p>
              <h3 class="mt-2 font-serif text-2xl tracking-tight">{idea.title}</h3>
              <p class="mt-3 leading-relaxed text-ink">{idea.body}</p>
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="mt-10 text-sm text-muted">
      P100 cite (NVIDIA, context only):
      <a class="underline decoration-accent/40" href={file.p100_post.href} rel="noopener">{file.p100_post.title}</a>
      — {file.p100_post.model} {file.p100_post.decode} with {file.p100_post.extras} on a {file.p100_post.device}.
      {file.p100_post.note}
    </p>
    <div class="mt-8">
      <HowWeTest />
    </div>
  </main>
</Base>
