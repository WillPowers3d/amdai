---
import Base from '../../layouts/Base.astro';
import { SHANNON_CITED_LABEL, loadShannonLab } from '../../lib/shannon-lab';

const file = loadShannonLab();
---

<Base
  title="Community labs"
  description="Cited home-lab write-ups that are not measured on the local desktop. Shannon’s How I run my Lab is the first."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">Cited, not ours</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Community labs</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Write-ups we did not run. Every number and layout stays labeled
      <strong class="text-ink">{SHANNON_CITED_LABEL}</strong>.
      House cards stay on
      <a class="underline decoration-accent/40" href="/results">/results</a>.
    </p>
    <ul class="mt-10 space-y-4">
      <li>
        <a class="card block p-5" href="/labs/shannon">
          <p class="kicker">{file.article.date} · @{file.handle}</p>
          <h2 class="mt-2 text-2xl tracking-tight">{file.author} — {file.article.title}</h2>
          <p class="mt-3 text-sm text-muted">
            Herdr, Coolify, Hermes profiles, a Radeon VII autoresearch note, a secure-lab layout,
            and an amdai-bench idea. No invented tok/s.
          </p>
        </a>
      </li>
    </ul>
  </main>
</Base>
