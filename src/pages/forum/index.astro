---
import Base from '../../layouts/Base.astro';
import ForumOff from '../../components/forum/ForumOff.astro';
import { forumEnabled } from '../../lib/flags';
import { categoryPath, forumCategories } from '../../lib/forum-categories';

const on = forumEnabled();
export const prerender = !forumEnabled();
let stats: Array<{ slug: string; title: string; blurb: string; threads: number; lastAt: number | null }> = forumCategories.map((c) => ({
  ...c,
  threads: 0,
  lastAt: null,
}));
let user: { email: string; role: string } | null = null;
let unread = 0;

if (on) {
  const { getSessionUser } = await import('../../server/session');
  const { asActor, listCategoryStats, unreadNoticeCount } = await import('../../server/forum');
  const session = await getSessionUser(Astro.cookies);
  if (session) {
    user = { email: session.email, role: session.role };
    unread = unreadNoticeCount(session.id);
  }
  stats = listCategoryStats(session ? asActor(session) : null);
}
---

<Base title="Forum" description="Community threads for local Radeon AI — llama.cpp, ROCm, rigs, and cited errors.">
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    {on ? (
      <>
        <p class="kicker">Community</p>
        <h1 class="display mt-3 text-4xl sm:text-5xl">Forum</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          Ask with a saved rig attached. Mark solved when you have an answer. Read needs no JavaScript.
        </p>
        <p class="mt-4 flex flex-wrap gap-3 text-sm">
          <a class="btn-primary" href="/forum/new">New thread</a>
          <a class="btn-secondary" href="/forum/search">Search</a>
          <a class="btn-ghost" href="/forum/rules">Rules</a>
          <a class="btn-ghost" href="/rocm-problems">ROCm problems</a>
          {user && <a class="btn-ghost" href="/forum/inbox">Inbox{unread ? ` (${unread})` : ''}</a>}
          {user && (user.role === 'mod' || user.role === 'admin') && <a class="btn-ghost" href="/forum/mod">Moderation</a>}
          {!user && <a class="btn-ghost" href="/login?next=/forum">Sign in</a>}
        </p>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2">
          {stats.map((cat) => (
            <li>
              <a class="card block p-5" href={categoryPath(cat.slug)}>
                <h2 class="text-xl tracking-tight">{cat.title}</h2>
                <p class="mt-2 text-sm text-muted">{cat.blurb}</p>
                <p class="mt-3 text-xs text-faint">
                  {cat.threads} thread{cat.threads === 1 ? '' : 's'}
                  {cat.lastAt ? ` · last ${new Date(cat.lastAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}` : ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <>
        <ForumOff />
        <div class="card mt-8 p-6">
          <p class="kicker">Categories</p>
          <ul class="mt-4 grid gap-2 text-sm text-muted sm:grid-cols-2">
            {forumCategories.map((cat) => (
              <li><a class="hover:text-ink" href={categoryPath(cat.slug)}>{cat.title}</a></li>
            ))}
          </ul>
        </div>
      </>
    )}
  </main>
</Base>
