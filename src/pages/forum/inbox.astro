---
import Base from '../../layouts/Base.astro';
import ForumOff from '../../components/forum/ForumOff.astro';
import { forumEnabled } from '../../lib/flags';
import { threadPath } from '../../lib/forum-categories';

const on = forumEnabled();
export const prerender = !forumEnabled();

let notices: Array<{ id: string; read: number; created_at: number; title?: string; slug?: string; kind: string }> = [];
let signedIn = false;

if (on) {
  const { getSessionUser } = await import('../../server/session');
  const { listNotices, markNoticesRead } = await import('../../server/forum');
  const session = await getSessionUser(Astro.cookies);
  signedIn = Boolean(session);
  if (session) {
    notices = listNotices(session.id);
    markNoticesRead(session.id);
  }
}
---

<Base title="Forum inbox" description="On-site reply notices. Email is opt-in on your account.">
  <main id="main" class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
    {!on ? (
      <ForumOff title="Inbox" />
    ) : !signedIn ? (
      <>
        <h1 class="display text-4xl">Inbox</h1>
        <p class="mt-4 text-muted"><a class="underline" href="/login?next=/forum/inbox">Sign in</a> to see reply notices.</p>
      </>
    ) : (
      <>
        <p class="text-sm text-faint"><a href="/forum">Forum</a> / Inbox</p>
        <h1 class="display mt-3 text-4xl">Inbox</h1>
        <p class="mt-3 text-muted">
          Email replies are opt-in on <a class="underline decoration-accent/40" href="/account">your account</a>.
        </p>
        {notices.length === 0 ? (
          <p class="mt-8 text-muted">No notices yet.</p>
        ) : (
          <ul class="mt-8 space-y-3">
            {notices.map((row) => (
              <li class="card p-4">
                <p class="text-xs text-faint">{row.read ? 'Read' : 'New'} · {row.kind} · {new Date(row.created_at).toLocaleString()}</p>
                <p class="mt-1"><a href={row.slug ? threadPath(row.slug) : '/forum'}>{row.title ?? 'Thread'}</a></p>
              </li>
            ))}
          </ul>
        )}
      </>
    )}
  </main>
</Base>
