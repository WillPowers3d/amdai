---
import Base from '../../layouts/Base.astro';
import ForumOff from '../../components/forum/ForumOff.astro';
import { categoryForErrorTags, forumCategories } from '../../lib/forum-categories';
import { errorPatterns } from '../../lib/errors';
import { forumEnabled } from '../../lib/flags';
import { forumErrorCopy } from '../../lib/forum-perms';
import { discussBody } from '../../lib/rocm-problems';
import { rocmProblem } from '../../lib/rocm-problems-data';

const on = forumEnabled();
export const prerender = !forumEnabled();

const q = Astro.url.searchParams;
const requestedCategory = q.get('category') ?? '';
const patternId = q.get('pattern') ?? q.get('problem') ?? '';
const pattern = errorPatterns.find((row) => row.id === patternId);
const problem = rocmProblem(patternId);
const category = forumCategories.some((c) => c.slug === requestedCategory)
  ? requestedCategory
  : problem
    ? problem.forum_category
    : pattern
      ? categoryForErrorTags(pattern.tags)
      : 'getting-started';
const title = q.get('title') ?? problem?.title ?? pattern?.title ?? '';
const pasted = (q.get('body') ?? q.get('error') ?? '').slice(0, 4000);
const err = forumErrorCopy(q.get('error'));

let user = null as null | { email: string };
let rigs: Array<{ id: string; name: string; gpu: string; backend: string; rocm_version: string | null }> = [];
let csrf = '';

if (on) {
  const { getSessionUser } = await import('../../server/session');
  const { ensureCsrf } = await import('../../server/csrf');
  const { listRigs } = await import('../../server/rigs');
  const session = await getSessionUser(Astro.cookies);
  user = session ? { email: session.email } : null;
  csrf = ensureCsrf(Astro.cookies);
  if (session) rigs = await listRigs(session.id);
}

const defaultBody = problem
  ? (pasted || discussBody(problem)).slice(0, 4000)
  : pasted
    ? `\`\`\`\n${pasted}\n\`\`\`\n\n${pattern ? `Matched troubleshooter pattern: ${pattern.title} (${pattern.id}).\n` : ''}`
    : '';
---

<Base title="New thread" description="Start a forum thread. Attach a saved rig so helpers see GPU, ROCm, and backend.">
  <main id="main" class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
    {!on ? (
      <ForumOff title="New thread" />
    ) : !user ? (
      <>
        <p class="kicker">Forum</p>
        <h1 class="display mt-3 text-4xl">Sign in to post</h1>
        <p class="mt-4 text-muted">
          The forum uses the same account as saved rigs.
          <a class="underline decoration-accent/40" href={`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}>Sign in</a>
        </p>
      </>
    ) : (
      <>
        <p class="text-sm text-faint"><a href="/forum">Forum</a> / New thread</p>
        <h1 class="display mt-3 text-4xl">New thread</h1>
        <p class="mt-3 text-muted">Markdown with code fences. Attach a rig if you have one — that badge is how people debug you.</p>
        {err && <p class="mt-4 text-sm text-warn">{err}</p>}
        <form class="mt-8 space-y-4" method="post" action="/api/forum/thread">
          <input type="hidden" name="_csrf" value={csrf} />
          {patternId && <input type="hidden" name="error_pattern_id" value={patternId} />}
          <label class="hp" aria-hidden="true">Company site<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <label class="block text-sm">
            <span class="text-faint">Category</span>
            <select class="mt-1 w-full rounded-xl border border-line bg-raised px-3 py-2" name="category" required>
              {forumCategories.map((cat) => (
                <option value={cat.slug} selected={cat.slug === category}>{cat.title}</option>
              ))}
            </select>
          </label>
          <label class="block text-sm">
            <span class="text-faint">Title</span>
            <input class="mt-1 w-full rounded-xl border border-line bg-raised px-3 py-2" name="title" required minlength="8" maxlength="140" value={title} />
          </label>
          <label class="block text-sm">
            <span class="text-faint">Body</span>
            <textarea class="mt-1 min-h-48 w-full rounded-xl border border-line bg-raised p-3 font-mono text-sm" name="body" required minlength="8">{defaultBody}</textarea>
          </label>
          <label class="block text-sm">
            <span class="text-faint">Attach a saved rig (optional)</span>
            <select class="mt-1 w-full rounded-xl border border-line bg-raised px-3 py-2" name="rig_id">
              <option value="">None</option>
              {rigs.map((rig) => (
                <option value={rig.id}>{rig.name} · {rig.gpu} · {rig.backend}{rig.rocm_version ? ` · ROCm ${rig.rocm_version}` : ''}</option>
              ))}
            </select>
          </label>
          {rigs.length === 0 && (
            <p class="text-sm text-faint">
              No saved rigs yet. <a class="underline" href="/account">Save one</a> from the calculator if you want the badge.
            </p>
          )}
          <button class="btn-primary" type="submit">Post thread</button>
        </form>
      </>
    )}
  </main>
</Base>

<style>
  .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }
</style>
