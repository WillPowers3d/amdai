---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import {
  FINE_TUNING_CITED_LABEL,
  FINE_TUNING_DESCRIPTION,
  FINE_TUNING_EXPORT,
  FINE_TUNING_FAQ,
  FINE_TUNING_FIT_ROWS,
  FINE_TUNING_HUB_LINKS,
  FINE_TUNING_LEAD,
  FINE_TUNING_SECTIONS,
  FINE_TUNING_SOURCES,
  FINE_TUNING_SPEED_LABEL,
  FINE_TUNING_STEPS,
  FINE_TUNING_TITLE,
  FINE_TUNING_TOOLS,
  FINE_TUNING_VRAM_NOTE,
  FINE_TUNING_VRAM_ROWS,
  FINE_TUNING_WHAT,
} from '../lib/fine-tuning';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../lib/ram-surfaces';
---

<Base title={FINE_TUNING_TITLE} description={FINE_TUNING_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">{FINE_TUNING_CITED_LABEL}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{FINE_TUNING_TITLE}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{FINE_TUNING_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {FINE_TUNING_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-4">
      <OpenInStackLab {...HOUSE_STACK_LAB.doctor} />
    </div>

    <Callout type="note" title="No invented training speeds">
      <p>
        Training throughput is
        <strong class="text-ink">{FINE_TUNING_SPEED_LABEL}</strong>.
        Record an <code class="font-mono text-ink">amdai-bench/run@1</code> card, or open
        Stack Lab doctor. The gap is on
        <a class="underline decoration-accent/40" href="/wanted">/wanted</a>
        and <a class="underline decoration-accent/40" href="/amdai-bench">/amdai-bench</a>.
        llama.cpp stays first for inference. Q3 is a labeled estimate. Nothing below Q3.
      </p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="Fine-tuning sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {FINE_TUNING_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="what-it-is" class="mt-10 scroll-mt-36" aria-labelledby="what-it-is-heading">
      <h2 id="what-it-is-heading" class="font-serif text-3xl tracking-tight">What works on Radeon today</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{FINE_TUNING_WHAT}</p>
      <ul class="mt-6 grid gap-4">
        {FINE_TUNING_TOOLS.map((tool) => (
          <li id={tool.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{tool.name}</h3>
            <p class="mt-3 leading-relaxed text-muted">{tool.support}</p>
            <p class="mt-2 text-sm text-faint">
              Cite · <a class="underline decoration-accent/40" href={tool.href}>{tool.cite}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="vram" class="mt-12 scroll-mt-36" aria-labelledby="vram-heading">
      <h2 id="vram-heading" class="font-serif text-3xl tracking-tight">VRAM — LoRA vs QLoRA</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{FINE_TUNING_VRAM_NOTE}</p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-line">
        <table class="table-lab min-w-[36rem]">
          <caption class="sr-only">Unsloth published absolute-minimum VRAM for QLoRA (4-bit) and LoRA (16-bit)</caption>
          <thead>
            <tr>
              <th scope="col">Parameters</th>
              <th scope="col">QLoRA (4-bit)</th>
              <th scope="col">LoRA (16-bit)</th>
              <th scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {FINE_TUNING_VRAM_ROWS.map((row) => (
              <tr id={row.id}>
                <th scope="row">{row.size}</th>
                <td>{row.qlora}</td>
                <td>{row.lora}</td>
                <td>{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3 class="mt-10 font-serif text-2xl tracking-tight">Map to cards we already list</h3>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Card VRAM is the hardware label on each /gpus sheet. Training numbers above stay Unsloth
        or AMD playbook cites. Speed stays {FINE_TUNING_SPEED_LABEL}.
      </p>
      <ul class="mt-6 grid gap-4">
        {FINE_TUNING_FIT_ROWS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.vramClass}</h3>
            <p class="mt-3 leading-relaxed text-muted">{row.fit}</p>
            <p class="mt-2 text-sm text-faint">Speed · {row.speed}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {row.cards.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="linux" class="mt-12 scroll-mt-36" aria-labelledby="linux-heading">
      <h2 id="linux-heading" class="font-serif text-3xl tracking-tight">Linux path — Ubuntu, then a wheel</h2>
      <ol class="mt-6 grid gap-4">
        {FINE_TUNING_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Step {index + 1}</p>
            <h3 class="mt-1 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="export" class="mt-12 scroll-mt-36" aria-labelledby="export-heading">
      <h2 id="export-heading" class="font-serif text-3xl tracking-tight">Export back to llama.cpp</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Merge the adapter, convert to GGUF, quantize Q6_K / Q5_K_M / Q4_K_M, then serve.
        Q3_K_M is a labeled estimate. Shopper RAM lines after export, when offload appears, are
        <strong class="text-ink">{RAM_MIN_LABEL}</strong> and
        <strong class="text-ink">{RAM_FULL_LABEL}</strong>
        — size that on
        <a class="underline decoration-accent/40" href="/calculator">/calculator</a>.
      </p>
      <div class="mt-6 grid gap-4">
        <div class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Merge (PEFT, AMD playbook)</h3>
          <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-canvas p-4 font-mono text-sm text-ink"><code>{FINE_TUNING_EXPORT.merge}</code></pre>
        </div>
        <div class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Convert</h3>
          <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-canvas p-4 font-mono text-sm text-ink"><code>{FINE_TUNING_EXPORT.convert}</code></pre>
        </div>
        <div class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Quantize</h3>
          <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-canvas p-4 font-mono text-sm text-ink"><code>{FINE_TUNING_EXPORT.quant}</code></pre>
        </div>
        <div class="rounded-2xl border border-line bg-raised/50 p-5">
          <h3 class="font-serif text-2xl tracking-tight">Serve</h3>
          <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-canvas p-4 font-mono text-sm text-ink"><code>{FINE_TUNING_EXPORT.serve}</code></pre>
        </div>
      </div>
    </section>

    <section id="faq" class="mt-12 scroll-mt-36" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <ul class="mt-6 grid gap-4">
        {FINE_TUNING_FAQ.map((item) => (
          <li id={item.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{item.question}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {item.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-36" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
        {FINE_TUNING_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href}>{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <NextSteps path="/fine-tuning" />
  </main>
</Base>
