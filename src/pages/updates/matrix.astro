---
import Base from '../../layouts/Base.astro';
import { cellFor, matrixFile } from '../../lib/matrix';

const tone: Record<string, string> = {
  official: 'text-ok',
  first_party: 'text-accent-ink',
  cited: 'text-warn',
  no_data: 'text-faint',
};
---

<Base
  title="Version matrix"
  description="ROCm 10.0 and 10.1 × llama.cpp × vLLM 0.31 × R9700 / 9070 XT / 7900 XTX. Cited or no data."
>
  <main id="main" class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Pins</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">ROCm × engine × card</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      As of {matrixFile.as_of}. Official rows come from AMD’s 10.0 / 10.1 notes.
      First-party means our test rig. Empty knowledge is labeled no data.
    </p>

    {matrixFile.rocm.map((rocm) => (
      <section class="mt-12">
        <h2 class="font-serif text-3xl">ROCm {rocm.version}</h2>
        <p class="mt-2 text-sm">
          <a class="underline decoration-accent/40 underline-offset-2" href={rocm.notes}>{rocm.notes_label}</a>
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-[48rem] w-full text-left text-sm">
            <thead>
              <tr class="border-b border-line text-faint">
                <th class="py-2 pr-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]">Card</th>
                {matrixFile.engines.map((engine) => (
                  <th class="py-2 pr-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]">{engine.name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {matrixFile.cards.map((card) => (
                <tr class="border-b border-line/70 align-top">
                  <td class="py-3 pr-3 font-medium">
                    {card.name}
                    <span class="mt-0.5 block font-mono text-[0.68rem] text-faint">{card.gfx}</span>
                  </td>
                  {matrixFile.engines.map((engine) => {
                    const cell = cellFor(card.id, rocm.version, engine.id);
                    return (
                      <td class="py-3 pr-3">
                        <p class:list={['font-mono text-[0.68rem] uppercase tracking-[0.12em]', tone[cell?.status ?? 'no_data']]}>
                          {(cell?.status ?? 'no_data').replace('_', ' ')}
                        </p>
                        <p class="mt-1 text-muted">{cell?.text ?? 'no data'}</p>
                        {cell?.source && (
                          <p class="mt-2 text-xs">
                            <a class="underline decoration-accent/40 underline-offset-2" href={cell.source}>{cell.source_label}</a>
                          </p>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <p class="mt-10 text-sm text-muted">
      Feed: <a class="underline decoration-accent/40 underline-offset-2" href="/updates">/updates</a>
      · <a class="underline decoration-accent/40 underline-offset-2" href="/updates/rss.xml">RSS</a>
    </p>
  </main>
</Base>
