---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import UpdateCard from '../../components/UpdateCard.astro';
import { matrixFile } from '../../lib/matrix';

const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Updates"
  description="Dated ROCm / llama.cpp / vLLM snapshots, an RSS feed, and a cited version matrix. Cells without a source say no data."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Living notes</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Updates</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Snapshots, not law. The <a class="underline decoration-accent/40 underline-offset-2" href="/">home status card</a> is the current recommendation.
      Subscribe:
      <a class="underline decoration-accent/40 underline-offset-2" href="/updates/rss.xml">RSS</a>.
    </p>

    <section class="mt-12">
      <h2 class="font-serif text-3xl">Version matrix</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        ROCm {matrixFile.rocm.map((row) => row.version).join(' and ')} × llama.cpp × vLLM 0.31 × card.
        As of {matrixFile.as_of}. Every cell is cited or says <strong class="text-ink">no data</strong>.
        We do not invent tok/s.
      </p>
      <p class="mt-4">
        <a class="text-accent-ink underline decoration-accent/40 underline-offset-2" href="/updates/matrix">Open the matrix</a>
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-serif text-3xl">Dated notes</h2>
      {updates.map((note) => <UpdateCard note={note} />)}
    </section>
  </main>
</Base>
