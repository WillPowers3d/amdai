---
import Base from '../../layouts/Base.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import ModelSheet from '../../components/ModelSheet.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextSteps from '../../components/NextSteps.astro';
import RecipeTable from '../../components/RecipeTable.astro';
import RunCard from '../../components/RunCard.astro';
import { houseModelPage, HOUSE_MODEL_IDS } from '../../lib/model-pages';
import { recipesForModel } from '../../lib/recipes';
import { recipes } from '../../lib/recipes-data';
import { officialAmdaiRuns, runsForModelName, verifiedMeasured } from '../../lib/run-card';
import { runs } from '../../lib/run-card-data';

export function getStaticPaths() {
  return HOUSE_MODEL_IDS.map((id) => ({ params: { id }, props: { id } }));
}

const page = houseModelPage(Astro.props.id);
const rows = recipesForModel(recipes, page.id);
const modelRuns = officialAmdaiRuns(verifiedMeasured(runsForModelName(runs, page.id)));
---

<Base title={page.title} description={page.description}>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">
      <a class="underline decoration-accent/40" href="/models">Models</a>
      · {page.role}
    </p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{page.name}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{page.lead}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-secondary" href="/models">All models</a>
      <a class="btn-primary" href={`/calculator?model=${page.id}`}>Open in calculator</a>
      <a class="btn-ghost" href="/benchmarks">Benchmarks</a>
      <a class="btn-ghost" href="/compare">Compare 35B</a>
      <a class="btn-ghost" href="/gpus/r9700">R9700</a>
      <a class="btn-ghost" href={page.card.hf}>Hugging Face card</a>
      {page.deepLinks.map((link) => (
        <a class="btn-ghost" href={link.href}>{link.label}</a>
      ))}
    </div>
    <div class="mt-4">
      <HowWeTest />
    </div>

    <ModelSheet page={page} />

    <section class="mt-12" aria-labelledby="recipes-heading">
      <h2 id="recipes-heading" class="font-serif text-3xl">Recipes</h2>
      <div class="mt-6">
        <RecipeTable recipes={rows} empty="No tested recipe yet — contribute." />
      </div>
    </section>

    {modelRuns.length > 0 && (
      <section class="mt-12" aria-labelledby="runs-heading">
        <h2 id="runs-heading" class="font-serif text-3xl">Official run cards</h2>
        <p class="mt-3 max-w-2xl text-sm text-muted">
          Measured cells come from verified <code>amdai-bench/run@1</code> cards credited to the submitter.
        </p>
        <div class="mt-6 grid gap-6">
          {modelRuns.map((card) => (
            <RunCard card={card} heading="h3" compact />
          ))}
        </div>
      </section>
    )}

    <NextSteps path={page.path} />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
