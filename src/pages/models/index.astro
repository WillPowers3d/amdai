---
import Base from '../../layouts/Base.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NextSteps from '../../components/NextSteps.astro';
import RecipeTable from '../../components/RecipeTable.astro';
import { contributeModels, houseModelPages } from '../../lib/model-pages';
import { recipesForModel } from '../../lib/recipes';
import { recipes } from '../../lib/recipes-data';

const pages = houseModelPages();
const contribute = contributeModels();
---

<Base
  title="Models"
  description="House Qwen recipes plus cited open-weight pages — gpt-oss, Gemma 3, Llama 3.3, GLM 5.3 Flash, Qwen 27B. Reverse view of the GPU directory. Q3 is a labeled estimate."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">House recipes and cited cards</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Models</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      The reverse of the GPU pages: pick a model, see the cited card and which Radeon setups fit.
      amdai’s two daily drivers first, then cited open-weight pages for 16–64 GB Radeon boxes and the 320B / 18B GLM offload case.
      Those older 2.5-class and 8B names stay off this site.
      Q3 appears only as estimate/community unless we measured it.
      A name with no official card and GGUF listing stays contribute — we do not invent a shopper page.
      The <a class="underline decoration-accent/40" href="/qwen">Qwen compare</a> table lists every current 3.6 / 3.8 file.
    </p>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-secondary" href="/calculator">Calculator</a>
      <a class="btn-ghost" href="/benchmarks">Benchmarks</a>
      <a class="btn-ghost" href="/compare">Compare 35B</a>
      <a class="btn-ghost" href="/gpus/r9700">R9700</a>
      <a class="btn-ghost" href="/abliterated">Abliterated (educational)</a>
    </div>
    <div class="mt-8 grid gap-6">
      {pages.map((model) => {
        const rows = recipesForModel(recipes, model.id);
        return (
          <section class="card p-5 sm:p-6" aria-labelledby={`${model.id}-heading`}>
            <p class="kicker">{model.role}</p>
            <h2 id={`${model.id}-heading`} class="mt-1 text-2xl tracking-tight">
              <a class="underline decoration-accent/40" href={model.path}>{model.name}</a>
            </h2>
            <p class="mt-2 text-sm text-muted">
              Official <a class="underline decoration-accent/40" href={model.card.hf}>{model.card.official}</a>
              {' · '}
              GGUF {model.card.ggufName}
              {' · '}
              {model.card.parameters} / {model.card.active}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{model.lead}</p>
            <div class="mt-5">
              <RecipeTable
                recipes={rows}
                empty={model.pageKind === 'cited' ? 'Not yet measured on our R9700s — open the cited page.' : 'No tested recipe yet — contribute.'}
              />
            </div>
            <p class="mt-4 text-sm">
              <a class="underline decoration-accent/40" href={model.path}>
                {model.pageKind === 'cited' ? 'Open the cited page' : 'Open the recipe page'}
              </a>
              {' · '}
              <a class="underline decoration-accent/40" href={`/calculator?model=${model.id}`}>Calculator</a>
            </p>
          </section>
        );
      })}
    </div>

    <section id="contribute" class="mt-12" aria-labelledby="contribute-heading">
      <h2 id="contribute-heading" class="font-serif text-3xl">Contribute — no cited row yet</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        AMDai publishes a cited estimate page only when the official card and a GGUF listing already exist.
        Names without that stay contribute. Abliterated files stay on <a class="underline decoration-accent/40" href="/abliterated">/abliterated</a>.
        Send a measured <code>amdai-bench/run@1</code> card if you have one of these on a Radeon.
      </p>
      {contribute.length > 0 ? (
        <ul class="mt-6 grid gap-4">
          {contribute.map((row) => (
            <li class="rounded-2xl border border-line bg-raised/40 p-5">
              <h3 class="text-xl tracking-tight">{row.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{row.why}</p>
              <p class="mt-3 text-sm">
                <a class="underline decoration-accent/40" href={row.href}>
                  {row.href === '/contribute' ? 'Contribute a card' : 'See Qwen compare'}
                </a>
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6">
          <a class="btn-secondary" href="/contribute">Contribute a card</a>
        </p>
      )}
    </section>
    <NextSteps path="/models" />
  </main>
</Base>
