---
import Base from '../../layouts/Base.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import ConsumerGpuSheet from '../../components/ConsumerGpuSheet.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import LaunchCommand from '../../components/LaunchCommand.astro';
import NextSteps from '../../components/NextSteps.astro';
import RecipeTable from '../../components/RecipeTable.astro';
import SystemRamNeed from '../../components/SystemRamNeed.astro';
import { recipeSystemRam } from '../../lib/recipes';
import { recipes } from '../../lib/recipes-data';
import { gpuPageById, gpuPages } from '../../lib/gpu-pages';
import RunCard from '../../components/RunCard.astro';
import { officialAmdaiRuns, runsForGpu, verifiedMeasured } from '../../lib/run-card';
import { runs } from '../../lib/run-card-data';
import { measuredRamHits } from '../../lib/measured-ram-data';
import HowWeTest from '../../components/HowWeTest.astro';
import { consumerRecipeIdFromPage, consumerRecipePage } from '../../lib/consumer-gpu';
import { gpuDirectory } from '../../lib/status';

export function getStaticPaths() {
  return gpuPages(recipes)
    .filter((page) => page.id !== 'r9700' && page.id !== 'strix-halo' && page.id !== 'rx9070xt' && page.id !== 'rx9060xt' && page.id !== 'rx7900gre' && page.id !== 'rx7700xt' && page.id !== 'rx7600xt' && page.id !== 'rx7600' && page.id !== 'rx6800xt' && page.id !== 'rx6700xt')
    .map((page) => ({ params: { id: page.id }, props: { id: page.id } }));
}

const page = gpuPageById(recipes, Astro.props.id);
if (!page) throw new Error(`unknown GPU page ${Astro.props.id}`);
const recipeId = consumerRecipeIdFromPage(page.id);
const sheet = recipeId ? consumerRecipePage(recipeId) : null;
const llamaFirst = [...page.recipes].sort((a, b) => {
  if (a.backend === b.backend) return b.ctx - a.ctx;
  return a.backend === 'llamacpp' ? -1 : 1;
});
const gpuRuns = officialAmdaiRuns(verifiedMeasured(runsForGpu(runs, page.id)));
---

<Base
  title={sheet?.title ?? page.name}
  description={
    sheet?.description ??
    `${page.name} recipes — model, backend, quant, context, decode, and a copyable launch command. Spec-only cards stay listed.`
  }
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">
      <a class="underline decoration-accent/40" href="/gpus">GPU directory</a>
      · {page.family} · {page.arch} · {page.gfx}
    </p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{sheet?.name ?? page.name}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
      {sheet ? sheet.lead : (
        <>
          {page.vram_gb == null ? 'Confirm VRAM on the product page.' : `${page.vram_gb} GB published VRAM.`}
          {page.rocm_note}
          {page.support === 'official' ? ' Official on the current ROCm matrix.' : ' Unofficial on the current matrix.'}
        </>
      )}
    </p>
    {!sheet && (
      <p class="mt-3 text-sm text-muted">
        HSA_OVERRIDE: {page.hsa_override}
        {' · '}
        <a class="underline decoration-accent/40" href={gpuDirectory.matrix} rel="noopener">ROCm matrix</a>
        {' · '}
        <a class="underline decoration-accent/40" href={gpuDirectory.linux_reqs} rel="noopener">Linux requirements</a>
      </p>
    )}
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-secondary" href="/gpus">All cards</a>
      {page.id === 'r9700' && <a class="btn-secondary" href="/compare">Compare 35B</a>}
      <a class="btn-secondary" href="/compare/radeon-vs-nvidia">Radeon vs NVIDIA</a>
      {(sheet || page.calcId) && (
        <a class="btn-primary" href={sheet?.calculatorHref ?? `/calculator?gpu=${page.calcId}`}>
          Open in calculator
        </a>
      )}
      <a class="btn-ghost" href="/contribute">Contribute a recipe</a>
      <a class="btn-ghost" href="/models/qwen36">35B model page</a>
      <a class="btn-ghost" href="/models/flash">Flash model page</a>
    </div>
    <div class="mt-4">
      <HowWeTest />
    </div>
    {sheet && <ConsumerGpuSheet sheet={sheet} />}
    {sheet && <BuyButtons product={sheet.id} />}

    <section class="mt-12" aria-labelledby="config-heading">
      <h2 id="config-heading" class="font-serif text-3xl">Configurations we have</h2>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        A row is one launch that passed enough gates to publish. llama.cpp first.
        Empty cells stay empty. Spec-only cards say so instead of inventing a fit.
      </p>
      <div class="mt-6">
        <RecipeTable
          recipes={llamaFirst}
          empty="No tested recipe yet — contribute. This card stays listed so the gap is visible."
        />
      </div>
    </section>

    {gpuRuns.length > 0 && (
      <section class="mt-12" aria-labelledby="runs-heading">
        <h2 id="runs-heading" class="font-serif text-3xl">Official run cards</h2>
        <p class="mt-3 max-w-2xl text-sm text-muted">
          Measured cells on this page come from verified <code>amdai-bench/run@1</code> cards credited to the submitter.
        </p>
        <div class="mt-6 grid gap-6">
          {gpuRuns.map((card) => (
            <RunCard card={card} heading="h3" compact />
          ))}
        </div>
      </section>
    )}

    {llamaFirst.map((recipe) => (
      <section class="card mt-8 scroll-mt-28 p-5 sm:p-6" id={recipe.id} aria-labelledby={`${recipe.id}-heading`}>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="kicker">{recipe.backend === 'llamacpp' ? 'llama.cpp' : 'Strata'} · {recipe.ctx_label}</p>
            <h3 id={`${recipe.id}-heading`} class="mt-1 text-2xl tracking-tight">{recipe.model} · {recipe.weights.quant}</h3>
          </div>
          <EvidenceBadge tier={recipe.proof[0]?.tier ?? 'tested-our-rig'} />
        </div>
        <p class="mt-3 text-sm text-muted">{recipe.notes.join(' ')}</p>
        {recipe.withdrawn && (
          <p class="mt-3 rounded-xl border border-warn/40 bg-warn/10 px-3 py-2 text-sm">
            Withdrawn {recipe.withdrawn.date}: {recipe.withdrawn.reason}
            <span class="mt-1 block text-xs text-faint">{recipe.withdrawn.source}</span>
          </p>
        )}
        <div class="mt-5">
          <LaunchCommand recipe={recipe} />
        </div>
        {recipeSystemRam(recipe, measuredRamHits) && (
          <div class="mt-5">
            <SystemRamNeed need={recipeSystemRam(recipe, measuredRamHits)!} />
          </div>
        )}
        <p class="mt-4 text-sm">
          <a class="underline decoration-accent/40" href={`/recipes/${recipe.id}`}>Full recipe</a>
          {' · '}
          <a class="underline decoration-accent/40" href={recipe.calculator}>Calculator</a>
        </p>
      </section>
    ))}
    {sheet && <NextSteps path={sheet.path} />}
  </main>
</Base>
