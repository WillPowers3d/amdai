---
import Base from '../layouts/Base.astro';
import { AMAZON_ASSOCIATE_DISCLOSURE } from '../lib/affiliates';
---

<Base
  title="Affiliate disclosure"
  description="Amazon Associates statement, Rakuten Advertising and B&H notes, and which store links are not affiliate."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Legal</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Affiliate disclosure</h1>
    <p class="mt-6 font-serif text-2xl text-ink">{AMAZON_ASSOCIATE_DISCLOSURE}</p>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      amdai.net may earn commissions from retailer links. Amazon links use the Amazon Associates program.
      Newegg links may use Rakuten Advertising where that program is available.
      A commission does not change the price you pay and does not change which hardware we recommend.
      Paid affiliate links are marked <code class="font-mono text-ink">rel=&quot;sponsored&quot;</code>.
      Buttons say “Check price” — we do not invent SKUs or show a live or stale price.
    </p>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">Amazon Associates</h2>
      <p class="mt-3 leading-relaxed text-muted">
        {AMAZON_ASSOCIATE_DISCLOSURE}
      </p>
      <p class="mt-3 leading-relaxed text-muted">
        R9700 Lab Notes is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com and Amazon sites.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">Rakuten Advertising (Newegg)</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Some retailer links, including Newegg links, may be affiliate links through Rakuten Advertising, Amazon Associates or other programs. If you buy through them we may earn a commission at no extra cost to you. It never changes which hardware we recommend.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">B&amp;H</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Some B&amp;H links may be affiliate links when that program is available. A commission does not change the price you pay.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">Not affiliate programs</h2>
      <p class="mt-3 leading-relaxed text-muted">
        <strong class="font-medium text-ink">Micro Center</strong> and the <strong class="font-medium text-ink">AMD Store</strong>
        appear as “also available at” links only. Those links are not affiliate links.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-3xl">FTC</h2>
      <p class="mt-3 leading-relaxed text-muted">
        This site contains affiliate links. {AMAZON_ASSOCIATE_DISCLOSURE}
        We may also earn a commission from other retailer programs when those links are available, including Newegg via Rakuten Advertising.
        That relationship does not change our stack recommendations — those come from the test rig notes and the calculator estimates, not from who pays a commission.
      </p>
    </section>
  </main>
</Base>
