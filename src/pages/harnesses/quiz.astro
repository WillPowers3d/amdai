---
import Base from '../../layouts/Base.astro';
import HarnessesNav from '../../components/harnesses/HarnessesNav.astro';
import {
  CATEGORY_COPY,
  harnessPath,
  hybridLabel,
  parseQuizAnswers,
  pickHarness,
  quizHasAnswers,
  quizResultPath,
  surfaceLabel,
  type QuizAnswers,
} from '../../lib/harnesses';
import { harnesses } from '../../lib/harnesses-data';

const fromQuery = parseQuizAnswers(Astro.url.search);
const defaults: QuizAnswers = {
  job: fromQuery.job ?? 'agent',
  usage: fromQuery.usage ?? 'local',
  surface: fromQuery.surface ?? 'cli',
  tools: fromQuery.tools ?? 'yes',
};
const submitted = quizHasAnswers(fromQuery);
const list = harnesses();

const variants: { key: string; answers: QuizAnswers }[] = [
  { key: 'hermes-cli', answers: { job: 'agent', usage: 'local', surface: 'cli', tools: 'yes' } },
  { key: 'hermes-desktop', answers: { job: 'agent', usage: 'local', surface: 'desktop', tools: 'yes' } },
  { key: 'continue-local', answers: { job: 'agent', usage: 'local', surface: 'ide', tools: 'yes' } },
  { key: 'continue-hybrid', answers: { job: 'agent', usage: 'hybrid', surface: 'ide', tools: 'yes' } },
  { key: 'openhands', answers: { job: 'agent', usage: 'local', surface: 'web', tools: 'yes' } },
  { key: 'lm-studio', answers: { job: 'chat', usage: 'local', surface: 'desktop', tools: 'no' } },
  { key: 'open-webui', answers: { job: 'chat', usage: 'local', surface: 'web', tools: 'no' } },
  { key: 'comfyui', answers: { job: 'image', usage: 'local', surface: 'web', tools: 'no' } },
];

const cards = variants.map((row) => ({ ...row, pick: pickHarness(row.answers, list) }));
const currentKey =
  defaults.job === 'image'
    ? 'comfyui'
    : defaults.job === 'chat'
      ? defaults.surface === 'desktop'
        ? 'lm-studio'
        : 'open-webui'
      : defaults.surface === 'ide'
        ? defaults.usage === 'hybrid'
          ? 'continue-hybrid'
          : 'continue-local'
        : defaults.surface === 'web'
          ? 'openhands'
          : defaults.surface === 'desktop'
            ? 'hermes-desktop'
            : 'hermes-cli';
---

<Base
  title="Pick a harness"
  description="Mini quiz: agent, chat, or image? Local or hybrid? CLI, IDE, desktop, or web? Reading the result needs no JavaScript."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <HarnessesNav current="quiz" />
    <h1 class="display mt-6 text-4xl sm:text-5xl">Pick a harness</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Four questions. The pick updates from the radios — no JavaScript. Permalink URLs are real
      static pages if you want to share one.
    </p>

    <form id="harness-quiz" class="mt-8 space-y-6" method="get" action="/harnesses/quiz">
      <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
        <legend class="px-1 font-medium">What are you plugging in?</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-3">
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="job" value="agent" checked={defaults.job === 'agent'} />
            <span class="block font-medium">Agent</span>
            <span class="mt-1 block text-sm text-muted">Tools, edits, a loop.</span>
          </label>
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="job" value="chat" checked={defaults.job === 'chat'} />
            <span class="block font-medium">Chat UI</span>
            <span class="mt-1 block text-sm text-muted">Talk to the same /v1.</span>
          </label>
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="job" value="image" checked={defaults.job === 'image'} />
            <span class="block font-medium">Image / video</span>
            <span class="mt-1 block text-sm text-muted">Diffusion, not GGUF chat.</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
        <legend class="px-1 font-medium">Local or hybrid?</legend>
        <p class="mt-1 text-sm text-muted">
          Same toggle as the <a class="underline decoration-accent/40" href="/calculator">calculator</a>.
          No cloud prices.
        </p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="usage" value="local" checked={defaults.usage !== 'hybrid'} />
            <span class="block font-medium">Fully local</span>
            <span class="mt-1 block text-sm text-muted">127.0.0.1 does the whole job.</span>
          </label>
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="usage" value="hybrid" checked={defaults.usage === 'hybrid'} />
            <span class="block font-medium">Hybrid</span>
            <span class="mt-1 block text-sm text-muted">Local plus a cloud model for heavy turns.</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
        <legend class="px-1 font-medium">Where do you want to sit?</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {([
            ['cli', 'CLI', 'Terminal agent or pair-programmer.'],
            ['ide', 'IDE', 'VS Code / editor extension.'],
            ['desktop', 'Desktop', 'A local app window.'],
            ['web', 'Web', 'Browser UI or gateway.'],
          ] as const).map(([value, label, hint]) => (
            <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
              <input class="sr-only" type="radio" name="surface" value={value} checked={defaults.surface === value} />
              <span class="block font-medium">{label}</span>
              <span class="mt-1 block text-sm text-muted">{hint}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="rounded-2xl border border-line bg-raised/40 p-5">
        <legend class="px-1 font-medium">Do you need tools?</legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="tools" value="yes" checked={defaults.tools !== 'no'} />
            <span class="block font-medium">Yes — files, terminal, channels</span>
          </label>
          <label class="cursor-pointer rounded-2xl border border-line bg-canvas/70 p-4 has-[:checked]:border-accent has-[:checked]:ring-2 has-[:checked]:ring-accent">
            <input class="sr-only" type="radio" name="tools" value="no" checked={defaults.tools === 'no'} />
            <span class="block font-medium">No — chat is enough</span>
          </label>
        </div>
      </fieldset>

      <div class="flex flex-wrap gap-3">
        <button class="btn-primary" type="submit">Refresh from URL</button>
        {submitted && <a class="btn-ghost" href="/harnesses/quiz">Clear</a>}
      </div>

      <div class="quiz-results">
        {cards.map((card) => (
          <section
            class:list={['card mt-8 p-5 quiz-card', card.key === currentKey && 'is-fallback']}
            data-quiz={card.key}
            aria-labelledby={`pick-${card.key}`}
          >
            <p class="kicker">Starting point</p>
            <h2 id={`pick-${card.key}`} class="mt-1 text-2xl tracking-tight">
              <a class="underline decoration-accent/40" href={harnessPath(card.pick.primary.id)}>{card.pick.primary.title}</a>
            </h2>
            <p class="mt-3 flex flex-wrap gap-2 text-xs">
              <span class="badge">{CATEGORY_COPY[card.pick.primary.category].label}</span>
              {card.pick.primary.used_on_our_rig && <span class="badge-tested">Used on our rig</span>}
              <span class="badge">{hybridLabel(card.pick.primary)}</span>
              {card.pick.primary.surfaces.map((surface) => <span class="badge">{surfaceLabel(surface)}</span>)}
            </p>
            <p class="mt-4 text-muted">{card.pick.reason}</p>
            <p class="mt-3 text-sm text-muted">{card.pick.usageNote}</p>
            <p class="mt-5 flex flex-wrap gap-3 text-sm">
              <a class="btn-primary" href={harnessPath(card.pick.primary.id)}>Open {card.pick.primary.title}</a>
              <a class="btn-secondary" href="/harnesses/connect">Connect to :8080 / :8083</a>
              <a class="btn-ghost" href={quizResultPath(card.answers)}>Permalink</a>
            </p>
            {card.pick.alternates.length > 0 && (
              <div class="mt-6">
                <h3 class="text-lg tracking-tight">Also consider</h3>
                <ul class="mt-2 space-y-2 text-sm">
                  {card.pick.alternates.map((row) => (
                    <li>
                      <a class="underline decoration-accent/40" href={harnessPath(row.id)}>{row.title}</a>
                      <span class="text-muted"> — {row.what_for}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ))}
      </div>
    </form>

    <p class="mt-8 text-sm text-muted">
      Presets:
      <a class="underline decoration-accent/40" href="/harnesses/quiz/agent-local-cli-yes">our-rig CLI</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/harnesses/quiz/agent-local-ide-yes">IDE agent</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/harnesses/quiz/chat-local-web-no">browser chat</a>
      {' · '}
      <a class="underline decoration-accent/40" href="/harnesses/quiz/image-local-web-no">ComfyUI</a>
    </p>
  </main>
</Base>

<style>
  .quiz-card {
    display: none;
  }
  .quiz-card.is-fallback {
    display: block;
  }
  #harness-quiz:has([name='job']:checked) .quiz-card.is-fallback {
    display: none;
  }
  #harness-quiz:has([name='job'][value='image']:checked) .quiz-card[data-quiz='comfyui'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='chat']:checked):has([name='surface'][value='desktop']:checked)
    .quiz-card[data-quiz='lm-studio'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='chat']:checked):not(:has([name='surface'][value='desktop']:checked))
    .quiz-card[data-quiz='open-webui'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='agent']:checked):has([name='surface'][value='ide']:checked):has(
      [name='usage'][value='hybrid']:checked
    )
    .quiz-card[data-quiz='continue-hybrid'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='agent']:checked):has([name='surface'][value='ide']:checked):not(
      :has([name='usage'][value='hybrid']:checked)
    )
    .quiz-card[data-quiz='continue-local'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='agent']:checked):has([name='surface'][value='web']:checked)
    .quiz-card[data-quiz='openhands'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='agent']:checked):has([name='surface'][value='desktop']:checked)
    .quiz-card[data-quiz='hermes-desktop'] {
    display: block;
  }
  #harness-quiz:has([name='job'][value='agent']:checked):has([name='surface'][value='cli']:checked)
    .quiz-card[data-quiz='hermes-cli'],
  #harness-quiz:has([name='job'][value='agent']:checked):not(:has([name='surface']:checked))
    .quiz-card[data-quiz='hermes-cli'] {
    display: block;
  }
</style>
