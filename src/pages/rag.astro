---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import {
  RAG_ALONGSIDE,
  RAG_CITED_LABEL,
  RAG_DESCRIPTION,
  RAG_EMPTY,
  RAG_ERRORS,
  RAG_FAQ,
  RAG_FIT_BANDS,
  RAG_FIT_ROWS,
  RAG_HUB,
  RAG_LEAD,
  RAG_LINUX_STEPS,
  RAG_MODELS,
  RAG_SECTIONS,
  RAG_SOURCES,
  RAG_SPEED_LABEL,
  RAG_TITLE,
  RAG_WHAT,
  RAG_WINDOWS_STEPS,
} from '../lib/rag';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../lib/ram-surfaces';
---

<Base title={RAG_TITLE} description={RAG_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">{RAG_CITED_LABEL}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{RAG_TITLE}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{RAG_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {RAG_HUB.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>

    <Callout type="note" title="llama.cpp embeddings first, not a ranked app">
      <p>
        Local RAG on AMDai starts with llama.cpp <code class="font-mono text-ink">--embeddings</code>
        and <code class="font-mono text-ink">/v1/embeddings</code>. The chat sidecar stays
        llama.cpp Vulkan. AnythingLLM and Open WebUI are catalogued harnesses that
        already say docs-plus-chat — that is not a ranking. Speeds and retrieval
        quality are <strong class="text-ink">{RAG_SPEED_LABEL}</strong>. The gap is on
        <a class="underline decoration-accent/40" href="/wanted">/wanted</a>.
        There is no house Stack Lab recipe for RAG.
      </p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="RAG sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {RAG_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="what-it-is" class="mt-10 scroll-mt-36" aria-labelledby="what-it-is-heading">
      <h2 id="what-it-is-heading" class="font-serif text-3xl tracking-tight">What local RAG is</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{RAG_WHAT}</p>
      <Callout type="note" title="Go deeper">
        <p>
          Context length, the KV cache, and why VRAM rises as the window fills live on
          <a class="underline decoration-accent/40" href="/long-context">Long context</a>
          and the glossary entries
          <a class="underline decoration-accent/40" href="/glossary#kv-cache">KV cache</a>,
          <a class="underline decoration-accent/40" href="/glossary#context-length">context length</a>,
          and
          <a class="underline decoration-accent/40" href="/glossary#offload">offload</a>.
          Shopper RAM lines stay <strong class="text-ink">{RAM_MIN_LABEL}</strong> and
          <strong class="text-ink">{RAM_FULL_LABEL}</strong>.
        </p>
      </Callout>
    </section>

    <section id="models" class="mt-12 scroll-mt-36" aria-labelledby="models-heading">
      <h2 id="models-heading" class="font-serif text-3xl tracking-tight">nomic-embed fit bands</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Official nomic-embed-text-v1.5 GGUF sizes. House comparison is Q6_K / Q5_K_M /
        Q4_K_M. <strong class="text-ink">Q3_K_M is a labeled estimate</strong> — not a
        local desktop run. Runtime VRAM stays {RAG_EMPTY}. We do not invent a disk size.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="table-lab min-w-[52rem]">
          <caption>
            Official nomic-embed-text-v1.5 GGUF sizes. Q3 is a labeled estimate. Speed is not measured.
          </caption>
          <thead>
            <tr>
              <th scope="col">Quant</th>
              <th scope="col">Kind</th>
              <th scope="col">Official size</th>
              <th scope="col">Standalone 8 GB+</th>
              <th scope="col">Next to a 35B sidecar</th>
              <th scope="col">Speed</th>
            </tr>
          </thead>
          <tbody>
            {RAG_FIT_BANDS.map((row) => (
              <tr>
                <th scope="row">{row.quant}</th>
                <td>{row.kindLabel}</td>
                <td class="tabular-nums">{row.size}</td>
                <td>{row.standalone}</td>
                <td>{row.sidecar}</td>
                <td>{row.speed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-faint">
        Also cited, not in the Q6/Q5/Q4 set: Q8_0 140 MiB, F16 262 MiB, BGE small 33.4M
        params, BGE base 0.1B params. File listings without a published GGUF size stay
        {RAG_EMPTY}.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-[40rem] border-collapse text-left text-sm">
          <caption class="sr-only">Cited embedding files including larger nomic listings and BGE param counts.</caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="py-3 pr-4 font-medium text-ink">File</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Official size</th>
              <th scope="col" class="py-3 pr-4 font-medium text-ink">Note</th>
            </tr>
          </thead>
          <tbody>
            {RAG_MODELS.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-3 pr-4 font-medium text-ink">
                  <a class="underline decoration-accent/40" href={row.href}>{row.name}</a>
                  <span class="block text-[0.65rem] font-normal text-faint">
                    {row.kind === 'estimate' ? 'estimate' : 'cited'}
                  </span>
                </th>
                <td class="py-3 pr-4 tabular-nums text-muted">{row.size}</td>
                <td class="py-3 pr-4 text-muted">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fit" class="mt-12 scroll-mt-36" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">Pick by VRAM — embed plus the chat sidecar</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Every row is a labeled estimate. Pick the nomic file from official sizes.
        The embed GGUF is small; the chat sidecar is the VRAM question. Speed stays
        {RAG_SPEED_LABEL}.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="table-lab min-w-[52rem]">
          <caption>
            Pick a cited nomic-embed file by discrete VRAM class. Speed is not measured.
          </caption>
          <thead>
            <tr>
              <th scope="col">VRAM</th>
              <th scope="col">Pick</th>
              <th scope="col">Fit</th>
              <th scope="col">Speed</th>
            </tr>
          </thead>
          <tbody>
            {RAG_FIT_ROWS.map((row) => (
              <tr id={row.id}>
                <th scope="row">{row.vramClass}</th>
                <td>{row.pick}</td>
                <td>{row.fit}</td>
                <td>{row.speed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="mt-4 flex flex-wrap gap-2">
        {RAG_FIT_ROWS.flatMap((row) => row.cards).map((link) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-6 rounded-xl border border-line bg-canvas/60 p-3 text-sm">
        <p class="text-muted">
          When the chat sidecar offloads, shopper RAM lines stay the same two labels —
          labeled estimate until a first-party RAG card exists. Size the LLM on the
          <a class="underline decoration-accent/40" href="/calculator">calculator</a>.
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <p class="text-faint">{RAM_MIN_LABEL}</p>
            <p class="mt-1 font-serif text-2xl">Estimate</p>
            <p class="mt-1 text-xs text-faint">Chat sidecar · size on the calculator</p>
          </div>
          <div>
            <p class="text-faint">{RAM_FULL_LABEL}</p>
            <p class="mt-1 font-serif text-2xl">Estimate</p>
            <p class="mt-1 text-xs text-faint">Chat sidecar · size on the calculator</p>
          </div>
        </div>
      </div>
    </section>

    <section id="linux" class="mt-12 scroll-mt-36" aria-labelledby="linux-heading">
      <h2 id="linux-heading" class="font-serif text-3xl tracking-tight">Linux path — index a folder, ask a question</h2>
      <ul class="mt-6 grid gap-4">
        {RAG_LINUX_STEPS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{row.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {row.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="windows" class="mt-12 scroll-mt-36" aria-labelledby="windows-heading">
      <h2 id="windows-heading" class="font-serif text-3xl tracking-tight">Windows — cited pointer</h2>
      <ul class="mt-6 grid gap-4">
        {RAG_WINDOWS_STEPS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{row.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {row.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="alongside" class="mt-12 scroll-mt-36" aria-labelledby="alongside-heading">
      <h2 id="alongside-heading" class="font-serif text-3xl tracking-tight">Next to the daily driver</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{RAG_ALONGSIDE}</p>
      <p class="mt-4">
        <a class="btn-secondary" href="/harnesses">Harnesses</a>
        <a class="btn-ghost ml-3" href="/stack-lab">Stack Lab</a>
      </p>
    </section>

    <section id="errors" class="mt-12 scroll-mt-36" aria-labelledby="errors-heading">
      <h2 id="errors-heading" class="font-serif text-3xl tracking-tight">When it breaks</h2>
      <ul class="mt-6 grid gap-4">
        {RAG_ERRORS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{row.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {row.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq" class="mt-12 scroll-mt-36" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <ul class="mt-6 grid gap-4">
        {RAG_FAQ.map((item) => (
          <li id={item.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{item.question}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
            {item.links?.length ? (
              <ul class="mt-4 flex flex-wrap gap-2">
                {item.links.map((link) => (
                  <li>
                    <a
                      class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-36" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
        {RAG_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href}>{source.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <NextSteps path="/rag" />
  </main>
</Base>
