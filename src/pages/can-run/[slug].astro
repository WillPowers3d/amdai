---
import Base from '../../layouts/Base.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import Callout from '../../components/Callout.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextStepBuyBox from '../../components/NextStepBuyBox.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import SystemRamNeed from '../../components/SystemRamNeed.astro';
import { runs } from '../../lib/run-card-data';
import { runPath } from '../../lib/run-card';
import {
  CAN_RUN_HUB,
  CAN_RUN_UNMEASURED,
  canRunPairPage,
  canRunPairPages,
  parseCanRunSlug,
} from '../../lib/can-run';
import { RAM_FULL_LABEL, RAM_MIN_LABEL } from '../../lib/ram-surfaces';
import { CAN_RUN_FOOTER_SRC, CAN_RUN_NEXT_STEP_SRC, nextStepPicks } from '../../lib/upgrade-pick';

export function getStaticPaths() {
  return canRunPairPages().map((page) => ({ params: { slug: page.slug } }));
}

const slug = Astro.params.slug ?? '';
const parsed = parseCanRunSlug(slug);
if (!parsed) throw new Error(`unknown can-run slug ${slug}`);
const page = canRunPairPage(parsed.modelId, parsed.gpuId, runs);
const nextStep = nextStepPicks(page.modelId, page.gpuId);
---

<Base title={page.title} description={page.description}>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">
      <a class="underline decoration-accent/40" href={CAN_RUN_HUB}>Can my Radeon run it?</a>
      ·
      <a class="underline decoration-accent/40" href={page.gpuPath}>{page.gpuShort}</a>
      ·
      <a class="underline decoration-accent/40" href={page.modelPath}>{page.modelShort}</a>
      · {page.engine}
    </p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{page.heading}</h1>
    <p class="mt-3 font-serif text-2xl tracking-tight text-accent-ink">{page.headlineLabel}</p>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{page.lead}</p>
    <NextStepBuyBox picks={nextStep} src={CAN_RUN_NEXT_STEP_SRC} />
    <div class="mt-4">
      <HowWeTest />
    </div>
    <Callout type="note" title="What is measured">
      <p>
        Sizes come from the
        <a class="underline decoration-accent/40" href={page.modelPath}>{page.modelShort}</a>
        page. VRAM is the published
        <a class="underline decoration-accent/40" href={page.gpuPath}>{page.gpuShort}</a>
        sticker ({page.vramLabel}, {page.gfx}). Fit totals are calculator estimates.
        <strong class="text-ink">{page.q3}</strong> is a labeled estimate ({page.q3Cite}).
        Measured tok/s appear only where a local desktop card already exists.
        Check-price buttons use the existing
        <a class="underline decoration-accent/40" href="/disclosure">/go/</a>
        routes. We do not print a price.
      </p>
    </Callout>

    <section id="fit" class="mt-12" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">Q6 / Q5 / Q4 plus a Q3 estimate</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Weights are official GGUF listings when the model page has them. Totals include KV at f16.
        1-GPU and 2-GPU columns use the same calculator as
        <a class="underline decoration-accent/40" href={page.calculatorHref}>this share URL</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">{page.modelShort} on {page.gpuShort} fit table</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Weights</th>
              {page.rows[0]?.one.map((cell) => (
                <th class="py-2 pr-3 font-normal" scope="col">1× {cell.contextLabel}</th>
              ))}
              {page.rows[0]?.two.map((cell) => (
                <th class="py-2 pr-3 font-normal" scope="col">2× {cell.contextLabel}</th>
              ))}
              <th class="py-2 font-normal" scope="col">Speed</th>
            </tr>
          </thead>
          <tbody>
            {page.rows.map((row) => {
              const speedCell = row.one.find((cell) => cell.context === 4096) ?? row.one[0];
              return (
                <tr class="border-b border-line/70 align-top">
                  <th class="py-3 pr-3 font-medium" scope="row">
                    {row.quant}
                    <p class="text-xs font-normal text-faint">{row.kindLabel}</p>
                  </th>
                  <td class="py-3 pr-3">
                    {row.weightsGb}
                    <p class="mt-1 text-xs text-faint">{row.weightsCite}</p>
                  </td>
                  {row.one.map((cell) => (
                    <td class="py-3 pr-3">
                      <span class="text-ink">{cell.verdictLabel}</span>
                      <p class="text-xs text-faint">{cell.totalGb}</p>
                    </td>
                  ))}
                  {row.two.map((cell) => (
                    <td class="py-3 pr-3">
                      <span class="text-ink">{cell.verdictLabel}</span>
                      <p class="text-xs text-faint">{cell.totalGb}</p>
                    </td>
                  ))}
                  <td class="py-3 text-xs">
                    {speedCell && speedCell.speedKind === 'measured' && speedCell.speed !== CAN_RUN_UNMEASURED ? (
                      <span class="text-accent-ink">{speedCell.speed}</span>
                    ) : (
                      <span class="text-faint">{speedCell?.speed ?? CAN_RUN_UNMEASURED}</span>
                    )}
                    <p class="mt-1 text-faint">{speedCell?.note}</p>
                    {speedCell && speedCell.runIds.length > 0 && (
                      <p class="mt-1">
                        {speedCell.runIds.map((id) => (
                          <a class="mr-2 underline decoration-accent/40" href={runPath(id)}>{id}</a>
                        ))}
                      </p>
                    )}
                    {speedCell && speedCell.speedKind !== 'measured' && (
                      <p class="mt-1">
                        <a class="underline decoration-accent/40" href="/contribute">Contribute</a>
                        ·
                        <a class="underline decoration-accent/40" href="/amdai-bench">amdai-bench</a>
                      </p>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section id="ram" class="mt-12" aria-labelledby="ram-heading">
      <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">System RAM</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        {page.showRam
          ? `When the file does not stay in ${page.vramLabel} VRAM, the spill is system RAM.`
          : `The shopper ${page.ramQuant} file stays in ${page.vramLabel} at 4K. Longer context can still spill.`}
        Shopper lines stay <strong class="text-ink">{RAM_MIN_LABEL}</strong> and
        <strong class="text-ink">{RAM_FULL_LABEL}</strong>
        for {page.ramQuant} on this card. Estimate unless a measured R9700 card overlays the kit.
      </p>
      <div class="mt-6">
        <SystemRamNeed need={page.ramNeed} />
      </div>
    </section>

    <section id="launch" class="mt-12" aria-labelledby="launch-heading">
      <h2 id="launch-heading" class="font-serif text-3xl tracking-tight">llama.cpp launch</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Vulkan first, then ROCm/HIP. Copy a house recipe when one exists.
        <a class="underline decoration-accent/40" href="/backends/llamacpp">llama.cpp</a>
        stays first. Strata / vLLM stay on
        <a class="underline decoration-accent/40" href="/backends">/backends</a>.
      </p>
      <div class="mt-6 grid gap-4">
        {page.launches.map((launch) => (
          <article class="min-w-0 max-w-full rounded-2xl border border-line bg-raised/50 p-5">
            <p class="kicker">{launch.backend}</p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">
              <a class="hover:text-accent-ink" href={launch.href}>{launch.label}</a>
            </h3>
            <p class="mt-2 text-sm text-muted">{launch.note}</p>
            <pre class="mt-4 overflow-x-auto rounded-xl border border-line bg-canvas p-3 text-xs">{launch.command}</pre>
          </article>
        ))}
      </div>
    </section>

    <section id="buy" class="mt-12" aria-labelledby="buy-heading">
      <h2 id="buy-heading" class="font-serif text-3xl tracking-tight">Check price</h2>
      <p class="mt-3 text-sm text-muted">
        Existing <a class="underline decoration-accent/40" href="/disclosure">/go/</a> routes for this GPU sheet.
        Buttons say Check price — we do not print a figure.
      </p>
      <BuyButtons product={page.productId} heading={page.gpuName} src={CAN_RUN_FOOTER_SRC} />
    </section>

    <section id="faq" class="mt-12" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <dl class="mt-6 grid gap-6">
        {page.faq.map((item) => (
          <div>
            <dt class="font-serif text-2xl tracking-tight">{item.question}</dt>
            <dd class="mt-2 leading-relaxed text-muted">{item.answer}</dd>
            <dd class="mt-2 text-sm">
              {item.links.map((link, index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="stack-lab" class="mt-12" aria-labelledby="stack-lab-heading">
      <h2 id="stack-lab-heading" class="font-serif text-3xl tracking-tight">Stack Lab</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Measure the pair on your box. Doctor and planner are allowlisted. House daily / Flash
        profiles appear only for those house models.
      </p>
      <div class="mt-4 grid gap-4">
        {page.stackLab.map((input) => (
          <OpenInStackLab {...input} compact />
        ))}
      </div>
    </section>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40" href={CAN_RUN_HUB}>All pairs</a>
      ·
      <a class="underline decoration-accent/40" href={page.gpuPath}>{page.gpuShort}</a>
      ·
      <a class="underline decoration-accent/40" href={page.modelPath}>{page.modelShort}</a>
      ·
      <a class="underline decoration-accent/40" href={page.ggufHref}>Official GGUF</a>
      ·
      <a class="underline decoration-accent/40" href={page.hfHref}>Official card</a>
      ·
      <a class="underline decoration-accent/40" href="/backends/llamacpp">llama.cpp</a>
      ·
      <a class="underline decoration-accent/40" href="/tuning">Speed up llama.cpp</a>
      ·
      <a class="underline decoration-accent/40" href="/multi-gpu">Dual / multi-GPU</a>
    </p>
    <NextSteps path={page.path} />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
