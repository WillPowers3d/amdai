---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import SystemRamNeed from '../../components/SystemRamNeed.astro';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';
import { runPath } from '../../lib/run-card';
import { runs } from '../../lib/run-card-data';
import {
  COMPARE_MODEL,
  COMPARE_Q3,
  HIP_BUILD,
  HIP_RUN,
  RAM_FULL_LABEL,
  RAM_MIN_LABEL,
  VULKAN_BUILD,
  VULKAN_RUN,
  VULKAN_VS_ROCM_AXES,
  VULKAN_VS_ROCM_CITED_LABEL,
  VULKAN_VS_ROCM_DECISION,
  VULKAN_VS_ROCM_DESCRIPTION,
  VULKAN_VS_ROCM_FAQ,
  VULKAN_VS_ROCM_GPUS,
  VULKAN_VS_ROCM_HUB,
  VULKAN_VS_ROCM_LEAD,
  VULKAN_VS_ROCM_PENDING,
  VULKAN_VS_ROCM_RAM_NOTE,
  VULKAN_VS_ROCM_SECTIONS,
  VULKAN_VS_ROCM_SOURCES,
  VULKAN_VS_ROCM_STACK_LAB,
  VULKAN_VS_ROCM_TITLE,
  VULKAN_VS_ROCM_UNMEASURED,
  vulkanVsRocmDailyRamNeed,
  vulkanVsRocmMeasuredRows,
  vulkanVsRocmOffloadRamNeed,
} from '../../lib/vulkan-vs-rocm';

const measured = vulkanVsRocmMeasuredRows(runs);
const dailyRam = vulkanVsRocmDailyRamNeed();
const offloadRam = vulkanVsRocmOffloadRamNeed();
---

<Base title={VULKAN_VS_ROCM_TITLE} description={VULKAN_VS_ROCM_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">
      <a class="underline decoration-accent/40" href="/compare">Compare</a>
      · {VULKAN_VS_ROCM_CITED_LABEL}
    </p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">llama.cpp on Radeon: Vulkan vs ROCm (HIP)</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{VULKAN_VS_ROCM_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {VULKAN_VS_ROCM_HUB.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-4 grid gap-3">
      <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      <OpenInStackLab {...HOUSE_STACK_LAB.daily} compact />
      <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
    </div>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="Vulkan vs ROCm sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {VULKAN_VS_ROCM_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="decision" class="mt-12 scroll-mt-28" aria-labelledby="decision-heading">
      <h2 id="decision-heading" class="font-serif text-3xl tracking-tight">Decision box</h2>
      <Callout type="check" title="Pick Vulkan tonight. Keep HIP when ROCm is already clean.">
        <p>{VULKAN_VS_ROCM_DECISION}</p>
      </Callout>
      <p class="mt-4 text-sm text-muted">
        Longer ROCm-guide version:
        <a class="underline decoration-accent/40" href="/rocm/vulkan-hip">/rocm/vulkan-hip</a>.
        Glossary:
        <a class="underline decoration-accent/40" href="/glossary#vulkan">Vulkan</a>
        ·
        <a class="underline decoration-accent/40" href="/glossary#hip">HIP</a>.
      </p>
    </section>

    <section id="axes" class="mt-12 scroll-mt-28" aria-labelledby="axes-heading">
      <h2 id="axes-heading" class="font-serif text-3xl tracking-tight">Install, speed, split, flags</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        HIP speed cells stay <strong class="text-ink">{VULKAN_VS_ROCM_PENDING}</strong>.
        Q6 / Q5 / Q4 first. {COMPARE_Q3} is a labeled estimate.
      </p>
      <ul class="mt-6 grid gap-4">
        {VULKAN_VS_ROCM_AXES.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.title}</h3>
            <p class="mt-1 text-xs uppercase tracking-[0.14em] text-faint">{row.kind}</p>
            <dl class="mt-4 grid gap-4 text-sm md:grid-cols-2">
              <div>
                <dt class="text-faint">Vulkan</dt>
                <dd class="mt-1 leading-relaxed text-muted">{row.vulkan}</dd>
              </div>
              <div>
                <dt class="text-faint">ROCm / HIP</dt>
                <dd class="mt-1 leading-relaxed text-muted">{row.hip}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </section>

    <section id="gpus" class="mt-12 scroll-mt-28" aria-labelledby="gpus-heading">
      <h2 id="gpus-heading" class="font-serif text-3xl tracking-tight">Supported GPUs</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Official HIP follows the ROCm 10.1 matrix. Vulkan is the always-works consumer path.
        gfx1031 HSA_OVERRIDE stays unofficial.
      </p>
      <ul class="mt-6 grid gap-4">
        {VULKAN_VS_ROCM_GPUS.map((row) => (
          <li id={row.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.gen}</h3>
            <p class="mt-2 font-mono text-sm text-accent-ink">{row.gfx}</p>
            <dl class="mt-4 grid gap-4 text-sm md:grid-cols-2">
              <div>
                <dt class="text-faint">Vulkan</dt>
                <dd class="mt-1 leading-relaxed text-muted">{row.vulkan}</dd>
              </div>
              <div>
                <dt class="text-faint">ROCm / HIP</dt>
                <dd class="mt-1 leading-relaxed text-muted">{row.hip}</dd>
              </div>
            </dl>
            <p class="mt-3 text-sm text-muted">{row.note}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {row.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section id="measured" class="mt-12 scroll-mt-28" aria-labelledby="measured-heading">
      <h2 id="measured-heading" class="font-serif text-3xl tracking-tight">Measured on local-desktop</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Official llama.cpp Vulkan cells from existing run cards. The HIP column stays
        <strong class="text-ink">{VULKAN_VS_ROCM_PENDING}</strong> until a first-party card lands.
        {COMPARE_Q3} is a labeled estimate. Full matrix:
        <a class="underline decoration-accent/40" href="/benchmarks">/benchmarks</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">{COMPARE_MODEL} Vulkan vs HIP on one R9700</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Kind</th>
              <th class="py-2 pr-3 font-normal" scope="col">Vulkan 4K</th>
              <th class="py-2 pr-3 font-normal" scope="col">Vulkan 32K</th>
              <th class="py-2 pr-3 font-normal" scope="col">HIP</th>
              <th class="py-2 font-normal" scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {measured.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">{row.quant}</th>
                <td class="py-3 pr-3 text-muted">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Measured Vulkan'}</td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && row.vulkan4k !== VULKAN_VS_ROCM_UNMEASURED ? (
                    <span class="text-accent-ink">{row.vulkan4k}</span>
                  ) : (
                    <span class="text-faint">{row.vulkan4k}</span>
                  )}
                </td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && row.vulkan32k !== VULKAN_VS_ROCM_UNMEASURED ? (
                    <span class="text-accent-ink">{row.vulkan32k}</span>
                  ) : (
                    <span class="text-faint">{row.vulkan32k}</span>
                  )}
                </td>
                <td class="py-3 pr-3 text-faint">{row.hip}</td>
                <td class="py-3 text-xs text-faint">
                  {row.note}
                  {row.runIds.length > 0 && (
                    <p class="mt-1">
                      {row.runIds.map((id) => (
                        <a class="mr-2 underline decoration-accent/40" href={runPath(id)}>{id}</a>
                      ))}
                    </p>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="commands" class="mt-12 scroll-mt-28" aria-labelledby="commands-heading">
      <h2 id="commands-heading" class="font-serif text-3xl tracking-tight">Build and run — llama.cpp first</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">
        Flags come from llama.cpp build.md and the house 35B recipe. HIP run flags match
        Vulkan; that is not a measured HIP card.
      </p>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">Vulkan compile</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{VULKAN_BUILD}</pre>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">HIP compile</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{HIP_BUILD}</pre>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">House Vulkan serve</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{VULKAN_RUN}</pre>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">HIP serve (same flags, unmeasured)</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{HIP_RUN}</pre>
      <p class="mt-4 text-sm text-muted">
        Walkthrough:
        <a class="underline decoration-accent/40" href="/tutorials/run-local-llm">Run a local Qwen</a>
        ·
        <a class="underline decoration-accent/40" href="/backends/llamacpp">llama.cpp backend</a>
        ·
        <a class="underline decoration-accent/40" href="/rocm-problems/hip-no-binary-for-gpu">HIP no binary</a>.
      </p>
    </section>

    <section id="ram" class="mt-12 scroll-mt-28" aria-labelledby="ram-heading">
      <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">System RAM</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{VULKAN_VS_ROCM_RAM_NOTE}</p>
      {dailyRam && (
        <div class="mt-6">
          <h3 class="font-serif text-2xl tracking-tight">House 35B · in-VRAM on one R9700</h3>
          <div class="mt-4">
            <SystemRamNeed need={dailyRam} />
          </div>
        </div>
      )}
      <div class="mt-8">
        <h3 class="font-serif text-2xl tracking-tight">Offload example · 16 GB + 35B Q4</h3>
        <p class="mt-2 text-sm text-muted">
          {RAM_MIN_LABEL} and {RAM_FULL_LABEL} for house 35B Q4_K_M on a 16 GB RX 7800 XT.
          Estimate. Backend (Vulkan or HIP) does not change the kit math.
        </p>
        <div class="mt-4">
          <SystemRamNeed need={offloadRam} />
        </div>
      </div>
    </section>

    <section id="stack-lab" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-heading">
      <h2 id="stack-lab-heading" class="font-serif text-3xl tracking-tight">Measure it on your card</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{VULKAN_VS_ROCM_STACK_LAB}</p>
      <div class="mt-4 grid gap-3">
        <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
        <OpenInStackLab {...HOUSE_STACK_LAB.daily} compact />
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
      </div>
    </section>

    <section id="faq" class="mt-12 scroll-mt-28" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <dl class="mt-6 grid gap-6">
        {VULKAN_VS_ROCM_FAQ.map((item) => (
          <div id={item.id}>
            <dt class="font-serif text-2xl tracking-tight">{item.question}</dt>
            <dd class="mt-2 leading-relaxed text-muted">{item.answer}</dd>
            <dd class="mt-2 text-sm">
              {item.links.map((link, index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {VULKAN_VS_ROCM_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel={source.href.startsWith('http') ? 'noopener' : undefined}>
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40" href="/compare">Compare</a>
      ·
      <a class="underline decoration-accent/40" href="/setup">Setup</a>
      ·
      <a class="underline decoration-accent/40" href="/faq">FAQ</a>
    </p>
    <NextSteps path="/compare/vulkan-vs-rocm" />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
