---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import HouseRam from '../../components/HouseRam.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import SecondCardBox from '../../components/SecondCardBox.astro';
import SystemRamNeed from '../../components/SystemRamNeed.astro';
import { runs } from '../../lib/run-card-data';
import {
  COMPARE_CONTEXTS,
  COMPARE_ENGINE,
  COMPARE_MODEL,
  COMPARE_Q3,
  COMPARE_Q3_CITE,
  COMPARE_QUANTS,
  SWEEP_REVERIFY,
  q3RamNeed,
  decodeWinner,
  oneVsTwoRows,
  winnerSummary,
} from '../../lib/local-desktop-compare';
import {
  secondCardClientPayload,
  twoCardFlashStrataRows,
} from '../../lib/second-card';

const rows = oneVsTwoRows(runs);
const summary = winnerSummary(rows);
const q3Ram = q3RamNeed(1);
const secondCard = secondCardClientPayload(runs);
const flashStrataRows = twoCardFlashStrataRows(runs);
const payload = rows.map((row) => ({
  id: `${row.quant}-${row.context}`,
  quant: row.quant,
  context: row.context,
  contextLabel: row.contextLabel,
  one: row.one,
  both: row.both,
  flag: row.flag ?? '',
  winner: decodeWinner(row),
}));
---

<Base
  title="One R9700 vs two (split)"
  description="Qwen3.6-35B-A3B on the local desktop: one R9700 versus a split across both cards — decode, prefill, VRAM, and system RAM from official llama.cpp run cards."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="kicker">
      <a class="underline decoration-accent/40" href="/compare">Compare</a>
      · {COMPARE_MODEL} · {COMPARE_ENGINE}
    </p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">One GPU or a split?</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
      Same 35B GGUF, llama.cpp Vulkan, f16 KV. Left is one R9700; right is a split across both cards.
      {summary.headline}
      Two full copies are a different layout —
      <a class="underline decoration-accent/40" href="/qwen36-dual">35B on two cards</a>.
      When a second card helps:
      <a class="underline decoration-accent/40" href="/multi-gpu">Dual / multi-GPU</a>.
      Hands-on llama.cpp flags:
      <a class="underline decoration-accent/40" href="/setup/multi-gpu">/setup/multi-gpu</a>.
    </p>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-6">
      <HouseRam which="daily" compact />
    </div>
    <aside class="mt-8 rounded-2xl border border-line bg-raised/40 p-5" aria-labelledby="second-card-verdict-heading">
      <p class="kicker">Measured verdict</p>
      <h2 id="second-card-verdict-heading" class="mt-2 font-serif text-2xl tracking-tight">
        {secondCard.honesty.headline}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">{secondCard.honesty.detail}</p>
      <p class="mt-3 text-xs text-faint">
        Counts and percents are derived from the 35B llama.cpp cards on this page, not typed in by hand.
      </p>
    </aside>
    <SecondCardBox verdict={secondCard.defaultVerdict} />
    <script type="application/json" id="second-card-payload" set:html={JSON.stringify(secondCard)} />
    <p class="mt-3 text-sm text-faint">
      Winner counts on this sweep: one GPU {summary.one} · split {summary.two} · tie {summary.tie} · incomplete {summary.incomplete}.
      Q6_K 1-GPU 4K uses the 23:55 card (103.23 tok/s). The earlier 82.62 card stays on /results.
    </p>

    <Callout type="warn" title="Overnight sweep, 2026-10-12">
      <p>{SWEEP_REVERIFY}</p>
    </Callout>
    {flashStrataRows.length ? (
      <aside class="mt-6 rounded-2xl border border-line bg-raised/40 p-5" aria-labelledby="flash-strata-heading">
        <p class="kicker">Flash / Strata, two cards</p>
        <h2 id="flash-strata-heading" class="mt-2 font-serif text-2xl tracking-tight">Measured two-card Strata Flash</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Flash-class files are the job a second card is for. These rows already exist in the repo — they are not a 35B split.
          Q3 stays a labeled estimate on this page.
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="table-lab min-w-[36rem]">
            <caption>Two-card Flash on Strata from official run cards and the lab log. Empty stays empty.</caption>
            <thead>
              <tr>
                <th scope="col">Quant</th>
                <th scope="col">Context</th>
                <th scope="col">Decode</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {flashStrataRows.map((row) => (
                <tr>
                  <td>{row.quant}</td>
                  <td>{row.contextLabel}</td>
                  <td class="tabular-nums">
                    <a class="underline decoration-accent/40" href={row.href}>{row.decode}</a>
                  </td>
                  <td class="text-sm text-muted">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </aside>
    ) : (
      <Callout type="note" title="Flash / Strata">
        <p>Two-card Strata Flash: measured results coming. Q3 stays a labeled estimate.</p>
      </Callout>
    )}

    <form id="compare-filters" class="mt-8 space-y-4" aria-controls="compare-table">
      <div>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Quant</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Quant">
          <button type="button" class="chip is-on" data-filter="quant" data-value="">All</button>
          {COMPARE_QUANTS.map((quant) => (
            <button type="button" class="chip" data-filter="quant" data-value={quant}>{quant}</button>
          ))}
        </div>
      </div>
      <div>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">Context</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Context">
          <button type="button" class="chip is-on" data-filter="context" data-value="">All</button>
          {COMPARE_CONTEXTS.map((ctx) => (
            <button type="button" class="chip" data-filter="context" data-value={String(ctx)}>
              {ctx === 4096 ? '4K' : ctx === 32768 ? '32K' : ctx === 131072 ? '128K' : '256K'}
            </button>
          ))}
        </div>
      </div>
      <div>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-faint">GPU count</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="GPU count">
          <button type="button" class="chip is-on" data-filter="gpuCount" data-value="">Both sides</button>
          <button type="button" class="chip" data-filter="gpuCount" data-value="1">1× R9700</button>
          <button type="button" class="chip" data-filter="gpuCount" data-value="2">2× split</button>
        </div>
      </div>
      <p class="text-sm text-muted" data-compare-status>{rows.length} rows. Share this URL.</p>
    </form>

    <div class="mt-6 hidden rounded-2xl border border-line bg-raised/50 p-5" data-compare-empty role="status">
      <p class="kicker">Empty</p>
      <h2 class="mt-2 text-xl">Nothing matches that filter</h2>
      <p class="mt-2 text-sm text-muted">We will not invent a row. Clear a chip or open the run cards.</p>
    </div>

    <div class="compare-cards mt-8 grid gap-4 lg:hidden">
      {payload.map((row) => (
        <article
          class="rounded-2xl border border-line bg-raised/50 p-5"
          data-compare-row
          data-quant={row.quant}
          data-context={String(row.context)}
        >
          <p class="kicker">{row.quant} · {row.contextLabel}</p>
          <h2 class="mt-1 text-xl tracking-tight">{row.winner.note}</h2>
          {row.flag ? <p class="mt-2 text-xs text-faint">{row.flag}</p> : null}
          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div data-side="1">
              <dt class="text-faint">1× decode</dt>
              <dd class="tabular-nums">
                {row.one.runIds.length ? <a class="underline decoration-accent/40" href={row.one.href}>{row.one.decode}</a> : row.one.decode}
              </dd>
            </div>
            <div data-side="2">
              <dt class="text-faint">Split decode</dt>
              <dd class="tabular-nums">
                {row.both.runIds.length ? <a class="underline decoration-accent/40" href={row.both.href}>{row.both.decode}</a> : row.both.decode}
              </dd>
            </div>
            <div data-side="1">
              <dt class="text-faint">1× prefill</dt>
              <dd class="tabular-nums">{row.one.prefill}</dd>
            </div>
            <div data-side="2">
              <dt class="text-faint">Split prefill</dt>
              <dd class="tabular-nums">{row.both.prefill}</dd>
            </div>
            <div data-side="1">
              <dt class="text-faint">1× VRAM / total</dt>
              <dd class="tabular-nums">{row.one.vramPerGpu} · {row.one.vramTotal}</dd>
            </div>
            <div data-side="2">
              <dt class="text-faint">Split VRAM / total</dt>
              <dd class="tabular-nums">{row.both.vramPerGpu} · {row.both.vramTotal}</dd>
            </div>
            <div data-side="1">
              <dt class="text-faint">1× system RAM</dt>
              <dd class="tabular-nums">{row.one.systemRam}</dd>
            </div>
            <div data-side="2">
              <dt class="text-faint">Split system RAM</dt>
              <dd class="tabular-nums">{row.both.systemRam}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>

    <div class="compare-table mt-8 hidden overflow-x-auto lg:block" id="compare-table">
      <table class="table-lab compare-sticky min-w-[72rem]">
        <caption>One R9700 versus a split across both cards. Decode, prefill, VRAM, and system RAM from local desktop run cards.</caption>
        <thead>
          <tr>
            <th scope="col" rowspan="2">Quant</th>
            <th scope="col" rowspan="2">Context</th>
            <th scope="col" rowspan="2">Who wins decode</th>
            <th scope="colgroup" colspan="5" data-side="1">One R9700</th>
            <th scope="colgroup" colspan="5" data-side="2">Both R9700s (split)</th>
          </tr>
          <tr>
            <th data-side="1">Prefill</th>
            <th data-side="1">Decode</th>
            <th data-side="1">VRAM / card</th>
            <th data-side="1">VRAM total</th>
            <th data-side="1">System RAM</th>
            <th data-side="2">Prefill</th>
            <th data-side="2">Decode</th>
            <th data-side="2">VRAM / card</th>
            <th data-side="2">VRAM total</th>
            <th data-side="2">System RAM</th>
          </tr>
        </thead>
        <tbody>
          {payload.map((row) => (
            <tr data-compare-row data-quant={row.quant} data-context={String(row.context)}>
              <td class="font-medium">
                {row.quant}
                {row.flag ? <span class="block text-xs font-normal text-faint">{row.flag}</span> : null}
              </td>
              <td>{row.contextLabel}</td>
              <td class="text-sm text-muted">{row.winner.note}</td>
              <td class="tabular-nums" data-side="1">
                {row.one.runIds.length ? <a class="underline decoration-accent/40" href={row.one.href}>{row.one.prefill}</a> : row.one.prefill}
              </td>
              <td class="tabular-nums" data-side="1">
                {row.one.runIds.length ? <a class="underline decoration-accent/40" href={row.one.href}>{row.one.decode}</a> : row.one.decode}
              </td>
              <td class="tabular-nums" data-side="1">{row.one.vramPerGpu}</td>
              <td class="tabular-nums" data-side="1">{row.one.vramTotal}</td>
              <td class="tabular-nums" data-side="1">{row.one.systemRam}</td>
              <td class="tabular-nums" data-side="2">
                {row.both.runIds.length ? <a class="underline decoration-accent/40" href={row.both.href}>{row.both.prefill}</a> : row.both.prefill}
              </td>
              <td class="tabular-nums" data-side="2">
                {row.both.runIds.length ? <a class="underline decoration-accent/40" href={row.both.href}>{row.both.decode}</a> : row.both.decode}
              </td>
              <td class="tabular-nums" data-side="2">{row.both.vramPerGpu}</td>
              <td class="tabular-nums" data-side="2">{row.both.vramTotal}</td>
              <td class="tabular-nums" data-side="2">{row.both.systemRam}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <aside class="mt-10 rounded-2xl border border-line bg-raised/40 p-5" aria-labelledby="q3-ram-heading">
      <p class="kicker">Q3 estimate</p>
      <h2 id="q3-ram-heading" class="mt-2 font-serif text-2xl tracking-tight">{COMPARE_Q3}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Q6 / Q5 / Q4 system RAM above is from local desktop cards.
        <strong class="text-ink">{COMPARE_Q3}</strong> is a labeled estimate ({COMPARE_Q3_CITE}) — not a local desktop run.
        Decode and prefill stay not measured. Full Q3 column:
        <a class="underline decoration-accent/40" href="/compare/q4-q5-q6">Q6 / Q5 / Q4 + Q3 estimate</a>.
      </p>
      <div class="mt-4">
        <SystemRamNeed need={q3Ram} compact />
      </div>
    </aside>

    <p class="mt-8 text-sm text-muted">
      Card sheet:
      <a class="underline decoration-accent/40" href="/gpus/r9700">R9700 measured page</a>
      ·
      Quant picker:
      <a class="underline decoration-accent/40" href="/compare/q4-q5-q6">Q6 vs Q5 vs Q4</a>
      ·
      <a class="underline decoration-accent/40" href="/results">run cards</a>
      ·
      <a class="underline decoration-accent/40" href="/calculator">calculator</a>
    </p>
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>

<script is:inline>
  const QUANT_KEY = { 'Q6_K': 'q6', 'UD-Q5_K_XL': 'q5xl', 'Q5_K_M': 'q5', 'Q4_K_M': 'q4' };
  const CTX_KEY = { '4096': '4k', '32768': '32k', '131072': '128k', '262144': '256k' };
  const CTX_ANSWER = { '4096': 'short', '32768': '32K', '131072': '128K', '262144': '256K' };
  const state = { quant: '', context: '', gpuCount: '' };
  const form = document.getElementById('compare-filters');
  const status = document.querySelector('[data-compare-status]');
  const empty = document.querySelector('[data-compare-empty]');
  const secondCardBox = document.querySelector('[data-second-card-box]');
  const secondCardPayloadEl = document.getElementById('second-card-payload');
  const secondCardData = secondCardPayloadEl ? JSON.parse(secondCardPayloadEl.textContent || '{}') : null;
  const secondCardRels = window.__secondCardRels || { r9700: 'noopener', ram: 'noopener' };

  function pctChange(from, to) {
    if (!from) return 0;
    return ((to - from) / from) * 100;
  }

  function findCell(quant, ctx) {
    return (secondCardData?.cells || []).find((row) => row.quant === quant && row.ctx === ctx);
  }

  function verdictFromAnswers(answers) {
    const cells = secondCardData?.cells || [];
    const flash = secondCardData?.flash || {};
    const r9700 = secondCardData?.r9700Href || '/go/newegg/r9700?src=second-card-verdict';
    const ram = secondCardData?.ramHref || '/go/newegg/ddr5-256?src=second-card-verdict';
    if (answers.twoModels) {
      return {
        buy: true,
        pick: 'second R9700',
        why: 'Running the 35B on one card and a second model on the other is the cleanest reason to own two cards: neither model is split, so neither loses speed.',
        evidence: 'layout reason, no speed claim',
        link: r9700,
        also: null,
      };
    }
    if (answers.model === 'flash') {
      const bits = ['A Flash-class model does not fit one 32 GB card at Q4+, so the RAM is the must-buy and the second card is the speed add-on.'];
      if (flash.storyTok != null && flash.codeTok != null) {
        bits.push('Measured here: two R9700s + DDR5 on Strata, UD-Q5_K_XL, ' + flash.storyTok + ' tok/s story / ' + flash.codeTok + ' code.');
      }
      if (flash.citedOneStory != null && flash.citedTwoStory != null && flash.citedOneCode != null && flash.citedTwoCode != null) {
        bits.push('Cited (maintainer, MTP on, experts in RAM): one card UD-Q5 ' + flash.citedOneStory + '/' + flash.citedOneCode + ' tok/s, two cards ' + flash.citedTwoStory + '/' + flash.citedTwoCode + '.');
      }
      let evidence = 'measured + cited';
      if (flash.citedOneStory != null && flash.citedTwoStory != null && flash.citedOneCode != null && flash.citedTwoCode != null) {
        const story = Math.round(pctChange(flash.citedOneStory, flash.citedTwoStory));
        const code = Math.round(pctChange(flash.citedOneCode, flash.citedTwoCode));
        evidence = 'measured + cited; second card adds ~' + story + '% story, ~' + code + '% code decode on Strata';
      }
      return { buy: true, pick: 'second R9700 + 256 GB DDR5', why: bits.join(' '), evidence: evidence, link: r9700, also: ram };
    }
    if (answers.ctxOver262k) {
      return {
        buy: true,
        pick: 'second R9700',
        why: 'Past 262K on the 35B (YaRN to ~1M) needs two cards at f16 KV by our KV math; one card reaches 524K only at UD-Q5 with q8_0 KV.',
        evidence: 'estimate from GGUF KV sizes',
        link: r9700,
        also: null,
      };
    }
    const row = findCell(answers.quant, answers.ctx);
    if (!row) {
      return {
        buy: false,
        pick: 'keep one R9700',
        why: 'No measured one-vs-split cell for that filter. We will not invent a tok/s.',
        evidence: 'measured, pending re-verify after RAM fix',
        link: null,
        also: null,
      };
    }
    const dec = pctChange(row.oneDecode, row.splitDecode);
    const pre = pctChange(row.onePrefill, row.splitPrefill);
    if (answers.longPrompts && pre >= 10) {
      return {
        buy: true,
        pick: 'second R9700 (prompt speed only)',
        why: 'At ' + row.contextLabel + ' the split reads prompts ' + Math.round(pre) + '% faster (' + row.onePrefill + ' -> ' + row.splitPrefill + ' tok/s) while decode changes ' + (dec >= 0 ? '+' : '') + Math.round(dec) + '%. Worth it only if long documents are your main workload.',
        evidence: 'measured, pending re-verify after RAM fix',
        link: r9700,
        also: null,
      };
    }
    if (dec > 0 && answers.quant === 'Q6_K') {
      const udShort = findCell('UD-Q5_K_XL', 'short');
      const q6Short = findCell('Q6_K', 'short');
      const ud128 = findCell('UD-Q5_K_XL', '128K');
      const q6_128 = findCell('Q6_K', '128K');
      const ud256 = findCell('UD-Q5_K_XL', '256K');
      const q6_256 = findCell('Q6_K', '256K');
      const beats = [];
      if (udShort && q6Short) beats.push(udShort.oneDecode + ' vs ' + q6Short.splitDecode + ' short');
      if (ud128 && q6_128) beats.push(ud128.oneDecode + ' vs ' + q6_128.splitDecode + ' at 128K');
      if (ud256 && q6_256) beats.push(ud256.oneDecode + ' vs ' + q6_256.splitDecode + ' at 256K');
      const beatBit = beats.length ? ' UD-Q5_K_XL on one card beats the Q6_K split at every measured context (' + beats.join(', ') + ') and costs nothing.' : '';
      return {
        buy: false,
        pick: 'UD-Q5_K_XL on the card you have',
        why: 'Q6_K on one card spills into DDR5 past short context, so a split wins by ' + Math.round(dec) + '% (' + row.oneDecode + ' -> ' + row.splitDecode + ' tok/s).' + beatBit,
        evidence: 'measured, pending re-verify after RAM fix',
        link: null,
        also: null,
      };
    }
    return {
      buy: false,
      pick: 'keep one R9700',
      why: 'Measured: one card decodes ' + row.oneDecode + ' tok/s, a split of the same file ' + row.splitDecode + ' (' + (dec >= 0 ? '+' : '') + Math.round(dec) + '%). A second card does not make the 35B faster here.',
      evidence: 'measured, pending re-verify after RAM fix',
      link: null,
      also: null,
    };
  }

  function currentAnswers() {
    const model = document.querySelector('[data-second-card-model]:checked');
    return {
      model: model && model.value === 'flash' ? 'flash' : '35b',
      quant: state.quant || 'UD-Q5_K_XL',
      ctx: CTX_ANSWER[state.context] || 'short',
      longPrompts: Boolean(document.querySelector('[data-second-card-q="longPrompts"]:checked')),
      twoModels: Boolean(document.querySelector('[data-second-card-q="twoModels"]:checked')),
      ctxOver262k: Boolean(document.querySelector('[data-second-card-q="ctxOver262k"]:checked')),
    };
  }

  function paintSecondCard() {
    if (!secondCardBox || !secondCardData) return;
    const verdict = verdictFromAnswers(currentAnswers());
    secondCardBox.setAttribute('data-verdict', verdict.buy ? 'buy' : 'keep');
    const title = secondCardBox.querySelector('[data-second-card-title]');
    const why = secondCardBox.querySelector('[data-second-card-why]');
    const evidence = secondCardBox.querySelector('[data-second-card-evidence]');
    if (title) title.textContent = verdict.buy ? 'Worth it for you: ' + verdict.pick : 'Save your money: ' + verdict.pick;
    if (why) why.textContent = verdict.why;
    if (evidence) evidence.textContent = 'Source: ' + verdict.evidence + '. Cells cite run cards above.';
    const actions = secondCardBox.querySelector('[data-second-card-actions]');
    if (actions) {
      actions.replaceChildren();
      if (verdict.buy && verdict.link) {
        const gpu = document.createElement('a');
        gpu.className = 'btn-primary';
        gpu.href = verdict.link;
        gpu.rel = secondCardRels.r9700;
        gpu.target = '_blank';
        gpu.textContent = 'Check R9700 at Newegg';
        actions.appendChild(gpu);
      }
      if (verdict.buy && verdict.also) {
        const kit = document.createElement('a');
        kit.className = 'btn-ghost';
        kit.href = verdict.also;
        kit.rel = secondCardRels.ram;
        kit.target = '_blank';
        kit.textContent = '256 GB DDR5 kit at Newegg';
        actions.appendChild(kit);
      }
      if (!verdict.buy) {
        const budget = document.createElement('a');
        budget.className = 'btn-ghost';
        budget.href = '/budget';
        budget.textContent = 'Plan a later Flash build instead';
        actions.appendChild(budget);
      }
    }
    secondCardBox.querySelectorAll('[data-second-card-model]').forEach((input) => {
      const label = input.closest('label');
      if (label) label.classList.toggle('is-on', input.checked);
    });
  }

  function readUrl() {
    const q = new URLSearchParams(location.search);
    const n = q.get('n');
    state.gpuCount = n === '1' || n === '2' ? n : '';
    const rawQ = (q.get('q') || '').split(',')[0];
    const quant = Object.entries(QUANT_KEY).find(([, key]) => key === rawQ);
    state.quant = quant ? quant[0] : '';
    const rawC = (q.get('c') || '').split(',')[0];
    const ctx = Object.entries(CTX_KEY).find(([, key]) => key === rawC);
    state.context = ctx ? ctx[0] : '';
  }

  function writeUrl() {
    const q = new URLSearchParams();
    if (state.gpuCount) q.set('n', state.gpuCount);
    if (state.quant && QUANT_KEY[state.quant]) q.set('q', QUANT_KEY[state.quant]);
    if (state.context && CTX_KEY[state.context]) q.set('c', CTX_KEY[state.context]);
    const next = q.toString();
    const url = next ? location.pathname + '?' + next : location.pathname;
    if (url !== location.pathname + location.search) history.replaceState({}, '', url);
  }

  function paintChips() {
    if (!form) return;
    form.querySelectorAll('[data-filter]').forEach((btn) => {
      const key = btn.getAttribute('data-filter');
      const value = btn.getAttribute('data-value') || '';
      const on = key === 'quant' ? state.quant === value : key === 'context' ? state.context === value : state.gpuCount === value;
      btn.classList.toggle('is-on', on);
    });
  }

  function apply() {
    writeUrl();
    paintChips();
    let shown = 0;
    document.querySelectorAll('[data-compare-row]').forEach((node) => {
      const q = node.getAttribute('data-quant') || '';
      const c = node.getAttribute('data-context') || '';
      const match = (!state.quant || q === state.quant) && (!state.context || c === state.context);
      node.hidden = !match;
      if (match) shown += node.tagName === 'TR' || node.tagName === 'ARTICLE' ? 1 : 0;
    });
    const articles = document.querySelectorAll('article[data-compare-row]:not([hidden])').length;
    if (status) status.textContent = articles + ' rows. Share this URL.';
    if (empty) empty.classList.toggle('hidden', articles > 0);
    document.querySelectorAll('[data-side]').forEach((node) => {
      const side = node.getAttribute('data-side');
      node.hidden = !!(state.gpuCount && side !== state.gpuCount);
    });
    paintSecondCard();
  }

  readUrl();
  if (form) {
    form.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-filter]');
      if (!btn) return;
      const key = btn.getAttribute('data-filter');
      const value = btn.getAttribute('data-value') || '';
      if (key === 'quant') state.quant = value;
      if (key === 'context') state.context = value;
      if (key === 'gpuCount') state.gpuCount = value;
      apply();
    });
  }
  if (secondCardBox) {
    secondCardBox.addEventListener('change', paintSecondCard);
  }
  apply();
</script>

<style>
  .chip {
    min-height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--raised);
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
  }
  .chip.is-on {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .compare-sticky thead th {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    background: var(--raised);
  }
</style>
