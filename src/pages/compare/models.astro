---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextSteps from '../../components/NextSteps.astro';
import OpenInStackLab from '../../components/OpenInStackLab.astro';
import {
  MODEL_COMPARE_ENGINE,
  MODEL_COMPARE_HUB_LEAD,
  MODEL_COMPARE_IDS,
  MODEL_COMPARE_SHORT,
  modelCompareHubCards,
  modelCompareLinksFor,
  modelCompareSide,
  parseModelComparePicker,
} from '../../lib/model-compare';
import { HOUSE_STACK_LAB } from '../../lib/stack-lab-open';

const cards = modelCompareHubCards();
const sides = MODEL_COMPARE_IDS.map((id) => modelCompareSide(id));
const picked = parseModelComparePicker(Astro.url.search);
const pickedHref = picked.href;
const pickedLabel =
  picked.a && picked.b
    ? `${MODEL_COMPARE_SHORT[picked.a]} vs ${MODEL_COMPARE_SHORT[picked.b]}`
    : null;
---

<Base
  title="Compare models"
  description="Pick two cited AMDai model pages. Compare sizes, cited context, Q6/Q5/Q4 fit, and a labeled Q3 estimate. No invented prices."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">
      <a class="underline decoration-accent/40" href="/compare">Compare</a>
      · cited /models pages · {MODEL_COMPARE_ENGINE}
    </p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Compare two models</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{MODEL_COMPARE_HUB_LEAD}</p>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <Callout type="note" title="Q3 is an estimate">
      <p>
        Every pair lists Q6, Q5, and Q4 plus a labeled Q3 estimate from the files already on each
        <a class="underline decoration-accent/40" href="/models">/models</a> page. Q1/Q2 stay off.
        Measured decode appears only from existing local-desktop run cards. We do not invent a price.
      </p>
    </Callout>

    <form id="model-compare-picker" class="mt-10 rounded-2xl border border-line bg-raised/50 p-5" method="get" action="/compare/models">
      <fieldset>
        <legend class="font-serif text-2xl tracking-tight">Pick Model A vs Model B</legend>
        <p class="mt-2 text-sm text-muted">
          The form works without JavaScript: submit to land on this page with a link to the pair.
          With JS, the same controls open the shareable pair URL directly.
        </p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="text-faint">Model A</span>
            <select name="a" class="mt-1 w-full rounded-xl border border-line bg-canvas px-3 py-2 text-ink">
              {sides.map((side) => (
                <option value={side.id} selected={picked.a === side.id}>{side.shortName}</option>
              ))}
            </select>
          </label>
          <label class="block text-sm">
            <span class="text-faint">Model B</span>
            <select name="b" class="mt-1 w-full rounded-xl border border-line bg-canvas px-3 py-2 text-ink">
              {sides.map((side) => (
                <option value={side.id} selected={picked.b === side.id || (!picked.b && side.id === 'glm-53-flash')}>
                  {side.shortName}
                </option>
              ))}
            </select>
          </label>
        </div>
        <button class="btn-primary mt-5" type="submit">Compare</button>
      </fieldset>
    </form>

    {pickedHref && pickedLabel && (
      <p class="mt-6 rounded-2xl border border-accent/40 bg-raised/50 p-5">
        Open the static pair page:
        <a class="ml-1 underline decoration-accent/40 underline-offset-2" href={pickedHref}>{pickedLabel}</a>
      </p>
    )}

    <section id="featured" class="mt-12" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="font-serif text-3xl tracking-tight">Useful pairs</h2>
      <p class="mt-3 text-sm text-muted">
        Pre-rendered, shareable URLs. Every other catalog pair is also a static page — use the picker or the lists below.
      </p>
      <ul class="mt-6 grid gap-4">
        {cards.map((card) => (
          <li>
            <a class="block rounded-2xl border border-line bg-raised/50 p-5 hover:border-accent/50" href={card.href}>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">{card.kicker}</p>
              <h3 class="mt-2 font-serif text-2xl">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{card.body}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="all-pairs" class="mt-12" aria-labelledby="all-pairs-heading">
      <h2 id="all-pairs-heading" class="font-serif text-3xl tracking-tight">Every cited model vs every other</h2>
      <p class="mt-3 text-sm text-muted">
        Works with JavaScript disabled. Each heading is one model page; the links are static pair pages.
      </p>
      {sides.map((side) => (
        <div id={`model-${side.slug}`} class="mt-8 scroll-mt-28">
          <h3 class="font-serif text-2xl tracking-tight">
            <a class="hover:text-accent-ink" href={side.path}>{side.shortName}</a>
            <span class="ml-2 font-sans text-sm font-normal text-faint">{side.paramsLine} · {side.contextLabel}</span>
          </h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {modelCompareLinksFor(side.id).map((link) => (
              <li>
                <a class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm" href={link.href}>
                  vs {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section id="stack-lab" class="mt-12" aria-labelledby="stack-lab-heading">
      <h2 id="stack-lab-heading" class="font-serif text-3xl tracking-tight">Stack Lab</h2>
      <p class="mt-3 text-sm text-muted">
        Doctor is allowlisted on every compare. House daily / Flash / agent profiles stay on those house model pages only.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.doctor} />
      </div>
    </section>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40 underline-offset-2" href="/compare">Compare 35B</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/compare/gpus">Compare GPUs</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/models">Models</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/benchmarks">Benchmarks</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/calculator">Calculator</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/stack-lab">Stack Lab</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/models/qwen36">Qwen3.6-35B</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/models/flash">Qwen 3.8 Flash</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/models/glm-53-flash">GLM 5.3 Flash</a>
    </p>
    <NextSteps path="/compare/models" />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>

<script>
  const form = document.getElementById('model-compare-picker');
  if (form instanceof HTMLFormElement) {
    const slugs: Record<string, string> = {
      qwen36: 'qwen36',
      flash: 'flash',
      'gpt-oss-20b': 'gpt-oss-20b',
      'gemma3-27b': 'gemma3-27b',
      'llama33-70b': 'llama33-70b',
      'glm-53-flash': 'glm-53-flash',
      'qwen36-27b': 'qwen36-27b',
      'qwen38-27b': 'qwen38-27b',
    };
    const order = Object.keys(slugs);
    form.addEventListener('submit', (event) => {
      const data = new FormData(form);
      const a = String(data.get('a') ?? '');
      const b = String(data.get('b') ?? '');
      if (!a || !b || a === b) return;
      const ia = order.indexOf(a);
      const ib = order.indexOf(b);
      if (ia < 0 || ib < 0) return;
      const left = ia < ib ? a : b;
      const right = ia < ib ? b : a;
      const leftSlug = slugs[left];
      const rightSlug = slugs[right];
      if (!leftSlug || !rightSlug) return;
      event.preventDefault();
      window.location.href = `/compare/models/${leftSlug}-vs-${rightSlug}`;
    });
  }
</script>
