---
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import { FLASH_RERUN_NOTE } from '../../lib/run-card';
import { compareHubCards, SWEEP_REVERIFY } from '../../lib/local-desktop-compare';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextSteps from '../../components/NextSteps.astro';
import HowWeTest from '../../components/HowWeTest.astro';
import HouseRam from '../../components/HouseRam.astro';

const cards = compareHubCards();
---

<Base
  title="Compare 35B on local-desktop"
  description="Cited AMDai decisions from official local-desktop 35B llama.cpp run cards — one GPU vs split, and Q6 / Q5 / Q4 plus a labeled Q3 estimate."
>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">local-desktop · llama.cpp first</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Compare, from the cards</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      These pages turn the official <strong class="text-ink">AMDai</strong> 35B sweep into shopper questions:
      one R9700 or a split across two, which quant to load, Radeon versus an RTX card,
      and GPU-vs-GPU pages under
      <a class="underline decoration-accent/40 underline-offset-2" href="/compare/gpus">/compare/gpus</a>
      built only from the sheets already on the site.
      Every tok/s and measured GB is from validated <code class="text-ink">amdai-bench/run@1</code> cards on local-desktop.
      We do not invent a speed or a price.
    </p>
    <div class="mt-4">
      <HowWeTest />
    </div>
    <div class="mt-6">
      <HouseRam which="daily" compact />
    </div>
    <p class="mt-3 text-sm text-faint">
      Engine is llama.cpp Vulkan. Q3 is listed only as a labeled estimate.
      Q1/Q2 stay off. The master grid of every 3.6 / 3.8 file stays on
      <a class="underline decoration-accent/40 underline-offset-2" href="/qwen">/qwen</a>.
    </p>

    <Callout type="warn" title="Overnight sweep, 2026-10-12">
      <p>{SWEEP_REVERIFY}</p>
    </Callout>
    <Callout type="warn" title="Flash / Strata / Q3 pending">
      <p>{FLASH_RERUN_NOTE} These compare pages are 35B llama.cpp only.</p>
    </Callout>

    <ul class="mt-10 grid gap-4">
      {cards.map((card) => (
        <li>
          <a class="block rounded-2xl border border-line bg-raised/50 p-5 hover:border-accent/50" href={card.href}>
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">{card.kicker}</p>
            <h2 class="mt-2 font-serif text-2xl">{card.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{card.body}</p>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40 underline-offset-2" href="/gpus/r9700">R9700 measured page</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/results">run cards</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/benchmarks">benchmarks</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/calculator">calculator</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/qwen36-dual">two copies vs split</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/multi-gpu">dual / multi-GPU</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/compare/gpus">Compare GPUs</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/compare/radeon-vs-nvidia">Radeon vs NVIDIA</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/glossary">glossary</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/models/qwen36">35B model page</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/models/flash">Flash model page</a>
      ·
      <a class="underline decoration-accent/40 underline-offset-2" href="/long-context">long context</a>
    </p>
    <NextSteps path="/compare" />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
