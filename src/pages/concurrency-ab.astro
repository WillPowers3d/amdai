---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HouseRam from '../components/HouseRam.astro';
import HowWeTest from '../components/HowWeTest.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import {
  NP_CITED_LABEL,
  NP_CTX,
  NP_DESCRIPTION,
  NP_HUB_LINKS,
  NP_LEAD,
  NP_ONE,
  NP_PACK,
  NP_QUANTS,
  NP_RAM,
  NP_SHARED,
  NP_SOURCES,
  NP_STEPS,
  NP_TITLE,
  NP_TRADEOFF,
  NP_WHAT,
} from '../lib/concurrency-ab';
---

<Base title={NP_TITLE} description={NP_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="kicker">{NP_CITED_LABEL}</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">
      Parallel slots (-np) on a Radeon GPU with llama.cpp
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{NP_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {NP_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <Callout type="linux" title="One GPU, one process">
      <p>
        <code>-np</code> / <code>--parallel</code> is slots on one
        llama-server. Two copies on two R9700s stay on
        <a class="underline decoration-accent/40" href="/qwen36-dual">/qwen36-dual</a>.
        Slot tok/s stay {NP_PACK} — not the overnight one-client cards.
      </p>
    </Callout>

    <section id="what" class="mt-12 scroll-mt-28" aria-labelledby="what-heading">
      <h2 id="what-heading" class="font-serif text-3xl tracking-tight">What a slot is</h2>
      <p class="mt-3 leading-relaxed text-muted">{NP_WHAT}</p>
    </section>

    <section id="context" class="mt-12 scroll-mt-28" aria-labelledby="context-heading">
      <h2 id="context-heading" class="font-serif text-3xl tracking-tight">Context per slot</h2>
      <p class="mt-3 leading-relaxed text-muted">{NP_CTX}</p>
    </section>

    <section id="tradeoff" class="mt-12 scroll-mt-28" aria-labelledby="tradeoff-heading">
      <h2 id="tradeoff-heading" class="font-serif text-3xl tracking-tight">TTFT versus aggregate decode</h2>
      <p class="mt-3 leading-relaxed text-muted">{NP_TRADEOFF}</p>
    </section>

    <section id="flags" class="mt-12 scroll-mt-28" aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-serif text-3xl tracking-tight">Cited flags</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Vulkan <code>llama-server</code>, house 35B, loopback. Replace the binary
        and GGUF paths. These are examples, not a measured slot card.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{NP_ONE.trim()}</code></pre>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-raised/50 p-4 text-sm leading-relaxed text-ink"><code>{NP_SHARED.trim()}</code></pre>
    </section>

    <section id="quants" class="mt-12 scroll-mt-28" aria-labelledby="quants-heading">
      <h2 id="quants-heading" class="font-serif text-3xl tracking-tight">Q6 / Q5 / Q4 plus a labeled Q3</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Raising <code>-np</code> multiplies KV, not the GGUF. A smaller quant
        does not invent a slot tok/s. Nothing below Q3.
      </p>
      <ul class="mt-4 space-y-3">
        {NP_QUANTS.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-4">
            <p class="font-mono text-sm text-ink">
              {row.quant}
              {row.estimate ? ' · labeled estimate' : ''}
            </p>
            <p class="mt-1 text-sm text-muted">{row.file}. {row.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="checklist" class="mt-12 scroll-mt-28" aria-labelledby="checklist-heading">
      <h2 id="checklist-heading" class="font-serif text-3xl tracking-tight">Zero to a measured slot count</h2>
      <ol class="mt-8 space-y-6">
        {NP_STEPS.map((step, index) => (
          <li id={step.id} class="scroll-mt-28 rounded-2xl border border-line bg-raised/50 p-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-faint">
              {index + 1} · {NP_CITED_LABEL}
            </p>
            <h3 class="mt-2 font-serif text-2xl tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink">{step.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {step.links.map((link) => (
                <li>
                  <a
                    class="inline-flex min-h-9 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="fit-ram" class="mt-12 scroll-mt-28" aria-labelledby="fit-ram-heading">
      <h2 id="fit-ram-heading" class="font-serif text-3xl tracking-tight">RAM lines (Ubuntu-measured)</h2>
      <p class="mt-3 leading-relaxed text-muted">{NP_RAM}</p>
      <div class="mt-4">
        <HouseRam which="daily" compact />
      </div>
    </section>

    <section id="stack-lab-cta" class="mt-12 scroll-mt-28" aria-labelledby="stack-lab-cta-heading">
      <h2 id="stack-lab-cta-heading" class="font-serif text-3xl tracking-tight">Open in Stack Lab</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Pack {NP_PACK} is the concurrency A/B. It is not an allowlisted deep
        link on this site. Use the planner. Packages are not published yet
        and there is no public download.
      </p>
      <div class="mt-4">
        <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      </div>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
        {NP_SOURCES.map((source) => (
          <li>
            <a class="underline decoration-accent/40" href={source.href} rel="noopener">{source.title}</a>
            {source.official ? '' : ' — unofficial for llama.cpp'}
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-8">
      <HowWeTest />
    </div>
    <NextSteps path="/concurrency-ab" />
  </main>
</Base>
