---
import Base from '../layouts/Base.astro';
import { accountsEnabled } from '../lib/flags';

const on = accountsEnabled();
---

<Base title="Sign in" description="Optional login for saved rigs and stack-update alerts.">
  <main id="main" class="mx-auto max-w-lg px-4 py-10 sm:px-6">
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-accent">Account</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Sign in</h1>
    {
      on ? (
        <div class="mt-6 space-y-4">
          <p class="text-muted">Magic link to your email. GitHub is optional if this build has OAuth keys.</p>
          <form id="magic" class="space-y-3">
            <label class="block text-sm">
              <span class="text-faint">Email</span>
              <input class="mt-1 w-full rounded-xl border border-line bg-raised px-3 py-2" type="email" name="email" required autocomplete="email" />
            </label>
            <button class="rounded-full bg-accent px-5 py-2 text-sm text-white" type="submit">Send magic link</button>
            <p class="text-sm text-ok" data-status hidden></p>
          </form>
          <p class="text-sm">
            <a class="underline decoration-accent/40 underline-offset-2" href="/api/auth/github/start">Continue with GitHub</a>
          </p>
        </div>
      ) : (
        <p class="mt-4 text-muted">
          Accounts are off on this static build (<code class="font-mono text-ink">ACCOUNTS_ENABLED=0</code>).
          No database is used. See <a class="underline decoration-accent/40 underline-offset-2" href="/privacy">privacy</a>.
        </p>
      )
    }
  </main>
</Base>

{
  on && (
    <script>
      const form = document.getElementById('magic') as HTMLFormElement | null;
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const csrf = await fetch('/api/csrf').then((r) => r.json());
        const email = new FormData(form).get('email');
        const res = await fetch('/api/auth/magic', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-csrf-token': csrf.csrf },
          body: JSON.stringify({ email }),
        });
        const status = document.querySelector('[data-status]');
        if (status) {
          status.removeAttribute('hidden');
          status.textContent = res.ok
            ? 'If SMTP is unset, the link is in the server console. Otherwise check email.'
            : 'Could not send the link. Try again in a few minutes.';
        }
      });
    </script>
  )
}
