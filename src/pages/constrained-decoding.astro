---
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import HowWeTest from '../components/HowWeTest.astro';
import HouseRam from '../components/HouseRam.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import NextSteps from '../components/NextSteps.astro';
import OpenInStackLab from '../components/OpenInStackLab.astro';
import SystemRamNeed from '../components/SystemRamNeed.astro';
import { HOUSE_STACK_LAB } from '../lib/stack-lab-open';
import { runPath } from '../lib/run-card';
import { runs } from '../lib/run-card-data';
import {
  CD_CITED_LABEL,
  CD_COST,
  CD_CURL,
  CD_DESCRIPTION,
  CD_FAQ,
  CD_FLAGS,
  CD_HEADING,
  CD_HOUSE,
  CD_HUB_LINKS,
  CD_LAUNCH,
  CD_LAUNCH_GBNF,
  CD_LAUNCH_SCHEMA,
  CD_LEAD,
  CD_NAME,
  CD_PACK,
  CD_PATH,
  CD_RAM_NOTE,
  CD_SECTIONS,
  CD_SOURCES,
  CD_STACK_LAB,
  CD_UNMEASURED,
  CD_WHAT,
  CD_WHEN_GBNF,
  CD_WHEN_SCHEMA,
  COMPARE_MODEL,
  COMPARE_Q3,
  RAM_FULL_LABEL,
  RAM_MIN_LABEL,
  cdDailyRamNeed,
  cdFitNote,
  cdFitRows,
  cdMeasuredRows,
  cdOffloadRamNeed,
  cdQ3RamNeed,
} from '../lib/constrained-decoding';

const measured = cdMeasuredRows(runs);
const fit32k = cdFitRows(1, 32768);
const fit262k = cdFitRows(1, 262144);
const dailyRam = cdDailyRamNeed();
const offloadRam = cdOffloadRamNeed();
const q3Ram = cdQ3RamNeed();
---

<Base title={CD_NAME} description={CD_DESCRIPTION}>
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <p class="kicker">{CD_CITED_LABEL}</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">{CD_HEADING}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{CD_LEAD}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {CD_HUB_LINKS.map((link) => (
        <li>
          <a
            class="inline-flex min-h-11 items-center rounded-full border border-line bg-canvas px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
            href={link.href}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <HowWeTest />
    </div>
    {dailyRam && (
      <div class="mt-6">
        <HouseRam which="daily" compact />
      </div>
    )}
    <div class="mt-4 grid gap-3">
      <OpenInStackLab {...HOUSE_STACK_LAB.planner} compact />
      <OpenInStackLab {...HOUSE_STACK_LAB.doctor} compact />
    </div>

    <Callout type="warn" title="Grammar decode is not measured here">
      <p>
        {CD_UNMEASURED}. Baseline 35B decode (no grammar) is the official local-desktop
        llama.cpp Vulkan sweep. Pack {CD_PACK} is the A/B — not an Open-in-Stack-Lab
        deep link. {COMPARE_Q3} is a labeled estimate.
      </p>
    </Callout>

    <nav
      class="sticky z-20 -mx-4 mt-8 border-y border-line bg-canvas/95 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6"
      aria-label="Constrained decoding sections"
    >
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint">Jump to section</p>
      <ol class="flex flex-wrap gap-2">
        {CD_SECTIONS.map((section) => (
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-full border border-line bg-raised px-3 text-sm text-ink hover:border-accent/50 hover:text-accent-ink"
              href={`#${section.id}`}
            >
              {section.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="what" class="mt-12 scroll-mt-28" aria-labelledby="what-heading">
      <h2 id="what-heading" class="font-serif text-3xl tracking-tight">What a grammar does</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{CD_WHAT}</p>
    </section>

    <section id="when" class="mt-12 scroll-mt-28" aria-labelledby="when-heading">
      <h2 id="when-heading" class="font-serif text-3xl tracking-tight">GBNF vs JSON Schema</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{CD_WHEN_SCHEMA}</p>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{CD_WHEN_GBNF}</p>
    </section>

    <section id="cost" class="mt-12 scroll-mt-28" aria-labelledby="cost-heading">
      <h2 id="cost-heading" class="font-serif text-3xl tracking-tight">Cost vs free-form</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{CD_COST}</p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{CD_STACK_LAB}</p>
    </section>

    <section id="house" class="mt-12 scroll-mt-28" aria-labelledby="house-heading">
      <h2 id="house-heading" class="font-serif text-3xl tracking-tight">House launch</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{CD_HOUSE}</p>
      <p class="mt-3 text-sm text-muted">
        Daily-driver recipe:
        <a class="underline decoration-accent/40" href="/recipes/qwen36-35b.llamacpp-vulkan.262k">qwen36-35b.llamacpp-vulkan.262k</a>
        · Coding attach:
        <a class="underline decoration-accent/40" href="/setup/coding-assistant">/setup/coding-assistant</a>
        · Harnesses:
        <a class="underline decoration-accent/40" href="/harnesses">/harnesses</a>.
      </p>
      <pre class="mt-6 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{CD_LAUNCH}</pre>
    </section>

    <section id="flags" class="mt-12 scroll-mt-28" aria-labelledby="flags-heading">
      <h2 id="flags-heading" class="font-serif text-3xl tracking-tight">llama.cpp flags</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Cited from the
        <a class="underline decoration-accent/40" href="https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md" rel="noopener">llama.cpp server README</a>
        and
        <a class="underline decoration-accent/40" href="https://github.com/ggml-org/llama.cpp/blob/master/grammars/README.md" rel="noopener">grammars/README.md</a>
        (checked 2026-10-14). Vulkan first; HIP after rocminfo lists the gfx —
        <a class="underline decoration-accent/40" href="/compare/vulkan-vs-rocm">Vulkan vs ROCm</a>.
      </p>
      <ul class="mt-6 grid gap-4">
        {CD_FLAGS.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-mono text-sm text-accent-ink">{row.flag}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{row.meaning}</p>
            <p class="mt-2 text-xs text-faint">{row.cite}</p>
          </li>
        ))}
      </ul>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">llama-server with a JSON Schema</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{CD_LAUNCH_SCHEMA}</pre>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">llama-cli with a GBNF file</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{CD_LAUNCH_GBNF}</pre>
      <h3 class="mt-8 font-serif text-2xl tracking-tight">curl · response_format</h3>
      <pre class="mt-4 overflow-x-auto rounded-2xl border border-line bg-canvas p-4 text-xs">{CD_CURL}</pre>
      <p class="mt-3 text-sm text-faint">
        Shape only. Speed knobs (-ngl, threads, batch, -fa, KV, split, draft) live on
        <a class="underline decoration-accent/40" href="/tuning">/tuning</a>.
      </p>
    </section>

    <section id="measured" class="mt-12 scroll-mt-28" aria-labelledby="measured-heading">
      <h2 id="measured-heading" class="font-serif text-3xl tracking-tight">Measured 35B — no grammar</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
        Official {COMPARE_MODEL} llama.cpp Vulkan cells from existing run cards.
        These launches have no --grammar / --json-schema. Grammar-on cells stay
        {CD_UNMEASURED}. {COMPARE_Q3} is a labeled estimate. Full matrix:
        <a class="underline decoration-accent/40" href="/benchmarks">/benchmarks</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">{COMPARE_MODEL} decode on one R9700 without a grammar</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Kind</th>
              <th class="py-2 pr-3 font-normal" scope="col">4K decode</th>
              <th class="py-2 pr-3 font-normal" scope="col">32K decode</th>
              <th class="py-2 font-normal" scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {measured.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">{row.quant}</th>
                <td class="py-3 pr-3 text-muted">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Measured'}</td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && /tok\/s/.test(row.decode4k) ? (
                    <span class="text-accent-ink">{row.decode4k}</span>
                  ) : (
                    <span class="text-faint">{row.decode4k}</span>
                  )}
                </td>
                <td class="py-3 pr-3">
                  {row.kind === 'measured' && /tok\/s/.test(row.decode32k) ? (
                    <span class="text-accent-ink">{row.decode32k}</span>
                  ) : (
                    <span class="text-faint">{row.decode32k}</span>
                  )}
                </td>
                <td class="py-3 text-xs text-faint">
                  {row.note}
                  {row.runIds.length > 0 && (
                    <p class="mt-1">
                      {row.runIds.map((id) => (
                        <a class="mr-2 underline decoration-accent/40" href={runPath(id)}>{id}</a>
                      ))}
                    </p>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fit" class="mt-12 scroll-mt-28" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="font-serif text-3xl tracking-tight">VRAM fit — Q6 / Q5 / Q4 + Q3 estimate</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{cdFitNote()}</p>

      <h3 class="mt-8 font-serif text-2xl tracking-tight">One R9700 · 32K</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Calculator VRAM for house 35B at 32K on one R9700</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Weights</th>
              <th class="py-2 pr-3 font-normal" scope="col">Total</th>
              <th class="py-2 pr-3 font-normal" scope="col">Usable</th>
              <th class="py-2 font-normal" scope="col">Leftover</th>
            </tr>
          </thead>
          <tbody>
            {fit32k.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">
                  {row.quant}
                  <span class="mt-1 block text-xs text-faint">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Estimate'}</span>
                </th>
                <td class="py-3 pr-3 tabular-nums">{row.weightsGb}</td>
                <td class="py-3 pr-3 tabular-nums">{row.totalGb}</td>
                <td class="py-3 pr-3 tabular-nums">{row.usableGb}</td>
                <td class="py-3 text-xs text-faint">{row.leftover}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="mt-8 font-serif text-2xl tracking-tight">One R9700 · 262K</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Calculator VRAM for house 35B at 262K on one R9700</caption>
          <thead>
            <tr class="border-b border-line text-faint">
              <th class="py-2 pr-3 font-normal" scope="col">Quant</th>
              <th class="py-2 pr-3 font-normal" scope="col">Weights</th>
              <th class="py-2 pr-3 font-normal" scope="col">Total</th>
              <th class="py-2 pr-3 font-normal" scope="col">Usable</th>
              <th class="py-2 font-normal" scope="col">Leftover</th>
            </tr>
          </thead>
          <tbody>
            {fit262k.map((row) => (
              <tr class="border-b border-line/70 align-top">
                <th class="py-3 pr-3 font-medium" scope="row">
                  {row.quant}
                  <span class="mt-1 block text-xs text-faint">{row.kind === 'q3-estimate' ? 'Q3 estimate' : 'Estimate'}</span>
                </th>
                <td class="py-3 pr-3 tabular-nums">{row.weightsGb}</td>
                <td class="py-3 pr-3 tabular-nums">{row.totalGb}</td>
                <td class="py-3 pr-3 tabular-nums">{row.usableGb}</td>
                <td class="py-3 text-xs text-faint">{row.leftover}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted">
        More cards:
        <a class="underline decoration-accent/40" href="/gpus/r9700">R9700</a>
        ·
        <a class="underline decoration-accent/40" href="/compare/q4-q5-q6">Q6 / Q5 / Q4</a>
        ·
        <a class="underline decoration-accent/40" href="/moe">MoE</a>
        ·
        <a class="underline decoration-accent/40" href="/calculator">Calculator</a>.
      </p>
    </section>

    <aside id="q3" class="mt-12 scroll-mt-28 rounded-2xl border border-line bg-raised/40 p-6" aria-labelledby="q3-heading">
      <p class="kicker">Q3 estimate</p>
      <h2 id="q3-heading" class="mt-2 font-serif text-2xl tracking-tight">{COMPARE_Q3}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Q6 / Q5 / Q4 above include this labeled estimate. It is not a house pick
        and not a grammar measurement.
      </p>
      <div class="mt-4">
        <SystemRamNeed need={q3Ram} compact />
      </div>
    </aside>

    <section id="ram" class="mt-12 scroll-mt-28" aria-labelledby="ram-heading">
      <h2 id="ram-heading" class="font-serif text-3xl tracking-tight">System RAM</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{CD_RAM_NOTE}</p>
      {dailyRam && (
        <div class="mt-6">
          <h3 class="font-serif text-2xl tracking-tight">House 35B · in-VRAM on one R9700</h3>
          <div class="mt-4">
            <HouseRam which="daily" compact />
          </div>
        </div>
      )}
      <div class="mt-8">
        <h3 class="font-serif text-2xl tracking-tight">Offload example · 16 GB + 35B Q4</h3>
        <p class="mt-2 text-sm text-muted">
          {RAM_MIN_LABEL} and {RAM_FULL_LABEL}. Estimate. A grammar does not add host weight.
        </p>
        <div class="mt-4">
          <SystemRamNeed need={offloadRam} compact />
        </div>
      </div>
    </section>

    <section id="faq" class="mt-12 scroll-mt-28" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
      <ul class="mt-6 grid gap-4">
        {CD_FAQ.map((row) => (
          <li class="rounded-2xl border border-line bg-raised/50 p-5">
            <h3 class="font-serif text-2xl tracking-tight">{row.question}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{row.answer}</p>
            <p class="mt-3 text-sm">
              {row.links.map((link, index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <a class="underline decoration-accent/40" href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="sources" class="mt-12 scroll-mt-28" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-serif text-3xl tracking-tight">Sources</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {CD_SOURCES.map((source) => (
          <li>
            <a
              class="underline decoration-accent/40"
              href={source.href}
              rel={source.href.startsWith('http') ? 'noopener' : undefined}
            >
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 text-sm text-muted">
      Also:
      <a class="underline decoration-accent/40" href="/tuning">Speed up llama.cpp</a>
      ·
      <a class="underline decoration-accent/40" href="/glossary">Glossary</a>
      ·
      <a class="underline decoration-accent/40" href="/faq">FAQ</a>.
    </p>
    <NextSteps path={CD_PATH} />
    <div class="mt-12">
      <NewsletterSignup variant="article" />
    </div>
  </main>
</Base>
